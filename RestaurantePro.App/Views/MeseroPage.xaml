<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantePro.App.Views.MeseroPage"
             Title="Mesero">

    <CollectionView ItemsSource="{Binding Comandas}"
                    EmptyView="No hay comandas listas para entregar">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Grid.Row="0" Text="{Binding Id, StringFormat='Comanda #{0}'}" FontSize="Large"/>
                        <Label Grid.Row="1" Text="{Binding FechaHora, StringFormat='Fecha: {0:g}'}" />
                        <Label Grid.Row="2" Text="{Binding Mesa.Numero, StringFormat='Mesa: {0}'}" />
                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                Text="Entregar"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:MeseroViewModel}}, Path=UpdateEstadoCommand}"
                                CommandParameter="{Binding}"
                                BackgroundColor="Green"
                                TextColor="White"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>