<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.ReporteVentaPage">

    <ContentPage.BindingContext>
        <vm:ReporteVentaViewModel />
    </ContentPage.BindingContext>

    <StackLayout>
        <ListView x:Name="ReporteVentaListView" ItemsSource="{Binding ReporteVentas}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="Medium" VerticalOptions="Center" Grid.Column="0" />
                            <Label Text="{Binding TotalVentas, StringFormat='{}{0:C}'}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,20,0" Grid.Column="1" />
                            <Label Text="{Binding TotalPlatosVendidos}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>