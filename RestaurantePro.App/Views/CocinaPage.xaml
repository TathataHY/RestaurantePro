<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.CocinaPage"
             Title="Cocina">

    <ContentPage.BindingContext>
        <vm:CocinaViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding ComandasPendientes}"
                    EmptyView="No hay comandas pendientes">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10">
                    <StackLayout>
                        <Label Text="{Binding Id, StringFormat='Comanda #{0}'}" FontSize="Large"/>
                        <Label Text="{Binding FechaHora, StringFormat='Fecha: {0:g}'}" />
                        <Label Text="{Binding Mesa.Numero, StringFormat='Mesa: {0}'}" />
                        <CollectionView ItemsSource="{Binding Detalles}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Plato.Nombre, StringFormat='{0} x{1}'}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>