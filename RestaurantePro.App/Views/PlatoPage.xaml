<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.PlatoPage">

    <ContentPage.BindingContext>
        <vm:PlatoViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <ListView x:Name="PlatoListView" ItemsSource="{Binding Platos}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar" Command="{Binding BindingContext.EditPlatoCommand, Source={x:Reference PlatoListView}}" CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Eliminar" Command="{Binding BindingContext.DeletePlatoCommand, Source={x:Reference PlatoListView}}" CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Nombre}" FontSize="Medium" VerticalOptions="Center" Grid.Column="0" />
                                <Label Text="{Binding Precio, StringFormat='{}{0:C}'}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,20,0" Grid.Column="1" />
                                <Label Text="{Binding Categoria}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                            </Grid>
                        </SwipeView>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Agregar Plato" Command="{Binding AddPlatoCommand}" />
    </StackLayout>
</ContentPage>