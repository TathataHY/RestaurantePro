<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.MenuPage">

    <ContentPage.BindingContext>
        <vm:MenuViewModel />
    </ContentPage.BindingContext>

    <StackLayout>
        <Label Text="Menú del Día" FontSize="Large" HorizontalOptions="Center" />
        <ListView x:Name="PlatosListView" ItemsSource="{Binding Platos}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Actualizar Stock" BackgroundColor="LightGreen" Command="{Binding BindingContext.UpdateStockCommand, Source={x:Reference PlatosListView}}" CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Nombre}" FontSize="Medium" VerticalOptions="Center" Grid.Column="0" />
                                <Label Text="{Binding Precio, StringFormat='{}{0:C}'}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="1" Margin="0,0,10,0" />
                                <Label Text="{Binding Stock}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                            </Grid>
                        </SwipeView>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>