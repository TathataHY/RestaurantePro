<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.UsuarioPage">

    <ContentPage.BindingContext>
        <vm:UsuarioViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <ListView x:Name="UsuarioListView" ItemsSource="{Binding Usuarios}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar" Command="{Binding BindingContext.EditUsuarioCommand, Source={x:Reference UsuarioListView}}" CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Eliminar" Command="{Binding BindingContext.DeleteUsuarioCommand, Source={x:Reference UsuarioListView}}" CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Nombre}" FontSize="Medium" VerticalOptions="Center" Grid.Column="0" />
                                <Label Text="{Binding Rol}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,20,0" Grid.Column="1" />
                                <Label Text="{Binding Activo, Converter={StaticResource BoolToAvailabilityConverter}}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                            </Grid>
                        </SwipeView>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Agregar Usuario" Command="{Binding AddUsuarioCommand}" />
    </StackLayout>
</ContentPage>