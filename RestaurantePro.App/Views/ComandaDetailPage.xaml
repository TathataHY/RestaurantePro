<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.ComandaDetailPage">

    <ContentPage.BindingContext>
        <vm:ComandaDetailViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <Label Text="Fecha y Hora" />
        <DatePicker Date="{Binding FechaHora}" />
        <TimePicker Time="{Binding FechaHora, Converter={StaticResource DateTimeToTimeSpanConverter}}" />

        <Label Text="Mesa" />
        <Picker ItemsSource="{Binding Mesas}" SelectedItem="{Binding Mesa}" ItemDisplayBinding="{Binding Numero}" />

        <Label Text="Estado" />
        <Picker ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" />

        <Button Text="Guardar" Command="{Binding SaveCommand}" />
    </StackLayout>
</ContentPage>