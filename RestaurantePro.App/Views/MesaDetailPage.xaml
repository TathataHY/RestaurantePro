<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.MesaDetailPage">

    <ContentPage.BindingContext>
        <vm:MesaDetailViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <Label Text="Número de Mesa" />
        <Entry Text="{Binding Numero}" />

        <Label Text="Estado" />
        <Picker ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" />

        <Button Text="Guardar" Command="{Binding SaveCommand}" />
    </StackLayout>
</ContentPage>