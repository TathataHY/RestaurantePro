<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.ComandaDetallesPage">

    <ContentPage.BindingContext>
        <vm:ComandaDetallesViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <Label Text="Detalles de la Comanda" FontSize="Large" HorizontalOptions="Center" />
        <ListView ItemsSource="{Binding Detalles}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding PlatoNombre}" FontSize="Medium" VerticalOptions="Center" Grid.Column="0" />
                            <Label Text="{Binding Cantidad}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="1" Margin="0,0,20,0" />
                            <Label Text="{Binding Subtotal, StringFormat='{}{0:C}'}" FontSize="Small" TextColor="Gray" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackLayout Orientation="Horizontal" HorizontalOptions="End" Margin="0,10,0,0">
            <Label Text="Total:" FontSize="Medium" VerticalOptions="Center" />
            <Label Text="{Binding Total, StringFormat='{}{0:C}'}" FontSize="Medium" VerticalOptions="Center" Margin="10,0,0,0" />
        </StackLayout>

        <Button Text="Agregar Detalle" Command="{Binding AddDetalleCommand}" Margin="0,20,0,0" />
    </StackLayout>
</ContentPage>