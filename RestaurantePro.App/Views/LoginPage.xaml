<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.LoginPage">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="30">
        <Label Text="Iniciar Sesión" FontSize="Large" HorizontalOptions="Center" />
        <Entry Placeholder="Nombre de Usuario" Text="{Binding NombreUsuario}" />
        <Entry Placeholder="Contraseña" Text="{Binding Contraseña}" IsPassword="True" />
        <Button Text="Iniciar Sesión" Command="{Binding LoginCommand}" />
    </StackLayout>
</ContentPage>