<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.App.ViewModels"
             x:Class="RestaurantePro.App.Views.UsuarioDetailPage">

    <ContentPage.BindingContext>
        <vm:UsuarioDetailViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <Label Text="Nombre" />
        <Entry Text="{Binding Nombre}" />

        <Label Text="Nombre de Usuario" />
        <Entry Text="{Binding NombreUsuario}" />

        <Label Text="Contraseña" />
        <Entry Text="{Binding Contraseña}" IsPassword="True" />

        <Label Text="Rol" />
        <Picker ItemsSource="{Binding Roles}" SelectedItem="{Binding Rol}" />

        <Label Text="Activo" />
        <Switch IsToggled="{Binding Activo}" />

        <Button Text="Guardar" Command="{Binding SaveCommand}" />
    </StackLayout>
</ContentPage>