{
  "AppSettings": {
    "Notifications": {
      "EnableEmailNotifications": true,
      "EnableSMSNotifications": true,
      "EnablePushNotifications": true,
      "EnableSignalRNotifications": true,
      "DefaultTimeoutSeconds": 30,
      "MaxRetryAttempts": 3
    },
    "Cache": {
      "DefaultExpirationMinutes": 60,
      "SizeLimit": 1024,
      "CompactionPercentage": 0.25,
      "EnableQueryCaching": true
    },
    "BackgroundJobs": {
      "EnableBackgroundJobs": true,
      "DefaultStockCheckIntervalHours": 24,
      "DefaultInvoiceReminderDays": 3,
      "AutoCleanupTime": "02:00",
      "LogRetentionDays": 30
    },
    "Integration": {
      "SignalR": {
        "Enabled": false,
        "NotificationHubUrl": "/notificationHub",
        "ConnectionTimeoutSeconds": 30
      },
      "ExternalServices": {
        "Email": {
          "Provider": "SMTP",
          "DefaultFromEmail": "noreply@restaurantepro.com",
          "DefaultFromName": "RestaurantePro",
          "TestMode": true
        },
        "SMS": {
          "Provider": "Twilio",
          "DefaultFromNumber": "+1234567890",
          "TestMode": true
        }
      }
    },
    "BusinessRules": {
      "Fidelizacion": {
        "PuntosMinimosCanjeActive": 100,
        "PuntosMaximosPorTransaccion": 10000,
        "PorcentajeMinimoDescuento": 5.0,
        "PorcentajeMaximoDescuento": 50.0
      },
      "Inventario": {
        "StockMinimoGlobal": 5,
        "DiasVencimientoAlerta": 7,
        "PorcentajeRotacionMinimo": 10.0
      },
      "Operaciones": {
        "TiempoMaximoPreparacionMinutos": 45,
        "ReservationToleranceMinutes": 15
      }
    },
    "Behaviors": {
      "Performance": {
        "QueryThresholdMs": 500,
        "CommandThresholdSeconds": 2.0,
        "ComplexOperationThresholdSeconds": 5.0,
        "ReportThresholdSeconds": 10.0,
        "DefaultThresholdSeconds": 3.0,
        "LogAllOperations": false,
        "EnableDetailedMetrics": true
      },
      "Retry": {
        "MaxAttempts": 3,
        "BaseDelayMs": 1000,
        "MaxDelayMs": 30000,
        "Enabled": true,
        "RetryableCommands": [
          "CrearFactura",
          "ProcesarPago",
          "FinalizarComanda",
          "CrearReservacion",
          "ActualizarStock",
          "CrearOrdenCompra",
          "EnviarNotificacion",
          "ProcesarPedidoCompleto",
          "FinalizarServicioCompleto"
        ],
        "RetryableExceptions": [
          "HttpRequestException",
          "TaskCanceledException",
          "TimeoutException",
          "InvalidConcurrencyException"
        ]
      },
      "Auditing": {
        "Enabled": true,
        "CommandsOnly": true,
        "IncludeRequestData": true,
        "IncludeResponseData": false,
        "MaxDataSizeBytes": 10240,
        "SensitiveFields": [
          "password",
          "contraseña",
          "token",
          "secret",
          "key"
        ]
      },
      "Transaction": {
        "Enabled": true,
        "TimeoutSeconds": 30,
        "DefaultIsolationLevel": "ReadCommitted",
        "AlwaysRequireTransaction": [
          "CrearFactura",
          "ProcesarPago",
          "FinalizarComanda",
          "ActualizarStock",
          "CanjearPuntos"
        ],
        "NeverRequireTransaction": [
          "ObtenerProducto",
          "BuscarCliente",
          "ConsultarStock"
        ]
      }
    },
    "Metrics": {
      "Enabled": true,
      "ReportIntervalSeconds": 60,
      "EnableBusinessMetrics": true,
      "EnableSystemMetrics": true,
      "MaxMetricsInMemory": 10000,
      "MetricsEndpoint": "https://metrics.restaurantepro.com/api/metrics"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=RestauranteProDb;Trusted_Connection=true;MultipleActiveResultSets=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RestaurantePro": "Debug"
    }
  }
} 