{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnvironmentConfig": {
    "Environment": "Demo",
    "IsDemo": true,
    "IsDevelopment": false,
    "IsProduction": false,
    "DemoSettings": {
      "NombreRestaurante": "La Buena Mesa Demo",
      "MaxComandasPerSession": 10,
      "AutoResetHours": 24,
      "HabilitarResetAutomatico": true,
      "UsuariosDemo": [
        "admin@demo.com",
        "mesero@demo.com",
        "cocinero@demo.com"
      ],
      "LimiteUsuariosConcurrentes": 50
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=demo-server;Database=RestaurantePro_Demo;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "demo-secret-key-for-testing-purposes-only",
    "Issuer": "RestaurantePro-Demo",
    "Audience": "RestaurantePro-Demo-Users",
    "ExpirationHours": 24
  },
  "SignalR": {
    "HubUrl": "/hubs",
    "EnableDetailedErrors": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://demo.restaurantepro.com",
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "RateLimiting": {
    "MaxRequestsPerMinute": 100,
    "MaxRequestsPerHour": 1000
  }
} 