<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Configuración para ASP.NET Core en IIS -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      
      <!-- Configuración del módulo ASP.NET Core -->
      <aspNetCore processPath="dotnet" 
                  arguments=".\RestaurantePro.API.dll" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        
        <!-- Variables de entorno para SmarterASP.NET -->
        <environmentVariables>
          <!-- Configurar entorno como Production para usar appsettings.Production.json -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      
      <!-- Configuración de seguridad y rendimiento -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52428800" /> <!-- 50MB -->
        </requestFiltering>
      </security>
      
      <!-- Configuración de compresión -->
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />
      
      <!-- Configuración de headers -->
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="X-XSS-Protection" value="1; mode=block" />
        </customHeaders>
      </httpProtocol>
      
      <!-- Configuración de errores personalizados -->
      <httpErrors errorMode="Detailed" />
      
    </system.webServer>
  </location>
  
  <!-- Configuración adicional para .NET Core -->
  <system.web>
    <compilation tempDirectory="~/App_Data/Temp/" />
  </system.web>
  
</configuration>
