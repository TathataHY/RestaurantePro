<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RestaurantePro.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RestaurantePro.Mobile.Features.Authentication.Pages"
    xmlns:ui="clr-namespace:RestaurantePro.Mobile.UI.Pages"
    xmlns:mesas="clr-namespace:RestaurantePro.Mobile.Features.Operations.Mesas.Pages"
    xmlns:comandas="clr-namespace:RestaurantePro.Mobile.Features.Operations.Comandas.Pages"
    Title="RestaurantePro">

    <!-- Shell Resources -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="#007ACC" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Login Page - Página inicial por defecto -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="login" />

    <!-- Main App - Con navegación por tabs -->
    <TabBar Route="main">
        <!-- Dashboard Tab -->
        <ShellContent
            Title="Dashboard"
            Icon="home.png"
            ContentTemplate="{DataTemplate ui:DashboardPage}"
            Route="dashboard" />

        <!-- Mesas Tab -->
        <ShellContent
            Title="Mesas"
            Icon="table.png"
            ContentTemplate="{DataTemplate mesas:MesasPage}"
            Route="mesas" />

        <!-- Comandas Tab -->
        <ShellContent
            Title="Comandas"
            Icon="order.png"
            ContentTemplate="{DataTemplate comandas:ComandasPage}"
            Route="comandas" />

        <!-- Más Tab - Para futuras funcionalidades -->
        <ShellContent
            Title="Más"
            Icon="more.png"
            ContentTemplate="{DataTemplate ui:DashboardPage}"
            Route="more" />
    </TabBar>

</Shell>
