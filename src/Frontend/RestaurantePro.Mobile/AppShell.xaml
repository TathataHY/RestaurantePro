<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RestaurantePro.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RestaurantePro.Mobile.Features.Authentication.Pages"
    xmlns:ui="clr-namespace:RestaurantePro.Mobile.UI.Pages"
    xmlns:mesas="clr-namespace:RestaurantePro.Mobile.Features.Operations.Mesas.Pages"
    xmlns:comandas="clr-namespace:RestaurantePro.Mobile.Features.Operations.Comandas.Pages"
    xmlns:productos="clr-namespace:RestaurantePro.Mobile.Features.Operations.Productos.Pages"
    xmlns:cocina="clr-namespace:RestaurantePro.Mobile.Features.Operations.Cocina.Pages"
    xmlns:reservaciones="clr-namespace:RestaurantePro.Mobile.Features.Inventory.Reservaciones.Pages"
    xmlns:facturas="clr-namespace:RestaurantePro.Mobile.Features.Commercial.Billing.Pages"
    xmlns:clientes="clr-namespace:RestaurantePro.Mobile.Features.Commercial.Customers.Pages"
    xmlns:tarjetas="clr-namespace:RestaurantePro.Mobile.Features.Commercial.Loyalty.Pages"
    xmlns:ingredientes="clr-namespace:RestaurantePro.Mobile.Features.Inventory.Ingredients.Pages"
    xmlns:categorias="clr-namespace:RestaurantePro.Mobile.Features.Categorias.Pages"
    xmlns:analytics="clr-namespace:RestaurantePro.Mobile.Features.Analytics.Pages"
    xmlns:dailypreps="clr-namespace:RestaurantePro.Mobile.Features.DailyPreparations.Pages"
    xmlns:views="clr-namespace:RestaurantePro.Mobile.Views"
    Title="RestaurantePro">

    <!-- Shell Resources -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="#007ACC" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Login Page - Página inicial por defecto -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:SimpleLoginPage}"
        Route="login" />

    <!-- Debug Page -->
    <ShellContent
        Title="Debug"
        ContentTemplate="{DataTemplate views:DebugPage}"
        Route="debug" />

    <!-- Onboarding Page -->
    <ShellContent
        Title="Onboarding"
        ContentTemplate="{DataTemplate views:ModernOnboardingPage}"
        Route="onboarding" />

    <!-- Main App - Con navegación por tabs -->
    <TabBar Route="main">
        <!-- Dashboard Tab -->
        <ShellContent
            Title="Dashboard"
            Icon="dashboard.png"
            ContentTemplate="{DataTemplate views:ModernDashboardPage}"
            Route="dashboard" />

        <!-- Mesas Tab -->
        <ShellContent
            Title="Mesas"
            Icon="mesas.png"
            ContentTemplate="{DataTemplate mesas:ModernMesasPage}"
            Route="mesas" />

        <!-- Comandas Tab -->
        <ShellContent
            Title="Comandas"
            Icon="comandas.png"
            ContentTemplate="{DataTemplate comandas:ModernComandasPage}"
            Route="comandas" />

        <!-- Productos Tab -->
        <ShellContent
            Title="Productos"
            Icon="productos.png"
            ContentTemplate="{DataTemplate productos:ModernProductosPage}"
            Route="productos" />

        <!-- Cocina Tab -->
        <ShellContent
            Title="Cocina"
            Icon="cocina.png"
            ContentTemplate="{DataTemplate cocina:ModernCocinaPage}"
            Route="cocina" />

        <!-- Menú del Día Tab - Operativo para Cocineros -->
        <ShellContent
            Title="Menú del Día"
            Icon="preparacionesdiarias.svg"
            ContentTemplate="{DataTemplate dailypreps:ModernDailyPreparationsPage}"
            Route="dailypreparations" />

        <!-- Reservaciones Tab - TEMPORALMENTE OCULTO -->
        <!--<ShellContent
            Title="Reservas"
            Icon="reservas.png"
            ContentTemplate="{DataTemplate reservaciones:ModernReservacionesPage}"
            Route="reservaciones" />-->

        <!-- Facturas Tab - TEMPORALMENTE OCULTO -->
        <!--<ShellContent
            Title="Facturar"
            Icon="facturar.png"
            ContentTemplate="{DataTemplate facturas:ModernFacturasPage}"
            Route="facturas" />-->

        <!-- Clientes Tab - TEMPORALMENTE OCULTO -->
        <!--<ShellContent
            Title="Clientes"
            Icon="clientes.png"
            ContentTemplate="{DataTemplate clientes:ClientesPage}"
            Route="clientes" />-->

        <!-- Tarjetas Fidelización Tab - TEMPORALMENTE OCULTO -->
        <!--<ShellContent
            Title="Fidelización"
            Icon="fidelizacion.png"
            ContentTemplate="{DataTemplate tarjetas:TarjetasFidelizacionPage}"
            Route="tarjetasfidelizacion" />-->

        <!-- Ingredientes Tab - TEMPORALMENTE OCULTO -->
        <!--<ShellContent
            Title="Ingredientes"
            Icon="ingredientes.png"
            ContentTemplate="{DataTemplate ingredientes:ModernIngredientesPage}"
            Route="ingredientes" />-->

        <!-- Categorías Tab - Navegación de menú para meseros -->
        <ShellContent
            Title="Categorías"
            Icon="categorias.png"
            ContentTemplate="{DataTemplate categorias:CategoriasPage}"
            Route="categorias" />

        <!-- Analytics Tab - Movido a Web Admin -->
        <!--<ShellContent
            Title="Analytics"
            Icon="analytics.png"
            ContentTemplate="{DataTemplate analytics:AnalyticsPage}"
            Route="analytics" />-->

        <!-- Configuración Tab -->
        <ShellContent
            Title="Configuración"
            Icon="configuracion.png"
            ContentTemplate="{DataTemplate views:ModernConfiguracionPage}"
            Route="configuracion" />

        <!-- Perfil Tab -->
        <ShellContent
            Title="Perfil"
            Icon="perfil.png"
            ContentTemplate="{DataTemplate views:ModernPerfilPage}"
            Route="perfil" />
    </TabBar>

</Shell>
