<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Views.DailyPreparationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:viewmodels="clr-namespace:RestaurantePro.Mobile.Core.Features.DailyPreparations.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:models="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             Title="Menú del Día"
             x:DataType="viewmodels:DailyPreparationsViewModel">

    <Grid RowDefinitions="*">

        <!-- Contenido Principal en un solo scroll (Header + Items) -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
                
                <CollectionView ItemsSource="{Binding PreparacionesDiarias}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedPreparacion}">

                    <!-- Header: estadísticas + búsqueda + filtros -->
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="12" Padding="16,8,16,0">
                            
                            <!-- Estadísticas del Día -->
                            <Grid BackgroundColor="{StaticResource Primary}"
                                  Padding="16"
                                  IsVisible="{Binding MostrarEstadisticas}">
                                
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    
                                    <!-- Título -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="📊 Estadísticas del Día"
                                           TextColor="White"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    
                                    <!-- Botón para ocultar/mostrar estadísticas -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Text="👁️"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontSize="16"
                                            Command="{Binding ToggleEstadisticasCommand}"/>
                                    
                                    <!-- Estadísticas -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" 
                                          ColumnDefinitions="*,*,*,*"
                                          Margin="0,8,0,0">
                                        
                                        <!-- Total Preparaciones -->
                                        <StackLayout Grid.Column="0" HorizontalOptions="Center">
                                            <Label Text="{Binding Estadisticas.TotalPreparaciones}"
                                                   TextColor="White"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Total"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                        
                                        <!-- Disponibles -->
                                        <StackLayout Grid.Column="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Estadisticas.PreparacionesDisponibles}"
                                                   TextColor="White"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Disponibles"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                        
                                        <!-- Por Vencer -->
                                        <StackLayout Grid.Column="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Estadisticas.PreparacionesPorVencer}"
                                                   TextColor="White"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Por Vencer"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                        
                                        <!-- Eficiencia -->
                                        <StackLayout Grid.Column="3" HorizontalOptions="Center">
                                            <Label Text="{Binding Estadisticas.EficienciaFormateada}"
                                                   TextColor="White"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Eficiencia"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Barra de herramientas -->
                            <Grid BackgroundColor="{StaticResource Surface}"
                                  Padding="16"
                                  ColumnDefinitions="*,Auto,Auto">
                                
                                <!-- Barra de búsqueda -->
                                <Grid Grid.Column="0" ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           Placeholder="🔍 Buscar preparaciones..."
                                           Text="{Binding TextoBusqueda}"
                                           ReturnCommand="{Binding BuscarPreparacionesCommand}"/>
                                    
                                    <Button Grid.Column="1"
                                            Text="❌"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource OnSurface}"
                                            Command="{Binding LimpiarBusquedaCommand}"
                                            IsVisible="{Binding TextoBusqueda, Converter={StaticResource StringToBoolConveY rter}}"/>
                                </Grid>
                                
                                <!-- Botón de filtro -->
                                <Button Grid.Column="1"
                                        Text="🔽"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource OnSurface}"
                                        Command="{Binding ShowFiltrosCommand}"
                                        Margin="8,0,0,0"/>
                                
                                <!-- Botón de refresh -->
                                <Button Grid.Column="2"
                                        Text="🔄"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource OnSurface}"
                                        Command="{Binding RefreshCommand}"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    
                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" 
                                     VerticalOptions="Center"
                                     Margin="20">
                            <Label Text="🍽️"
                                   FontSize="48"
                                   HorizontalOptions="Center"/>
                            <Label Text="No hay elementos en el menú del día"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,0"/>
                            <Label Text="Toca el botón + para agregar un nuevo elemento al menú"
                                   FontSize="14"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   HorizontalOptions="Center"
                                   Margin="0,4,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PreparacionDiariaDto">
                            
                            <Grid Padding="16" 
                                  BackgroundColor="{StaticResource Surface}"
                                  Margin="8,4"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto">
                                
                                <!-- Header con nombre y estado -->
                                <Frame Grid.Row="0" Grid.ColumnSpan="2" 
                                       HasShadow="False" 
                                       BackgroundColor="Transparent"
                                       Padding="0">
                                    
                                    <VerticalStackLayout Spacing="4">
                                        
                                        <!-- Nombre del producto con scroll horizontal -->
                                        <ScrollView Orientation="Horizontal" 
                                                   HorizontalScrollBarVisibility="Never"
                                                   VerticalScrollBarVisibility="Never">
                                            <Label Text="{Binding NombreProducto}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource OnSurface}"
                                                   HorizontalOptions="Start"/>
                                        </ScrollView>
                                        
                                        <!-- Estado del producto -->
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                            <Label Text="{Binding IconoEstado}"
                                                   FontSize="16"/>
                                            
                                            <Label Text="{Binding TextoEstado}"
                                                   FontSize="12"
                                                   TextColor="{Binding ColorEstado}"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                                
                                <!-- Información de cantidades -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" 
                                      ColumnDefinitions="*,*,*"
                                      Margin="0,8,0,0">
                                    
                                    <StackLayout Grid.Column="0" HorizontalOptions="Center">
                                        <Label Text="{Binding CantidadPreparada}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                        <Label Text="Preparada"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                    
                                    <StackLayout Grid.Column="1" HorizontalOptions="Center">
                                        <Label Text="{Binding CantidadDisponible}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{Binding ColorEstado}"
                                               HorizontalOptions="Center"/>
                                        <Label Text="Disponible"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                    
                                    <StackLayout Grid.Column="2" HorizontalOptions="Center">
                                        <Label Text="{Binding CantidadConsumida}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                        <Label Text="Consumida"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                </Grid>
                                
                                <!-- Información adicional y botones -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" 
                                      ColumnDefinitions="*,Auto"
                                      Margin="0,8,0,0">
                                    
                                    <!-- Información adicional -->
                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding NombreChef, StringFormat='Chef: {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"/>
                                        
                                        <Label Text="{Binding FechaVencimiento, StringFormat='Vence: {0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="12"
                                               TextColor="{Binding EstaPorVencer, Converter={StaticResource BoolToColorConverter}}"/>
                                        
                                        <Label Text="{Binding Observaciones}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               IsVisible="{Binding Observaciones, Converter={StaticResource StringToBoolConverter}}"/>
                                    </StackLayout>
                                    
                                    <!-- Botones de acción -->
                                    <StackLayout Grid.Column="1" 
                                                 Orientation="Horizontal"
                                                 HorizontalOptions="End">
                                        
                                        <!-- Botón consumir -->
                                        <Button Text="🍽️"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="8,4"
                                                Margin="4,0,0,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=ConsumirPreparacionCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding EstaDisponible}"/>
                                        
                                        <!-- Botón disponible -->
                                        <Button Text="✅"
                                                BackgroundColor="{StaticResource Secondary}"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="8,4"
                                                Margin="4,0,0,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=MarcarComoDisponibleCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Estado, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Preparando}"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=CanMarcarDisponible}"/>
                                        
                                        <!-- Botón editar -->
                                        <Button Text="✏️"
                                                BackgroundColor="{StaticResource Tertiary}"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="8,4"
                                                Margin="4,0,0,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=EditarPreparacionCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=CanEditarPreparacion}"/>
                                        
                                        <!-- Botón eliminar -->
                                        <Button Text="🗑️"
                                                BackgroundColor="{StaticResource Error}"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="8,4"
                                                Margin="4,0,0,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=EliminarPreparacionCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DailyPreparationsViewModel}}, Path=CanEliminarPreparacion}"/>
                                    </StackLayout>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        <!-- Floating Action Button -->
        <controls:FloatingActionButton Grid.Row="0"
                                       x:Name="MainFab"
                                       Text="➕"
                                       Command="{Binding CrearNuevaPreparacionCommand}"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       Margin="16,0,16,80"
                                       IsEnabled="{Binding CanCrearPreparacion}" />
    </Grid>
</ContentPage> 