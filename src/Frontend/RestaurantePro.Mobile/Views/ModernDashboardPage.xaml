<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             x:Class="RestaurantePro.Mobile.Views.ModernDashboardPage"
             Title="Dashboard"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Header con título y botón de logout -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,8,16,0">
            <Label Grid.Column="0" 
                   Text="Dashboard" 
                   Style="{StaticResource H1Style}" 
                   VerticalOptions="Center" />
            <Button Grid.Column="1" 
                    Text="Cerrar Sesión"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding LogoutCommand}"
                    VerticalOptions="Center"
                    Padding="12,8" />
        </Grid>
        
        <!-- Header con estadísticas -->
        <ScrollView Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal"
                    Padding="16,8">
            <HorizontalStackLayout Spacing="12">
                
                <!-- Card de Ventas Hoy -->
                <controls:ModernCard Padding="16" WidthRequest="160">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="💰" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Ventas Hoy" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TodaySales, StringFormat='${0:F2}'}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource SuccessColor}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding SalesChangePercentage, StringFormat='{0:+0.0;-0.0;0}% vs ayer'}" 
                               Style="{StaticResource CaptionStyle}" 
                               TextColor="{Binding SalesChangePercentage, Converter={StaticResource PercentageChangeColorConverter}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card de Comandas Activas -->
                <controls:ModernCard Padding="16" WidthRequest="160">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🍽️" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Comandas Activas" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding ActiveOrdersCount}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource WarningColor}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding PendingOrdersCount, StringFormat='{0} pendientes'}" 
                               Style="{StaticResource CaptionStyle}" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card de Mesas Ocupadas -->
                <controls:ModernCard Padding="16" WidthRequest="160">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🪑" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Mesas Ocupadas" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding MesasOcupadasDisplay}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding PorcentajeOcupacionDisplay}" 
                               Style="{StaticResource CaptionStyle}" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Contenido principal -->
        <ScrollView Grid.Row="2" Padding="16">
            <VerticalStackLayout Spacing="24">

                <!-- Sección de Menú del Día -->
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="🍽️ Menú del Día" 
                               Style="{StaticResource H2Style}" />
                        <Button Grid.Column="1"
                                Text="Ver Todo"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ViewMenuDelDiaCommand}"
                                Padding="12,6" />
                    </Grid>
                    
                    <controls:SkeletonLoader x:Name="MenuSkeleton" 
                                            SkeletonType="List"
                                            IsVisible="{Binding IsLoading}" />
                    
                    <CollectionView x:Name="MenuDelDiaCollectionView"
                                   ItemsSource="{Binding MenuDelDia}"
                                   IsVisible="{Binding IsNotLoading}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <controls:ModernCard Padding="12" WidthRequest="220">
                                    <VerticalStackLayout Spacing="8">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding NombreProducto}" 
                                                   Style="{StaticResource H3Style}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />
                                            <!-- Estado con color -->
                                            <Border BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="8,4"
                                                    HorizontalOptions="Start">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Estado, Converter={StaticResource EstadoIconConverter}}" 
                                                           FontSize="12"
                                                           TextColor="White" />
                                                    <Label Text="{Binding Estado}" 
                                                           Style="{StaticResource CaptionStyle}"
                                                           TextColor="White" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding CantidadDisponible}" 
                                                       Style="{StaticResource H2Style}" 
                                                       TextColor="{StaticResource SuccessColor}"
                                                       HorizontalOptions="Center" />
                                                <Label Text="Disponible" 
                                                       Style="{StaticResource CaptionStyle}"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding CantidadPreparada}" 
                                                       Style="{StaticResource H2Style}" 
                                                       TextColor="{StaticResource PrimaryColor}"
                                                       HorizontalOptions="Center" />
                                                <Label Text="Preparada" 
                                                       Style="{StaticResource CaptionStyle}"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Text="{Binding NombreChef, StringFormat='Chef: {0}'}" 
                                               Style="{StaticResource CaptionStyle}" 
                                               TextColor="{StaticResource TextSecondary}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Padding="20">
                                <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                                <Label Text="No hay preparaciones disponibles para hoy" 
                                       Style="{StaticResource BodyStyle}" 
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                                <Label Text="💡 Solo se muestran preparaciones del día actual, no vencidas y con estado 'Disponible'" 
                                       Style="{StaticResource CaptionStyle}" 
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center"
                                       MaxLines="3"
                                       LineBreakMode="WordWrap" />
                                <Button Text="Gestionar Preparaciones"
                                        Command="{Binding ViewMenuDelDiaCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Sección de Acciones Rápidas -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="⚡ Acciones Rápidas" 
                           Style="{StaticResource H2Style}" />
                    
                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" 
                          ColumnSpacing="12" RowSpacing="12">
                        
                        <Button Grid.Column="0" Grid.Row="0"
                                Text="Nueva Comanda"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CreateOrderCommand}" />
                        
                        <Button Grid.Column="1" Grid.Row="0"
                                Text="Asignar Mesa"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AssignTableCommand}" />
                        
                        <Button Grid.Column="0" Grid.Row="1"
                                Text="Ver Inventario"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ViewInventoryCommand}" />
                        
                        <Button Grid.Column="1" Grid.Row="1"
                                Text="Reportes"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ViewReportsCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Sección de Comandas Recientes -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="📋 Comandas Recientes" 
                           Style="{StaticResource H2Style}" />
                    
                    <controls:TabNavigation x:Name="OrdersTabNavigation" />
                    
                    <controls:SkeletonLoader x:Name="OrdersSkeleton" 
                                            SkeletonType="List"
                                            IsVisible="{Binding IsLoading}" />
                    
                    <CollectionView x:Name="OrdersCollectionView"
                                   ItemsSource="{Binding RecentOrders}"
                                   IsVisible="{Binding IsNotLoading}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <controls:ModernCard Margin="0,8">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding OrderNumber}"
                                               Style="{StaticResource H3Style}" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Status}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="{Binding StatusColor}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding CustomerName}"
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Total, StringFormat='{0:C}'}"
                                               Style="{StaticResource BodyStyle}"
                                               FontAttributes="Bold" />
                                    </Grid>
                                </controls:ModernCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Sección de Estado de Mesas -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="🪑 Estado de Mesas" 
                           Style="{StaticResource H2Style}" />
                    
                    <!-- Grid de Mesas Dinámico -->
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*" 
                          ColumnSpacing="8" RowSpacing="8">
                        <CollectionView ItemsSource="{Binding TableStatus.Mesas}"
                                        Grid.ColumnSpan="4" Grid.RowSpan="2"
                                        ItemsLayout="VerticalGrid, 4">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <controls:ModernCard BackgroundColor="{Binding EstadoColor}"
                                                        Padding="12"
                                                        Margin="2">
                                        <Label Text="{Binding Numero}" 
                                               Style="{StaticResource H2Style}" 
                                               TextColor="White"
                                               HorizontalOptions="Center" />
                                    </controls:ModernCard>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

                <!-- Bottom Navigation - COMENTADO PARA USAR TABS NATIVOS -->
        <!--
        <controls:ModernTabBar Grid.Row="3" x:Name="BottomTabBar" />
        -->

        <!-- Floating Action Button -->
        <controls:FloatingActionButton Grid.Row="2"
                                       x:Name="MainFab"
                                       Text="➕"
                                       Command="{Binding CreateOrderCommand}"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       Margin="16,0,16,16" />

    </Grid>

</ContentPage> 
