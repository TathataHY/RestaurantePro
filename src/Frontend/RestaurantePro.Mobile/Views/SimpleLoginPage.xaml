<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             x:Class="RestaurantePro.Mobile.Views.SimpleLoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" 
                            Padding="16,24,16,24"
                            VerticalOptions="Center">
            
            <!-- Logo Moderno -->
            <Border x:Name="LogoBorder"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeShape="Ellipse"
                    WidthRequest="100"
                    HeightRequest="100"
                    HorizontalOptions="Center">
                
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowColor}" 
                            Offset="0,8" Radius="16" Opacity="0.3" />
                </Border.Shadow>
                
                <Label Text="🍽️"
                       FontSize="50"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <!-- Título Moderno -->
            <Label Text="RestaurantePro"
                   Style="{StaticResource H1Style}"
                   HorizontalOptions="Center" />
            
            <!-- Subtítulo Moderno -->
            <Label Text="Sistema de Gestión Restaurante"
                   Style="{StaticResource BodyStyle}"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource TextSecondary}" />
            
            <!-- Formulario Moderno -->
            <controls:ModernCard Padding="20,24">
                <VerticalStackLayout Spacing="24">
                    
                    <!-- Email Moderno -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo Electrónico"
                               Style="{StaticResource BodyStyle}"
                               FontAttributes="Bold" />
                        
                        <controls:ModernEntry Text="{Binding Email}"
                                             Placeholder="ejemplo@restaurantepro.com"
                                             Icon="📧"
                                             Keyboard="Email"
                                             HorizontalOptions="FillAndExpand"
                                             x:Name="EmailEntry"
                                             AutomationProperties.Name="EmailEntry" />
                    </VerticalStackLayout>
                    
                    <!-- Contraseña Moderna -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña"
                               Style="{StaticResource BodyStyle}"
                               FontAttributes="Bold" />
                        
                        <controls:ModernEntry Text="{Binding Password}"
                                             Placeholder="Ingrese su contraseña"
                                             Icon="🔒"
                                             IsPassword="True"
                                             HorizontalOptions="FillAndExpand"
                                             x:Name="PasswordEntry"
                                             AutomationProperties.Name="PasswordEntry" />
                    </VerticalStackLayout>
                    
                    <!-- Recordar sesión Moderno -->
                    <HorizontalStackLayout Spacing="12" 
                                          HorizontalOptions="Start"
                                          VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding Recordarme}"
                                 x:Name="RememberMeCheckBox"
                                 AutomationProperties.Name="RememberMeCheckBox" />
                        <Label Text="Recordar sesión" 
                               Style="{StaticResource BodyStyle}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    
                    <!-- Mensaje de Error Moderno -->
                    <Border BackgroundColor="{StaticResource ErrorColor}"
                            StrokeShape="RoundRectangle 8"
                            Padding="16"
                            IsVisible="{Binding HasError}">
                        
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="⚠️"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </controls:ModernCard>
            
            <!-- Botón de Login Moderno -->
            <Button Text="Iniciar Sesión"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="56"
                    HorizontalOptions="FillAndExpand"
                    Margin="0,20,0,0"
                    x:Name="LoginButton"
                    AutomationProperties.Name="LoginButton" />
                    
            <!-- Indicador de Carga Moderno -->
            <VerticalStackLayout Spacing="12"
                                IsVisible="{Binding IsBusy}"
                                HorizontalOptions="Center">
                
                <ActivityIndicator IsRunning="True"
                                  Color="{StaticResource PrimaryColor}"
                                  WidthRequest="32"
                                  HeightRequest="32" />
                
                <Label Text="Iniciando sesión..."
                       Style="{StaticResource CaptionStyle}"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
            
            <!-- Información adicional Moderna -->
            <Label Text="Versión 4.0 - Pruebas UI"
                   Style="{StaticResource CaptionStyle}"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource TextSecondary}" />
            
            <!-- Botón de Debug Moderno - Solo visible en modo DEBUG -->
            <Button x:Name="DebugButton"
                    Text="🔧 Debug"
                    Clicked="OnDebugClicked"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="44"
                    IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage> 