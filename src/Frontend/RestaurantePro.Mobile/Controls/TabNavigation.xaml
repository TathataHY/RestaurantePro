<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             x:Class="RestaurantePro.Mobile.Controls.TabNavigation">
    
    <Grid RowDefinitions="Auto,Auto">
        <!-- ScrollView horizontal para los tabs -->
        <ScrollView Grid.Row="0" 
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="TabContainer" 
                                   Spacing="0" 
                                   HorizontalOptions="Start"
                                   Padding="16,0">
                <!-- Tabs dinámicos se agregarán aquí -->
            </HorizontalStackLayout>
        </ScrollView>
        <BoxView Grid.Row="1" 
                 BackgroundColor="{StaticResource BorderColor}" 
                 HeightRequest="1" />
    </Grid>
    
</ContentView> 