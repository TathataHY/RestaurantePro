<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantePro.Mobile.Controls.ModernEntry"
             x:Name="ModernEntryControl">
    
    <Border x:Name="ButtonBorder"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{StaticResource SurfacePrimary}"
            Stroke="{StaticResource BorderColor}"
            StrokeThickness="1">
        <Grid ColumnDefinitions="Auto,*" Padding="16,12">
            <Label x:Name="LabelIcon" 
                   Grid.Column="0" 
                   Text=""
                   FontSize="16"
                   TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0"
                   IsVisible="False"
                   AutomationProperties.Name="{Binding Source={x:Reference ModernEntryControl}, Path=IconDescription}"
                   AutomationProperties.HelpText="Icono descriptivo del campo" />
            <Entry x:Name="InnerEntry" 
                   Grid.Column="1"
                   BackgroundColor="Transparent"
                   TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextSecondary}"
                   FontSize="16"
                   VerticalOptions="Center"
                   Text="{Binding Source={x:Reference ModernEntryControl}, Path=Text, Mode=TwoWay}"
                   AutomationProperties.Name="{Binding Source={x:Reference ModernEntryControl}, Path=AccessibilityName}"
                   AutomationProperties.HelpText="{Binding Source={x:Reference ModernEntryControl}, Path=AccessibilityHelpText}"
                   AutomationProperties.IsInAccessibleTree="True"
                   AutomationProperties.LabeledBy="{x:Reference LabelIcon}" />
        </Grid>
    </Border>
    
</ContentView> 