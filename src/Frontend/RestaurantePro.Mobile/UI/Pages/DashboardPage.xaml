<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantePro.Mobile.UI.Pages.DashboardPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="RestaurantePro - Dashboard"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Botones principales según V1 -->
            <VerticalStackLayout Spacing="15">
                
                <Button Text="🏠 Gestión de Mesas"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="60" />

                <Button Text="📝 Gestión de Comandas"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="60" />

                <Button Text="🍳 Preparaciones"
                        BackgroundColor="#FFC107"
                        TextColor="Black"
                        FontSize="16"
                        HeightRequest="60" />

                <Button Text="📊 Consultar Menú"
                        BackgroundColor="#17A2B8"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="60" />

                <Button Text="💰 Facturación"
                        BackgroundColor="#6F42C1"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="60" />

            </VerticalStackLayout>

            <!-- Botón de Logout -->
            <Button Text="Cerrar Sesión"
                    BackgroundColor="#DC3545"
                    TextColor="White"
                    FontSize="14"
                    Margin="0,30,0,0"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage> 