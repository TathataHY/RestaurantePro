<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             x:Class="RestaurantePro.Mobile.UI.Pages.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Header Moderno con Gradiente -->
            <Frame BackgroundColor="Transparent" 
                   Padding="0" 
                   CornerRadius="20"
                   HasShadow="True">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0.0" />
                        <GradientStop Color="#764ba2" Offset="1.0" />
                    </LinearGradientBrush>
                </Frame.Background>
                <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🏪 RestaurantePro"
                           Style="{StaticResource H1Style}"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Panel de Control Inteligente"
                           Style="{StaticResource CaptionStyle}"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center" />
                    <Label Text="Bienvenido de vuelta"
                           Style="{StaticResource BodyStyle}"
                           TextColor="White"
                           Opacity="0.8"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Cards de Estadísticas Mejoradas -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                
                <!-- Card: Mesas -->
                <Frame Grid.Column="0" Grid.Row="0" 
                       BackgroundColor="White" 
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🏠" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Mesas" Style="{StaticResource H2Style}" HorizontalOptions="Center" />
                        <Label Text="8 disponibles" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="2 ocupadas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" TextColor="#28a745" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card: Comandas -->
                <Frame Grid.Column="1" Grid.Row="0" 
                       BackgroundColor="White" 
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📝" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Comandas" Style="{StaticResource H2Style}" HorizontalOptions="Center" />
                        <Label Text="12 activas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="3 pendientes" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" TextColor="#ffc107" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card: Preparaciones -->
                <Frame Grid.Column="0" Grid.Row="1" 
                       BackgroundColor="White" 
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🍳" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Cocina" Style="{StaticResource H2Style}" HorizontalOptions="Center" />
                        <Label Text="5 pendientes" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="2 en preparación" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" TextColor="#17a2b8" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card: Ventas -->
                <Frame Grid.Column="1" Grid.Row="1" 
                       BackgroundColor="White" 
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="💰" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Ventas" Style="{StaticResource H2Style}" HorizontalOptions="Center" />
                        <Label Text="$2,450 hoy" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="+15% vs ayer" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" TextColor="#28a745" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Sección de Acciones Rápidas -->
            <Frame BackgroundColor="White" 
                   CornerRadius="16"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="16">
                    <Label Text="🚀 Acciones Rápidas" 
                           Style="{StaticResource H2Style}" 
                           HorizontalOptions="Center" />
                    
                    <!-- Primera fila de botones -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Frame Grid.Column="0" 
                               BackgroundColor="#667eea" 
                               CornerRadius="12"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="🏠" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Mesas" Style="{StaticResource BodyStyle}" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToMesasCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Frame Grid.Column="1" 
                               BackgroundColor="#764ba2" 
                               CornerRadius="12"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="📝" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Comandas" Style="{StaticResource BodyStyle}" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToComandasCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>

                    <!-- Segunda fila de botones -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Frame Grid.Column="0" 
                               BackgroundColor="#f093fb" 
                               CornerRadius="12"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="🍳" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Cocina" Style="{StaticResource BodyStyle}" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToPreparacionesCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Frame Grid.Column="1" 
                               BackgroundColor="#4facfe" 
                               CornerRadius="12"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="📊" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Menú" Style="{StaticResource BodyStyle}" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToProductosCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>

                    <!-- Tercera fila de botones -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Frame Grid.Column="0" 
                               BackgroundColor="#43e97b" 
                               CornerRadius="12"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="💰" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Facturar" Style="{StaticResource BodyStyle}" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToFacturasCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Frame Grid.Column="1" 
                               BackgroundColor="#fa709a" 
                               CornerRadius="12"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="👥" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Clientes" Style="{StaticResource BodyStyle}" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToClientesCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Botón de Logout Mejorado -->
            <Frame BackgroundColor="#dc3545" 
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="True">
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="🚪" FontSize="20" VerticalOptions="Center" />
                    <Label Text="Cerrar Sesión" 
                           Style="{StaticResource BodyStyle}" 
                           TextColor="White" 
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                </Frame.GestureRecognizers>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage> 