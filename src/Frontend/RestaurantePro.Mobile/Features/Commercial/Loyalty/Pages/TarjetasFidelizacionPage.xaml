<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Commercial.Loyalty.Pages.TarjetasFidelizacionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:RestaurantePro.Mobile.Core.Features.Commercial.Loyalty.ViewModels"
             x:DataType="viewmodels:TarjetasFidelizacionViewModel"
             Title="Fidelización"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con información de tarjeta -->
        <Border Grid.Row="0" 
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                StrokeShape="RoundRectangle 10"
                Margin="10,10,10,5"
                IsVisible="{Binding TarjetaActual, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Padding="15" Spacing="10">
                
                <!-- Información de tarjeta -->
                <HorizontalStackLayout>
                    <Label Text="Tarjeta:" 
                           TextColor="White" 
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Text="{Binding TarjetaActual.CodigoTarjeta}"
                           TextColor="White"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                
                <!-- Puntos y estado -->
                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="Puntos Disponibles" 
                               TextColor="White" 
                               FontSize="12" 
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TarjetaActual.PuntosDisponibles}" 
                               TextColor="White" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="Estado" 
                               TextColor="White" 
                               FontSize="12" 
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TarjetaActual.Estado}" 
                               TextColor="White" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Contenido principal -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding EstaRefrescando}"
                     Command="{Binding RefrescarCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="15" Padding="10">
                    
                    <!-- Búsqueda de tarjeta -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            StrokeShape="RoundRectangle 10"
                            Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Buscar Tarjeta" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                            
                            <Frame BackgroundColor="Transparent" 
                                   BorderColor="Transparent" 
                                   Padding="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           Placeholder="Ingrese código de tarjeta..."
                                           Text="{Binding CodigoTarjeta}"
                                           ReturnCommand="{Binding BuscarTarjetaCommand}"/>
                                    <Button Grid.Column="1"
                                            Text="Buscar"
                                            Command="{Binding BuscarTarjetaCommand}"
                                            Margin="5,0,0,0"/>
                                </Grid>
                            </Frame>
                            
                            <Button Text="Activar Nueva Tarjeta"
                                    Command="{Binding ActivarTarjetaCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Secondary}}"
                                    TextColor="White"
                                    CornerRadius="20"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Acciones de tarjeta -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                            StrokeShape="RoundRectangle 10"
                            Padding="15"
                            IsVisible="{Binding TarjetaActual, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Acciones" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                            
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Spacing="10">
                                <Button Grid.Row="0" Grid.Column="0"
                                        Text="Aplicar Descuento"
                                        Command="{Binding AplicarDescuentoCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                                        TextColor="White"
                                        CornerRadius="20"/>
                                
                                <Button Grid.Row="0" Grid.Column="1"
                                        Text="Ver Historial"
                                        Command="{Binding CargarHistorialCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Secondary}}"
                                        TextColor="White"
                                        CornerRadius="20"/>
                                
                                <Button Grid.Row="1" Grid.Column="0"
                                        Text="Recargar Puntos"
                                        Command="{Binding RecargarPuntosCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource Green}}"
                                        TextColor="White"
                                        CornerRadius="20"/>
                                
                                <Button Grid.Row="1" Grid.Column="1"
                                        Text="Bloquear Tarjeta"
                                        Command="{Binding BloquearTarjetaCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Red}, Dark={StaticResource Red}}"
                                        TextColor="White"
                                        CornerRadius="20"
                                        IsVisible="{Binding TarjetaActual.Activa}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Historial de transacciones -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                            StrokeShape="RoundRectangle 10"
                            Padding="15"
                            IsVisible="{Binding Historial, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Historial de Transacciones" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                            
                            <CollectionView ItemsSource="{Binding Historial}"
                                          HeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="TransaccionPuntosDto">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="5">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding TipoTransaccion}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"/>
                                                <Label Text="{Binding FechaTransaccion, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                            </VerticalStackLayout>
                                            
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Puntos, StringFormat='{0} pts'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,10,0"/>
                                            
                                            <Label Grid.Column="2" 
                                                   Text="{Binding Monto, StringFormat='${0:N2}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>

        <!-- Mensaje de error -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasError}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Red100}, Dark={StaticResource Red900}}"
                StrokeShape="RoundRectangle 10"
                Margin="10,5,10,10">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource Red600}, Dark={StaticResource Red300}}"
                   HorizontalOptions="Center"
                   Padding="15"/>
        </Border>
    </Grid>
</ContentPage> 