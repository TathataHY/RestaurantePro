<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:viewmodels="clr-namespace:RestaurantePro.Mobile.Core.Features.Commercial.Customers.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:dtos="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Commercial.Customers.Pages.ClientesPage"
             x:DataType="viewmodels:ClientesViewModel"
             Title="Clientes"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="*">
        <!-- Contenido Principal -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding EstaRefrescando}"
                     Command="{Binding RefrescarCommand}">
            
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="16,8,16,16">
                    
                    <!-- Estadísticas Principales -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="👥" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Total" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding TotalClientes}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="✅" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Activos" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding ClientesActivos}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="🆕" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Nuevos Hoy" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding ClientesNuevosHoy}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource InfoColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Filtros de Búsqueda -->
                    <controls:ModernCard>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="🔍 Búsqueda de Clientes" 
                                   Style="{StaticResource H3Style}"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <!-- Búsqueda -->
                            <controls:ModernEntry Placeholder="Buscar por nombre, email o teléfono..."
                                                 Text="{Binding Busqueda}"
                                                 Icon="🔍" />
                            
                            <!-- Filtro de estado -->
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding SoloActivos}"
                                         CheckedChanged="OnSoloActivosChanged"/>
                                <Label Text="Solo clientes activos"
                                       Style="{StaticResource BodyStyle}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </controls:ModernCard>

                    <!-- Lista de Clientes -->
                    <CollectionView ItemsSource="{Binding Clientes}"
                                  SelectionMode="Single"
                                  SelectedItem="{Binding ClienteSeleccionado}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:ClienteSummaryDto">
                                <controls:ModernCard Margin="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                          ColumnDefinitions="*,Auto">
                                        
                                        <!-- Header de Cliente -->
                                        <StackLayout Grid.Row="0" Grid.Column="0" 
                                                     Orientation="Horizontal" 
                                                     VerticalOptions="Center">
                                            <Label Text="{Binding NombreCompleto}" 
                                                   Style="{StaticResource H3Style}" />
                                        </StackLayout>

                                        <!-- Estado Badge -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                BackgroundColor="{Binding Activo, Converter={StaticResource BoolToColorConverter}}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="8,4">
                                            <Label Text="{Binding Activo, Converter={StaticResource BoolToTextConverter}}" 
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextColor="White"
                                                   HorizontalOptions="Center" />
                                        </Border>

                                        <!-- Información de Cliente -->
                                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" 
                                                             Spacing="4" Margin="0,12,0,0">
                                            <Label Text="{Binding Email, StringFormat='📧 {0}'}" 
                                                   Style="{StaticResource BodyStyle}" />
                                            <Label Text="{Binding Telefono, StringFormat='📞 {0}'}" 
                                                   Style="{StaticResource BodyStyle}" />
                                            <Label Text="{Binding FechaRegistro, StringFormat='📅 Registro: {0:dd/MM/yyyy}'}" 
                                                   Style="{StaticResource BodyStyle}" />
                                        </VerticalStackLayout>

                                        <!-- Estadísticas del Cliente -->
                                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                             Spacing="2" Margin="0,8,0,0">
                                            <Label Text="📊 Estadísticas:" 
                                                   Style="{StaticResource CaptionStyle}"
                                                   FontAttributes="Bold" />
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                                                <Label Grid.Column="0" Grid.Row="0"
                                                       Text="{Binding TotalComandas, StringFormat='Comandas: {0}'}"
                                                       Style="{StaticResource CaptionStyle}" />
                                                <Label Grid.Column="1" Grid.Row="0"
                                                       Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                                       Style="{StaticResource CaptionStyle}" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Botones de Acción (Solo Consulta) -->
                                        <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" 
                                                               Spacing="8" Margin="0,12,0,0">
                                            
                                            <Button Text="👁️ Ver Detalle"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarClienteCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalOptions="FillAndExpand" />
                                            
                                            <Button Text="📋 Historial"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerHistorialCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalOptions="FillAndExpand" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </controls:ModernCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Indicador de carga -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Color="{StaticResource PrimaryColor}" />

        <!-- Mensaje de error -->
        <Border IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource ErrorColor}"
                StrokeShape="RoundRectangle 10"
                Margin="16"
                Padding="16">
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodyStyle}"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Estado Vacío -->
        <CollectionView.EmptyView>
            <VerticalStackLayout Spacing="16" 
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Padding="32">
                <Label Text="👥" 
                       FontSize="64" 
                       HorizontalOptions="Center" />
                <Label Text="No hay clientes registrados" 
                       Style="{StaticResource H2Style}" 
                       HorizontalOptions="Center" />
                <Label Text="Los clientes aparecerán aquí cuando estén disponibles" 
                       Style="{StaticResource BodyStyle}" 
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
    </Grid>
</ContentPage> 