<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:viewmodels="clr-namespace:RestaurantePro.Mobile.Core.Features.Analytics.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:dtos="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Analytics.Pages.AnalyticsPage"
             x:DataType="viewmodels:AnalyticsViewModel"
             Title="Analytics"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="*">
        <!-- Contenido Principal -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding EstaRefrescando}"
                     Command="{Binding RefrescarCommand}">
            
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="16,8,16,16">
                    
                    <!-- Filtros de Período -->
                    <controls:ModernCard>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="📊 Filtros de Período" 
                                   Style="{StaticResource H3Style}"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <!-- Filtro de período -->
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label Text="Período:" 
                                       Style="{StaticResource BodyStyle}"
                                       VerticalOptions="Center" />
                                <Picker Title="Seleccionar período"
                                        SelectedItem="{Binding FiltroPeriodo}"
                                        SelectedIndexChanged="OnPeriodoChanged"
                                        HorizontalOptions="FillAndExpand">
                                    <Picker.Items>
                                        <x:String>Hoy</x:String>
                                        <x:String>Esta Semana</x:String>
                                        <x:String>Este Mes</x:String>
                                        <x:String>Personalizado</x:String>
                                    </Picker.Items>
                                </Picker>
                            </HorizontalStackLayout>
                            
                            <!-- Fechas personalizadas -->
                            <Grid ColumnDefinitions="*,*" 
                                  ColumnSpacing="12"
                                  IsVisible="{Binding FiltroPeriodo, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Personalizado}">
                                <DatePicker Grid.Column="0" 
                                            Date="{Binding FechaDesde}" />
                                <DatePicker Grid.Column="1" 
                                            Date="{Binding FechaHasta}" />
                            </Grid>
                        </VerticalStackLayout>
                    </controls:ModernCard>

                    <!-- Estadísticas Principales -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="💰" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Ventas" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding MetricasDia.TotalVentas, StringFormat='${0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="🍽️" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Comandas" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding MetricasDia.TotalComandas}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="👥" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Clientes" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding MetricasDia.ClientesAtendidos}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource WarningColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="140">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="📊" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Ocupación" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                    <Label Text="{Binding MetricasDia.PorcentajeOcupacionMesas, StringFormat='{0:N1}%'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource InfoColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Métricas Adicionales -->
                    <controls:ModernCard>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="📈 Métricas del Día" 
                                   Style="{StaticResource H3Style}"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <controls:ModernCard Grid.Row="0" Grid.Column="0" Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="⏱️" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Tiempo Prep." FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding MetricasDia.TiempoPromedioPreparacion, StringFormat='{0} min'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource WarningColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                
                                <controls:ModernCard Grid.Row="0" Grid.Column="1" Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="📦" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Productos" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding MetricasDia.TotalProductosVendidos}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource InfoColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                            </Grid>
                        </VerticalStackLayout>
                    </controls:ModernCard>

                    <!-- Top Productos -->
                    <controls:ModernCard>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="🏆 Top Productos" 
                                   Style="{StaticResource H3Style}"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <CollectionView ItemsSource="{Binding TopProductos}"
                                          HeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:TopProductoDto">
                                        <controls:ModernCard Margin="0,4">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12">
                                                <!-- Posición -->
                                                <Border Grid.Column="0"
                                                        BackgroundColor="{StaticResource PrimaryColor}"
                                                        StrokeShape="RoundRectangle 12"
                                                        WidthRequest="24"
                                                        HeightRequest="24">
                                                    <Label Text="{Binding CantidadVendida, StringFormat='{0}'}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Border>
                                                
                                                <!-- Información del producto -->
                                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                    <Label Text="{Binding NombreProducto}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding CantidadVendida, StringFormat='{0} unidades vendidas'}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           TextColor="{StaticResource TextSecondary}"/>
                                                </VerticalStackLayout>
                                                
                                                <!-- Total de ventas -->
                                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                                    <Label Text="{Binding TotalVentas, StringFormat='${0:N2}'}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource SuccessColor}"
                                                           HorizontalOptions="End"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </controls:ModernCard>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </controls:ModernCard>

                    <!-- Ocupación de Mesas -->
                    <controls:ModernCard IsVisible="{Binding OcupacionMesas, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="🏠 Ocupación de Mesas" 
                                   Style="{StaticResource H3Style}"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <controls:ModernCard Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="✅" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Libres" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding OcupacionMesas.MesasLibres}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                
                                <controls:ModernCard Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="👥" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Ocupadas" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding OcupacionMesas.MesasOcupadas}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource WarningColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                
                                <controls:ModernCard Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="📅" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Reservadas" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding OcupacionMesas.MesasReservadas}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                            </Grid>
                        </VerticalStackLayout>
                    </controls:ModernCard>

                    <!-- Tiempo de Preparación -->
                    <controls:ModernCard IsVisible="{Binding TiempoPreparacion, Converter={StaticResource IsNotNullConverter}}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="⏱️ Tiempo de Preparación" 
                                   Style="{StaticResource H3Style}"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <controls:ModernCard Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="📊" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Promedio" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding TiempoPreparacion.TiempoPromedioMinutos, StringFormat='{0} min'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource InfoColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                
                                <controls:ModernCard Padding="12">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="⏰" FontSize="20" HorizontalOptions="Center" />
                                        <Label Text="Máximo" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                                        <Label Text="{Binding TiempoPreparacion.TiempoMaximoMinutos, StringFormat='{0} min'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource WarningColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                            </Grid>
                        </VerticalStackLayout>
                    </controls:ModernCard>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Indicador de carga -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Color="{StaticResource PrimaryColor}" />

        <!-- Mensaje de error -->
        <Border IsVisible="{Binding HasError}"
                BackgroundColor="{StaticResource ErrorColor}"
                StrokeShape="RoundRectangle 10"
                Margin="16"
                Padding="16">
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodyStyle}"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Border>

    </Grid>

</ContentPage>