<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Categorias.Pages.CategoriasPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:RestaurantePro.Mobile.Core.Features.Categorias.ViewModels"
             x:DataType="viewmodels:CategoriasViewModel"
             Title="Categorías"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con estadísticas -->
        <Border Grid.Row="0" 
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                StrokeShape="RoundRectangle 10"
                Margin="10,10,10,5">
            <Grid ColumnDefinitions="*,*,*" Padding="15">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="Total" 
                           TextColor="White" 
                           FontSize="12" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding TotalCategorias}" 
                           TextColor="White" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Activas" 
                           TextColor="White" 
                           FontSize="12" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding CategoriasActivas}" 
                           TextColor="White" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="Inactivas" 
                           TextColor="White" 
                           FontSize="12" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding CategoriasInactivas}" 
                           TextColor="White" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding EstaRefrescando}"
                     Command="{Binding RefrescarCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="10" Padding="10">
                    
                    <!-- Filtros -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            StrokeShape="RoundRectangle 10"
                            Padding="15">
                        <VerticalStackLayout Spacing="10">
                            
                            <!-- Búsqueda -->
                            <Frame BackgroundColor="Transparent" 
                                   BorderColor="Transparent" 
                                   Padding="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           Placeholder="Buscar categorías..."
                                           Text="{Binding FiltroBusqueda}"
                                           ReturnCommand="{Binding BuscarCategoriasCommand}"/>
                                    <Button Grid.Column="1"
                                            Text="Buscar"
                                            Command="{Binding BuscarCategoriasCommand}"
                                            Margin="5,0,0,0"/>
                                </Grid>
                            </Frame>
                            
                            <!-- Filtro de activas -->
                            <HorizontalStackLayout>
                                <CheckBox IsChecked="{Binding MostrarSoloActivas}"
                                         CheckedChanged="OnMostrarSoloActivasChanged"/>
                                <Label Text="Solo categorías activas"
                                       VerticalOptions="Center"
                                       Margin="5,0,0,0"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de categorías -->
                    <CollectionView ItemsSource="{Binding Categorias}"
                                  SelectionMode="Single"
                                  SelectedItem="{Binding CategoriaSeleccionada}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="CategoriaProductoDto">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                                        StrokeShape="RoundRectangle 10"
                                        Margin="0,0,0,10"
                                        Padding="15">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        
                                        <!-- Información principal -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <Label Text="{Binding Nombre}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                            
                                            <Label Text="{Binding Descripcion}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                   LineBreakMode="TailTruncation"/>
                                            
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding TotalProductos, StringFormat='{0} productos'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"/>
                                                
                                                <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        
                                        <!-- Indicador de estado -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                BackgroundColor="{Binding Activa, Converter={StaticResource BoolToColorConverter}}"
                                                StrokeShape="RoundRectangle 5"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                VerticalOptions="Center"/>
                                        
                                        <!-- Acciones -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                             Spacing="10" 
                                                             Margin="0,10,0,0">
                                            <Button Text="Ver Productos"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriasViewModel}}, Path=SeleccionarCategoriaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                                                    TextColor="White"
                                                    CornerRadius="20"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>

        <!-- Mensaje de error -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasError}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Red100}, Dark={StaticResource Red900}}"
                StrokeShape="RoundRectangle 10"
                Margin="10,5,10,10">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource Red600}, Dark={StaticResource Red300}}"
                   HorizontalOptions="Center"
                   Padding="15"/>
        </Border>
    </Grid>
</ContentPage> 