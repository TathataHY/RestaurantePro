<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Reservaciones.Pages.ReservacionesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:RestaurantePro.Mobile.Core.Features.Inventory.Reservaciones.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:models="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             Title="Reservaciones"
             x:DataType="viewmodels:ReservacionesViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Estilos para las tarjetas de reservación -->
            <Style x:Key="ReservacionCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"/>
            </Style>

            <!-- Estilo para el estado de la reservación -->
            <Style x:Key="EstadoStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalOptions" Value="Start"/>
            </Style>

            <!-- Estilo para botones de acción -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header con filtros -->
        <Frame Grid.Row="0" 
               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"
               Padding="16"
               Margin="0,0,0,8"
               HasShadow="False">
            
            <StackLayout Spacing="12">
                <!-- Título y botón de nueva reservación -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Label Grid.Column="0" 
                           Text="📅 Reservaciones" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    
                    <Button Grid.Column="1" 
                            Text="➕ Nueva"
                            Command="{Binding CreateReservacionCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"/>
                </Grid>

                <!-- Filtros rápidos -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="📅 Hoy" 
                            Command="{Binding LoadReservacionesDelDiaCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#2196F3"
                            TextColor="White"/>
                    
                    <Button Text="⏳ Pendientes" 
                            Command="{Binding LoadReservacionesPendientesCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#FF9800"
                            TextColor="White"/>
                    
                    <Button Text="🔄 Refrescar" 
                            Command="{Binding RefreshReservacionesCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#9C27B0"
                            TextColor="White"/>
                    
                    <Button Text="🔍 Disponibilidad" 
                            Command="{Binding CheckAvailabilityCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#607D8B"
                            TextColor="White"/>
                </HorizontalStackLayout>

                <!-- Filtros avanzados -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <DatePicker Grid.Column="0" 
                                Date="{Binding FechaInicio}"
                                Format="dd/MM/yyyy"/>
                    
                    <DatePicker Grid.Column="1" 
                                Date="{Binding FechaFin}"
                                Format="dd/MM/yyyy"/>
                    
                    <Button Grid.Column="2" 
                            Text="Filtrar"
                            Command="{Binding ApplyFiltersCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#3F51B5"
                            TextColor="White"/>
                </Grid>
            </StackLayout>
        </Frame>

        <!-- Indicador de carga -->
        <ActivityIndicator Grid.Row="1" 
                          IsRunning="{Binding IsLoadingReservaciones}"
                          IsVisible="{Binding IsLoadingReservaciones}"
                          HorizontalOptions="Center"
                          Margin="0,8"/>

        <!-- Lista de reservaciones -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsLoadingReservaciones}"
                     Command="{Binding RefreshReservacionesCommand}">
            
            <CollectionView ItemsSource="{Binding Reservaciones}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedReservacion}">
                
                <CollectionView.Header>
                    <Label Text="📋 Lista de Reservaciones" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           Margin="16,8"
                           HorizontalOptions="Center"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReservacionDto">
                        <Frame Style="{StaticResource ReservacionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Información principal -->
                                <StackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding NombreCliente}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"/>
                                    
                                    <Label Text="{Binding FechaFormateada}" 
                                           FontSize="14" 
                                           TextColor="#666"/>
                                    
                                    <Label Text="{Binding CantidadPersonas, StringFormat='👥 {0} personas'}" 
                                           FontSize="12" 
                                           TextColor="#888"/>
                                </StackLayout>

                                <!-- Estado de la reservación -->
                                <StackLayout Grid.Row="0" Grid.Column="1" 
                                           HorizontalOptions="End" 
                                           VerticalOptions="Start">
                                    
                                    <Label Text="{Binding Estado}" 
                                           Style="{StaticResource EstadoStyle}"
                                           BackgroundColor="{Binding Estado, Converter={StaticResource EstadoToColorConverter}}"
                                           TextColor="White"/>
                                </StackLayout>

                                <!-- Mesa asignada -->
                                <StackLayout Grid.Row="1" Grid.Column="0" 
                                           Orientation="Horizontal" 
                                           Spacing="8"
                                           Margin="0,8,0,0">
                                    
                                    <Label Text="🪑 Mesa:" 
                                           FontSize="12" 
                                           TextColor="#666"/>
                                    
                                    <Label Text="{Binding NumeroMesa, StringFormat='{0}'}" 
                                           FontSize="12" 
                                           FontAttributes="Bold"
                                           TextColor="#333"/>
                                </StackLayout>

                                <!-- Observaciones -->
                                <Label Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding Observaciones}" 
                                       FontSize="11" 
                                       TextColor="#999"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Margin="0,8,0,0"
                                       IsVisible="{Binding Observaciones, Converter={StaticResource StringToVisibilityConverter}}"/>

                                <!-- Botones de acción -->
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                     Spacing="8" 
                                                     HorizontalOptions="End"
                                                     Margin="0,12,0,0">
                                    
                                    <Button Text="👁️ Ver" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReservacionesViewModel}}, Path=ViewReservacionDetailsCommand}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            BackgroundColor="#2196F3"
                                            TextColor="White"/>
                                    
                                    <Button Text="✅ Confirmar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReservacionesViewModel}}, Path=ConfirmReservacionCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            IsVisible="{Binding EstaPendiente}"/>
                                    
                                    <Button Text="🔄 Reprogramar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReservacionesViewModel}}, Path=ReprogramReservacionCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            BackgroundColor="#FF9800"
                                            TextColor="White"
                                            IsVisible="{Binding EstaPendiente}"/>
                                    
                                    <Button Text="❌ Cancelar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReservacionesViewModel}}, Path=CancelReservacionCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            BackgroundColor="#F44336"
                                            TextColor="White"
                                            IsVisible="{Binding EstaPendiente}"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <StackLayout>
                        <!-- Botón para cargar más -->
                        <Button Text="📄 Cargar más reservaciones" 
                                Command="{Binding LoadMoreReservacionesCommand}"
                                IsVisible="{Binding HasMorePages}"
                                Style="{StaticResource ActionButtonStyle}"
                                BackgroundColor="#9E9E9E"
                                TextColor="White"
                                Margin="16,8"/>
                        
                        <!-- Mensaje cuando no hay más páginas -->
                        <Label Text="✅ No hay más reservaciones para cargar" 
                               IsVisible="{Binding HasMorePages, Converter={StaticResource InverseBooleanConverter}}"
                               HorizontalOptions="Center"
                               Margin="16,8"
                               TextColor="#666"/>
                    </StackLayout>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 Spacing="16">
                        <Label Text="📅" 
                               FontSize="48" 
                               HorizontalOptions="Center"/>
                        <Label Text="No hay reservaciones" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="No se encontraron reservaciones para los filtros seleccionados" 
                               FontSize="14" 
                               TextColor="#666"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="🔄 Refrescar" 
                                Command="{Binding RefreshReservacionesCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                BackgroundColor="#2196F3"
                                TextColor="White"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage> 