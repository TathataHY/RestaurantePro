<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Inventory.Reservaciones.ViewModels;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Inventory.Reservaciones.Pages.ModernReservacionesPage"
             x:DataType="vm:ReservacionesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con Estadísticas -->
        <ScrollView Grid.Row="0" 
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,8">
            <HorizontalStackLayout Spacing="12">
                
                <!-- Card Total Reservaciones -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📅" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Total" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.TotalReservaciones}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card Confirmadas -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✅" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Confirmadas" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.ReservacionesConfirmadas}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource SuccessColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card Pendientes -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⏳" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Pendientes" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.ReservacionesPendientes}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource WarningColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card Canceladas -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="❌" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Canceladas" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.ReservacionesCanceladas}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource ErrorColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            
            <!-- Barra de Búsqueda y Filtros -->
            <controls:ModernCard Grid.Row="0" Margin="16,8">
                <VerticalStackLayout Spacing="16">
                    
                    <!-- Búsqueda -->
                    <controls:ModernEntry Placeholder="Buscar reservaciones por cliente o fecha..."
                                         Text="{Binding TextoBusqueda}"
                                         Icon="🔍" />
                    
                    <!-- Tabs de Filtro -->
                    <controls:TabNavigation x:Name="FilterTabNavigation" />
                    
                    <!-- Botones de Acción -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*" 
                          ColumnSpacing="8" RowSpacing="8">
                        
                        <Button Grid.Column="0" Grid.Row="0"
                                Text="🔄 Refrescar"
                                Command="{Binding RefreshReservacionesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        
                        <Button Grid.Column="1" Grid.Row="0"
                                Text="📊 Estadísticas"
                                Command="{Binding LoadEstadisticasCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        
                        <Button Grid.Column="2" Grid.Row="0"
                                Text="📅 Calendario"
                                Command="{Binding VerCalendarioCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        
                        <Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                                Text="➕ Nueva Reservación"
                                Command="{Binding CrearReservacionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:ModernCard>

            <!-- Lista de Reservaciones -->
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshReservacionesCommand}">
                
                <CollectionView ItemsSource="{Binding Reservaciones}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedReservacion}">
                    
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:ModernCard Margin="8">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto">
                                    
                                    <!-- Header de Reservación -->
                                    <StackLayout Grid.Row="0" Grid.Column="0" 
                                                 Orientation="Horizontal" 
                                                 VerticalOptions="Center">
                                        <Label Text="{Binding ClienteNombre}" 
                                               Style="{StaticResource H3Style}" />
                                        <Label Text="{Binding Estado, Converter={StaticResource EstadoIconConverter}}" 
                                               FontSize="16" 
                                               Margin="8,0,0,0" />
                                    </StackLayout>

                                    <!-- Estado Badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,4">
                                        <Label Text="{Binding Estado}" 
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="White"
                                               HorizontalOptions="Center" />
                                    </Border>

                                    <!-- Información de Reservación -->
                                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" 
                                                         Spacing="4" Margin="0,12,0,0">
                                        <Label Text="{Binding FechaReservacion, StringFormat='📅 Fecha: {0:dd/MM/yyyy}'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding HoraReservacion, StringFormat='🕐 Hora: {0:HH:mm}'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding NumeroPersonas, StringFormat='👥 Personas: {0}'}" 
                                               Style="{StaticResource BodyStyle}" />
                                    </VerticalStackLayout>

                                    <!-- Información Adicional -->
                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                         Spacing="2" Margin="0,8,0,0"
                                                         IsVisible="{Binding MesaNumero, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding MesaNumero, StringFormat='🪑 Mesa: {0}'}" 
                                               Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding Telefono, StringFormat='📞 Teléfono: {0}'}" 
                                               Style="{StaticResource CaptionStyle}"
                                               IsVisible="{Binding Telefono, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>

                                    <!-- Observaciones -->
                                    <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" 
                                                         Spacing="2" Margin="0,8,0,0"
                                                         IsVisible="{Binding Observaciones, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="📝 Observaciones:" 
                                               Style="{StaticResource CaptionStyle}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding Observaciones}" 
                                               Style="{StaticResource CaptionStyle}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <!-- Botones de Acción -->
                                    <HorizontalStackLayout Grid.Row="4" Grid.ColumnSpan="2" 
                                                           Spacing="8" Margin="0,12,0,0">
                                        
                                        <Button Text="👁️ Ver"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerReservacionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalOptions="FillAndExpand" />
                                        
                                        <Button Text="✏️ Editar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarReservacionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalOptions="FillAndExpand" />
                                        
                                        <Button Text="✅ Confirmar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmarReservacionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                HorizontalOptions="FillAndExpand" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </controls:ModernCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Estado Vacío -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16" 
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="32">
                            <Label Text="📅" 
                                   FontSize="64" 
                                   HorizontalOptions="Center" />
                            <Label Text="No hay reservaciones registradas" 
                                   Style="{StaticResource H2Style}" 
                                   HorizontalOptions="Center" />
                            <Label Text="Crea una nueva reservación para comenzar" 
                                   Style="{StaticResource BodyStyle}" 
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                            <Button Text="Crear Primera Reservación"
                                    Command="{Binding CrearReservacionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Bottom Navigation -->
        <controls:ModernTabBar Grid.Row="2" x:Name="BottomTabBar" />
    </Grid>

    <!-- Floating Action Button -->
    <controls:FloatingActionButton x:Name="MainFab"
                                   Text="+"
                                   Command="{Binding CrearReservacionCommand}"
                                   HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Margin="16,0,16,80" />

</ContentPage> 