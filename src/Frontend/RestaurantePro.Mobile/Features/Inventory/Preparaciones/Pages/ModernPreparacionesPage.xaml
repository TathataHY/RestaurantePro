<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Inventory.Preparaciones.ViewModels;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Inventory.Preparaciones.Pages.ModernPreparacionesPage"
             x:DataType="vm:PreparacionesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con Estadísticas -->
        <ScrollView Grid.Row="0" 
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,8">
            <HorizontalStackLayout Spacing="12">
                
                <!-- Card Total Preparaciones -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🍳" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Total" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.TotalPreparaciones}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card En Preparación -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🔥" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="En Preparación" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.PreparacionesEnProceso}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card Listas -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✅" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Listas" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.PreparacionesListas}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource SuccessColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

                <!-- Card Tiempo Promedio -->
                <controls:ModernCard Padding="16" WidthRequest="120">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⏱️" 
                               FontSize="24" 
                               HorizontalOptions="Center" />
                        <Label Text="Tiempo Promedio" 
                               Style="{StaticResource CaptionStyle}" 
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Estadisticas.TiempoPromedio, StringFormat='{0:F1} min'}" 
                               Style="{StaticResource H2Style}" 
                               TextColor="{StaticResource WarningColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </controls:ModernCard>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            
            <!-- Barra de Búsqueda y Filtros -->
            <controls:ModernCard Grid.Row="0" Margin="16,8">
                <VerticalStackLayout Spacing="16">
                    
                    <!-- Búsqueda -->
                    <controls:ModernEntry Placeholder="Buscar preparaciones por nombre..."
                                         Text="{Binding TextoBusqueda}"
                                         Icon="🔍" />
                    
                    <!-- Tabs de Filtro -->
                    <controls:TabNavigation x:Name="FilterTabNavigation" />
                    
                    <!-- Botones de Acción -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*" 
                          ColumnSpacing="8" RowSpacing="8">
                        
                        <Button Grid.Column="0" Grid.Row="0"
                                Text="🔄 Refrescar"
                                Command="{Binding RefreshPreparacionesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        
                        <Button Grid.Column="1" Grid.Row="0"
                                Text="📊 Estadísticas"
                                Command="{Binding LoadEstadisticasCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        
                        <Button Grid.Column="2" Grid.Row="0"
                                Text="⏰ Urgentes"
                                Command="{Binding LoadPreparacionesUrgentesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        
                        <Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                                Text="➕ Nueva Preparación"
                                Command="{Binding CrearPreparacionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </controls:ModernCard>

            <!-- Lista de Preparaciones -->
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshPreparacionesCommand}">
                
                <CollectionView ItemsSource="{Binding Preparaciones}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedPreparacion}">
                    
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:ModernCard Margin="8">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto">
                                    
                                    <!-- Header de Preparación -->
                                    <StackLayout Grid.Row="0" Grid.Column="0" 
                                                 Orientation="Horizontal" 
                                                 VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" 
                                               Style="{StaticResource H3Style}" />
                                        <Label Text="{Binding Estado, Converter={StaticResource EstadoIconConverter}}" 
                                               FontSize="16" 
                                               Margin="8,0,0,0" />
                                    </StackLayout>

                                    <!-- Estado Badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,4">
                                        <Label Text="{Binding Estado}" 
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="White"
                                               HorizontalOptions="Center" />
                                    </Border>

                                    <!-- Información de Preparación -->
                                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" 
                                                         Spacing="4" Margin="0,12,0,0">
                                        <Label Text="{Binding ComandaNumero, StringFormat='🍽️ Comanda: {0}'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding MesaNumero, StringFormat='🪑 Mesa: {0}'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding TiempoEstimado, StringFormat='⏱️ Tiempo: {0} min'}" 
                                               Style="{StaticResource BodyStyle}" />
                                    </VerticalStackLayout>

                                    <!-- Items de la Preparación -->
                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                         Spacing="2" Margin="0,8,0,0">
                                        <Label Text="📋 Items:" 
                                               Style="{StaticResource CaptionStyle}"
                                               FontAttributes="Bold" />
                                        <CollectionView ItemsSource="{Binding Items}"
                                                       HeightRequest="60">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding Cantidad, StringFormat='{0}x'}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding ProductoNombre}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Observaciones}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalOptions="Center"
                                                               IsVisible="{Binding Observaciones, Converter={StaticResource IsNotNullConverter}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>

                                    <!-- Información Adicional -->
                                    <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" 
                                                         Spacing="2" Margin="0,8,0,0"
                                                         IsVisible="{Binding FechaCreacion, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding FechaCreacion, StringFormat='🕐 Creada: {0:HH:mm}'}" 
                                               Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding Observaciones}" 
                                               Style="{StaticResource CaptionStyle}"
                                               IsVisible="{Binding Observaciones, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>

                                    <!-- Botones de Acción -->
                                    <HorizontalStackLayout Grid.Row="4" Grid.ColumnSpan="2" 
                                                           Spacing="8" Margin="0,12,0,0">
                                        
                                        <Button Text="👁️ Ver"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerPreparacionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalOptions="FillAndExpand" />
                                        
                                        <Button Text="🔥 Iniciar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IniciarPreparacionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalOptions="FillAndExpand" />
                                        
                                        <Button Text="✅ Completar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CompletarPreparacionCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                HorizontalOptions="FillAndExpand" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </controls:ModernCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Estado Vacío -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16" 
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="32">
                            <Label Text="🍳" 
                                   FontSize="64" 
                                   HorizontalOptions="Center" />
                            <Label Text="No hay preparaciones pendientes" 
                                   Style="{StaticResource H2Style}" 
                                   HorizontalOptions="Center" />
                            <Label Text="¡Excelente trabajo! Todo está al día" 
                                   Style="{StaticResource BodyStyle}" 
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Bottom Navigation -->
        <controls:ModernTabBar Grid.Row="2" x:Name="BottomTabBar" />
    </Grid>

    <!-- Floating Action Button -->
    <controls:FloatingActionButton x:Name="MainFab"
                                   Text="+"
                                   Command="{Binding CrearPreparacionCommand}"
                                   HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Margin="16,0,16,80" />

</ContentPage> 