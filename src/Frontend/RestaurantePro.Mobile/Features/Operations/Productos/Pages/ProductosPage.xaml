<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Operations.Productos.Pages.ProductosPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Productos.ViewModels;assembly=RestaurantePro.Mobile.Core"
             x:DataType="vm:ProductosViewModel"
             Title="Productos">

    <!-- ViewModel se configura en code-behind con DI -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Búsqueda y Filtros -->
        <Frame Grid.Row="0" 
               BackgroundColor="#F8F9FA" 
               Padding="16" 
               Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Búsqueda -->
                <SearchBar Grid.Row="0"
                           x:Name="SearchBar"
                           Placeholder="Buscar productos..."
                           Text="{Binding TextoBusqueda}"
                           SearchCommand="{Binding BuscarProductosCommand}"
                           Margin="0,0,0,8" />

                <!-- Filtros -->
                <ScrollView Grid.Row="1" Orientation="Horizontal">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Button Text="🔄 Refrescar" 
                                Command="{Binding RefreshProductosCommand}"
                                BackgroundColor="#007bff" 
                                TextColor="White" 
                                CornerRadius="20" 
                                Padding="16,8" 
                                FontSize="14" 
                                Margin="4" />

                        <Button Text="🔥 Populares" 
                                Command="{Binding LoadProductosPopularesCommand}"
                                BackgroundColor="#ff6347" 
                                TextColor="White" 
                                CornerRadius="20" 
                                Padding="16,8" 
                                FontSize="14" 
                                Margin="4" />

                        <Button Text="✅ Disponibles" 
                                Command="{Binding LoadProductosDisponiblesCommand}"
                                BackgroundColor="#28a745" 
                                TextColor="White" 
                                CornerRadius="20" 
                                Padding="16,8" 
                                FontSize="14" 
                                Margin="4" />

                        <Button Text="🗂️ Categorías" 
                                Command="{Binding LoadCategoriasCommand}"
                                BackgroundColor="#6c757d" 
                                TextColor="White" 
                                CornerRadius="20" 
                                Padding="16,8" 
                                FontSize="14" 
                                Margin="4" />

                        <Button Text="📊 Estadísticas" 
                                Command="{Binding LoadEstadisticasCommand}"
                                BackgroundColor="#17a2b8" 
                                TextColor="White" 
                                CornerRadius="20" 
                                Padding="16,8" 
                                FontSize="14" 
                                Margin="4" />
                    </StackLayout>
                </ScrollView>
            </Grid>
        </Frame>

        <!-- Estadísticas de Productos -->
        <Frame Grid.Row="1" 
               BackgroundColor="#E8F5E8" 
               Padding="12" 
               Margin="8,0"
               IsVisible="{Binding MostrarEstadisticas}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="{Binding TotalProductos, StringFormat='{0}'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center" />
                    <Label Text="Total Productos" FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>

                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding ProductosDisponibles, StringFormat='{0}'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#28a745" HorizontalOptions="Center" />
                    <Label Text="Disponibles" FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>

                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="{Binding CategoriaSeleccionada.Nombre, StringFormat='{0}'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#17a2b8" HorizontalOptions="Center" />
                    <Label Text="Categoría Actual" FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Lista de Productos -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshProductosCommand}">
            <CollectionView ItemsSource="{Binding Productos}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedProducto}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" 
                               Padding="16" 
                               Margin="8,4" 
                               CornerRadius="12" 
                               HasShadow="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Nombre del Producto -->
                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Nombre}" 
                                       FontSize="16" FontAttributes="Bold" 
                                       TextColor="#333" />

                                <!-- Precio -->
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Precio, StringFormat='{0:C}'}" 
                                       FontSize="16" FontAttributes="Bold" 
                                       TextColor="#28a745" />

                                <!-- Descripción -->
                                <Label Grid.Row="1" Grid.ColumnSpan="2" 
                                       Text="{Binding Descripcion}" 
                                       FontSize="14" TextColor="#666" 
                                       MaxLines="2" 
                                       LineBreakMode="TailTruncation" />

                                <!-- Categoría y Disponibilidad -->
                                <Label Grid.Row="2" Grid.Column="0" 
                                       Text="{Binding Categoria}" 
                                       FontSize="12" TextColor="#666" />

                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding EstadoDisponibilidad}" 
                                       FontSize="12" FontAttributes="Bold" 
                                       TextColor="{Binding ColorDisponibilidad}" />

                                <!-- Botones de Acción -->
                                <StackLayout Grid.Row="3" Grid.ColumnSpan="2" 
                                             Orientation="Horizontal" 
                                             HorizontalOptions="Center" 
                                             Spacing="8" 
                                             Margin="0,8,0,0">
                                    <Button Text="👁️ Ver Detalle" 
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#007bff" 
                                            TextColor="White" 
                                            CornerRadius="6" 
                                            Padding="12,6" 
                                            FontSize="12" />

                                    <Button Text="➕ Agregar" 
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#28a745" 
                                            TextColor="White" 
                                            CornerRadius="6" 
                                            Padding="12,6" 
                                            FontSize="12" 
                                            IsVisible="{Binding PuedeAgregarAComanda}" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <StackLayout Padding="16" HorizontalOptions="Center">
                        <Label Text="No se encontraron productos" 
                               FontSize="16" TextColor="#666" 
                               HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage> 