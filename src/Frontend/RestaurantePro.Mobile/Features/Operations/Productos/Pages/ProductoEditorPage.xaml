<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantePro.Mobile.Features.Operations.Productos.Pages.ProductoEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Productos.ViewModels;assembly=RestaurantePro.Mobile.Core"
    xmlns:models="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
    x:DataType="vm:ProductoEditorViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="Nombre" />
            <Entry Text="{Binding Nombre}" Placeholder="Nombre del producto" />

            <Label Text="Descripción" />
            <Editor Text="{Binding Descripcion}" AutoSize="TextChanges" />

            <Label Text="Precio" />
            <Entry Text="{Binding Precio}" Keyboard="Numeric" />

            <Label Text="Categoría" />
            <Picker x:Name="CategoriaPicker"
                    ItemsSource="{Binding Categorias}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedIndexChanged="Picker_SelectedIndexChanged" />

            <Switch IsToggled="{Binding Activo}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="1"
                        Text="{Binding PrimaryButtonText}"
                        Command="{Binding GuardarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


