<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Productos.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:models="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Operations.Productos.Pages.ModernProductosPage"
             x:DataType="vm:ProductosViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Banda de estadísticas (igual que mesas) -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="12,8">
                        <HorizontalStackLayout Spacing="12">
                            <controls:ModernCard Padding="16" WidthRequest="160">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                    <Label Text="📦" FontSize="24" HorizontalOptions="Center" />
                                    <Label Text="Total Productos" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding Estadisticas.TotalProductos}" Style="{StaticResource H2Style}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="160">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                    <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                                    <Label Text="Disponibles" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding Estadisticas.ProductosDisponibles}" Style="{StaticResource H2Style}" TextColor="{StaticResource SuccessColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="160">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                    <Label Text="❌" FontSize="24" HorizontalOptions="Center" />
                                    <Label Text="Agotados" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding Estadisticas.ProductosAgotados}" Style="{StaticResource H2Style}" TextColor="{StaticResource ErrorColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                            <controls:ModernCard Padding="16" WidthRequest="160">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                    <Label Text="🏷️" FontSize="24" HorizontalOptions="Center" />
                                    <Label Text="Categorías" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding Estadisticas.TotalCategorias}" Style="{StaticResource H2Style}" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </controls:ModernCard>
                        </HorizontalStackLayout>
        </ScrollView>

        <!-- Contenido Principal (igual que mesas) -->
        <RefreshView Grid.Row="1" Command="{Binding RefreshProductosCommand}" IsRefreshing="{Binding IsRefreshing}">
            <Grid RowDefinitions="Auto,*">
                <!-- Filtros fuera del CollectionView (igual que mesas) -->
                <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="16,0,16,8">
                    <controls:ModernCard HorizontalOptions="FillAndExpand">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                            <controls:ModernEntry Grid.Column="0"
                                                 HorizontalOptions="FillAndExpand"
                                                 Margin="0,0,8,0"
                                                 Placeholder="Buscar productos por nombre o categoría"
                                                 Text="{Binding TextoBusqueda}"
                                                 Icon="🔍" />
                            <Button Grid.Column="1"
                                    Text="Más filtros"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshProductosCommand}" />
                        </Grid>
                    </controls:ModernCard>
                </VerticalStackLayout>

                <!-- CollectionView con paginación (igual que mesas) -->
                <CollectionView Grid.Row="1" 
                               ItemsSource="{Binding Productos}"
                               ItemsLayout="VerticalGrid, 2"
                               ItemSizingStrategy="MeasureFirstItem"
                               SelectionMode="None"
                               RemainingItemsThreshold="3"
                               RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">

                    <!-- Template de producto con imagen (mejorado) -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductoDto">
                            <controls:ModernCard Margin="8">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    
                                    <!-- Imagen del Producto -->
                                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                                            BackgroundColor="{StaticResource SurfaceSecondary}"
                                            StrokeShape="RoundRectangle 12"
                                            HeightRequest="110"
                                            Margin="0,0,0,12">
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource ShadowColor}" 
                                                    Offset="0,3" Radius="6" Opacity="0.15" />
                                        </Border.Shadow>
                                        
                                        <!-- Siempre mostrar placeholder por ahora -->
                                        <VerticalStackLayout VerticalOptions="Center" 
                                                             HorizontalOptions="Center">
                                            <Label Text="📦" 
                                                   FontSize="32" 
                                                   HorizontalOptions="Center"
                                                   TextColor="{StaticResource TextSecondary}" />
                                            <Label Text="Sin imagen" 
                                                   Style="{StaticResource CaptionStyle}" 
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    
                                    <!-- Nombre del producto -->
                                    <Label Grid.Row="1" Grid.Column="0" 
                                           Text="{Binding Nombre}" 
                                           Style="{StaticResource H3Style}"
                                           LineBreakMode="TailTruncation" 
                                           VerticalOptions="Center" />
                                    
                                    <!-- Estado Badge -->
                                    <Border Grid.Row="1" Grid.Column="1" 
                                            BackgroundColor="{StaticResource SuccessColor}" 
                                            StrokeShape="RoundRectangle 12" 
                                            Padding="8,4" 
                                            HorizontalOptions="End">
                                        <Label Text="{Binding Estado}" 
                                               Style="{StaticResource CaptionStyle}" 
                                               TextColor="White" 
                                               HorizontalOptions="Center" />
                                    </Border>
                                    
                                    <!-- Información del producto -->
                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                         Spacing="6" Margin="0,4,0,0">
                                        <Label Text="{Binding CategoriaNombre, StringFormat='🏷️ {0}'}" 
                                               Style="{StaticResource BodyStyle}" 
                                               TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding Precio, StringFormat='💰 {0:C}'}" 
                                               Style="{StaticResource H3Style}" 
                                               FontAttributes="Bold" 
                                               TextColor="{StaticResource SuccessColor}" />
                                        <Label Text="{Binding Stock, StringFormat='📦 Stock: {0}'}" 
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    
                                    <!-- Botones de acción -->
                                    <ScrollView Grid.Row="3" Grid.ColumnSpan="2" 
                                                Orientation="Horizontal" 
                                                HorizontalScrollBarVisibility="Never" 
                                                Margin="0,12,0,0">
                                        <HorizontalStackLayout Spacing="8" Padding="0,0,8,0">
                                            <Button Text="👁️ Ver detalle" 
                                                    Style="{StaticResource SecondaryButtonStyle}" 
                                                    HorizontalOptions="Start" />
                                        </HorizontalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </controls:ModernCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- EmptyView que SABEMOS que funciona -->
                    <CollectionView.EmptyView>
                        <StackLayout Padding="50" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="📦" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No hay productos disponibles" HorizontalOptions="Center" FontSize="16" />
                            <Button Text="🔄 Actualizar" Command="{Binding RefreshProductosCommand}" HorizontalOptions="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </RefreshView>

        <!-- Floating Action Button ocultado -->
        <!--
        <controls:FloatingActionButton Grid.RowSpan="1"
                                       x:Name="MainFab"
                                       Text="+"
                                       Command="{Binding CrearProductoCommand}"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       Margin="16,0,16,80" />
        -->

    </Grid>

</ContentPage> 
