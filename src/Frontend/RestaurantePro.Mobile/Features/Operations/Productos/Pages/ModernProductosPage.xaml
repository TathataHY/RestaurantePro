<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Productos.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:models="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Operations.Productos.Pages.ModernProductosPage"
             x:DataType="vm:ProductosViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="*">
        
        

        <!-- Contenido Principal -->
        <Grid Grid.Row="0">
            
            

            <!-- Grid de Productos -->
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshProductosCommand}">
                
                <CollectionView ItemsSource="{Binding Productos}"
                               SelectionMode="None">
                    
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="12" Padding="16,8,16,0">
                            <!-- Estadísticas -->
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="12">
                                    <controls:ModernCard Padding="16" WidthRequest="120">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="📦" FontSize="24" HorizontalOptions="Center" />
                                            <Label Text="Total" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                            <Label Text="{Binding Estadisticas.TotalProductos}" Style="{StaticResource H2Style}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </controls:ModernCard>
                                    <controls:ModernCard Padding="16" WidthRequest="120">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                                            <Label Text="Disponibles" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                            <Label Text="{Binding Estadisticas.ProductosDisponibles}" Style="{StaticResource H2Style}" TextColor="{StaticResource SuccessColor}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </controls:ModernCard>
                                    <controls:ModernCard Padding="16" WidthRequest="120">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="❌" FontSize="24" HorizontalOptions="Center" />
                                            <Label Text="Agotados" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                            <Label Text="{Binding Estadisticas.ProductosAgotados}" Style="{StaticResource H2Style}" TextColor="{StaticResource ErrorColor}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </controls:ModernCard>
                                    <controls:ModernCard Padding="16" WidthRequest="120">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="🏷️" FontSize="24" HorizontalOptions="Center" />
                                            <Label Text="Categorías" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                            <Label Text="{Binding Estadisticas.TotalCategorias}" Style="{StaticResource H2Style}" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </controls:ModernCard>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <!-- Búsqueda, filtros y acciones -->
                            <controls:ModernCard>
                                <VerticalStackLayout Spacing="16">
                                    <controls:ModernEntry Placeholder="Buscar productos por nombre o categoría..." Text="{Binding TextoBusqueda}" Icon="🔍" />
                                    <controls:TabNavigation x:Name="FilterTabNavigation" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*" ColumnSpacing="8" RowSpacing="8">
                                        <Button Grid.Column="0" Grid.Row="0" Text="🔄 Refrescar" Command="{Binding RefreshProductosCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="1" Grid.Row="0" Text="🔥 Populares" Command="{Binding LoadProductosPopularesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="2" Grid.Row="0" Text="✅ Disponibles" Command="{Binding LoadProductosDisponiblesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <!-- Botón de nuevo producto ocultado en mobile operativo -->
                                        <!--<Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Text="➕ Nuevo Producto" Command="{Binding CrearProductoCommand}" Style="{StaticResource PrimaryButtonStyle}" />-->
                                    </Grid>
                                </VerticalStackLayout>
                            </controls:ModernCard>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" 
                                         Span="{OnIdiom Phone=2, Tablet=3, Desktop=4}" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductoDto">
                            <controls:ModernCard Margin="8">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto">
                                    
                                    <!-- Imagen del Producto -->
                                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                                            BackgroundColor="{StaticResource SurfaceSecondary}"
                                            StrokeShape="RoundRectangle 8"
                                            HeightRequest="120"
                                            Margin="0,0,0,8">
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource ShadowColor}" 
                                                    Offset="0,2" Radius="4" Opacity="0.1" />
                                        </Border.Shadow>
                                        
                                        <Image Source="{Binding ImagenUrl}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding ImagenUrl, Converter={StaticResource IsNotNullConverter}}" />
                                        
                                        <!-- Placeholder si no hay imagen -->
                                        <VerticalStackLayout IsVisible="{Binding ImagenUrl, Converter={StaticResource StringToVisibilityConverter}}"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="Center">
                                            <Label Text="📦" 
                                                   FontSize="32" 
                                                   HorizontalOptions="Center" />
                                            <Label Text="Sin imagen" 
                                                   Style="{StaticResource CaptionStyle}" 
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Header de Producto -->
                                    <StackLayout Grid.Row="1" Grid.Column="0" 
                                                 Orientation="Horizontal" 
                                                 VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" 
                                               Style="{StaticResource H3Style}"
                                               LineBreakMode="TailTruncation" />
                                    </StackLayout>

                                    <!-- Estado Badge -->
                                    <Border Grid.Row="1" Grid.Column="1"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,4">
                                        <Label Text="{Binding Estado}" 
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="White"
                                               HorizontalOptions="Center" />
                                    </Border>

                                    <!-- Información de Producto -->
                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                         Spacing="4" Margin="0,8,0,0">
                                        <Label Text="{Binding CategoriaNombre, StringFormat='🏷️ {0}'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding Precio, StringFormat='💰 {0:C}'}" 
                                               Style="{StaticResource BodyStyle}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding Stock, StringFormat='📦 Stock: {0}'}" 
                                               Style="{StaticResource CaptionStyle}" />
                                    </VerticalStackLayout>

                                    <!-- Botones de Acción (solo Ver) -->
                                    <ScrollView Grid.Row="3" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never"
                                                Margin="0,12,0,0">
                                        <HorizontalStackLayout Spacing="8" Padding="0,0,8,0">
                                            <Button Text="👁️ Ver"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerProductoCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalOptions="Start" />
                                            <!-- Editar y Eliminar ocultados en mobile operativo -->
                                            <!--<Button Text="✏️ Editar" ... />-->
                                            <!--<Button Text="🗑️ Eliminar" ... />-->
                                        </HorizontalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </controls:ModernCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Estado Vacío -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16" 
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="32">
                            <Label Text="📦" 
                                   FontSize="64" 
                                   HorizontalOptions="Center" />
                            <Label Text="No hay productos disponibles" 
                                   Style="{StaticResource H2Style}" 
                                   HorizontalOptions="Center" />
                            <!-- Llamado a crear primer producto ocultado -->
                            <!--<Label Text="Crea un nuevo producto para comenzar" Style="{StaticResource BodyStyle}" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Button Text="Crear Primer Producto" Command="{Binding CrearProductoCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalOptions="Center" />-->
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Floating Action Button ocultado -->
        <!--
        <controls:FloatingActionButton Grid.RowSpan="1"
                                       x:Name="MainFab"
                                       Text="+"
                                       Command="{Binding CrearProductoCommand}"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       Margin="16,0,16,80" />
        -->

    </Grid>

</ContentPage> 
