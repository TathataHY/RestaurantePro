<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Comandas.ViewModels;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.Operations.Comandas.Pages.ModernComandasPage"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="*">

        <!-- Contenido Principal en un solo scroll (Header + Items) -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshComandasCommand}">

            <CollectionView ItemsSource="{Binding Comandas}"
                            SelectionMode="None">

                <!-- Header: estadísticas + búsqueda + filtros + acciones -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12" Padding="16,8,16,0">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="12">
                                <!-- Card Total Comandas -->
                                <controls:ModernCard Padding="16" WidthRequest="120">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="🍽️" FontSize="24" HorizontalOptions="Center" />
                                        <Label Text="Total" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Estadisticas.TotalComandasActivas}" Style="{StaticResource H2Style}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                <!-- Card Pendientes -->
                                <controls:ModernCard Padding="16" WidthRequest="120">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="⏳" FontSize="24" HorizontalOptions="Center" />
                                        <Label Text="Pendientes" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Estadisticas.ComandasPendientes}" Style="{StaticResource H2Style}" TextColor="{StaticResource WarningColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                <!-- Card En Progreso -->
                                <controls:ModernCard Padding="16" WidthRequest="120">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="🔥" FontSize="24" HorizontalOptions="Center" />
                                        <Label Text="En Progreso" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Estadisticas.ComandasEnPreparacion}" Style="{StaticResource H2Style}" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                                <!-- Card Completadas -->
                                <controls:ModernCard Padding="16" WidthRequest="120">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                                        <Label Text="Completadas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Estadisticas.ComandasCompletadasHoy}" Style="{StaticResource H2Style}" TextColor="{StaticResource SuccessColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </controls:ModernCard>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- Búsqueda, filtros y acciones -->
                        <controls:ModernCard>
                            <VerticalStackLayout Spacing="16">
                                <controls:ModernEntry Placeholder="Buscar comanda por número o cliente..." Text="{Binding SearchText}" Icon="🔍" />
                                
                                <!-- Filtros rápidos: Estado y Solo Activas -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <Picker Grid.Column="0"
                                            Title="Estado"
                                            ItemsSource="{Binding EstadosDisponibles}"
                                            SelectedItem="{Binding FiltroEstado, Mode=TwoWay}" />
                                    <Label Grid.Column="1" Text="Solo activas" VerticalTextAlignment="Center" />
                                    <Switch Grid.Column="2" IsToggled="{Binding SoloActivas, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="+ Nueva Comanda" Command="{Binding CrearComandaCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Grid.Column="1" Text="⋮ Más" Clicked="OnMasOpcionesClicked" Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </VerticalStackLayout>
                        </controls:ModernCard>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <controls:ModernCard Margin="8">
                                <controls:ModernCard.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </controls:ModernCard.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto">
                                    
                                    <!-- Header de Comanda -->
                                    <StackLayout Grid.Row="0" Grid.Column="0" 
                                                 Orientation="Horizontal" 
                                                 VerticalOptions="Center">
                                        <Label Text="{Binding NumeroDisplay, StringFormat='Comanda {0}'}" 
                                               Style="{StaticResource H3Style}" />
                                        <Label Text="{Binding Estado, Converter={StaticResource EstadoIconConverter}}" 
                                               FontSize="16" 
                                               Margin="8,0,0,0" />
                                    </StackLayout>

                                    <!-- Estado Badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,4">
                                        <Label Text="{Binding Estado}" 
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="White"
                                               HorizontalOptions="Center" />
                                    </Border>

                                    <!-- Información de Comanda -->
                                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" 
                                                         Spacing="4" Margin="0,12,0,0">
                                        <Label Text="{Binding MesaNumeroDisplay, StringFormat='🪑 Mesa: {0}', TargetNullValue='🪑 Mesa: Sin asignar'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding ClienteNombre, StringFormat='👤 Cliente: {0}', TargetNullValue='👤 Cliente: No asignado'}" 
                                               Style="{StaticResource BodyStyle}" />
                                        <Label Text="{Binding Total, StringFormat='💰 Total: {0:C}'}" 
                                               Style="{StaticResource BodyStyle}"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <!-- Items de la Comanda -->
                                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                         Spacing="2" Margin="0,8,0,0">
                                        <Label Text="📋 Items:" 
                                               Style="{StaticResource CaptionStyle}"
                                               FontAttributes="Bold" />
                                        <CollectionView ItemsSource="{Binding Items}"
                                                       HeightRequest="80">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding Cantidad, StringFormat='{0}x'}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Nombre}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="2"
                                                               Text="{Binding PrecioFinal, StringFormat='{0:C}'}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                            <CollectionView.EmptyView>
                                                <Label Text="(sin items)"
                                                       Style="{StaticResource CaptionStyle}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </CollectionView.EmptyView>
                                        </CollectionView>
                                    </VerticalStackLayout>

                                    <!-- Información Adicional -->
                                    <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" 
                                                         Spacing="2" Margin="0,8,0,0"
                                                         IsVisible="{Binding FechaCreacion, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding FechaCreacion, StringFormat='🕐 Creada: {0:dd/MM/yyyy HH:mm}'}" 
                                               Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding Observaciones}" 
                                               Style="{StaticResource CaptionStyle}"
                                               IsVisible="{Binding Observaciones, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>

                                    <!-- Botones de Acción (scroll horizontal) -->
                                    <ScrollView Grid.Row="4" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never"
                                                Margin="0,12,0,0">
                                        <HorizontalStackLayout Spacing="8">
                                            <Button Text="✅ Finalizar"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FinalizarComandaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding PuedeCobrar}"
                                                    Style="{StaticResource SuccessButtonStyle}"
                                                    HorizontalOptions="Start" />

                                            <Button Text="❌ Cancelar"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarComandaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding PuedeCancelar}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalOptions="Start" />

                                            <Button Text="⋮ Más"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MostrarOpcionesComandaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalOptions="Start" />
                                        </HorizontalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </controls:ModernCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Estado Vacío -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16" 
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="32">
                            <Label Text="🍽️" 
                                   FontSize="64" 
                                   HorizontalOptions="Center" />
                            <Label Text="No hay comandas disponibles" 
                                   Style="{StaticResource H2Style}" 
                                   HorizontalOptions="Center" />
                            <Label Text="Crea una nueva comanda para comenzar" 
                                   Style="{StaticResource BodyStyle}" 
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                            <Button Text="Crear Primera Comanda"
                                    Command="{Binding CrearComandaCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

        <!-- Bottom Navigation - COMENTADO PARA USAR TABS NATIVOS -->
        <!--
        <controls:ModernTabBar Grid.Row="2" x:Name="BottomTabBar" />
        -->

        <!-- Floating Action Button -->
        <controls:FloatingActionButton Grid.Row="0"
                                       x:Name="MainFab"
                                       Text="➕"
                                       Command="{Binding CrearComandaCommand}"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       Margin="16,0,16,16" />
    </Grid>

</ContentPage> 