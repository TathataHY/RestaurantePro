<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Comandas.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:dtos="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             x:Class="RestaurantePro.Mobile.Features.Operations.Comandas.Pages.ComandasPage"
             x:DataType="vm:ComandasViewModel"
             x:Name="comandasPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Estilos para Estados de Comanda -->
            <Style x:Key="EstadoLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
            
            <!-- Estilo para Cards de Comanda -->
            <Style x:Key="ComandaCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="8,4" />
            </Style>

            <Style x:Key="FilterButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#007bff" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#28a745" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="2" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#6c757d" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="2" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- ViewModel se configura en code-behind con DI -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Búsqueda y Filtros -->
        <Frame Grid.Row="0" 
               BackgroundColor="#F8F9FA" 
               Padding="16" 
               Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Búsqueda -->
                <SearchBar Grid.Row="0"
                           x:Name="SearchBar"
                           Placeholder="Buscar comanda por número o cliente..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding ApplyFiltersCommand}"
                           Margin="0,0,0,8" />

                <!-- Filtros -->
                <ScrollView Grid.Row="1" Orientation="Horizontal">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Button Text="🔄 Refrescar" 
                                Command="{Binding RefreshComandasCommand}"
                                Style="{StaticResource FilterButtonStyle}" />

                        <Button Text="➕ Nueva Comanda" 
                                Command="{Binding CrearComandaCommand}"
                                Style="{StaticResource FilterButtonStyle}" />

                        <Button Text="📊 Estadísticas" 
                                Command="{Binding LoadEstadisticasCommand}"
                                Style="{StaticResource FilterButtonStyle}" />

                        <Button Text="{Binding SoloActivas, StringFormat='{0:Solo Activas|Todas}'}"
                                Command="{Binding ToggleActivasCommand}"
                                Style="{StaticResource FilterButtonStyle}" />

                        <Button Text="🗂️ Filtros" 
                                Clicked="OnFiltrosClicked"
                                Style="{StaticResource FilterButtonStyle}" />
                    </StackLayout>
                </ScrollView>
            </Grid>
        </Frame>

        <!-- Estadísticas de Comandas -->
        <Frame Grid.Row="1" 
               BackgroundColor="#E8F5E8" 
               Padding="12" 
               Margin="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="{Binding Estadisticas.TotalComandasActivas, StringFormat='{0}'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center" />
                    <Label Text="Total Activas" FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>

                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding Estadisticas.ComandasCompletadasHoy, StringFormat='{0}'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#28a745" HorizontalOptions="Center" />
                    <Label Text="Completadas Hoy" FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>

                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="{Binding Estadisticas.ComandasPendientes, StringFormat='{0}'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#ffc107" HorizontalOptions="Center" />
                    <Label Text="Pendientes" FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>

                <StackLayout Grid.Column="3" HorizontalOptions="Center">
                    <Label Text="{Binding Estadisticas.TiempoPromedioPreparacion, StringFormat='{0:F1} min'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#17a2b8" HorizontalOptions="Center" />
                    <Label Text="Tiempo Prom." FontSize="12" TextColor="#666" HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Lista de Comandas -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshComandasCommand}">
            <CollectionView ItemsSource="{Binding Comandas}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedComanda}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ComandaDto">
                        <Frame Style="{StaticResource ComandaCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Encabezado de Comanda -->
                                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <Label Text="{Binding NumeroDisplay, StringFormat='Comanda {0}'}" 
                                           FontSize="18" FontAttributes="Bold" TextColor="#333" />
                                    <Label Text="{Binding MesaNumeroDisplay, StringFormat='Mesa {0}'}" 
                                           FontSize="14" TextColor="#666" />
                                </StackLayout>

                                <!-- Estado -->
                                <Frame Grid.Row="0" Grid.Column="1" 
                                       BackgroundColor="{Binding ColorEstado}"
                                       Padding="8,4">
                                    <Label Text="{Binding EstadoDescripcion}" 
                                           Style="{StaticResource EstadoLabelStyle}" />
                                </Frame>

                                <!-- Información de Cliente -->
                                <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0">
                                    <Label Text="{Binding ClienteNombre, StringFormat='Cliente: {0}'}" 
                                           FontSize="14" TextColor="#666" 
                                           IsVisible="{Binding ClienteNombre, Converter={StaticResource IsNotNullConverter}}" />
                                    <Label Text="{Binding CantidadProductos, StringFormat='Productos: {0}'}" 
                                           FontSize="14" TextColor="#666" />
                                    <Label Text="{Binding Total, StringFormat='Total: {0:C}'}" 
                                           FontSize="16" FontAttributes="Bold" TextColor="#28a745" />
                                </StackLayout>

                                <!-- Información Temporal -->
                                <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="2" Margin="0,8,0,0">
                                    <Label Text="{Binding FechaCreacion, StringFormat='Creada: {0:HH:mm}'}" 
                                           FontSize="12" TextColor="#999" />
                                    <Label Text="{Binding UltimaActualizacion, StringFormat='Actualizada: {0:HH:mm}'}" 
                                           FontSize="12" TextColor="#999" />
                                </StackLayout>

                                <!-- Observaciones -->
                                <StackLayout Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                             IsVisible="{Binding Observaciones, Converter={StaticResource IsNotNullConverter}}">
                                    <Label Text="Observaciones:" FontSize="12" FontAttributes="Bold" TextColor="#666" />
                                    <Label Text="{Binding Observaciones}" 
                                           FontSize="12" TextColor="#999" />
                                </StackLayout>

                                <!-- Botones de Acción -->
                                <StackLayout Grid.Row="4" Grid.ColumnSpan="2" 
                                             Orientation="Horizontal" 
                                             Spacing="8" 
                                             Margin="0,12,0,0">
                                    
                                    <Button Text="👁️ Ver" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ComandasViewModel}}, Path=NavigateToComandaDetailCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ActionButtonStyle}" />

                                    <Button Text="🔄 Estado" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ComandasViewModel}}, Path=CambiarEstadoComandaCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            IsVisible="{Binding EstaActiva}" />

                                    <Button Text="➕ Productos" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ComandasViewModel}}, Path=NavigateToAgregarProductosCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            IsVisible="{Binding PuedeSerEditada}" />

                                    <Button Text="✅ Finalizar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ComandasViewModel}}, Path=FinalizarComandaCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            IsVisible="{Binding EstaActiva}" />

                                    <Button Text="❌ Cancelar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ComandasViewModel}}, Path=CancelarComandaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#dc3545"
                                            TextColor="White"
                                            CornerRadius="6"
                                            Padding="12,6"
                                            FontSize="12"
                                            Margin="2"
                                            IsVisible="{Binding EstaActiva}" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Indicador de Carga -->
        <ActivityIndicator Grid.Row="2"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           Color="#007bff"
                           Scale="1.5"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Mensaje de Error -->
        <Frame Grid.Row="3" 
               BackgroundColor="#f8d7da" 
               BorderColor="#f5c6cb"
               Padding="16"
               Margin="8"
               IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#721c24" 
                   FontSize="14"
                   HorizontalOptions="Center" />
        </Frame>
    </Grid>
</ContentPage> 