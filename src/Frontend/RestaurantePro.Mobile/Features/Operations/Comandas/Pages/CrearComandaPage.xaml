<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Operations.Comandas.Pages.CrearComandaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Comandas.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:models="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Comandas.Models;assembly=RestaurantePro.Mobile.Core"

             x:DataType="vm:CrearComandaViewModel"
             Title="{Binding TituloPagina}"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1A1A1A}">



    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Header con información de la mesa -->
            <Frame BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A8A}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="{Binding TituloPagina}" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"
                           HorizontalOptions="Center"/>
                    
                    <Label Text="{Binding MesaInfo}" 
                           FontSize="16" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </StackLayout>
            </Frame>

            <!-- Búsqueda de productos -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="🔍 Buscar Productos" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <SearchBar x:Name="ProductoSearchBar"
                               Text="{Binding TextoBusqueda}"
                               Placeholder="Buscar productos..."
                               SearchCommand="{Binding BuscarProductosCommand}"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#404040}"
                               TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"/>
                </StackLayout>
            </Frame>

            <!-- Lista de productos -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="📋 Productos Disponibles" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <CollectionView ItemsSource="{Binding ProductosDisponibles}"
                                    SelectionMode="None"
                                    HeightRequest="400">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductoCarritoDto">
                                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                                       CornerRadius="16" 
                                       Padding="16"
                                       Margin="0,8"
                                       HasShadow="True"
                                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header del producto con nombre y precio -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackLayout Grid.Column="0">
                                                <Label Text="{Binding Nombre}" 
                                                       FontSize="18" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                <Label Text="{Binding Descripcion}" 
                                                       FontSize="14" 
                                                       TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"/>
                                            </StackLayout>
                                            
                                            <Frame Grid.Column="1"
                                                   BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}"
                                                   CornerRadius="12"
                                                   Padding="12,6"
                                                   HasShadow="False">
                                                <Label Text="{Binding Precio, StringFormat='${0:F0}'}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"/>
                                            </Frame>
                                        </Grid>
                                        
                                        <!-- Controles de cantidad -->
                                        <StackLayout Grid.Row="1" 
                                                     Orientation="Horizontal" 
                                                     HorizontalOptions="Center"
                                                     Spacing="16"
                                                     Margin="0,0,0,12">
                                            <Button Text="−" 
                                                    FontSize="20" 
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A2C2A}"
                                                    TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="24"
                                                    BorderColor="{AppThemeBinding Light=#FFCDD2, Dark=#FFCDD2}"
                                                    BorderWidth="2"
                                                    Clicked="OnDecrementarCantidadClicked"/>
                                            
                                            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#404040}"
                                                   CornerRadius="12"
                                                   Padding="16,8"
                                                   HasShadow="False">
                                                <Label Text="{Binding Cantidad}" 
                                                       FontSize="18" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       WidthRequest="40"/>
                                            </Frame>
                                            
                                            <Button Text="+" 
                                                    FontSize="20" 
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}"
                                                    TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="24"
                                                    BorderColor="{AppThemeBinding Light=#C8E6C9, Dark=#81C784}"
                                                    BorderWidth="2"
                                                    Clicked="OnIncrementarCantidadClicked"/>
                                        </StackLayout>
                                        
                                        <!-- Botón agregar al carrito -->
                                        <Button Grid.Row="2"
                                                Text="🛒 Agregar al Carrito" 
                                                FontSize="16" 
                                                FontAttributes="Bold"
                                                BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                                TextColor="White"
                                                CornerRadius="25"
                                                HeightRequest="48"
                                                Clicked="OnAgregarAlCarritoClicked"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Carrito de productos -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="16" 
                   Padding="20"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                <StackLayout>
                    <StackLayout Orientation="Horizontal" Margin="0,0,0,16">
                        <Label Text="🛒" 
                               FontSize="20"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Label Text="Productos Seleccionados" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    
                    <CollectionView ItemsSource="{Binding ProductosCarrito}"
                                    SelectionMode="None"
                                    HeightRequest="280">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductoCarritoDto">
                                <Frame BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E2723}" 
                                       CornerRadius="16" 
                                       Padding="20"
                                       Margin="0,8"
                                       HasShadow="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header del producto -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackLayout Grid.Column="0">
                                                <Label Text="{Binding Nombre}" 
                                                       FontSize="18" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Precio, StringFormat='Precio unitario: ${0:F0}'}" 
                                                       FontSize="14" 
                                                       TextColor="{AppThemeBinding Light=#BF360C, Dark=#FFCC02}"/>
                                            </StackLayout>
                                            
                                            <Frame Grid.Column="1"
                                                   BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}"
                                                   CornerRadius="12"
                                                   Padding="12,6"
                                                   HasShadow="False">
                                                <Label Text="{Binding Subtotal, StringFormat='${0:F0}'}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"/>
                                            </Frame>
                                        </Grid>
                                        
                                        <!-- Controles de cantidad -->
                                        <StackLayout Grid.Row="1" 
                                                     Orientation="Horizontal" 
                                                     HorizontalOptions="Center"
                                                     Spacing="16"
                                                     Margin="0,0,0,12">
                                            <Button Text="−" 
                                                    FontSize="18" 
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A2C2A}"
                                                    TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    CornerRadius="22"
                                                    BorderColor="{AppThemeBinding Light=#FFCDD2, Dark=#FFCDD2}"
                                                    BorderWidth="2"
                                                    Clicked="OnDecrementarCantidadCarritoClicked"/>
                                            
                                            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#404040}"
                                                   CornerRadius="12"
                                                   Padding="16,8"
                                                   HasShadow="False">
                                                <Label Text="{Binding Cantidad}" 
                                                       FontSize="18" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       WidthRequest="40"/>
                                            </Frame>
                                            
                                            <Button Text="+" 
                                                    FontSize="18" 
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}"
                                                    TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    CornerRadius="22"
                                                    BorderColor="{AppThemeBinding Light=#C8E6C9, Dark=#81C784}"
                                                    BorderWidth="2"
                                                    Clicked="OnIncrementarCantidadCarritoClicked"/>
                                        </StackLayout>
                                        
                                        <!-- Botón eliminar -->
                                        <Button Grid.Row="2"
                                                Text="🗑️ Eliminar" 
                                                FontSize="14" 
                                                FontAttributes="Bold"
                                                BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A2C2A}"
                                                TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"
                                                CornerRadius="20"
                                                HeightRequest="40"
                                                Clicked="OnEliminarDelCarritoClicked"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <!-- Total -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}" 
                           CornerRadius="20" 
                           Padding="24"
                           Margin="0,20,0,0"
                           HasShadow="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackLayout Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center">
                                <Label Text="💰" 
                                       FontSize="28"
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0"/>
                                <StackLayout VerticalOptions="Center">
                                    <Label Text="Total de la Comanda" 
                                           FontSize="16" 
                                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                           VerticalOptions="Center"/>
                                    <Label Text="Incluye todos los productos" 
                                           FontSize="12" 
                                           TextColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                            </StackLayout>
                            
                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding TotalCarrito, StringFormat='${0:F0}'}" 
                                       FontSize="28" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1B5E20, Dark=#C8E6C9}"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"/>
                                <Label Text="Pesos Chilenos" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#4CAF50, Dark=#A5D6A7}"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Observaciones -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="📝 Observaciones" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <Editor Text="{Binding Observaciones}"
                            Placeholder="Agregar observaciones especiales para la comanda..."
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#404040}"
                            TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                            HeightRequest="80"/>
                </StackLayout>
            </Frame>

            <!-- Botones de acción -->
            <StackLayout Orientation="Horizontal" 
                         Spacing="12" 
                         HorizontalOptions="FillAndExpand">
                
                <Button Text="❌ Cancelar" 
                        FontSize="16" 
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding CancelarCommand}"
                        HorizontalOptions="FillAndExpand"/>
                
                <Button Text="{Binding TextoBotonPrimario}" 
                        FontSize="16" 
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding CrearComandaCommand}"
                        IsEnabled="{Binding PuedeGuardar}"
                        HorizontalOptions="FillAndExpand"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>
