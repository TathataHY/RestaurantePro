<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Operations.Comandas.Pages.CrearComandaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Comandas.ViewModels;assembly=RestaurantePro.Mobile.Core"

             x:DataType="vm:CrearComandaViewModel"
             Title="Nueva Comanda"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1A1A1A}">



    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Header con información de la mesa -->
            <Frame BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A8A}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="🍽️ Nueva Comanda" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"
                           HorizontalOptions="Center"/>
                    
                    <Label Text="{Binding MesaInfo}" 
                           FontSize="16" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </StackLayout>
            </Frame>

            <!-- Búsqueda de productos -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="🔍 Buscar Productos" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <SearchBar x:Name="ProductoSearchBar"
                               Text="{Binding TextoBusqueda}"
                               Placeholder="Buscar productos..."
                               SearchCommand="{Binding BuscarProductosCommand}"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#404040}"
                               TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"/>
                </StackLayout>
            </Frame>

            <!-- Lista de productos -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="📋 Productos Disponibles" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <CollectionView ItemsSource="{Binding ProductosDisponibles}"
                                    SelectionMode="None"
                                    HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#3D3D3D}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Información del producto -->
                                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"/>
                                        <Label Text="{Binding Descripcion}" 
                                               FontSize="14" 
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#B0B0B0}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                               FontSize="14" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"/>
                                    </StackLayout>
                                    
                                    <!-- Cantidad -->
                                    <StackLayout Grid.Column="1" 
                                                 Orientation="Horizontal" 
                                                 VerticalOptions="Center"
                                                 Spacing="8">
                                        <Button Text="-" 
                                                FontSize="18" 
                                                FontAttributes="Bold"
                                                BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#FF7043}"
                                                TextColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearComandaViewModel}}, Path=DecrementarCantidadCommand}"
                                                CommandParameter="{Binding .}"/>
                                        
                                        <Label Text="{Binding Cantidad}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               WidthRequest="30"/>
                                        
                                        <Button Text="+" 
                                                FontSize="18" 
                                                FontAttributes="Bold"
                                                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"
                                                TextColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearComandaViewModel}}, Path=IncrementarCantidadCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </StackLayout>
                                    
                                    <!-- Agregar al carrito -->
                                    <Button Grid.Column="2"
                                            Text="➕" 
                                            FontSize="16" 
                                            FontAttributes="Bold"
                                            BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}"
                                            TextColor="White"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearComandaViewModel}}, Path=AgregarAlCarritoCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Carrito de productos -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="🛒 Productos Seleccionados" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <CollectionView ItemsSource="{Binding ProductosCarrito}"
                                    SelectionMode="None"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#3D3D3D}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Información del producto -->
                                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"/>
                                        <Label Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" 
                                               FontSize="14" 
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#B0B0B0}"/>
                                        <Label Text="{Binding Subtotal, StringFormat='Subtotal: ${0:F2}'}" 
                                               FontSize="14" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"/>
                                    </StackLayout>
                                    
                                    <!-- Cantidad -->
                                    <StackLayout Grid.Column="1" 
                                                 Orientation="Horizontal" 
                                                 VerticalOptions="Center"
                                                 Spacing="8">
                                        <Button Text="-" 
                                                FontSize="18" 
                                                FontAttributes="Bold"
                                                BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#FF7043}"
                                                TextColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearComandaViewModel}}, Path=DecrementarCantidadCarritoCommand}"
                                                CommandParameter="{Binding .}"/>
                                        
                                        <Label Text="{Binding Cantidad}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               WidthRequest="30"/>
                                        
                                        <Button Text="+" 
                                                FontSize="18" 
                                                FontAttributes="Bold"
                                                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"
                                                TextColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearComandaViewModel}}, Path=IncrementarCantidadCarritoCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </StackLayout>
                                    
                                    <!-- Eliminar del carrito -->
                                    <Button Grid.Column="2"
                                            Text="🗑️" 
                                            FontSize="16" 
                                            FontAttributes="Bold"
                                            BackgroundColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                                            TextColor="White"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearComandaViewModel}}, Path=EliminarDelCarritoCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <!-- Total -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#2E7D32}" 
                           CornerRadius="8" 
                           Padding="12"
                           Margin="0,12,0,0">
                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                            <Label Text="💰 Total:" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding TotalCarrito, StringFormat='${0:F2}'}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                   HorizontalOptions="EndAndExpand"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Observaciones -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}" 
                   CornerRadius="12" 
                   Padding="16"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="📝 Observaciones" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           Margin="0,0,0,12"/>
                    
                    <Editor Text="{Binding Observaciones}"
                            Placeholder="Agregar observaciones especiales para la comanda..."
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#404040}"
                            TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                            HeightRequest="80"/>
                </StackLayout>
            </Frame>

            <!-- Botones de acción -->
            <StackLayout Orientation="Horizontal" 
                         Spacing="12" 
                         HorizontalOptions="FillAndExpand">
                
                <Button Text="❌ Cancelar" 
                        FontSize="16" 
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding CancelarCommand}"
                        HorizontalOptions="FillAndExpand"/>
                
                <Button Text="✅ Crear Comanda" 
                        FontSize="16" 
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        Command="{Binding CrearComandaCommand}"
                        IsEnabled="{Binding PuedeCrearComanda}"
                        HorizontalOptions="FillAndExpand"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>
