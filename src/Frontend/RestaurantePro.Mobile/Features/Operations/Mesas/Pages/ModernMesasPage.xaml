<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantePro.Mobile.Features.Operations.Mesas.Pages.ModernMesasPage"
             Title="Gestión de Mesas"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con Estadísticas -->
        <ScrollView Grid.Row="0" 
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal"
                    Padding="16,8">
            <HorizontalStackLayout Spacing="12">
                
                <!-- Card Total Mesas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🏠" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Total Mesas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="{Binding EstadoMesas.TotalMesas}" Style="{StaticResource H2Style}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card Mesas Disponibles -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Disponibles" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="{Binding EstadoMesas.MesasDisponibles.Count}" Style="{StaticResource H2Style}" HorizontalOptions="Center" TextColor="#4CAF50" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card Mesas Ocupadas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="👥" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Ocupadas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="{Binding EstadoMesas.MesasOcupadas.Count}" Style="{StaticResource H2Style}" HorizontalOptions="Center" TextColor="#FF9800" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card Reservadas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="📅" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Reservadas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="{Binding EstadoMesas.MesasReservadas.Count}" Style="{StaticResource H2Style}" HorizontalOptions="Center" TextColor="#2196F3" />
                    </VerticalStackLayout>
                </Frame>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Contenido Principal -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- Filtros -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔍 Filtros" Style="{StaticResource H2Style}" />
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Picker Grid.Column="0" 
                                    Title="Estado"
                                    SelectedItem="{Binding FiltroEstado}"
                                    SelectedIndexChanged="OnEstadoFilterChanged">
                                <Picker.Items>
                                    <x:String>Todas</x:String>
                                    <x:String>Disponibles</x:String>
                                    <x:String>Ocupadas</x:String>
                                    <x:String>Reservadas</x:String>
                                    <x:String>Fuera de servicio</x:String>
                                    <x:String>En limpieza</x:String>
                                </Picker.Items>
                            </Picker>
                            
                            <Picker Grid.Column="1" 
                                    Title="Capacidad"
                                    SelectedItem="{Binding FiltroCapacidad}"
                                    SelectedIndexChanged="OnCapacidadFilterChanged">
                                <Picker.Items>
                                    <x:String>Todas</x:String>
                                    <x:String>2 personas</x:String>
                                    <x:String>4 personas</x:String>
                                    <x:String>6 personas</x:String>
                                    <x:String>8+ personas</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Grid de Mesas Dinámico -->
                <CollectionView ItemsSource="{Binding Mesas}"
                               ItemsLayout="VerticalGrid, 2"
                               ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{Binding EstadoColor}"
                                   CornerRadius="12"
                                   Padding="16"
                                   Margin="6"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToMesaDetailCommand}"
                                                         CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                                    <Label Text="{Binding Numero, StringFormat='Mesa {0}'}" 
                                           Style="{StaticResource H3Style}" 
                                           TextColor="White" 
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding Capacidad, StringFormat='{0} personas'}" 
                                           Style="{StaticResource CaptionStyle}" 
                                           TextColor="White" 
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding EstadoDescripcion}" 
                                           Style="{StaticResource CaptionStyle}" 
                                           TextColor="White" 
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Botones de Acción -->
        <Frame Grid.Row="2" 
               BackgroundColor="White" 
               CornerRadius="12"
               Padding="16"
               Margin="16"
               HasShadow="True">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" 
                        Text="➕ Nueva Mesa"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="8"
                        Command="{Binding CreateMesaCommand}" />
                
                <Button Grid.Column="1" 
                        Text="📊 Estadísticas"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="8"
                        Command="{Binding LoadEstadisticasCommandCommand}" />
            </Grid>
        </Frame>
    </Grid>

</ContentPage> 
