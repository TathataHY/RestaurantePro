<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantePro.Mobile.Features.Operations.Mesas.Pages.ModernMesasPage"
             Title="Gestión de Mesas"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header con Estadísticas -->
        <ScrollView Grid.Row="0" 
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,8">
            <HorizontalStackLayout Spacing="12">
                
                <!-- Card Total Mesas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🏠" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Total Mesas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="12" Style="{StaticResource H2Style}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card Mesas Disponibles -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="✅" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Disponibles" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="8" Style="{StaticResource H2Style}" HorizontalOptions="Center" TextColor="#4CAF50" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card Mesas Ocupadas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="👥" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Ocupadas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="4" Style="{StaticResource H2Style}" HorizontalOptions="Center" TextColor="#FF9800" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Card Reservadas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="📅" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Reservadas" Style="{StaticResource CaptionStyle}" HorizontalOptions="Center" />
                        <Label Text="2" Style="{StaticResource H2Style}" HorizontalOptions="Center" TextColor="#2196F3" />
                    </VerticalStackLayout>
                </Frame>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Contenido Principal -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- Filtros -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔍 Filtros" Style="{StaticResource H2Style}" />
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Picker Grid.Column="0" 
                                    Title="Estado"
                                    SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>Todas</x:String>
                                    <x:String>Disponibles</x:String>
                                    <x:String>Ocupadas</x:String>
                                    <x:String>Reservadas</x:String>
                                </Picker.Items>
                            </Picker>
                            
                            <Picker Grid.Column="1" 
                                    Title="Capacidad"
                                    SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>Todas</x:String>
                                    <x:String>2 personas</x:String>
                                    <x:String>4 personas</x:String>
                                    <x:String>6 personas</x:String>
                                    <x:String>8+ personas</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Grid de Mesas -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                      ColumnSpacing="12" RowSpacing="12">
                    
                    <!-- Mesa 1 -->
                    <Frame Grid.Column="0" Grid.Row="0" 
                           BackgroundColor="#4CAF50" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 1" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="4 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Disponible" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 2 -->
                    <Frame Grid.Column="1" Grid.Row="0" 
                           BackgroundColor="#FF9800" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 2" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="6 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Ocupada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 3 -->
                    <Frame Grid.Column="0" Grid.Row="1" 
                           BackgroundColor="#4CAF50" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 3" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="2 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Disponible" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 4 -->
                    <Frame Grid.Column="1" Grid.Row="1" 
                           BackgroundColor="#2196F3" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 4" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="8 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Reservada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 5 -->
                    <Frame Grid.Column="0" Grid.Row="2" 
                           BackgroundColor="#4CAF50" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 5" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="4 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Disponible" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 6 -->
                    <Frame Grid.Column="1" Grid.Row="2" 
                           BackgroundColor="#FF9800" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 6" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="6 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Ocupada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 7 -->
                    <Frame Grid.Column="0" Grid.Row="3" 
                           BackgroundColor="#4CAF50" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 7" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="2 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Disponible" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 8 -->
                    <Frame Grid.Column="1" Grid.Row="3" 
                           BackgroundColor="#9C27B0" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 8" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="10 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Reservada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 9 -->
                    <Frame Grid.Column="0" Grid.Row="4" 
                           BackgroundColor="#FF5722" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 9" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="4 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Ocupada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 10 -->
                    <Frame Grid.Column="1" Grid.Row="4" 
                           BackgroundColor="#4CAF50" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 10" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="6 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Disponible" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 11 -->
                    <Frame Grid.Column="0" Grid.Row="5" 
                           BackgroundColor="#9C27B0" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 11" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="8 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Ocupada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Mesa 12 -->
                    <Frame Grid.Column="1" Grid.Row="5" 
                           BackgroundColor="#FF5722" 
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Mesa 12" Style="{StaticResource H3Style}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="4 personas" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Ocupada" Style="{StaticResource CaptionStyle}" TextColor="White" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Botones de Acción -->
        <Frame Grid.Row="2" 
               BackgroundColor="White" 
               CornerRadius="12"
               Padding="16"
               Margin="16"
               HasShadow="True">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" 
                        Text="➕ Nueva Mesa"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="8" />
                
                <Button Grid.Column="1" 
                        Text="📊 Estadísticas"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>
        </Frame>
    </Grid>

</ContentPage> 