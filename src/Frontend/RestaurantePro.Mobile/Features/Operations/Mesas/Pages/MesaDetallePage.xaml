<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RestaurantePro.Mobile.Features.Operations.Mesas.Pages.MesaDetallePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:RestaurantePro.Mobile.Converters"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.Operations.Mesas.ViewModels;assembly=RestaurantePro.Mobile.Core"
             x:DataType="vm:MesaDetalleViewModel"
             Title="Detalle de Mesa">

    <!-- ViewModel se configura en code-behind con DI -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Información de la Mesa -->
        <Frame Grid.Row="0" 
               BackgroundColor="#F8F9FA" 
               Padding="16" 
               Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" 
                       Text="{Binding Mesa.Numero, StringFormat='Mesa {0}'}" 
                       FontSize="24" FontAttributes="Bold" 
                       TextColor="#333" />

                <Label Grid.Row="0" Grid.Column="1" 
                       Text="{Binding Mesa.EstadoDescripcion}" 
                       FontSize="16" FontAttributes="Bold" 
                       TextColor="{Binding Mesa.EstadoColor}" 
                       HorizontalOptions="End" />

                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding Mesa.Capacidad, StringFormat='Capacidad: {0} personas'}" 
                       FontSize="14" TextColor="#666" />

                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding Mesa.Ubicacion}" 
                       FontSize="14" TextColor="#666" 
                       HorizontalOptions="End" />

                <Label Grid.Row="2" Grid.ColumnSpan="2" 
                       Text="{Binding Mesa.Observaciones}" 
                       FontSize="14" TextColor="#666" 
                       IsVisible="{Binding Mesa.Observaciones, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
            </Grid>
        </Frame>

        <!-- Comandas Activas -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding ComandasActivas}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedComanda}">
                <CollectionView.Header>
                    <StackLayout Padding="16,8">
                        <Label Text="Comandas Activas" 
                               FontSize="18" FontAttributes="Bold" 
                               TextColor="#333" />
                    </StackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" 
                               Padding="16" 
                               Margin="8,4" 
                               CornerRadius="8" 
                               HasShadow="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Numero, StringFormat='Comanda {0}'}" 
                                       FontSize="16" FontAttributes="Bold" 
                                       TextColor="#333" />

                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding EstadoDescripcion}" 
                                       FontSize="14" FontAttributes="Bold" 
                                       TextColor="{Binding ColorEstado}" />

                                <Label Grid.Row="1" Grid.ColumnSpan="2" 
                                       Text="{Binding Cliente}" 
                                       FontSize="14" TextColor="#666" />

                                <Label Grid.Row="2" Grid.Column="0" 
                                       Text="{Binding Total, StringFormat='Total: {0:C}'}" 
                                       FontSize="14" FontAttributes="Bold" 
                                       TextColor="#28a745" />

                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding FechaHora, StringFormat='{0:HH:mm}'}" 
                                       FontSize="12" TextColor="#666" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <StackLayout Padding="16" HorizontalOptions="Center">
                        <Label Text="No hay comandas activas para esta mesa" 
                               FontSize="16" TextColor="#666" 
                               HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Botones de Acción con Scroll Horizontal -->
        <ScrollView Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalScrollBarVisibility="Never"
                    Padding="16">
            <StackLayout Orientation="Horizontal" 
                         Spacing="8">
                
                <!-- Botón Liberar Mesa - Solo visible si la mesa está ocupada -->
                <Button Text="🏠 Liberar Mesa" 
                        Command="{Binding LiberarMesaCommand}" 
                        BackgroundColor="#dc3545" 
                        TextColor="White" 
                        CornerRadius="6" 
                        Padding="16,8" 
                        FontSize="14" 
                        MinimumWidthRequest="120"
                        IsVisible="{Binding PuedeLiberar}" />

                <!-- Botón Asignar Mesa - Solo visible si la mesa está disponible -->
                <Button Text="👥 Asignar Mesa" 
                        Command="{Binding AsignarMesaCommand}" 
                        BackgroundColor="#28a745" 
                        TextColor="White" 
                        CornerRadius="6" 
                        Padding="16,8" 
                        FontSize="14" 
                        MinimumWidthRequest="120"
                        IsVisible="{Binding PuedeAsignar}" />

                <!-- Botón Nueva Comanda - Solo visible si la mesa está ocupada -->
                <Button Text="📝 Nueva Comanda" 
                        Command="{Binding CrearComandaCommand}" 
                        BackgroundColor="#007bff" 
                        TextColor="White" 
                        CornerRadius="6" 
                        Padding="16,8" 
                        FontSize="14" 
                        MinimumWidthRequest="120"
                        IsVisible="{Binding PuedeAsignar, Converter={StaticResource InverseBooleanConverter}}" />

                <!-- Botón Cambiar Estado - Siempre visible -->
                <Button Text="⚙️ Cambiar Estado" 
                        Command="{Binding CambiarEstadoCommand}" 
                        BackgroundColor="#6c757d" 
                        TextColor="White" 
                        CornerRadius="6" 
                        Padding="16,8" 
                        FontSize="14" 
                        MinimumWidthRequest="120" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage> 