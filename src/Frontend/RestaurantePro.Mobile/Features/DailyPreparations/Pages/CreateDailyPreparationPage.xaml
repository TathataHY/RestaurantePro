<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             xmlns:vm="clr-namespace:RestaurantePro.Mobile.Core.Features.DailyPreparations.ViewModels;assembly=RestaurantePro.Mobile.Core"
             xmlns:dto="clr-namespace:RestaurantePro.Mobile.Core.Models.DTOs;assembly=RestaurantePro.Mobile.Core"
             x:Class="RestaurantePro.Mobile.Features.DailyPreparations.Pages.CreateDailyPreparationPage"
             x:DataType="vm:CreateDailyPreparationViewModel"
             Title="Nuevo Menú"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <controls:ModernCard>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Categoría" Style="{StaticResource CaptionStyle}" />
                    <Picker ItemsSource="{Binding Categorias}" ItemDisplayBinding="{Binding Nombre}" SelectedItem="{Binding CategoriaSeleccionada}" />

                    <Label Text="Producto" Style="{StaticResource CaptionStyle}" />
                    <SearchBar Placeholder="Buscar producto..." Text="{Binding ProductoBusqueda}" SearchCommand="{Binding BuscarProductosCommand}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding ProductoSeleccionado.Nombre, StringFormat='Seleccionado: {0}'}" IsVisible="{Binding ProductoSeleccionado}" />
                    <CollectionView ItemsSource="{Binding Productos}" SelectionMode="Single" SelectedItem="{Binding ProductoSeleccionado}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:ProductoDto">
                                <Grid Padding="8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nombre}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding CategoriaNombre}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    <Label Grid.RowSpan="2" Grid.Column="1" Text="{Binding Precio, StringFormat='S/. {0:F2}'}" TextColor="{StaticResource TextPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Sin resultados" HorizontalOptions="Center"/>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <Label Text="Cantidad" Style="{StaticResource CaptionStyle}" />
                    <Entry Keyboard="Numeric" Text="{Binding Cantidad}" />

                    <Label Text="Fecha de vencimiento" Style="{StaticResource CaptionStyle}" />
                    <DatePicker Date="{Binding FechaVencimiento}" />

                    <Label Text="Observaciones" Style="{StaticResource CaptionStyle}" />
                    <Editor Text="{Binding Observaciones}" AutoSize="TextChanges" />
                </VerticalStackLayout>
            </controls:ModernCard>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="1" Text="Crear Menú" Command="{Binding CrearPreparacionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>


