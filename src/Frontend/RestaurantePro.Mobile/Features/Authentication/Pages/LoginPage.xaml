<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RestaurantePro.Mobile.Controls"
             x:Class="RestaurantePro.Mobile.Features.Authentication.Pages.LoginPage"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource SurfacePrimary}">

    <Grid RowDefinitions="*,Auto">
        
        <!-- Contenido Principal -->
        <ScrollView Grid.Row="0" 
                    VerticalScrollBarVisibility="Never"
                    Padding="24">
            
            <VerticalStackLayout Spacing="32" 
                                VerticalOptions="Center">
                
                <!-- Header con Logo -->
                <VerticalStackLayout Spacing="16" 
                                    HorizontalOptions="Center"
                                    Margin="0,40,0,20">
                    
                    <!-- Logo/Icono -->
                    <Border BackgroundColor="{StaticResource PrimaryColor}"
                            StrokeShape="Ellipse"
                            WidthRequest="80"
                            HeightRequest="80"
                            HorizontalOptions="Center">
                        
                        <Label Text="🍽️"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    
                    <!-- Título -->
                    <Label Text="RestaurantePro"
                           Style="{StaticResource H1Style}"
                           HorizontalOptions="Center" />
                    
                    <!-- Subtítulo -->
                    <Label Text="Sistema de Gestión Restaurante"
                           Style="{StaticResource BodyStyle}"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Formulario de Login -->
                <VerticalStackLayout Spacing="24">
                    
                    <!-- Campo Email -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo Electrónico"
                               Style="{StaticResource BodyStyle}"
                               FontAttributes="Bold" />
                        
                        <controls:ModernEntry Text="{Binding Email}"
                                             Placeholder="ejemplo@restaurantepro.com"
                                             Icon="📧"
                                             Keyboard="Email" />
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña"
                               Style="{StaticResource BodyStyle}"
                               FontAttributes="Bold" />
                        
                        <controls:ModernEntry Text="{Binding Password}"
                                             Placeholder="Ingrese su contraseña"
                                             Icon="🔒"
                                             IsPassword="True" />
                    </VerticalStackLayout>

                    <!-- Checkbox Recordarme -->
                    <HorizontalStackLayout Spacing="12" 
                                           VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding Recordarme}"
                                  Color="{StaticResource PrimaryColor}" />
                        
                        <Label Text="Recordarme"
                               Style="{StaticResource BodyStyle}"
                               VerticalOptions="Center"
                               TextColor="{StaticResource TextPrimary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleRecordarmeCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Mensaje de Error -->
                    <Border BackgroundColor="{StaticResource ErrorColor}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding HasError}">
                        
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="White"
                               FontSize="14"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Botón de Login -->
                <Button Text="Iniciar Sesión"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="56"
                        Margin="0,16,0,0" />

                <!-- Indicador de Carga -->
                <VerticalStackLayout Spacing="12"
                                    IsVisible="{Binding IsBusy}"
                                    HorizontalOptions="Center">
                    
                    <ActivityIndicator IsRunning="True"
                                      Color="{StaticResource PrimaryColor}"
                                      WidthRequest="24"
                                      HeightRequest="24" />
                    
                    <Label Text="Iniciando sesión..."
                           Style="{StaticResource CaptionStyle}"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource SurfaceSecondary}"
                StrokeShape="RoundRectangle 16 16 0 0"
                Padding="24,20">
            
            <VerticalStackLayout Spacing="8" 
                                HorizontalOptions="Center">
                
                <Label Text="¿Primera vez usando RestaurantePro?"
                       Style="{StaticResource BodyStyle}"
                       HorizontalOptions="Center" />
                
                <Label Text="Contacta al administrador para obtener acceso"
                       Style="{StaticResource CaptionStyle}"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage> 