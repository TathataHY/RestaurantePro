<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM Toolkit - V1 Fundamental -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    
    <!-- HTTP Client - V1 Fundamental -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    
    <!-- JSON Serialization - V1 Fundamental -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    
    <!-- Dependency Injection - V1 Fundamental -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    
    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    
    <!-- MAUI Essentials (para interfaces) -->
    <PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.10" />
  </ItemGroup>

</Project>
