@inherits LayoutComponentBase
@using RestaurantePro.Web.Public.Layout

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }
}

<div class="layout-container">
    <header class="header">
        <div class="header-content">
            <div class="logo-section">
                <div class="logo-icon">
                    <span class="material-symbols-outlined">restaurant_menu</span>
                </div>
                <h2 class="logo-text">RestaurantePro</h2>
            </div>
            <div class="nav-section">
                <nav class="nav-links">
                    <a class="nav-link" href="/">Inicio</a>
                    <a class="nav-link" href="/menu">Menú</a>
                    <a class="nav-link" href="/promociones">Promociones</a>
                    <a class="nav-link" href="/resenas">Reseñas</a>
                    <a class="nav-link" href="/acerca">Acerca</a>
                    <a class="nav-link" href="/contacto">Contacto</a>
                </nav>
                <div class="nav-actions">
                    <a href="/registro" class="btn-outline-light">Registrarse</a>
                    <a href="/reservas" class="btn-primary">Reservar Mesa</a>
                </div>
                <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
            
            <!-- Mobile Menu -->
            <div class="mobile-menu @(isMobileMenuOpen ? "open" : "")">
                <nav class="mobile-nav-links">
                    <a class="mobile-nav-link" href="/" @onclick="CloseMobileMenu">Inicio</a>
                    <a class="mobile-nav-link" href="/menu" @onclick="CloseMobileMenu">Menú</a>
                    <a class="mobile-nav-link" href="/promociones" @onclick="CloseMobileMenu">Promociones</a>
                    <a class="mobile-nav-link" href="/resenas" @onclick="CloseMobileMenu">Reseñas</a>
                    <a class="mobile-nav-link" href="/acerca" @onclick="CloseMobileMenu">Acerca</a>
                    <a class="mobile-nav-link" href="/contacto" @onclick="CloseMobileMenu">Contacto</a>
                </nav>
                <div class="mobile-nav-actions">
                    <a href="/registro" class="mobile-btn-outline" @onclick="CloseMobileMenu">Registrarse</a>
                    <a href="/reservas" class="mobile-btn-primary" @onclick="CloseMobileMenu">Reservar Mesa</a>
                </div>
            </div>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <Footer />
</div>
