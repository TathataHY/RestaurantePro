@page "/menu"
@inject RestaurantePro.Web.Public.Services.MenuApiService Api
@using RestaurantePro.Web.Public.Models
@using System.Globalization

<PageTitle>Menú - RestaurantePro</PageTitle>
<HeadContent>
    <link rel="canonical" href="/menu" />
    <meta property="og:title" content="Menú - RestaurantePro" />
    <meta property="og:description" content="Explora nuestras categorías y platos destacados. Ingredientes frescos, sabores auténticos y experiencias culinarias únicas." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/menu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Menú - RestaurantePro" />
    <meta name="twitter:description" content="Explora nuestras categorías y platos destacados. Ingredientes frescos, sabores auténticos y experiencias culinarias únicas." />
</HeadContent>

<!-- Hero Section del Menú -->
<section class="menu-hero">
    <div class="menu-hero-content">
        <h1 class="menu-hero-title">Nuestro Menú</h1>
        <p class="menu-hero-subtitle">
            Descubre una selección cuidadosamente curada de platos que celebran la tradición culinaria con un toque moderno.
        </p>
    </div>
</section>

<!-- Filtros y Búsqueda -->
<section class="menu-filters">
    <div class="filters-container">
        <div class="search-section">
            <div class="search-input-wrapper">
                <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input class="search-input" placeholder="Buscar categoría o plato..." @bind-value="textoBusqueda" @bind-value:event="oninput" />
            </div>
            <button class="search-button" @onclick="AplicarBusqueda">
                <svg class="search-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                Buscar
            </button>
        </div>
        <div class="sort-section">
            <label class="sort-label">Ordenar por:</label>
            <select class="sort-select" @bind="orden">
                <option value="popularidad">Más populares</option>
                <option value="precio_asc">Precio: menor a mayor</option>
                <option value="precio_desc">Precio: mayor a menor</option>
            </select>
        </div>
    </div>
</section>

<!-- Contenido Principal del Menú -->
<section class="menu-content">
    <div class="menu-layout">
        <!-- Sidebar de Categorías -->
        <aside class="menu-sidebar">
            <div class="sidebar-header">
                <h3 class="sidebar-title">Categorías</h3>
                <p class="sidebar-subtitle">Explora nuestras especialidades</p>
            </div>
            <div class="categories-list">
                @foreach (var cat in categorias)
                {
                    <div class="category-item @(categoriaSeleccionada?.Id == cat.Id ? "active" : "")" @onclick="(() => SeleccionarCategoria(cat))">
                        <div class="category-icon">@cat.Icono</div>
                        <div class="category-info">
                            <span class="category-name">@cat.Nombre</span>
                            <span class="category-count">@cat.ProductosDisponibles platos</span>
                        </div>
                        <div class="category-arrow">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    </div>
                }
            </div>
        </aside>

        <!-- Área de Productos -->
        <main class="menu-main">
            <div class="products-header">
                <h2 class="products-title">
                    @if (categoriaSeleccionada != null)
                    {
                        <span>@categoriaSeleccionada.Nombre</span>
                    }
                    else
                    {
                        <span>Todos los Productos</span>
                    }
                </h2>
                @if (categoriaSeleccionada != null)
                {
                    <p class="products-subtitle">@categoriaSeleccionada.ProductosDisponibles platos disponibles</p>
                }
            </div>
            <!-- Estado de Carga -->
            @if (cargando)
            {
                <div class="products-grid">
                    @foreach (var _ in Enumerable.Range(0, 6))
                    {
                        <div class="product-card loading">
                            <div class="product-image loading-placeholder"></div>
                            <div class="product-content">
                                <div class="product-title loading-placeholder"></div>
                                <div class="product-description loading-placeholder"></div>
                                <div class="product-footer">
                                    <div class="product-price loading-placeholder"></div>
                                    <div class="product-category loading-placeholder"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (productos.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                        </svg>
                    </div>
                    <h3 class="empty-title">No hay productos disponibles</h3>
                    <p class="empty-description">No se encontraron productos para esta categoría. Intenta con otra búsqueda.</p>
                </div>
            }
            else
            {
                <div class="products-grid">
                    @foreach (var p in productosPagina)
                    {
                        <div class="product-card @(p.Activo ? "" : "unavailable")">
                            <div class="product-image-wrapper">
                                <img src="@ObtenerImagenProducto(p)" class="product-image" alt="@p.Nombre" />
                                @if (!p.Activo)
                                {
                                    <div class="unavailable-badge">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                                        </svg>
                                        Sin stock
                                    </div>
                                }
                            </div>
                            <div class="product-content">
                                <h3 class="product-title">@p.Nombre</h3>
                                <p class="product-description">@p.Descripcion</p>
                                <div class="product-footer">
                                    <div class="product-price">@FormatearPrecio(p.Precio)</div>
                                    <div class="product-category">@p.CategoriaNombre</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Paginación -->
                <div class="pagination-container">
                    <div class="pagination-info">
                        <span class="pagination-text">Página @paginaActual de @totalPaginas</span>
                        <span class="pagination-count">(@productos.Count productos)</span>
                    </div>
                    <div class="pagination-controls">
                        <button class="pagination-button" disabled="@(paginaActual <= 1)" @onclick="PaginaAnterior">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                            Anterior
                        </button>
                        <button class="pagination-button" disabled="@(paginaActual >= totalPaginas)" @onclick="PaginaSiguiente">
                            Siguiente
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </main>
    </div>
</section>

@code {
    private List<CategoriaProductoDto> categorias = new();
    private List<ProductoDto> productos = new();
    private IEnumerable<ProductoDto> productosOrdenados => OrdenarProductos(productos, orden);
    private IEnumerable<ProductoDto> productosPagina => productos; // si el servidor ya recorta, esta es la página actual
    private CategoriaProductoDto? categoriaSeleccionada;
    private string textoBusqueda = string.Empty;
    private string orden = "popularidad";
    private bool cargando = false;
    private int paginaActual = 1;
    private int tamanoPagina = 6;
    private int totalPaginas = 1;
    private bool usarPaginacionServidor = true;

    protected override async Task OnInitializedAsync()
    {
        categorias = await Api.ObtenerCategoriasAsync(true, true);
        if (categorias.Count > 0)
        {
            await SeleccionarCategoria(categorias.First());
        }
    }

    private async Task SeleccionarCategoria(CategoriaProductoDto cat)
    {
        categoriaSeleccionada = cat;
        cargando = true;
        StateHasChanged();
        try
        {
            if (usarPaginacionServidor)
            {
                var orderBy = orden == "precio_asc" ? "Precio" : orden == "precio_desc" ? "Precio" : "Popularidad";
                var orderDirection = orden == "precio_desc" ? "desc" : orden == "precio_asc" ? "asc" : "desc";
                var page = await Api.ObtenerProductosPaginadosAsync(cat.Id, paginaActual, tamanoPagina, false, orderBy, orderDirection);
                productos = page.Items;
                totalPaginas = page.TotalPages;
            }
            else
            {
                // Traer también no activos para marcar "Sin stock"
                productos = await Api.ObtenerProductosPorCategoriaAsync(cat.Id, false, true);
                CalcularTotalPaginas();
            }
        }
        catch
        {
            productos = new List<ProductoDto>();
            totalPaginas = 1;
        }
        finally
        {
            cargando = false;
            paginaActual = 1;
            StateHasChanged();
        }
    }

    private async Task AplicarBusqueda()
    {
        var query = textoBusqueda?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(query))
        {
            categorias = await Api.ObtenerCategoriasAsync(true, true);
        }
        else
        {
            categorias = await Api.BuscarCategoriasAsync(query.ToLowerInvariant());
        }
        if (categorias.Count > 0)
        {
            await SeleccionarCategoria(categorias.First());
        }
        else
        {
            categoriaSeleccionada = null;
            productos = new List<ProductoDto>();
            paginaActual = 1;
            CalcularTotalPaginas();
        }
    }

    private static IEnumerable<ProductoDto> OrdenarProductos(IEnumerable<ProductoDto> source, string criterio)
    {
        return criterio switch
        {
            "precio_asc" => source.OrderBy(p => p.Precio),
            "precio_desc" => source.OrderByDescending(p => p.Precio),
            _ => source.OrderByDescending(p => p.Popularidad)
        };
    }

    private static string FormatearPrecio(decimal precio)
    {
        // Formato manual para evitar dependencia de ICU en WASM: miles con punto.
        var miles = precio.ToString("#,0", CultureInfo.InvariantCulture).Replace(",", ".");
        return "$ " + miles;
    }

    private static string ObtenerImagenProducto(ProductoDto p)
    {
        // Si en el futuro hay URL de imagen real en el DTO, usarla. Por ahora seed por Id.
        return $"https://picsum.photos/seed/{p.Id}/600/400";
    }

    private void CalcularTotalPaginas()
    {
        totalPaginas = Math.Max(1, (int)Math.Ceiling(productos.Count / (double)tamanoPagina));
        if (paginaActual > totalPaginas) paginaActual = totalPaginas;
    }

    private void PaginaSiguiente()
    {
        if (cargando) return;
        if (paginaActual < totalPaginas) { paginaActual++; if (categoriaSeleccionada != null && usarPaginacionServidor) _ = SeleccionarCategoria(categoriaSeleccionada); }
    }

    private void PaginaAnterior()
    {
        if (cargando) return;
        if (paginaActual > 1) { paginaActual--; if (categoriaSeleccionada != null && usarPaginacionServidor) _ = SeleccionarCategoria(categoriaSeleccionada); }
    }
}

