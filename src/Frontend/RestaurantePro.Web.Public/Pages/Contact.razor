@page "/contacto"
@inject RestaurantePro.Web.Public.Services.ContactApiService Api
@using RestaurantePro.Web.Public.Models

<PageTitle>Contacto - RestaurantePro</PageTitle>
<HeadContent>
    <link rel="canonical" href="/contacto" />
    <meta property="og:title" content="Contacto - RestaurantePro" />
    <meta property="og:description" content="Ponte en contacto con nosotros. Estamos aquí para responder tus preguntas y ayudarte con reservas, eventos especiales y cualquier consulta que tengas." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/contacto" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Contacto - RestaurantePro" />
    <meta name="twitter:description" content="Ponte en contacto con nosotros. Estamos aquí para responder tus preguntas y ayudarte con reservas, eventos especiales y cualquier consulta que tengas." />
</HeadContent>

<!-- Hero Section -->
<section class="contact-hero">
    <div class="contact-hero-content">
        <h1 class="contact-hero-title">Contáctanos</h1>
        <p class="contact-hero-subtitle">
            Estamos aquí para responder tus preguntas y ayudarte con reservas, eventos especiales y cualquier consulta que tengas.
        </p>
    </div>
</section>

<!-- Información de Contacto -->
<section class="contact-info">
    <div class="contact-info-container">
        <div class="contact-info-grid">
            <!-- Información de Contacto -->
            <div class="contact-details">
                <h2 class="contact-details-title">Información de Contacto</h2>
                <p class="contact-details-subtitle">Múltiples formas de ponerte en contacto con nosotros</p>
                
                <div class="contact-methods">
                    <div class="contact-method">
                        <div class="contact-method-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                        </div>
                        <div class="contact-method-content">
                            <h3 class="contact-method-title">Teléfono</h3>
                            <p class="contact-method-text">+1 (555) 123-4567</p>
                            <p class="contact-method-subtext">Lunes a Domingo: 9:00 - 22:00</p>
                        </div>
                    </div>
                    
                    <div class="contact-method">
                        <div class="contact-method-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <div class="contact-method-content">
                            <h3 class="contact-method-title">Email</h3>
                            <p class="contact-method-text">info@restaurantepro.com</p>
                            <p class="contact-method-subtext">Respuesta en 24 horas</p>
                        </div>
                    </div>
                    
                    <div class="contact-method">
                        <div class="contact-method-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <div class="contact-method-content">
                            <h3 class="contact-method-title">Ubicación</h3>
                            <p class="contact-method-text">123 Avenida Gastronómica</p>
                            <p class="contact-method-subtext">Ciudad Sabrosa, 12345</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Formulario de Contacto -->
            <div class="contact-form-container">
                <div class="contact-form-card">
                    <div class="contact-form-header">
                        <h3 class="contact-form-title">Envíanos un Mensaje</h3>
                        <p class="contact-form-subtitle">Completa el formulario y nos pondremos en contacto contigo</p>
                    </div>
                    
                    <EditForm Model="mensaje" OnValidSubmit="EnviarAsync">
                        <DataAnnotationsValidator />
                        <div class="contact-form-body">
                            @if (enviado)
                            {
                                <div class="contact-success">
                                    <div class="contact-success-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <h4 class="contact-success-title">¡Mensaje Enviado!</h4>
                                    <p class="contact-success-text">Gracias por contactarnos. Te responderemos pronto.</p>
                                </div>
                            }
                            else
                            {
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label class="form-label">Tu nombre *</label>
                                        <InputText @bind-Value="mensaje.Nombre" class="form-input" placeholder="Ej: Carlos Díaz" />
                                        <ValidationMessage For="() => mensaje.Nombre" class="form-error" />
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="form-label">Tu email *</label>
                                        <InputText @bind-Value="mensaje.Email" class="form-input" placeholder="tucorreo@dominio.com" />
                                        <ValidationMessage For="() => mensaje.Email" class="form-error" />
                                    </div>
                                    
                                    <div class="form-group form-group-full">
                                        <label class="form-label">Asunto (opcional)</label>
                                        <InputText @bind-Value="mensaje.Asunto" class="form-input" placeholder="Motivo del mensaje" />
                                    </div>
                                    
                                    <div class="form-group form-group-full">
                                        <label class="form-label">Mensaje *</label>
                                        <InputTextArea @bind-Value="mensaje.Mensaje" class="form-textarea" placeholder="Cuéntanos en qué podemos ayudarte" rows="5" />
                                        <ValidationMessage For="() => mensaje.Mensaje" class="form-error" />
                                    </div>
                                </div>
                                
                                <div class="form-actions">
                                    <button type="submit" class="contact-submit-button" disabled="@enviando">
                                        @if (enviando)
                                        {
                                            <div class="button-loading">
                                                <div class="button-spinner"></div>
                                                Enviando...
                                            </div>
                                        }
                                        else
                                        {
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                            </svg>
                                            @("Enviar Mensaje")
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mensajes Recientes -->
<section class="contact-messages">
    <div class="messages-container">
        <div class="messages-header">
            <h2 class="messages-title">Mensajes Recientes</h2>
            <p class="messages-subtitle">Últimos mensajes recibidos de nuestros clientes</p>
        </div>
        
        @if (cargando)
        {
            <div class="messages-loading">
                <div class="loading-spinner"></div>
                <p class="loading-text">Cargando mensajes...</p>
            </div>
        }
        else if (mensajes.Count == 0)
        {
            <div class="messages-empty">
                <div class="messages-empty-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
                <h3 class="messages-empty-title">No hay mensajes aún</h3>
                <p class="messages-empty-text">Sé el primero en enviarnos un mensaje usando el formulario de arriba.</p>
            </div>
        }
        else
        {
            <div class="messages-grid">
                @foreach (var m in mensajes)
                {
                    <div class="message-card">
                        <div class="message-header">
                            <div class="message-author">
                                <div class="message-avatar">
                                    @m.Nombre.Substring(0, 1).ToUpper()
                                </div>
                                <div class="message-author-info">
                                    <h4 class="message-author-name">@m.Nombre</h4>
                                    <p class="message-author-email">@m.Email</p>
                                </div>
                            </div>
                            <div class="message-date">
                                @m.Fecha.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(m.Asunto))
                        {
                            <div class="message-subject">
                                <strong>Asunto:</strong> @m.Asunto
                            </div>
                        }
                        
                        <div class="message-content">
                            @m.Mensaje
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private CreateContactMessageRequest mensaje = new();
    private bool enviando = false;
    private bool enviado = false;
    private bool cargando = true;
    private List<ContactMessageDto> mensajes = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        mensajes = await Api.ObtenerAsync();
        cargando = false;
    }

    private async Task EnviarAsync()
    {
        if (enviando) return;
        enviado = false;
        enviando = true;
        var ok = await Api.EnviarAsync(mensaje);
        if (ok)
        {
            enviado = true;
            mensaje = new CreateContactMessageRequest();
            mensajes = await Api.ObtenerAsync();
        }
        enviando = false;
    }
}

