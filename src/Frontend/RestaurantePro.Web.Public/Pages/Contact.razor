@page "/contacto"
@inject RestaurantePro.Web.Public.Services.ContactApiService Api
@using RestaurantePro.Web.Public.Models

<HeadContent>
    <link rel="canonical" href="/contacto" />
    <meta property="og:title" content="Contacto - RestaurantePro" />
    <meta property="og:description" content="Envíanos un mensaje o consulta. ¡Estamos para ayudarte!" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/contacto" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Contacto - RestaurantePro" />
    <meta name="twitter:description" content="Envíanos un mensaje o consulta. ¡Estamos para ayudarte!" />
</HeadContent>
<h3>Contacto</h3>

<EditForm Model="mensaje" OnValidSubmit="EnviarAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-card mb-3">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Tu nombre</label>
                <InputText @bind-Value="mensaje.Nombre" class="form-control" placeholder="Ej: Carlos Díaz" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Tu email</label>
                <InputText @bind-Value="mensaje.Email" class="form-control" placeholder="tucorreo@dominio.com" />
                <ValidationMessage For="() => mensaje.Email" />
            </div>
            <div class="col-12">
                <label class="form-label">Asunto (opcional)</label>
                <InputText @bind-Value="mensaje.Asunto" class="form-control" placeholder="Motivo del mensaje" />
            </div>
            <div class="col-12">
                <label class="form-label">Mensaje</label>
                <InputTextArea @bind-Value="mensaje.Mensaje" class="form-control" placeholder="Cuéntanos en qué podemos ayudarte" rows="5" />
            </div>
            <div class="col-12">
                <button class="btn btn-primary" disabled="@enviando">@(enviando ? "Enviando..." : "Enviar")</button>
                @if (enviado)
                {
                    <span class="ms-2 text-success">¡Gracias! Recibimos tu mensaje.</span>
                }
            </div>
        </div>
    </div>
</EditForm>

<h5 class="mt-4">Mensajes recientes (demo)</h5>
@if (cargando)
{
    <p>Cargando...</p>
}
else if (mensajes.Count == 0)
{
    <p>No hay mensajes aún.</p>
}
else
{
    <ul class="list-group">
        @foreach (var m in mensajes)
        {
            <li class="list-group-item">
                <strong>@m.Nombre</strong> <small class="text-muted">(@m.Email) • @m.Fecha.ToLocalTime().ToString("g")</small>
                <div>@m.Asunto</div>
                <div>@m.Mensaje</div>
            </li>
        }
    </ul>
}

@code {
    private CreateContactMessageRequest mensaje = new();
    private bool enviando = false;
    private bool enviado = false;
    private bool cargando = true;
    private List<ContactMessageDto> mensajes = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        mensajes = await Api.ObtenerAsync();
        cargando = false;
    }

    private async Task EnviarAsync()
    {
        if (enviando) return;
        enviado = false;
        enviando = true;
        var ok = await Api.EnviarAsync(mensaje);
        if (ok)
        {
            enviado = true;
            mensaje = new CreateContactMessageRequest();
            mensajes = await Api.ObtenerAsync();
        }
        enviando = false;
    }
}

