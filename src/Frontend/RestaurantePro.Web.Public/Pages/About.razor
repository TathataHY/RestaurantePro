@page "/acerca"
<HeadContent>
    <link rel="canonical" href="/acerca" />
    <meta property="og:title" content="Acerca - RestaurantePro" />
    <meta property="og:description" content="Conoce nuestra historia, valores, horarios y ubicación." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/acerca" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Acerca - RestaurantePro" />
    <meta name="twitter:description" content="Conoce nuestra historia, valores, horarios y ubicación." />
</HeadContent>

<h3>Acerca de RestaurantePro</h3>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <h5>Nuestra historia</h5>
        <p>Desde 2020, combinamos ingredientes frescos con técnicas contemporáneas para crear experiencias memorables. Somos un equipo apasionado por la gastronomía y el servicio.</p>
        <h5>Valores</h5>
        <ul>
            <li>Calidad y frescura</li>
            <li>Respeto por las personas</li>
            <li>Innovación y mejora continua</li>
        </ul>
    </div>
    <div class="col-12 col-md-6">
        <h5>Horarios</h5>
        <ul>
            <li>Lunes a Viernes: 12:00 - 22:00</li>
            <li>Sábado: 12:00 - 23:00</li>
            <li>Domingo: 12:00 - 21:00</li>
        </ul>
        <h5>Ubicación</h5>
        <p>Av. Principal 123, Ciudad Gastronómica</p>
        <div class="ratio ratio-16x9 rounded overflow-hidden border">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3152.168216184338!2d-122.419415!3d37.774929!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80858064d4ed6df9%3A0x9d9fb9b1a6a9b4a3!2sRestaurant!5e0!3m2!1ses!2s!4v1700000000000"
                style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <a class="btn btn-outline-primary" href="/contacto">Contáctanos</a>
    </div>
</div>

<hr class="my-4" />

<h4>Galería</h4>
<div class="row row-cols-2 row-cols-md-3 g-3">
    @foreach (var (url, idx) in fotos.Select((u, i) => (u, i)))
    {
        <div class="col">
            <img src="@url" class="img-fluid rounded shadow-sm" style="cursor:pointer" @onclick="(() => Abrir(idx))" alt="Foto del restaurante @idx" />
        </div>
    }
    @if (fotos.Count == 0)
    {
        <div class="text-muted">Pronto agregaremos fotos de nuestro restaurante.</div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal fade show" style="display:block; background: rgba(0,0,0,.5);" @onclick="Cerrar">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-body p-0">
                    <img src="@fotos[indiceActual]" class="img-fluid w-100" alt="Foto ampliada" />
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button class="btn btn-outline-secondary" @onclick="Anterior">Anterior</button>
                    <button class="btn btn-outline-secondary" @onclick="Siguiente">Siguiente</button>
                    <button class="btn btn-primary" @onclick="Cerrar">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<string> fotos = new()
    {
        "https://images.unsplash.com/photo-1528605248644-14dd04022da1?q=80&w=1470&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1528605248644-79fb6e1ebc6d?q=80&w=1470&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=1470&auto=format&fit=crop"
    };

    private bool mostrarModal = false;
    private int indiceActual = 0;

    private void Abrir(int idx)
    {
        indiceActual = idx;
        mostrarModal = true;
    }

    private void Cerrar()
    {
        mostrarModal = false;
    }

    private void Siguiente()
    {
        if (fotos.Count == 0) return;
        indiceActual = (indiceActual + 1) % fotos.Count;
    }

    private void Anterior()
    {
        if (fotos.Count == 0) return;
        indiceActual = (indiceActual - 1 + fotos.Count) % fotos.Count;
    }
}

