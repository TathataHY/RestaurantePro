@page "/"

<PageTitle>Inicio</PageTitle>
<HeadContent>
    <link rel="canonical" href="/" />
    <meta property="og:title" content="RestaurantePro - Sabores que inspiran" />
    <meta property="og:description" content="Ingredientes frescos, técnica moderna y un servicio que te hará volver." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1200&auto=format&fit=crop" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="RestaurantePro - Sabores que inspiran" />
    <meta name="twitter:description" content="Ingredientes frescos, técnica moderna y un servicio que te hará volver." />
    <meta name="twitter:image" content="https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1200&auto=format&fit=crop" />
    <meta name="description" content="Restaurante con sabores auténticos y experiencias memorables." />
}</HeadContent>

<section class="hero d-flex align-items-center text-white text-center mb-4">
    <div class="container py-5">
        <h1 class="display-5 fw-bold">Sabores que inspiran</h1>
        <p class="col-lg-8 mx-auto lead">Ingredientes frescos, técnica moderna y un servicio que te hará volver.</p>
        <div class="d-inline-flex gap-2">
            <a href="/menu" class="btn btn-primary btn-lg">Ver Menú</a>
            <a href="/resenas" class="btn btn-outline-light btn-lg">Reseñas</a>
            <button class="btn btn-success btn-lg" disabled title="Próximamente">Reservar</button>
        </div>
        <div class="mt-2"><small class="opacity-75">Reservas: función en desarrollo</small></div>
    </div>

    <style>
        .hero {
            min-height: 420px;
            border-radius: .5rem;
            background:
                linear-gradient(rgba(0,0,0,.45), rgba(0,0,0,.45)),
                url('https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1470&auto=format&fit=crop') center/cover no-repeat;
        }
    </style>
</section>

<section class="container mb-5">
    <h3 class="mb-3">Destacados</h3>
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var i in Enumerable.Range(1,3))
        {
            <div class="col">
                <div class="card h-100">
                    <img src="https://picsum.photos/seed/food@i/600/300" class="card-img-top" alt="Plato destacado @i" />
                    <div class="card-body">
                        <h5 class="card-title">Plato destacado @i</h5>
                        <p class="card-text">Una selección especial de nuestro chef, perfecta para compartir.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="container mb-5">
    <h3 class="mb-3">Testimonios</h3>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <p class="card-text">“La mejor experiencia culinaria que he tenido en meses.”</p>
                    <h6 class="card-subtitle text-muted">Ana P.</h6>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <p class="card-text">“Atención espectacular y platos con mucho sabor.”</p>
                    <h6 class="card-subtitle text-muted">Luis M.</h6>
                </div>
            </div>
        </div>
    </div>
</section>
