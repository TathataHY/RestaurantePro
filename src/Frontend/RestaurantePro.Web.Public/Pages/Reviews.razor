@page "/resenas"
@inject RestaurantePro.Web.Public.Services.ReviewsApiService Api
@using RestaurantePro.Web.Public.Models

<PageTitle>Reseñas de Clientes - RestaurantePro</PageTitle>
<HeadContent>
    <link rel="canonical" href="/resenas" />
    <meta property="og:title" content="Reseñas de Clientes - RestaurantePro" />
    <meta property="og:description" content="Lee las opiniones reales de nuestros clientes y comparte tu experiencia. Descubre por qué somos el restaurante favorito de muchos." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/resenas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Reseñas de Clientes - RestaurantePro" />
    <meta name="twitter:description" content="Lee las opiniones reales de nuestros clientes y comparte tu experiencia. Descubre por qué somos el restaurante favorito de muchos." />
</HeadContent>

<!-- Hero Section -->
<section class="reviews-hero">
    <div class="reviews-hero-content">
        <h1 class="reviews-hero-title">Lo Que Dicen Nuestros Clientes</h1>
        <p class="reviews-hero-subtitle">
            Descubre las experiencias reales de quienes nos visitan y comparte la tuya. 
            Tu opinión es muy importante para nosotros.
        </p>
    </div>
</section>

<!-- Formulario de Reseña -->
<section class="reviews-form-section">
    <div class="reviews-container">
        <div class="reviews-form-container">
            <div class="reviews-form-card">
                <div class="reviews-form-header">
                    <h2 class="reviews-form-title">Comparte Tu Experiencia</h2>
                    <p class="reviews-form-subtitle">Tu opinión nos ayuda a mejorar cada día</p>
                </div>
                
                <div class="reviews-form-body">
                    <EditForm Model="nuevo" OnValidSubmit="EnviarAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />
                        
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Tu nombre *</label>
                                <InputText @bind-Value="nuevo.Nombre" class="form-input" placeholder="Ej: Ana Pérez" />
                                <ValidationMessage For="@(() => nuevo.Nombre)" class="form-error" />
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Valoración *</label>
                                <div class="rating-input">
                                    <InputNumber @bind-Value="nuevo.Valoracion" class="form-input" placeholder="1 a 5" />
                                    <div class="rating-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <button type="button" class="star @(i <= nuevo.Valoracion ? "active" : "")" @onclick="() => nuevo.Valoracion = i">
                                                <svg fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="form-hint">Usa un valor entre 1 y 5</div>
                                <ValidationMessage For="@(() => nuevo.Valoracion)" class="form-error" />
                            </div>
                            
                            <div class="form-group full-width">
                                <label class="form-label">Tu comentario *</label>
                                <InputTextArea @bind-Value="nuevo.Comentario" class="form-textarea" placeholder="Cuéntanos sobre tu experiencia..." rows="4" />
                                <ValidationMessage For="@(() => nuevo.Comentario)" class="form-error" />
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button class="reviews-submit-button" disabled="@enviando">
                                @if (enviando)
                                {
                                    <div class="button-loading">
                                        <div class="button-spinner"></div>
                                        Enviando...
                                    </div>
                                }
                                else
                                {
                                    <span>Enviar Reseña</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lista de Reseñas -->
<section class="reviews-list-section">
    <div class="reviews-container">
        @if (cargando)
        {
            <div class="reviews-loading">
                <div class="loading-spinner"></div>
                <p class="loading-text">Cargando reseñas...</p>
            </div>
        }
        else if (resenas.Count == 0)
        {
            <div class="reviews-empty">
                <div class="reviews-empty-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
                <h3 class="reviews-empty-title">Aún no hay reseñas</h3>
                <p class="reviews-empty-text">¡Sé el primero en compartir tu experiencia con nosotros!</p>
            </div>
        }
        else
        {
            <div class="reviews-header">
                <h2 class="reviews-list-title">Reseñas de Nuestros Clientes</h2>
                <p class="reviews-list-subtitle">@resenas.Count reseña@(resenas.Count != 1 ? "s" : "")</p>
            </div>
            
            <div class="reviews-grid">
                @foreach (var r in resenas)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="review-author">
                                <div class="review-avatar">
                                    @r.Nombre.Substring(0, 1).ToUpper()
                                </div>
                                <div class="review-author-info">
                                    <h4 class="review-author-name">@r.Nombre</h4>
                                    <div class="review-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <svg class="star @(i <= r.Valoracion ? "active" : "")" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                            </svg>
                                        }
                                        <span class="review-rating-text">@r.Valoracion/5</span>
                                    </div>
                                </div>
                            </div>
                            <div class="review-date">
                                @r.Fecha.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                        </div>
                        
                        <div class="review-content">
                            <p class="review-comment">@r.Comentario</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<ReviewDto> resenas = new();
    private bool cargando = true;
    private bool enviando = false;
    private CreateReviewRequest nuevo = new() { Valoracion = 5 };

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        resenas = await Api.ObtenerAsync();
        cargando = false;
    }

    private async Task EnviarAsync()
    {
        if (enviando) return;
        enviando = true;
        var ok = await Api.CrearAsync(nuevo);
        if (ok)
        {
            nuevo = new CreateReviewRequest { Valoracion = 5 };
            resenas = await Api.ObtenerAsync();
        }
        enviando = false;
    }
}

