@page "/reservas"

<PageTitle>Reservas - RestaurantePro</PageTitle>
<HeadContent>
    <link rel="canonical" href="/reservas" />
    <meta property="og:title" content="Reservas - RestaurantePro" />
    <meta property="og:description" content="Reserva tu mesa en RestaurantePro. Disponemos de múltiples opciones para hacer tu reserva: teléfono, WhatsApp, email o formulario en línea." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="/reservas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Reservas - RestaurantePro" />
    <meta name="twitter:description" content="Reserva tu mesa en RestaurantePro. Disponemos de múltiples opciones para hacer tu reserva: teléfono, WhatsApp, email o formulario en línea." />
</HeadContent>

<!-- Hero Section -->
<section class="reservations-hero">
    <div class="reservations-hero-content">
        <h1 class="reservations-hero-title">Reserva tu Mesa</h1>
        <p class="reservations-hero-subtitle">
            Garantiza tu lugar en una experiencia culinaria excepcional. Reserva ahora y prepárate para disfrutar.
        </p>
    </div>
</section>

<!-- Opciones de Reserva -->
<section class="reservations-options">
    <div class="reservations-container">
        <div class="reservations-grid">
            <!-- Formulario de Reserva -->
            <div class="reservation-form-container">
                <div class="reservation-form-card">
                    <div class="reservation-form-header">
                        <h2 class="reservation-form-title">Reserva en Línea</h2>
                        <p class="reservation-form-subtitle">Completa el formulario y te confirmaremos tu reserva</p>
                    </div>
                    
                    <form class="reservation-form">
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Nombre completo *</label>
                                <input type="text" class="form-input" placeholder="Tu nombre completo" required />
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Teléfono *</label>
                                <input type="tel" class="form-input" placeholder="+1 (555) 123-4567" required />
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Email *</label>
                                <input type="email" class="form-input" placeholder="tu@email.com" required />
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Fecha *</label>
                                <input type="date" class="form-input" required />
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Hora *</label>
                                <select class="form-select" required>
                                    <option value="">Selecciona una hora</option>
                                    <option value="12:00">12:00 PM</option>
                                    <option value="12:30">12:30 PM</option>
                                    <option value="13:00">1:00 PM</option>
                                    <option value="13:30">1:30 PM</option>
                                    <option value="14:00">2:00 PM</option>
                                    <option value="14:30">2:30 PM</option>
                                    <option value="19:00">7:00 PM</option>
                                    <option value="19:30">7:30 PM</option>
                                    <option value="20:00">8:00 PM</option>
                                    <option value="20:30">8:30 PM</option>
                                    <option value="21:00">9:00 PM</option>
                                    <option value="21:30">9:30 PM</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Número de personas *</label>
                                <select class="form-select" required>
                                    <option value="">Selecciona</option>
                                    <option value="1">1 persona</option>
                                    <option value="2">2 personas</option>
                                    <option value="3">3 personas</option>
                                    <option value="4">4 personas</option>
                                    <option value="5">5 personas</option>
                                    <option value="6">6 personas</option>
                                    <option value="7">7 personas</option>
                                    <option value="8">8 personas</option>
                                    <option value="9">9 personas</option>
                                    <option value="10">10+ personas</option>
                                </select>
                            </div>
                            
                            <div class="form-group form-group-full">
                                <label class="form-label">Ocasión especial (opcional)</label>
                                <select class="form-select">
                                    <option value="">Selecciona una ocasión</option>
                                    <option value="cumpleanos">Cumpleaños</option>
                                    <option value="aniversario">Aniversario</option>
                                    <option value="cita">Cita romántica</option>
                                    <option value="negocios">Reunión de negocios</option>
                                    <option value="familia">Reunión familiar</option>
                                    <option value="otra">Otra</option>
                                </select>
                            </div>
                            
                            <div class="form-group form-group-full">
                                <label class="form-label">Comentarios adicionales</label>
                                <textarea class="form-textarea" placeholder="Alergias, preferencias especiales, etc." rows="3"></textarea>
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="submit" class="reservation-submit-button">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                Confirmar Reserva
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Información de Contacto -->
            <div class="reservation-info">
                <div class="reservation-info-card">
                    <h2 class="reservation-info-title">Otras Formas de Reservar</h2>
                    <p class="reservation-info-subtitle">Prefieres hablar con nosotros directamente? Estamos aquí para ayudarte</p>
                    
                    <div class="contact-methods">
                        <div class="contact-method">
                            <div class="contact-method-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                            </div>
                            <div class="contact-method-content">
                                <h3 class="contact-method-title">Teléfono</h3>
                                <p class="contact-method-text">+1 (555) 123-4567</p>
                                <p class="contact-method-subtext">Lunes a Domingo: 9:00 - 22:00</p>
                                <a href="tel:+15551234567" class="contact-method-link">Llamar ahora</a>
                            </div>
                        </div>
                        
                        <div class="contact-method">
                            <div class="contact-method-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                </svg>
                            </div>
                            <div class="contact-method-content">
                                <h3 class="contact-method-title">WhatsApp</h3>
                                <p class="contact-method-text">+1 (555) 123-4567</p>
                                <p class="contact-method-subtext">Respuesta inmediata</p>
                                <a href="https://wa.me/15551234567?text=Hola%20quiero%20reservar%20una%20mesa" target="_blank" rel="noopener" class="contact-method-link">Enviar mensaje</a>
                            </div>
                        </div>
                        
                        <div class="contact-method">
                            <div class="contact-method-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <div class="contact-method-content">
                                <h3 class="contact-method-title">Email</h3>
                                <p class="contact-method-text">reservas@restaurantepro.com</p>
                                <p class="contact-method-subtext">Respuesta en 2 horas</p>
                                <a href="mailto:reservas@restaurantepro.com" class="contact-method-link">Enviar email</a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Información de Horarios -->
                <div class="hours-info-card">
                    <h3 class="hours-title">Horarios de Atención</h3>
                    <div class="hours-list">
                        <div class="hours-item">
                            <span class="hours-days">Lunes - Viernes</span>
                            <span class="hours-time">12:00 - 22:00</span>
                        </div>
                        <div class="hours-item">
                            <span class="hours-days">Sábado</span>
                            <span class="hours-time">12:00 - 23:00</span>
                        </div>
                        <div class="hours-item">
                            <span class="hours-days">Domingo</span>
                            <span class="hours-time">12:00 - 21:00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Eventos Especiales -->
<section class="special-events">
    <div class="events-container">
        <div class="events-content">
            <div class="events-text">
                <h2 class="events-title">Eventos y Celebraciones</h2>
                <p class="events-description">
                    ¿Tienes una ocasión especial? Cumpleaños, aniversarios, propuestas de matrimonio, 
                    eventos corporativos o cualquier celebración merece un trato especial.
                </p>
                <ul class="events-features">
                    <li>Menús personalizados para tu evento</li>
                    <li>Decoración especial según la ocasión</li>
                    <li>Espacios privados disponibles</li>
                    <li>Coordinación completa del evento</li>
                </ul>
                <a href="/contacto" class="events-button">Consultar Evento</a>
            </div>
            <div class="events-image">
                <img src="https://images.unsplash.com/photo-1519167758481-83f1426d4b0a?q=80&w=1470&auto=format&fit=crop" alt="Evento especial en el restaurante" class="events-img" />
            </div>
        </div>
    </div>
</section>

<!-- Ubicación -->
<section class="reservation-location">
    <div class="location-container">
        <div class="location-header">
            <h2 class="location-title">Nuestra Ubicación</h2>
            <p class="location-subtitle">Encuéntranos en el corazón de la ciudad</p>
        </div>
        
        <div class="location-content">
            <div class="location-info">
                <div class="location-details">
                    <h3 class="location-address-title">Dirección</h3>
                    <p class="location-address">123 Avenida Gastronómica<br>Ciudad Sabrosa, 12345</p>
                    
                    <h3 class="location-parking-title">Estacionamiento</h3>
                    <p class="location-parking">Valet parking disponible<br>Estacionamiento gratuito en la calle</p>
                    
                    <h3 class="location-transport-title">Transporte Público</h3>
                    <p class="location-transport">Metro: Línea 2, Estación Gastronómica<br>Autobús: Líneas 15, 23, 45</p>
                </div>
            </div>
            
            <div class="location-map">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3152.168216184338!2d-122.419415!3d37.774929!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80858064d4ed6df9%3A0x9d9fb9b1a6a9b4a3!2sRestaurant!5e0!3m2!1ses!2s!4v1700000000000"
                    class="map-iframe"
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</section>


