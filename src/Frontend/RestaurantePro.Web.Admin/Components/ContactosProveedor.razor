@using RestaurantePro.Web.Admin.Models

<div class="modal fade @(MostrarModal ? "show" : "")" style="display: @(MostrarModal ? "block" : "none")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span class="oi oi-people" aria-hidden="true"></span>
                    Contactos de @Proveedor?.Nombre
                </h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            
            <div class="modal-body">
                @if (Proveedor != null)
                {
                    <!-- Información del Proveedor -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-primary">Información del Proveedor</h6>
                                            <p class="mb-1"><strong>Nombre:</strong> @Proveedor.Nombre</p>
                                            @if (!string.IsNullOrEmpty(Proveedor.Ruc))
                                            {
                                                <p class="mb-1"><strong>RUC:</strong> @Proveedor.Ruc</p>
                                            }
                                            @if (!string.IsNullOrEmpty(Proveedor.Ciudad))
                                            {
                                                <p class="mb-1"><strong>Ciudad:</strong> @Proveedor.Ciudad</p>
                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-primary">Estadísticas</h6>
                                            <p class="mb-1"><strong>Total Contactos:</strong> @Proveedor.TotalContactos</p>
                                            <p class="mb-1"><strong>Total Órdenes:</strong> @Proveedor.TotalOrdenesCompra</p>
                                            <p class="mb-0"><strong>Monto Total:</strong> @Proveedor.MontoTotalCompras.ToString("C")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Botón Agregar Contacto -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <button class="btn btn-primary" @onclick="AgregarContacto">
                                <span class="oi oi-plus" aria-hidden="true"></span>
                                Agregar Contacto
                            </button>
                        </div>
                    </div>
                    
                    <!-- Lista de Contactos -->
                    @if (Contactos != null && Contactos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Cargo</th>
                                        <th>Teléfono</th>
                                        <th>Email</th>
                                        <th>Celular</th>
                                        <th>Principal</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contacto in Contactos)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3">
                                                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                             style="width: 35px; height: 35px; font-size: 1rem;">
                                                            @contacto.Nombre.Substring(0, 1).ToUpper()
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">@contacto.Nombre @contacto.Apellido</div>
                                                        <small class="text-muted">
                                                            Creado: @contacto.FechaCreacion.ToString("dd/MM/yyyy")
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(contacto.Cargo))
                                                {
                                                    <span class="badge bg-secondary">@contacto.Cargo</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin cargo</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(contacto.Telefono))
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="oi oi-phone me-1" aria-hidden="true"></span>
                                                        <span>@contacto.Telefono</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin teléfono</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(contacto.Email))
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="oi oi-envelope-closed me-1" aria-hidden="true"></span>
                                                        <span>@contacto.Email</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin email</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(contacto.Celular))
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="oi oi-phone me-1" aria-hidden="true"></span>
                                                        <span>@contacto.Celular</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin celular</span>
                                                }
                                            </td>
                                            <td>
                                                @if (contacto.EsContactoPrincipal)
                                                {
                                                    <span class="badge bg-warning">
                                                        <span class="oi oi-star" aria-hidden="true"></span>
                                                        Principal
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark">Secundario</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-warning" 
                                                            @onclick="@(() => EditarContacto(contacto))"
                                                            title="Editar contacto">
                                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                                            @onclick="@(() => EliminarContacto(contacto))"
                                                            title="Eliminar contacto">
                                                        <span class="oi oi-trash" aria-hidden="true"></span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="text-muted">
                                <span class="oi oi-people" style="font-size: 3rem;" aria-hidden="true"></span>
                                <h5 class="mt-3">No hay contactos</h5>
                                <p>Este proveedor no tiene contactos registrados.</p>
                                <button class="btn btn-primary" @onclick="AgregarContacto">
                                    <span class="oi oi-plus" aria-hidden="true"></span>
                                    Agregar Primer Contacto
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                    <span class="oi oi-x" aria-hidden="true"></span>
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Formulario de Contacto -->
@if (MostrarFormularioContacto)
{
    <div class="modal fade show" style="display: block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="oi oi-person" aria-hidden="true"></span>
                        @(ContactoActual?.Id == Guid.Empty ? "Nuevo Contacto" : "Editar Contacto")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormularioContacto"></button>
                </div>
                
                <EditForm Model="ContactoActual" OnValidSubmit="GuardarContacto">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="contactoNombre" class="form-label">Nombre *</label>
                                    <InputText id="contactoNombre" class="form-control" @bind-Value="ContactoActual.Nombre" placeholder="Nombre del contacto" />
                                    <ValidationMessage For="@(() => ContactoActual.Nombre)" class="text-danger" />
                                </div>
                                
                                <div class="mb-3">
                                    <label for="contactoApellido" class="form-label">Apellido</label>
                                    <InputText id="contactoApellido" class="form-control" @bind-Value="ContactoActual.Apellido" placeholder="Apellido del contacto" />
                                    <ValidationMessage For="@(() => ContactoActual.Apellido)" class="text-danger" />
                                </div>
                                
                                <div class="mb-3">
                                    <label for="contactoCargo" class="form-label">Cargo</label>
                                    <InputText id="contactoCargo" class="form-control" @bind-Value="ContactoActual.Cargo" placeholder="Cargo o posición" />
                                    <ValidationMessage For="@(() => ContactoActual.Cargo)" class="text-danger" />
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="contactoTelefono" class="form-label">Teléfono</label>
                                    <InputText id="contactoTelefono" class="form-control" @bind-Value="ContactoActual.Telefono" placeholder="Teléfono fijo" />
                                    <ValidationMessage For="@(() => ContactoActual.Telefono)" class="text-danger" />
                                </div>
                                
                                <div class="mb-3">
                                    <label for="contactoEmail" class="form-label">Email</label>
                                    <InputText id="contactoEmail" class="form-control" @bind-Value="ContactoActual.Email" placeholder="correo@ejemplo.com" />
                                    <ValidationMessage For="@(() => ContactoActual.Email)" class="text-danger" />
                                </div>
                                
                                <div class="mb-3">
                                    <label for="contactoCelular" class="form-label">Celular</label>
                                    <InputText id="contactoCelular" class="form-control" @bind-Value="ContactoActual.Celular" placeholder="Número de celular" />
                                    <ValidationMessage For="@(() => ContactoActual.Celular)" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox id="esPrincipal" class="form-check-input" @bind-Value="ContactoActual.EsContactoPrincipal" />
                                    <label class="form-check-label" for="esPrincipal">
                                        Marcar como contacto principal
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarFormularioContacto">
                            <span class="oi oi-x" aria-hidden="true"></span>
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@GuardandoContacto">
                            @if (GuardandoContacto)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span class="oi oi-check" aria-hidden="true"></span>
                                <span>@(ContactoActual?.Id == Guid.Empty ? "Crear" : "Actualizar")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (MostrarModal || MostrarFormularioContacto)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public ProveedorDto? Proveedor { get; set; }
    [Parameter] public List<ContactoProveedorDto>? Contactos { get; set; }
    [Parameter] public bool MostrarModal { get; set; } = false;
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback<ContactoProveedorDto> OnAgregarContacto { get; set; }
    [Parameter] public EventCallback<ContactoProveedorDto> OnEditarContacto { get; set; }
    [Parameter] public EventCallback<ContactoProveedorDto> OnEliminarContacto { get; set; }

    private bool MostrarFormularioContacto = false;
    private ContactoProveedorDto ContactoActual = new();
    private bool GuardandoContacto = false;

    private async Task CerrarModal()
    {
        await OnCerrar.InvokeAsync();
    }

    private void AgregarContacto()
    {
        ContactoActual = new ContactoProveedorDto
        {
            Id = Guid.Empty,
            ProveedorId = Proveedor?.Id ?? Guid.Empty,
            ProveedorNombre = Proveedor?.Nombre
        };
        MostrarFormularioContacto = true;
    }

    private void EditarContacto(ContactoProveedorDto contacto)
    {
        ContactoActual = new ContactoProveedorDto
        {
            Id = contacto.Id,
            Nombre = contacto.Nombre,
            Apellido = contacto.Apellido,
            Cargo = contacto.Cargo,
            Telefono = contacto.Telefono,
            Email = contacto.Email,
            Celular = contacto.Celular,
            EsContactoPrincipal = contacto.EsContactoPrincipal,
            ProveedorId = Proveedor?.Id ?? Guid.Empty,
            ProveedorNombre = Proveedor?.Nombre
        };
        MostrarFormularioContacto = true;
    }

    private async Task GuardarContacto()
    {
        GuardandoContacto = true;
        
        if (ContactoActual.Id == Guid.Empty)
        {
            await OnAgregarContacto.InvokeAsync(ContactoActual);
        }
        else
        {
            await OnEditarContacto.InvokeAsync(ContactoActual);
        }
        
        GuardandoContacto = false;
        MostrarFormularioContacto = false;
    }

    private void CerrarFormularioContacto()
    {
        MostrarFormularioContacto = false;
        ContactoActual = new();
    }

    private async Task EliminarContacto(ContactoProveedorDto contacto)
    {
        await OnEliminarContacto.InvokeAsync(contacto);
    }
}
