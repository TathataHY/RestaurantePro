@using RestaurantePro.Web.Admin.Auth
@using RestaurantePro.Web.Admin.Services
@inject IJSRuntime JSRuntime
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IServiceProvider ServiceProvider

<header class="modern-header">
    <div class="header-container">
        <!-- Botón de toggle del sidebar -->
        <button class="sidebar-toggle" @onclick="ToggleSidebar" title="Alternar menú">
            <span class="material-symbols-outlined">menu</span>
        </button>

        <!-- Logo y título -->
        <div class="header-brand">
            <span class="header-logo material-symbols-outlined">restaurant_menu</span>
            <h1 class="header-title">RestaurantePro</h1>
        </div>

        <!-- Controles del header -->
        <div class="header-controls">
            <!-- Información del usuario -->
            @if (isAuthenticated)
            {
                <div class="user-info">
                    <div class="user-avatar">
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <span class="user-initial">@userName.Substring(0, 1).ToUpper()</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">person</span>
                        }
                    </div>
                    <div class="user-details">
                        <span class="user-name">@userName</span>
                        <span class="user-role">@GetUserRole()</span>
                    </div>
                </div>

                <!-- Menú de usuario -->
                <div class="user-menu">
                    <button class="user-menu-toggle" @onclick="ToggleUserMenu">
                        <span class="material-symbols-outlined">more_vert</span>
                    </button>
                    
                    @* El dropdown ahora se crea via JavaScript portal *@
                </div>
            }
            else
            {
                <a href="login" class="login-link">
                    <span class="material-symbols-outlined">login</span>
                    Iniciar Sesión
                </a>
            }
        </div>
    </div>
</header>

@code {
    private bool isAuthenticated = false;
    private string userName = string.Empty;
    private bool showUserMenu = false;
    private string userRole = string.Empty;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Cargar estado de autenticación
        await LoadAuthState();
    }

    private async Task LoadAuthState()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        userName = isAuthenticated ? user.Identity?.Name ?? "" : string.Empty;
        
        // Obtener rol del usuario
        if (isAuthenticated)
        {
            userRole = user.IsInRole("Administrador") ? "Administrador" :
                      user.IsInRole("Gerente") ? "Gerente" :
                      user.IsInRole("Mesero") ? "Mesero" :
                      user.IsInRole("Cocinero") ? "Cocinero" : "Usuario";
        }
    }


    private async Task ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        
        if (showUserMenu)
        {
            // Esperar a que el DOM se actualice
            await Task.Delay(10);
            await JSRuntime.InvokeVoidAsync("createUserMenuPortal");
        }
        else
        {
            // Eliminar el portal cuando se cierra
            await JSRuntime.InvokeVoidAsync("removeUserMenuPortal");
        }
    }

    private async Task Logout()
    {
        // Cerrar el menú de usuario
        showUserMenu = false;
        
        // Limpiar autenticación
        await AuthState.LogoutAsync();
        
        // Forzar recarga de la página para limpiar completamente el estado
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private string GetUserRole()
    {
        return userRole;
    }

    private async Task ToggleSidebar()
    {
        try
        {
            Console.WriteLine("ToggleSidebar called");
            var result = await JSRuntime.InvokeAsync<bool>("toggleSidebar");
            Console.WriteLine($"toggleSidebar JavaScript executed, result: {result}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calling toggleSidebar: {ex.Message}");
        }
    }

    // Método estático que puede ser llamado desde JavaScript
    [JSInvokable]
    public static async Task LogoutFromHeader()
    {
        await LogoutService.LogoutAsync();
    }

    // Cerrar menú al hacer clic fuera y cargar estado del sidebar
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cargar estado inicial del sidebar
            await JSRuntime.InvokeVoidAsync("loadSidebarState");

            // Portal del menú de usuario directamente en el body
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.createUserMenuPortal = function() {
                    // Eliminar portal existente si hay uno
                    const existingPortal = document.getElementById('user-menu-portal');
                    if (existingPortal) {
                        existingPortal.remove();
                    }

                    // Crear el portal
                    const portal = document.createElement('div');
                    portal.id = 'user-menu-portal';
                    portal.style.position = 'fixed';
                    portal.style.zIndex = '99999999';
                    portal.style.top = '0';
                    portal.style.left = '0';
                    portal.style.width = '100%';
                    portal.style.height = '100%';
                    portal.style.pointerEvents = 'none';
                    
                    // Crear el dropdown
                    const dropdown = document.createElement('div');
                    dropdown.className = 'user-menu-portal-dropdown';
                    dropdown.style.position = 'absolute';
                    dropdown.style.background = 'white';
                    dropdown.style.border = '1px solid #e5e7eb';
                    dropdown.style.borderRadius = '8px';
                    dropdown.style.boxShadow = '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)';
                    dropdown.style.minWidth = '12rem';
                    dropdown.style.padding = '0.5rem 0';
                    dropdown.style.pointerEvents = 'auto';
                    
                    // Posicionar el dropdown
                    const userMenu = document.querySelector('.user-menu');
                    if (userMenu) {
                        const rect = userMenu.getBoundingClientRect();
                        dropdown.style.top = (rect.bottom + 8) + 'px';
                        dropdown.style.right = (window.innerWidth - rect.right) + 'px';
                    }
                    
                    // Agregar contenido del menú
                    dropdown.innerHTML = `
                        <a href='#' class='user-menu-item' style='display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #374151; text-decoration: none; font-size: 0.875rem;'>
                            <span class='material-symbols-outlined'>person</span>
                            Mi Perfil
                        </a>
                        <a href='#' class='user-menu-item' style='display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #374151; text-decoration: none; font-size: 0.875rem;'>
                            <span class='material-symbols-outlined'>settings</span>
                            Configuración
                        </a>
                        <div style='height: 1px; background: #e5e7eb; margin: 0.5rem 0;'></div>
                        <button id='logout-button' class='user-menu-item logout-item' style='display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #dc2626; text-decoration: none; font-size: 0.875rem; background: none; border: none; width: 100%; text-align: left; cursor: pointer;'>
                            <span class='material-symbols-outlined'>logout</span>
                            Cerrar Sesión
                        </button>
                    `;
                    
        // Agregar event listener para el botón de logout
        const logoutButton = dropdown.querySelector('#logout-button');
        if (logoutButton) {
            logoutButton.addEventListener('click', async function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                try {
                    // Limpiar localStorage inmediatamente
                    if (window.authPersistence && window.authPersistence.clearAuth) {
                        window.authPersistence.clearAuth();
                        console.log('LocalStorage limpiado');
                    }
                    
                    // Llamar al método Logout de Blazor usando DotNet
                    await DotNet.invokeMethodAsync('RestaurantePro.Web.Admin', 'LogoutFromHeader');
                    
                    // Esperar un momento para que se complete el logout
                    await new Promise(resolve => setTimeout(resolve, 200));
                    
                    // Redirigir a la página de login usando JavaScript
                    window.location.href = '/login';
                } catch (error) {
                    console.error('Error durante el logout:', error);
                    // En caso de error, limpiar localStorage y redirigir de todas formas
                    if (window.authPersistence && window.authPersistence.clearAuth) {
                        window.authPersistence.clearAuth();
                    }
                    window.location.href = '/login';
                }
                
                // Cerrar el menú
                window.removeUserMenuPortal();
            });
        }
                    
                    // Agregar hover effects
                    dropdown.querySelectorAll('.user-menu-item').forEach(item => {
                        item.addEventListener('mouseenter', () => {
                            item.style.backgroundColor = '#f3f4f6';
                        });
                        item.addEventListener('mouseleave', () => {
                            item.style.backgroundColor = 'transparent';
                        });
                    });
                    
                    portal.appendChild(dropdown);
                    document.body.appendChild(portal);
                    
                    // Cerrar al hacer clic fuera
                    portal.addEventListener('click', function(e) {
                        if (e.target === portal) {
                            window.removeUserMenuPortal();
                        }
                    });
                };

                window.removeUserMenuPortal = function() {
                    const portal = document.getElementById('user-menu-portal');
                    if (portal) {
                        portal.remove();
                    }
                };
            ");
        }
    }
}
