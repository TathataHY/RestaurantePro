@using RestaurantePro.Web.Admin.Auth
@inject IJSRuntime JSRuntime
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Nav

<header class="modern-header">
    <div class="header-container">
        <!-- Logo y título -->
        <div class="header-brand">
            <span class="header-logo material-symbols-outlined">restaurant_menu</span>
            <h1 class="header-title">RestaurantePro</h1>
        </div>

        <!-- Controles del header -->
        <div class="header-controls">
            <!-- Información del usuario -->
            @if (isAuthenticated)
            {
                <div class="user-info">
                    <div class="user-avatar">
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <span class="user-initial">@userName.Substring(0, 1).ToUpper()</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">person</span>
                        }
                    </div>
                    <div class="user-details">
                        <span class="user-name">@userName</span>
                        <span class="user-role">@GetUserRole()</span>
                    </div>
                </div>

                <!-- Menú de usuario -->
                <div class="user-menu">
                    <button class="user-menu-toggle" @onclick="ToggleUserMenu">
                        <span class="material-symbols-outlined">more_vert</span>
                    </button>
                    
                    @if (showUserMenu)
                    {
                        <div class="user-menu-dropdown">
                            <a href="#" class="user-menu-item">
                                <span class="material-symbols-outlined">person</span>
                                Mi Perfil
                            </a>
                            <a href="#" class="user-menu-item">
                                <span class="material-symbols-outlined">settings</span>
                                Configuración
                            </a>
                            <div class="user-menu-divider"></div>
                            <button class="user-menu-item logout-item" @onclick="Logout">
                                <span class="material-symbols-outlined">logout</span>
                                Cerrar Sesión
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <a href="login" class="login-link">
                    <span class="material-symbols-outlined">login</span>
                    Iniciar Sesión
                </a>
            }
        </div>
    </div>
</header>

@code {
    private bool isAuthenticated = false;
    private string userName = string.Empty;
    private bool showUserMenu = false;
    private string userRole = string.Empty;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Cargar estado de autenticación
        await LoadAuthState();
    }

    private async Task LoadAuthState()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        userName = isAuthenticated ? user.Identity?.Name ?? "" : string.Empty;
        
        // Obtener rol del usuario
        if (isAuthenticated)
        {
            userRole = user.IsInRole("Administrador") ? "Administrador" :
                      user.IsInRole("Gerente") ? "Gerente" :
                      user.IsInRole("Mesero") ? "Mesero" :
                      user.IsInRole("Cocinero") ? "Cocinero" : "Usuario";
        }
    }


    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task Logout()
    {
        // Cerrar el menú de usuario
        showUserMenu = false;
        
        // Limpiar autenticación
        await AuthState.LogoutAsync();
        
        // Forzar recarga de la página para limpiar completamente el estado
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private string GetUserRole()
    {
        return userRole;
    }

    // Cerrar menú al hacer clic fuera
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                document.addEventListener('click', function(e) {
                    const userMenu = document.querySelector('.user-menu');
                    const userMenuDropdown = document.querySelector('.user-menu-dropdown');
                    
                    if (userMenu && userMenuDropdown && !userMenu.contains(e.target)) {
                        userMenuDropdown.style.display = 'none';
                    }
                });
            ");
        }
    }
}
