@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Services
@inject FacturasApiService FacturasApi
@inject ClientesApiService ClientesApi
@inject MesasApiService MesasApi
@inject UsuariosApiService UsuariosApi

<div class="card">
    <div class="card-header">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="oi oi-magnifying-glass"></i> Filtros de Búsqueda
        </h6>
    </div>
    <div class="card-body">
        <EditForm Model="Filtros" OnValidSubmit="AplicarFiltros">
            <DataAnnotationsValidator />
            
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Buscar</label>
                        <InputText @bind-Value="Filtros.Busqueda" class="form-control" placeholder="Número, cliente, mesero..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <InputSelect @bind-Value="Filtros.Estado" class="form-select">
                            <option value="">Todos los estados</option>
                            @if (estados != null)
                            {
                                @foreach (var estado in estados)
                                {
                                    <option value="@estado">@estado</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Tipo de Pago</label>
                        <InputSelect @bind-Value="Filtros.TipoPago" class="form-select">
                            <option value="">Todos los tipos</option>
                            @if (tiposPago != null)
                            {
                                @foreach (var tipo in tiposPago)
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <InputSelect @bind-Value="Filtros.ClienteId" class="form-select">
                            <option value="">Todos los clientes</option>
                            @if (clientes != null)
                            {
                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.Id">@cliente.NombreCompleto</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Mesa</label>
                        <InputSelect @bind-Value="Filtros.MesaId" class="form-select">
                            <option value="">Todas las mesas</option>
                            @if (mesas != null)
                            {
                                @foreach (var mesa in mesas)
                                {
                                    <option value="@mesa.Id">Mesa @mesa.Id - @mesa.NombreCliente</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Mesero</label>
                        <InputSelect @bind-Value="Filtros.MeseroId" class="form-select">
                            <option value="">Todos los meseros</option>
                            @if (meseros != null)
                            {
                                @foreach (var mesero in meseros)
                                {
                                    <option value="@mesero.Id">@mesero.NombreCompleto</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Método de Pago</label>
                        <InputSelect @bind-Value="Filtros.MetodoPago" class="form-select">
                            <option value="">Todos los métodos</option>
                            @if (metodosPago != null)
                            {
                                @foreach (var metodo in metodosPago)
                                {
                                    <option value="@metodo">@metodo</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Fecha Inicio</label>
                        <InputDate @bind-Value="Filtros.FechaInicio" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Fecha Fin</label>
                        <InputDate @bind-Value="Filtros.FechaFin" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Monto Mínimo</label>
                        <InputNumber @bind-Value="Filtros.MontoMinimo" class="form-control" placeholder="0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Monto Máximo</label>
                        <InputNumber @bind-Value="Filtros.MontoMaximo" class="form-control" placeholder="10000" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Ordenar Por</label>
                        <InputSelect @bind-Value="Filtros.OrdenarPor" class="form-select">
                            <option value="FechaEmision">Fecha de Emisión</option>
                            <option value="NumeroFactura">Número de Factura</option>
                            <option value="ClienteNombre">Cliente</option>
                            <option value="Total">Total</option>
                            <option value="Estado">Estado</option>
                            <option value="TipoPago">Tipo de Pago</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <InputSelect @bind-Value="Filtros.DireccionOrden" class="form-select">
                            <option value="desc">Descendente</option>
                            <option value="asc">Ascendente</option>
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="esFacturaElectronica" class="form-check-input" />
                        <label class="form-check-label">
                            Solo Facturas Electrónicas
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                        <i class="oi oi-reload"></i> Limpiar
                    </button>
                    <button type="button" class="btn btn-outline-info" @onclick="FiltrosRapidos">
                        <i class="oi oi-clock"></i> Últimos 7 días
                    </button>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary" disabled="@aplicando">
                        @if (aplicando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="oi oi-magnifying-glass"></i> Buscar
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public FacturaFiltrosDto Filtros { get; set; } = new();
    [Parameter] public EventCallback<FacturaFiltrosDto> OnFiltrosAplicados { get; set; }
    [Parameter] public bool Aplicando { get; set; }

    private List<string>? estados;
    private List<string>? tiposPago;
    private List<string>? metodosPago;
    private List<ClienteDto>? clientes;
    private List<MesaDto>? mesas;
    private List<UsuarioDto>? meseros;
    private bool aplicando => Aplicando;
    private bool esFacturaElectronica = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        CargarMeseros(); // Método síncrono
        await Task.WhenAll(
            CargarEstados(),
            CargarTiposPago(),
            CargarMetodosPago(),
            CargarClientes(),
            CargarMesas()
        );
    }

    private async Task CargarEstados()
    {
        try
        {
            estados = await FacturasApi.ObtenerEstadosAsync() ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar estados: {ex.Message}");
            estados = new List<string>();
        }
    }

    private async Task CargarTiposPago()
    {
        try
        {
            tiposPago = await FacturasApi.ObtenerTiposPagoAsync() ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar tipos de pago: {ex.Message}");
            tiposPago = new List<string>();
        }
    }

    private async Task CargarMetodosPago()
    {
        try
        {
            metodosPago = await FacturasApi.ObtenerMetodosPagoAsync() ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar métodos de pago: {ex.Message}");
            metodosPago = new List<string>();
        }
    }

    private async Task CargarClientes()
    {
        try
        {
            var filtros = new ClienteFiltrosDto { PageSize = 1000 };
            var resultado = await ClientesApi.ObtenerClientesAsync(filtros);
            clientes = resultado?.Items?.ToList() ?? new List<ClienteDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
            clientes = new List<ClienteDto>();
        }
    }

    private async Task CargarMesas()
    {
        try
        {
            mesas = await MesasApi.ObtenerAsync() ?? new List<MesaDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar mesas: {ex.Message}");
            mesas = new List<MesaDto>();
        }
    }

    private void CargarMeseros()
    {
        try
        {
            // Por ahora usamos una lista vacía hasta que tengamos el servicio de usuarios
            meseros = new List<UsuarioDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar meseros: {ex.Message}");
            meseros = new List<UsuarioDto>();
        }
    }

    private async Task AplicarFiltros()
    {
        Filtros.EsFacturaElectronica = esFacturaElectronica;
        await OnFiltrosAplicados.InvokeAsync(Filtros);
    }

    private void LimpiarFiltros()
    {
        Filtros = new FacturaFiltrosDto
        {
            OrdenarPor = "FechaEmision",
            DireccionOrden = "desc",
            PageNumber = 1,
            PageSize = 20
        };
    }

    private async Task FiltrosRapidos()
    {
        Filtros.FechaInicio = DateTime.Today.AddDays(-7);
        Filtros.FechaFin = DateTime.Today;
        await AplicarFiltros();
    }
}
