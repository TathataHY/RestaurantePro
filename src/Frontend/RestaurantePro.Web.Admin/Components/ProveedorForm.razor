@using RestaurantePro.Web.Admin.Models
@using System.ComponentModel.DataAnnotations

<div class="modal fade @(MostrarModal ? "show" : "")" style="display: @(MostrarModal ? "block" : "none")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span class="oi oi-people" aria-hidden="true"></span>
                    @(Proveedor?.Id == Guid.Empty ? "Nuevo Proveedor" : "Editar Proveedor")
                </h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            
            <EditForm Model="Proveedor" OnValidSubmit="GuardarProveedor">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                
                <div class="modal-body">
                    <div class="row">
                        <!-- Información Básica -->
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">
                                <span class="oi oi-info" aria-hidden="true"></span>
                                Información Básica
                            </h6>
                            
                            <div class="mb-3">
                                <label for="nombre" class="form-label">Nombre *</label>
                                <InputText id="nombre" class="form-control" @bind-Value="Proveedor.Nombre" placeholder="Nombre del proveedor" />
                                <ValidationMessage For="@(() => Proveedor.Nombre)" class="text-danger" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="ruc" class="form-label">RUC</label>
                                <InputText id="ruc" class="form-control" @bind-Value="Proveedor.Ruc" placeholder="Número de RUC" />
                                <ValidationMessage For="@(() => Proveedor.Ruc)" class="text-danger" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="telefono" class="form-label">Teléfono</label>
                                <InputText id="telefono" class="form-control" @bind-Value="Proveedor.Telefono" placeholder="Teléfono principal" />
                                <ValidationMessage For="@(() => Proveedor.Telefono)" class="text-danger" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <InputText id="email" class="form-control" @bind-Value="Proveedor.Email" placeholder="correo@ejemplo.com" />
                                <ValidationMessage For="@(() => Proveedor.Email)" class="text-danger" />
                            </div>
                        </div>
                        
                        <!-- Información de Ubicación -->
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">
                                <span class="oi oi-location" aria-hidden="true"></span>
                                Ubicación
                            </h6>
                            
                            <div class="mb-3">
                                <label for="direccion" class="form-label">Dirección</label>
                                <InputText id="direccion" class="form-control" @bind-Value="Proveedor.Direccion" placeholder="Dirección completa" />
                                <ValidationMessage For="@(() => Proveedor.Direccion)" class="text-danger" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="ciudad" class="form-label">Ciudad</label>
                                <InputText id="ciudad" class="form-control" @bind-Value="Proveedor.Ciudad" placeholder="Ciudad" />
                                <ValidationMessage For="@(() => Proveedor.Ciudad)" class="text-danger" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="pais" class="form-label">País</label>
                                <InputText id="pais" class="form-control" @bind-Value="Proveedor.Pais" placeholder="País" />
                                <ValidationMessage For="@(() => Proveedor.Pais)" class="text-danger" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="estado" class="form-label">Estado</label>
                                <InputSelect id="estado" class="form-select" @bind-Value="Proveedor.EstaActivo">
                                    <option value="true">Activo</option>
                                    <option value="false">Inactivo</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Observaciones -->
                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-primary mb-3">
                                <span class="oi oi-document" aria-hidden="true"></span>
                                Información Adicional
                            </h6>
                            
                            <div class="mb-3">
                                <label for="observaciones" class="form-label">Observaciones</label>
                                <InputTextArea id="observaciones" class="form-control" @bind-Value="Proveedor.Observaciones" 
                                             placeholder="Observaciones adicionales sobre el proveedor" rows="3" />
                                <ValidationMessage For="@(() => Proveedor.Observaciones)" class="text-danger" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Información de Rendimiento (Solo en edición) -->
                    @if (Proveedor?.Id != Guid.Empty)
                    {
                        <div class="row">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <span class="oi oi-bar-chart" aria-hidden="true"></span>
                                    Rendimiento
                                </h6>
                                
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 class="card-title text-muted">Total Contactos</h6>
                                                <h4 class="text-primary">@Proveedor.TotalContactos</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 class="card-title text-muted">Órdenes de Compra</h6>
                                                <h4 class="text-success">@Proveedor.TotalOrdenesCompra</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 class="card-title text-muted">Monto Total</h6>
                                                <h4 class="text-info">@Proveedor.MontoTotalCompras.ToString("C")</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 class="card-title text-muted">Última Compra</h6>
                                                <h6 class="text-warning">@(Proveedor.UltimaCompra?.ToString("dd/MM/yyyy") ?? "N/A")</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <span class="oi oi-x" aria-hidden="true"></span>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@Guardando">
                        @if (Guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span class="oi oi-check" aria-hidden="true"></span>
                            <span>@(Proveedor?.Id == Guid.Empty ? "Crear" : "Actualizar")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (MostrarModal)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public ProveedorDto Proveedor { get; set; } = new();
    [Parameter] public bool MostrarModal { get; set; } = false;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool Guardando = false;

    private async Task GuardarProveedor()
    {
        Guardando = true;
        await OnSubmit.InvokeAsync();
        Guardando = false;
    }

    private async Task CerrarModal()
    {
        await OnCancel.InvokeAsync();
    }
}
