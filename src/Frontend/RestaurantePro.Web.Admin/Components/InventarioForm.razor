@using RestaurantePro.Web.Admin.Models

<div class="modal fade @(Mostrar ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span class="oi oi-box" aria-hidden="true"></span>
                    @(Ingrediente.Id == Guid.Empty ? "Nuevo Ingrediente" : "Editar Ingrediente")
                </h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            
            <EditForm Model="Ingrediente" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Nombre *</label>
                                <InputText @bind-Value="Ingrediente.Nombre" class="form-control" placeholder="Nombre del ingrediente" />
                                <ValidationMessage For="@(() => Ingrediente.Nombre)" class="text-danger" />
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Categoría</label>
                                <InputText @bind-Value="Ingrediente.Categoria" class="form-control" placeholder="Categoría del ingrediente" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Unidad de Medida *</label>
                                <InputSelect @bind-Value="Ingrediente.UnidadMedida" class="form-select">
                                    <option value="">Seleccionar unidad</option>
                                    <option value="kg">Kilogramo (kg)</option>
                                    <option value="g">Gramo (g)</option>
                                    <option value="l">Litro (l)</option>
                                    <option value="ml">Mililitro (ml)</option>
                                    <option value="unidad">Unidad</option>
                                    <option value="docena">Docena</option>
                                    <option value="caja">Caja</option>
                                    <option value="bolsa">Bolsa</option>
                                    <option value="paquete">Paquete</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Ingrediente.UnidadMedida)" class="text-danger" />
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Proveedor</label>
                                <InputText @bind-Value="Ingrediente.Proveedor" class="form-control" placeholder="Nombre del proveedor" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Stock Mínimo *</label>
                                <InputNumber @bind-Value="Ingrediente.StockMinimo" class="form-control" step="0.01" min="0" />
                                <ValidationMessage For="@(() => Ingrediente.StockMinimo)" class="text-danger" />
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Stock Máximo *</label>
                                <InputNumber @bind-Value="Ingrediente.StockMaximo" class="form-control" step="0.01" min="0" />
                                <ValidationMessage For="@(() => Ingrediente.StockMaximo)" class="text-danger" />
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Stock Actual *</label>
                                <InputNumber @bind-Value="Ingrediente.StockActual" class="form-control" step="0.01" min="0" />
                                <ValidationMessage For="@(() => Ingrediente.StockActual)" class="text-danger" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Costo Unitario *</label>
                                <InputNumber @bind-Value="Ingrediente.CostoUnitario" class="form-control" step="0.01" min="0" />
                                <ValidationMessage For="@(() => Ingrediente.CostoUnitario)" class="text-danger" />
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Fecha de Vencimiento</label>
                                <InputDate @bind-Value="Ingrediente.FechaVencimiento" class="form-control" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <InputTextArea @bind-Value="Ingrediente.Descripcion" class="form-control" rows="3" placeholder="Descripción del ingrediente" />
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="Ingrediente.EstaActivo" class="form-check-input" />
                            <label class="form-check-label">
                                Ingrediente activo
                            </label>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                        <span class="oi oi-x" aria-hidden="true"></span> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@Cargando">
                        @if (Cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="oi oi-check" aria-hidden="true"></span>
                        }
                        @(Ingrediente.Id == Guid.Empty ? "Crear" : "Actualizar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public IngredienteDto Ingrediente { get; set; } = new();
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool Cargando { get; set; }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync();
    }
}
