@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

@code {
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            try
            {
                // Esperar a que el DOM esté completamente listo
                await Task.Delay(200);
                
                // Limpiar solo tokens expirados
                await JSRuntime.InvokeVoidAsync("authPersistence.clearExpiredTokens");
                
                // Verificar si hay autenticación en localStorage desde JavaScript
                var hasAuth = await JSRuntime.InvokeAsync<bool>("authPersistence.isAuthenticated");
                
                if (hasAuth)
                {
                    await AuthStateProvider.InitializeAsync();
                }
            }
            catch (Exception ex)
            {
                // Error silencioso - no mostrar logs de debug
            }
            _isInitialized = true;
        }
    }
}
