@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

@code {
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            try
            {
                // Esperar a que el DOM esté completamente listo
                await Task.Delay(200);
                
                // Limpiar solo tokens expirados
                await JSRuntime.InvokeVoidAsync("authPersistence.clearExpiredTokens");
                
                // Verificar si hay autenticación en localStorage desde JavaScript
                var hasAuth = await JSRuntime.InvokeAsync<bool>("authPersistence.isAuthenticated");
                Console.WriteLine($"AuthInitializer: hasAuth = {hasAuth}");
                
                if (hasAuth)
                {
                    Console.WriteLine("AuthInitializer: Inicializando autenticación...");
                    await AuthStateProvider.InitializeAsync();
                    Console.WriteLine("AuthInitializer: Autenticación inicializada");
                }
                else
                {
                    Console.WriteLine("AuthInitializer: No hay autenticación válida");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing auth: {ex.Message}");
                Console.WriteLine($"Stack trace: {ex.StackTrace}");
            }
            _isInitialized = true;
        }
    }
}
