@using RestaurantePro.Web.Admin.Models

@if (Ingredientes == null || !Ingredientes.Any())
{
    <div class="text-center py-5">
        <div class="oi oi-box text-muted" style="font-size: 3rem;"></div>
        <h5 class="text-muted mt-3">No hay ingredientes</h5>
        <p class="text-muted">No se encontraron ingredientes para mostrar en la vista Kanban.</p>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0">
                        <span class="oi oi-warning" aria-hidden="true"></span>
                        Stock Bajo (@Ingredientes.Count(i => i.StockActual <= i.StockMinimo))
                    </h6>
                </div>
                <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                    @foreach (var ingrediente in Ingredientes.Where(i => i.StockActual <= i.StockMinimo))
                    {
                        <div class="card mb-2">
                            <div class="card-body p-2">
                                <h6 class="card-title">@ingrediente.Nombre</h6>
                                <p class="card-text small">
                                    <strong>Stock:</strong> @ingrediente.StockActual.ToString("N2") @ingrediente.UnidadMedida}<br>
                                    <strong>Mínimo:</strong> @ingrediente.StockMinimo.ToString("N2")<br>
                                    <strong>Costo:</strong> $@ingrediente.CostoUnitario.ToString("N2")
                                </p>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OnEditar.InvokeAsync(ingrediente)" title="Editar">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm" @onclick="() => OnVerDetalles.InvokeAsync(ingrediente)" title="Ver detalles">
                                        <span class="oi oi-eye" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => OnCrearMovimiento.InvokeAsync(ingrediente)" title="Crear movimiento">
                                        <span class="oi oi-plus" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h6 class="mb-0">
                        <span class="oi oi-clock" aria-hidden="true"></span>
                        Vence Pronto (@Ingredientes.Count(i => i.FechaVencimiento <= DateTime.Now.AddDays(7) && i.FechaVencimiento > DateTime.Now))
                    </h6>
                </div>
                <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                    @foreach (var ingrediente in Ingredientes.Where(i => i.FechaVencimiento <= DateTime.Now.AddDays(7) && i.FechaVencimiento > DateTime.Now))
                    {
                        <div class="card mb-2">
                            <div class="card-body p-2">
                                <h6 class="card-title">@ingrediente.Nombre</h6>
                                <p class="card-text small">
                                    <strong>Vence:</strong> @ingrediente.FechaVencimiento.ToString("dd/MM/yyyy")<br>
                                    <strong>Días:</strong> @GetDiasVencimiento(ingrediente.FechaVencimiento)<br>
                                    <strong>Stock:</strong> @ingrediente.StockActual.ToString("N2") @ingrediente.UnidadMedida}
                                </p>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OnEditar.InvokeAsync(ingrediente)" title="Editar">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm" @onclick="() => OnVerDetalles.InvokeAsync(ingrediente)" title="Ver detalles">
                                        <span class="oi oi-eye" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => OnCrearMovimiento.InvokeAsync(ingrediente)" title="Crear movimiento">
                                        <span class="oi oi-plus" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">
                        <span class="oi oi-check" aria-hidden="true"></span>
                        Stock Normal (@Ingredientes.Count(i => i.StockActual > i.StockMinimo && i.StockActual < i.StockMaximo))
                    </h6>
                </div>
                <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                    @foreach (var ingrediente in Ingredientes.Where(i => i.StockActual > i.StockMinimo && i.StockActual < i.StockMaximo))
                    {
                        <div class="card mb-2">
                            <div class="card-body p-2">
                                <h6 class="card-title">@ingrediente.Nombre</h6>
                                <p class="card-text small">
                                    <strong>Stock:</strong> @ingrediente.StockActual.ToString("N2") @ingrediente.UnidadMedida}<br>
                                    <strong>Mín:</strong> @ingrediente.StockMinimo.ToString("N2") | <strong>Máx:</strong> @ingrediente.StockMaximo.ToString("N2")<br>
                                    <strong>Costo:</strong> $@ingrediente.CostoUnitario.ToString("N2")
                                </p>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OnEditar.InvokeAsync(ingrediente)" title="Editar">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm" @onclick="() => OnVerDetalles.InvokeAsync(ingrediente)" title="Ver detalles">
                                        <span class="oi oi-eye" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => OnCrearMovimiento.InvokeAsync(ingrediente)" title="Crear movimiento">
                                        <span class="oi oi-plus" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">
                        <span class="oi oi-power-standby" aria-hidden="true"></span>
                        Inactivos (@Ingredientes.Count(i => !i.EstaActivo))
                    </h6>
                </div>
                <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                    @foreach (var ingrediente in Ingredientes.Where(i => !i.EstaActivo))
                    {
                        <div class="card mb-2">
                            <div class="card-body p-2">
                                <h6 class="card-title">@ingrediente.Nombre</h6>
                                <p class="card-text small">
                                    <strong>Estado:</strong> Inactivo<br>
                                    <strong>Stock:</strong> @ingrediente.StockActual.ToString("N2") @ingrediente.UnidadMedida}<br>
                                    <strong>Costo:</strong> $@ingrediente.CostoUnitario.ToString("N2")
                                </p>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OnEditar.InvokeAsync(ingrediente)" title="Editar">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm" @onclick="() => OnVerDetalles.InvokeAsync(ingrediente)" title="Ver detalles">
                                        <span class="oi oi-eye" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => OnCrearMovimiento.InvokeAsync(ingrediente)" title="Crear movimiento">
                                        <span class="oi oi-plus" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<IngredienteDto>? Ingredientes { get; set; }
    [Parameter] public EventCallback<IngredienteDto> OnEditar { get; set; }
    [Parameter] public EventCallback<IngredienteDto> OnVerDetalles { get; set; }
    [Parameter] public EventCallback<IngredienteDto> OnCrearMovimiento { get; set; }

    private string GetDiasVencimiento(DateTime fechaVencimiento)
    {
        var dias = (fechaVencimiento - DateTime.Now).Days;
        
        if (dias < 0)
            return $"Vencido hace {Math.Abs(dias)} días";
        
        if (dias == 0)
            return "Vence hoy";
        
        if (dias == 1)
            return "Vence mañana";
        
        return $"Vence en {dias} días";
    }
}
