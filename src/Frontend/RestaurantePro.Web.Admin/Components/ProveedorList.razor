@using RestaurantePro.Web.Admin.Models

@if (Proveedores == null || !Proveedores.Any())
{
    <div class="text-center py-5">
        <div class="text-muted">
            <span class="oi oi-people" style="font-size: 3rem;" aria-hidden="true"></span>
            <h4 class="mt-3">No hay proveedores</h4>
            <p>No se encontraron proveedores con los filtros aplicados.</p>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Proveedor</th>
                    <th>RUC</th>
                    <th>Ubicación</th>
                    <th>Contacto</th>
                    <th>Rendimiento</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in Proveedores)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                         style="width: 40px; height: 40px; font-size: 1.2rem;">
                                        @proveedor.Nombre.Substring(0, 1).ToUpper()
                                    </div>
                                </div>
                                <div>
                                    <h6 class="mb-0">@proveedor.Nombre</h6>
                                    <small class="text-muted">
                                        Creado: @proveedor.FechaCreacion.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(proveedor.Ruc))
                            {
                                <span class="badge bg-secondary">@proveedor.Ruc</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin RUC</span>
                            }
                        </td>
                        <td>
                            <div>
                                @if (!string.IsNullOrEmpty(proveedor.Ciudad))
                                {
                                    <div class="fw-bold">@proveedor.Ciudad</div>
                                }
                                @if (!string.IsNullOrEmpty(proveedor.Pais))
                                {
                                    <small class="text-muted">@proveedor.Pais</small>
                                }
                                @if (string.IsNullOrEmpty(proveedor.Ciudad) && string.IsNullOrEmpty(proveedor.Pais))
                                {
                                    <span class="text-muted">Sin ubicación</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div>
                                @if (!string.IsNullOrEmpty(proveedor.Telefono))
                                {
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="oi oi-phone me-1" aria-hidden="true"></span>
                                        <small>@proveedor.Telefono</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(proveedor.Email))
                                {
                                    <div class="d-flex align-items-center">
                                        <span class="oi oi-envelope-closed me-1" aria-hidden="true"></span>
                                        <small>@proveedor.Email</small>
                                    </div>
                                }
                                @if (string.IsNullOrEmpty(proveedor.Telefono) && string.IsNullOrEmpty(proveedor.Email))
                                {
                                    <span class="text-muted">Sin contacto</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="text-center">
                                        <div class="fw-bold text-primary">@proveedor.TotalOrdenesCompra</div>
                                        <small class="text-muted">Órdenes</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center">
                                        <div class="fw-bold text-success">@proveedor.MontoTotalCompras.ToString("C0")</div>
                                        <small class="text-muted">Total</small>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (proveedor.EstaActivo)
                            {
                                <span class="badge bg-success">
                                    <span class="oi oi-check" aria-hidden="true"></span>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <span class="oi oi-x" aria-hidden="true"></span>
                                    Inactivo
                                </span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                        @onclick="@(() => OnVerDetalles.InvokeAsync(proveedor))"
                                        title="Ver detalles">
                                    <span class="oi oi-eye" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning" 
                                        @onclick="@(() => OnEditar.InvokeAsync(proveedor))"
                                        title="Editar">
                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info" 
                                        @onclick="@(() => OnGestionarContactos.InvokeAsync(proveedor))"
                                        title="Gestionar contactos">
                                    <span class="oi oi-people" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        @onclick="@(() => OnEliminar.InvokeAsync(proveedor))"
                                        title="Eliminar">
                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (Paginacion != null)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
                Mostrando @((Paginacion.PageNumber - 1) * Paginacion.PageSize + 1) a 
                @Math.Min(Paginacion.PageNumber * Paginacion.PageSize, Paginacion.TotalCount) de 
                @Paginacion.TotalCount proveedores
            </div>
            
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Paginacion.HasPreviousPage ? "" : "disabled")">
                        <button class="page-link" @onclick="@(() => OnCambiarPagina.InvokeAsync(Paginacion.PageNumber - 1))" 
                                disabled="@(!Paginacion.HasPreviousPage)">
                            <span class="oi oi-chevron-left" aria-hidden="true"></span>
                        </button>
                    </li>
                    
                    @for (int i = Math.Max(1, Paginacion.PageNumber - 2); i <= Math.Min(Paginacion.TotalPages, Paginacion.PageNumber + 2); i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(pageNumber == Paginacion.PageNumber ? "active" : "")">
                            <button class="page-link" @onclick="@(() => OnCambiarPagina.InvokeAsync(pageNumber))">
                                @pageNumber
                            </button>
                        </li>
                    }
                    
                    <li class="page-item @(Paginacion.HasNextPage ? "" : "disabled")">
                        <button class="page-link" @onclick="@(() => OnCambiarPagina.InvokeAsync(Paginacion.PageNumber + 1))" 
                                disabled="@(!Paginacion.HasNextPage)">
                            <span class="oi oi-chevron-right" aria-hidden="true"></span>
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    }
}

@code {
    [Parameter] public List<ProveedorDto>? Proveedores { get; set; }
    [Parameter] public PaginatedList<ProveedorDto>? Paginacion { get; set; }
    [Parameter] public EventCallback<ProveedorDto> OnVerDetalles { get; set; }
    [Parameter] public EventCallback<ProveedorDto> OnEditar { get; set; }
    [Parameter] public EventCallback<ProveedorDto> OnGestionarContactos { get; set; }
    [Parameter] public EventCallback<ProveedorDto> OnEliminar { get; set; }
    [Parameter] public EventCallback<int> OnCambiarPagina { get; set; }
}
