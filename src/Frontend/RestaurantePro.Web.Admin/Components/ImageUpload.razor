@using Microsoft.AspNetCore.Components.Forms
@using RestaurantePro.Web.Admin.Services
@inject IProductosApiService Api
@inject IJSRuntime JSRuntime

<div class="space-y-4">
    <!-- Vista previa de imagen actual -->
    @if (!string.IsNullOrEmpty(ImageUrl) && !isUploading)
    {
        <div class="relative group">
            <div class="border-2 border-gray-200 rounded-lg p-4">
                <img src="@ImageUrl" 
                     alt="Imagen actual" 
                     class="w-full h-auto max-h-64 object-contain rounded-lg" />
            </div>
            <button type="button" 
                    @onclick="EliminarImagen"
                    class="absolute top-2 right-2 bg-red-500 hover:bg-red-600 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold shadow-lg transition-all duration-200">
                ×
            </button>
            <button type="button" 
                    @onclick="ClickFileInput"
                    class="absolute bottom-2 right-2 bg-blue-500 hover:bg-blue-600 text-white text-xs px-3 py-1 rounded shadow-lg transition-all duration-200">
                Cambiar
            </button>
        </div>
    }

    <!-- InputFile siempre disponible (oculto) -->
    <InputFile id="fileInput" OnChange="OnFileSelected" 
               accept="image/*" 
               class="hidden" 
               @ref="fileInput"
               style="display: none;" />

    <!-- Área de subida (solo se muestra si no hay imagen o se está subiendo) -->
    @if (string.IsNullOrEmpty(ImageUrl) || isUploading)
    {
        <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-blue-400 transition-colors">
            @if (isUploading)
            {
                <div class="space-y-2">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
                    <p class="text-sm text-gray-600">Subiendo imagen...</p>
                </div>
            }
            else
            {
                <div class="space-y-2">
                    <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                        <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <p class="text-sm text-gray-600">
                        <button type="button" @onclick="ClickFileInput" class="text-blue-600 hover:text-blue-500 font-medium">
                            @(ProductoId == Guid.Empty ? "Seleccionar imagen" : "Agregar imagen al producto")
                        </button>
                    </p>
                    <p class="text-xs text-gray-500">
                        PNG, JPG, GIF hasta 5MB
                    </p>
                    @if (ProductoId != Guid.Empty)
                    {
                        <p class="text-xs text-amber-600 bg-amber-50 px-2 py-1 rounded mt-2">
                            💡 Este producto no tiene imagen. Haz clic para agregar una.
                        </p>
                    }
                </div>
            }
        </div>
    }

    <!-- Mensaje de error -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
            @errorMessage
        </div>
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public EventCallback<string?> ImageUrlChanged { get; set; }
    [Parameter] public Guid ProductoId { get; set; }
    [Parameter] public string ApiBaseUrl { get; set; } = "http://localhost:8080";

    private InputFile? fileInput;
    private bool isUploading = false;
    private string? errorMessage;
    
    protected override void OnParametersSet()
    {
        // Forzar actualización del estado cuando cambia la ImageUrl
        StateHasChanged();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        await SubirArchivo(e.File);
    }

    private async Task SubirArchivo(IBrowserFile archivo)
    {
        errorMessage = null;
        isUploading = true;

        try
        {
            // Validar tipo de archivo
            if (!archivo.ContentType.StartsWith("image/"))
            {
                errorMessage = "Solo se permiten archivos de imagen (PNG, JPG, GIF, etc.)";
                isUploading = false;
                return;
            }

            // Validar tamaño (5MB)
            if (archivo.Size > 5 * 1024 * 1024)
            {
                errorMessage = "El archivo es demasiado grande. Tamaño máximo: 5MB";
                isUploading = false;
                return;
            }

            // Siempre crear vista previa primero para cualquier producto (nuevo o existente)
            await CrearVistaPrevia(archivo);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task CrearVistaPrevia(IBrowserFile archivo)
    {
        try
        {
            string previewUrl = null;
            
            // Verificar si JavaScript está disponible
            try
            {
                var jsAvailable = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.imageUpload !== 'undefined'");
                
                if (jsAvailable)
                {
                    previewUrl = await JSRuntime.InvokeAsync<string>("imageUpload.createOptimizedPreview", archivo);
                }
            }
            catch (Exception jsEx)
            {
                // JavaScript no disponible, usar fallback C#
            }
            
            // Fallback a versión C# si JavaScript falla
            if (string.IsNullOrEmpty(previewUrl))
            {
                // Leer stream completo sin truncar (hasta 10MB)
                using var stream = archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var imageBytes = memoryStream.ToArray();

                var base64 = Convert.ToBase64String(imageBytes);
                previewUrl = $"data:{archivo.ContentType};base64,{base64}";
            }
            
            await ImageUrlChanged.InvokeAsync(previewUrl);
            
            // Mostrar mensaje diferente según si es producto nuevo o existente
            if (ProductoId == Guid.Empty)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Imagen seleccionada. Se subirá al servidor cuando guardes el producto.");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Imagen seleccionada. Se subirá al servidor cuando guardes los cambios.");
            }
            
            // Forzar actualización del estado
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar la imagen: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            
            // Forzar actualización del estado para mostrar la vista previa
            StateHasChanged();
        }
    }

    private async Task ClickFileInput()
    {
        try
        {
            // Usar JavaScript para hacer click en el InputFile
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('fileInput').click()");
        }
        catch (Exception ex)
        {
            // Fallback: intentar hacer click usando JavaScript con un selector diferente
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
            }
            catch (Exception ex2)
            {
                // Error en fallback JavaScript
            }
        }
    }

    private async Task EliminarImagen()
    {
        // Limpiar la imagen actual
        ImageUrl = null;
        errorMessage = null;
        
        // Notificar al componente padre que la imagen fue eliminada
        if (ImageUrlChanged.HasDelegate)
        {
            await ImageUrlChanged.InvokeAsync(null);
        }
        
        // Forzar actualización del estado
        StateHasChanged();
    }
}

<style>
    .animate-spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>