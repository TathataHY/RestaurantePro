@using Microsoft.AspNetCore.Components.Authorization
@using RestaurantePro.Web.Admin.Auth
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RestaurantePro.Web.Admin.Services.TokenStore TokenStore
@inject NavigationManager Navigation

@if (IsAuthorizedForWebAdmin)
{
    @ChildContent
}
else
{
    <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 text-center">
            <!-- Icono de bloqueo -->
            <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-red-100 mb-6">
                <span class="material-symbols-outlined text-red-600 text-4xl">block</span>
            </div>
            
            <!-- Título -->
            <h1 class="text-2xl font-bold text-gray-900 mb-4">Acceso No Permitido</h1>
            
            <!-- Mensaje principal -->
            <p class="text-gray-600 mb-6">
                Tu rol de <span class="font-semibold text-blue-600">@UserRole</span> no tiene permisos para acceder a la Web Administrativa.
            </p>
            
            <!-- Información sobre la aplicación correcta -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <span class="material-symbols-outlined text-blue-600 mr-3 mt-1">info</span>
                    <div class="text-left">
                        <p class="text-blue-800 font-medium text-sm mb-2">¿Dónde debes trabajar?</p>
                        <p class="text-blue-700 text-sm">
                            Como <span class="font-medium">@UserRole</span>, debes usar la 
                            <span class="font-semibold">Aplicación Móvil</span> para gestionar tus operaciones diarias.
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Roles permitidos en Web Admin -->
            <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <span class="material-symbols-outlined text-green-600 mr-3 mt-1">check_circle</span>
                    <div class="text-left">
                        <p class="text-green-800 font-medium text-sm mb-2">Roles permitidos en Web Admin:</p>
                        <p class="text-green-700 text-sm">Administrador, Gerente, Propietario</p>
                    </div>
                </div>
            </div>
            
            <!-- Acciones -->
            <div class="space-y-3">
                <button @onclick="Logout" 
                        class="w-full bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition-colors font-medium flex items-center justify-center">
                    <span class="material-symbols-outlined text-sm mr-2">logout</span>
                    Cerrar Sesión
                </button>
                
                <button @onclick="GoToMobileApp" 
                        class="w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium flex items-center justify-center">
                    <span class="material-symbols-outlined text-sm mr-2">phone_android</span>
                    Ir a Aplicación Móvil
                </button>
            </div>
            
            <!-- Información adicional -->
            <div class="mt-6 pt-6 border-t border-gray-200">
                <p class="text-xs text-gray-500">
                    Si crees que esto es un error, contacta al administrador del sistema.
                </p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsAuthorizedForWebAdmin { get; set; } = false;
    private string UserRole { get; set; } = "Usuario";

    // Roles que NO pueden acceder a la Web Administrativa
    private readonly string[] OperationalRoles = { "Mesero", "Cocinero", "Cajero", "Supervisor", "Empleado" };
    
    // Roles que SÍ pueden acceder a la Web Administrativa
    private readonly string[] AdminRoles = { "Admin", "Administrador", "Gerente", "Propietario" };

    protected override async Task OnInitializedAsync()
    {
        await CheckWebAdminAccess();
    }

    private async Task CheckWebAdminAccess()
    {
        try
        {
            // Obtener la URL actual
            var currentUri = Navigation.ToBaseRelativePath(Navigation.Uri);
            
            // Permitir acceso a la página de login sin verificar roles
            if (currentUri.StartsWith("login", StringComparison.OrdinalIgnoreCase))
            {
                IsAuthorizedForWebAdmin = true;
                return;
            }
            
            // Obtener el estado de autenticación
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            
            if (!authState.User.Identity?.IsAuthenticated == true)
            {
                IsAuthorizedForWebAdmin = false;
                return;
            }

            // Obtener el rol del usuario desde el token
            var userRoles = TokenStore.Roles ?? new List<string>();
            var identityRoles = authState.User.Claims
                .Where(c => c.Type == "role")
                .Select(c => c.Value)
                .ToList();

            var allUserRoles = userRoles.Union(identityRoles).ToList();
            
            // Determinar el rol principal del usuario
            UserRole = allUserRoles.FirstOrDefault() ?? "Usuario";

            // Debug: Log los roles encontrados
            Console.WriteLine($"🔍 WebAdminAccessGuard - Roles del usuario: {string.Join(", ", allUserRoles)}");
            Console.WriteLine($"🔍 WebAdminAccessGuard - Rol principal: {UserRole}");

            // Verificar si el usuario tiene un rol operativo (no permitido)
            var hasOperationalRole = allUserRoles.Any(role => OperationalRoles.Contains(role));
            
            // Verificar si el usuario tiene un rol administrativo (permitido)
            var hasAdminRole = allUserRoles.Any(role => AdminRoles.Contains(role));

            Console.WriteLine($"🔍 WebAdminAccessGuard - Tiene rol operativo: {hasOperationalRole}");
            Console.WriteLine($"🔍 WebAdminAccessGuard - Tiene rol admin: {hasAdminRole}");

            // Lógica corregida: Permitir acceso si tiene rol administrativo
            // Solo bloquear si NO tiene rol administrativo Y tiene rol operativo
            IsAuthorizedForWebAdmin = hasAdminRole || !hasOperationalRole;

            Console.WriteLine($"🔍 WebAdminAccessGuard - Acceso autorizado: {IsAuthorizedForWebAdmin}");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en CheckWebAdminAccess: {ex.Message}");
            IsAuthorizedForWebAdmin = false;
        }
    }

    private async Task Logout()
    {
        if (AuthenticationStateProvider is JwtAuthenticationStateProvider jwtProvider)
        {
            await jwtProvider.LogoutAsync();
        }
        Navigation.NavigateTo("/login", true);
    }

    private void GoToMobileApp()
    {
        // En una implementación real, esto podría redirigir a la app móvil
        // Por ahora, mostramos un mensaje
        // TODO: Implementar redirección a la aplicación móvil
    }
}
