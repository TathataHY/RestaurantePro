@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Services
@inject ReservacionesApiService ReservacionesApi
@inject ClientesApiService ClientesApi
@inject MesasApiService MesasApi
@inject IJSRuntime JSRuntime

<div class="modal fade @(Mostrar ? "show" : "")" style="display: @(Mostrar ? "block" : "none")" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="p-6 sm:p-8">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">
                        <span class="material-symbols-outlined text-blue-600 mr-2">restaurant</span>
                        @(EsEdicion ? "Editar Reservación" : "Nueva Reservación")
                    </h2>
                    <button type="button" class="text-gray-400 hover:text-gray-600" @onclick="Cerrar">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <EditForm Model="Reservacion" OnValidSubmit="GuardarReservacion">
                    <DataAnnotationsValidator />
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                        <!-- Información del Cliente -->
                        <div class="md:col-span-2">
                            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Información del Cliente</h3>
                        </div>
                        
                        <div class="md:col-span-2">
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Cliente *</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">person</span>
                                    <InputSelect @bind-Value="Reservacion.ClienteId" class="form-select w-full appearance-none pl-10 bg-white" @onchange="ClienteSeleccionado">
                                        <option value="">Seleccionar cliente</option>
                                        @if (clientes != null)
                                        {
                                            @foreach (var cliente in clientes)
                                            {
                                                <option value="@cliente.Id">@cliente.NombreCompleto</option>
                                            }
                                        }
                                    </InputSelect>
                                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                                </div>
                                <ValidationMessage For="@(() => Reservacion.ClienteId)" class="text-red-500 text-sm mt-1" />
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Teléfono</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">phone</span>
                                    <InputText @bind-Value="Reservacion.ClienteTelefono" class="form-input w-full pl-10" placeholder="Ej. 555-123-4567" type="tel" />
                                </div>
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Email</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">email</span>
                                    <InputText @bind-Value="Reservacion.ClienteEmail" class="form-input w-full pl-10" placeholder="Ej. cliente@email.com" type="email" />
                                </div>
                            </label>
                        </div>
                        
                        <div class="md:col-span-2">
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Notas especiales</span>
                                <InputTextArea @bind-Value="Reservacion.NotasEspeciales" class="form-input w-full min-h-28" placeholder="Ej. Alergia a mariscos, mesa cerca de la ventana" />
                            </label>
                        </div>
                        
                        <!-- Detalles de la Reservación -->
                        <div class="md:col-span-2 mt-4">
                            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Detalles de la Reservación</h3>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Fecha *</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">calendar_today</span>
                                    <InputDate @bind-Value="Reservacion.FechaReservacion" class="form-input w-full pl-10" @onchange="FechaCambiada" />
                                </div>
                                <ValidationMessage For="@(() => Reservacion.FechaReservacion)" class="text-red-500 text-sm mt-1" />
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Hora *</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">schedule</span>
                                    <InputText type="time" @bind-Value="horaReservacionString" class="form-input w-full pl-10" @onchange="HoraCambiada" />
                                </div>
                                <ValidationMessage For="@(() => Reservacion.HoraReservacion)" class="text-red-500 text-sm mt-1" />
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Número de personas *</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">groups</span>
                                    <InputNumber @bind-Value="Reservacion.NumeroPersonas" class="form-input w-full pl-10" min="1" placeholder="Ej. 2" @onchange="PersonasCambiadas" />
                                </div>
                                <ValidationMessage For="@(() => Reservacion.NumeroPersonas)" class="text-red-500 text-sm mt-1" />
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Mesa preferida *</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">table_restaurant</span>
                                    <InputSelect @bind-Value="Reservacion.MesaId" class="form-select w-full appearance-none pl-10 bg-white" @onchange="MesaSeleccionada">
                                        <option value="">Seleccionar mesa</option>
                                        @if (mesasDisponibles != null)
                                        {
                                            @foreach (var mesa in mesasDisponibles)
                                            {
                                                <option value="@mesa.MesaId">@mesa.MesaNombre - @mesa.Capacidad personas</option>
                                            }
                                        }
                                    </InputSelect>
                                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                                </div>
                                <ValidationMessage For="@(() => Reservacion.MesaId)" class="text-red-500 text-sm mt-1" />
                                @if (verificandoDisponibilidad)
                                {
                                    <div class="text-blue-600 text-sm mt-1">
                                        <span class="material-symbols-outlined text-sm">refresh</span> Verificando disponibilidad...
                                    </div>
                                }
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Tipo de evento</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">celebration</span>
                                    <InputSelect @bind-Value="Reservacion.FuenteReservacion" class="form-select w-full appearance-none pl-10 bg-white">
                                        <option value="Directa">Cena casual</option>
                                        <option value="Cumpleaños">Cumpleaños</option>
                                        <option value="Aniversario">Aniversario</option>
                                        <option value="Reunion">Reunión de negocios</option>
                                    </InputSelect>
                                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                                </div>
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Prioridad</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">priority_high</span>
                                    <select class="form-select w-full appearance-none pl-10 bg-white" @onchange="OnPrioridadChanged">
                                        <option value="Normal">Normal</option>
                                        <option value="Alta">Alta</option>
                                        <option value="VIP">VIP</option>
                                    </select>
                                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                                </div>
                            </label>
                        </div>
                        
                        <div>
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Canal de reservación</span>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">rss_feed</span>
                                    <InputSelect @bind-Value="Reservacion.CanalReservacion" class="form-select w-full appearance-none pl-10 bg-white">
                                        <option value="Telefono">Teléfono</option>
                                        <option value="Web">Sitio Web</option>
                                        <option value="App">App móvil</option>
                                        <option value="Presencial">En persona</option>
                                    </InputSelect>
                                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">expand_more</span>
                                </div>
                            </label>
                        </div>

                        <div class="md:col-span-2">
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Observaciones</span>
                                <InputTextArea @bind-Value="Reservacion.Observaciones" class="form-input w-full min-h-20" placeholder="Observaciones generales sobre la reservación" />
                            </label>
                        </div>
                        
                        <div class="md:col-span-2">
                            <label class="block">
                                <span class="text-gray-700 font-medium mb-1.5 block">Requerimientos Especiales</span>
                                <InputTextArea @bind-Value="Reservacion.RequerimientosEspeciales" class="form-input w-full min-h-20" placeholder="Requerimientos especiales del cliente" />
                            </label>
                        </div>
                    </div>

                    <!-- Información de contacto adicional -->
                    <div class="card mt-3">
                        <div class="card-header">
                            <h6 class="m-0">Información de Contacto Adicional</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Contacto Alternativo</label>
                                        <InputText @bind-Value="Reservacion.ContactoAlternativo" class="form-control" placeholder="Nombre del contacto" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Teléfono Alternativo</label>
                                        <InputText @bind-Value="Reservacion.TelefonoAlternativo" class="form-control" placeholder="Número de teléfono" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Email Alternativo</label>
                                        <InputText @bind-Value="Reservacion.EmailAlternativo" class="form-control" placeholder="Email de contacto" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información de grupo -->
                    @if (Reservacion.EsGrupo)
                    {
                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="m-0">Información de Grupo</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Nombre del Grupo</label>
                                            <InputText @bind-Value="Reservacion.NombreGrupo" class="form-control" placeholder="Nombre del grupo" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Empresa</label>
                                            <InputText @bind-Value="Reservacion.EmpresaGrupo" class="form-control" placeholder="Empresa o organización" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Tamaño del Grupo</label>
                                            <InputNumber @bind-Value="Reservacion.TamañoGrupo" class="form-control" min="1" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Opciones adicionales -->
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="Reservacion.RequiereConfirmacion" class="form-check-input" />
                                <label class="form-check-label">
                                    Requiere Confirmación
                                </label>
                            </div>
                            <div class="form-check">
                                <InputCheckbox @bind-Value="Reservacion.EsUrgente" class="form-check-input" />
                                <label class="form-check-label">
                                    Es Urgente
                                </label>
                            </div>
                            <div class="form-check">
                                <InputCheckbox @bind-Value="Reservacion.EsVIP" class="form-check-input" />
                                <label class="form-check-label">
                                    Es VIP
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="Reservacion.EsGrupo" class="form-check-input" @onchange="EsGrupoChanged" />
                                <label class="form-check-label">
                                    Es Grupo
                                </label>
                            </div>
                            <div class="form-check">
                                <InputCheckbox @bind-Value="Reservacion.EsRecurrente" class="form-check-input" />
                                <label class="form-check-label">
                                    Es Recurrente
                                </label>
                            </div>
                        </div>
                    </div>

                    @if (Reservacion.EsRecurrente)
                    {
                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="m-0">Configuración de Recurrencia</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Frecuencia</label>
                                            <InputSelect @bind-Value="Reservacion.FrecuenciaRecurrencia" class="form-select">
                                                <option value="Diaria">Diaria</option>
                                                <option value="Semanal">Semanal</option>
                                                <option value="Mensual">Mensual</option>
                                            </InputSelect>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Fecha Fin de Recurrencia</label>
                                            <InputDate @bind-Value="Reservacion.FechaFinRecurrencia" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </EditForm>
            </div>
            
            <div class="flex justify-end gap-4 mt-8 pt-6 border-t bg-gray-50 px-6 py-4">
                <button type="button" class="px-5 py-2.5 rounded-lg bg-gray-100 text-gray-800 text-sm font-bold hover:bg-gray-200 transition-colors" @onclick="Cerrar">
                    Cancelar
                </button>
                <button type="button" class="px-5 py-2.5 rounded-lg bg-blue-100 text-blue-700 text-sm font-bold hover:bg-blue-200 transition-colors" @onclick="VerificarDisponibilidad" disabled="@verificandoDisponibilidad">
                    @if (verificandoDisponibilidad)
                    {
                        <span class="material-symbols-outlined text-sm mr-2 animate-spin">refresh</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-sm mr-2">search</span>
                    }
                    Verificar Disponibilidad
                </button>
                <button type="button" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#1e71f6] text-white text-sm font-bold hover:bg-blue-700 transition-colors shadow-md hover:shadow-lg" @onclick="GuardarReservacion" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="material-symbols-outlined text-sm animate-spin">refresh</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-sm">save</span>
                    }
                    @(EsEdicion ? "Actualizar" : "Guardar Cambios")
                </button>
            </div>
        </div>
    </div>
</div>

@if (Mostrar)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback<ReservacionDto> OnReservacionGuardada { get; set; }

    private ReservacionDto Reservacion = new();
    private bool EsEdicion => Reservacion.Id != Guid.Empty;
    private bool guardando = false;
    private bool verificandoDisponibilidad = false;
    private bool mostrarValidacionNumero = false;

    private List<ClienteDto>? clientes;
    private List<MesaDisponibleDto>? mesasDisponibles;
    private string horaReservacionString = "";
    private string prioridadSeleccionada = "Normal";

    protected override async Task OnParametersSetAsync()
    {
        if (Mostrar && !EsEdicion)
        {
            Reservacion = new ReservacionDto
            {
                FechaCreacion = DateTime.Now,
                FechaReservacion = DateTime.Today,
                HoraReservacion = DateTime.Now.TimeOfDay,
                Estado = "Pendiente",
                NumeroPersonas = 2,
                CanalReservacion = "Web",
                FuenteReservacion = "Directa",
                RequiereConfirmacion = true
            };
            
            horaReservacionString = Reservacion.HoraReservacion.ToString("hh\\:mm");
            
            await CargarDatos();
            await GenerarNumeroReservacion();
        }
    }

    private async Task CargarDatos()
    {
        await Task.WhenAll(
            CargarClientes()
        );
    }

    private async Task CargarClientes()
    {
        try
        {
            var filtros = new ClienteFiltrosDto { PageSize = 1000 };
            var resultado = await ClientesApi.ObtenerClientesAsync(filtros);
            clientes = resultado?.Items?.ToList() ?? new List<ClienteDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
            clientes = new List<ClienteDto>();
        }
    }

    private async Task GenerarNumeroReservacion()
    {
        try
        {
            var resultado = await ReservacionesApi.ObtenerSiguienteNumeroReservacionAsync();
            if (resultado?.Success == true && !string.IsNullOrEmpty(resultado.Data))
            {
                Reservacion.NumeroReservacion = resultado.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar número de reservación: {ex.Message}");
        }
    }

    private async Task FechaCambiada()
    {
        await VerificarDisponibilidad();
    }

    private async Task HoraCambiada()
    {
        if (TimeSpan.TryParse(horaReservacionString, out var hora))
        {
            Reservacion.HoraReservacion = hora;
        }
        await VerificarDisponibilidad();
    }

    private async Task PersonasCambiadas()
    {
        await VerificarDisponibilidad();
    }

    private void ClienteSeleccionado()
    {
        if (Reservacion.ClienteId != Guid.Empty && clientes != null)
        {
            var cliente = clientes.FirstOrDefault(c => c.Id == Reservacion.ClienteId);
            if (cliente != null)
            {
                Reservacion.ClienteNombre = cliente.NombreCompleto;
                Reservacion.ClienteEmail = cliente.Email ?? "";
                Reservacion.ClienteTelefono = cliente.Telefono ?? "";
            }
        }
    }

    private void MesaSeleccionada()
    {
        if (Reservacion.MesaId != Guid.Empty && mesasDisponibles != null)
        {
            var mesa = mesasDisponibles.FirstOrDefault(m => m.MesaId == Reservacion.MesaId);
            if (mesa != null)
            {
                Reservacion.MesaNombre = mesa.MesaNombre;
                Reservacion.MesaNumero = mesa.MesaNumero;
                Reservacion.MesaUbicacion = mesa.MesaUbicacion;
                Reservacion.MesaCapacidad = mesa.Capacidad;
            }
        }
    }

    private void EsGrupoChanged()
    {
        if (!Reservacion.EsGrupo)
        {
            Reservacion.NombreGrupo = null;
            Reservacion.EmpresaGrupo = null;
            Reservacion.TamañoGrupo = null;
        }
    }

    private void OnPrioridadChanged(ChangeEventArgs e)
    {
        prioridadSeleccionada = e.Value?.ToString() ?? "Normal";
        switch (prioridadSeleccionada)
        {
            case "VIP":
                Reservacion.EsVIP = true;
                Reservacion.EsUrgente = false;
                break;
            case "Alta":
                Reservacion.EsUrgente = true;
                Reservacion.EsVIP = false;
                break;
            default:
                Reservacion.EsUrgente = false;
                Reservacion.EsVIP = false;
                break;
        }
    }

    private async Task VerificarDisponibilidad()
    {
        if (Reservacion.FechaReservacion == default || Reservacion.HoraReservacion == default || Reservacion.NumeroPersonas <= 0)
            return;

        verificandoDisponibilidad = true;
        StateHasChanged();

        try
        {
            var request = new VerificarDisponibilidadRequest
            {
                Fecha = Reservacion.FechaReservacion,
                Hora = Reservacion.HoraReservacion,
                NumeroPersonas = Reservacion.NumeroPersonas,
                MesaIdExcluir = EsEdicion ? Reservacion.MesaId : null
            };

            var disponibilidad = await ReservacionesApi.VerificarDisponibilidadAsync(request);
            if (disponibilidad != null)
            {
                mesasDisponibles = disponibilidad.MesasDisponibles;
                
                if (!disponibilidad.Disponible)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"No hay disponibilidad para {Reservacion.NumeroPersonas} personas en {Reservacion.FechaReservacion:dd/MM/yyyy} a las {Reservacion.HoraReservacion:hh\\:mm}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al verificar disponibilidad: {ex.Message}");
        }
        finally
        {
            verificandoDisponibilidad = false;
            StateHasChanged();
        }
    }

    private async Task GuardarReservacion()
    {
        guardando = true;
        StateHasChanged();

        try
        {
            // Validar número de reservación único
            if (!string.IsNullOrEmpty(Reservacion.NumeroReservacion))
            {
                mostrarValidacionNumero = true;
                var validacionNumero = await ReservacionesApi.ValidarNumeroReservacionAsync(Reservacion.NumeroReservacion, EsEdicion ? Reservacion.Id : null);
                mostrarValidacionNumero = false;

                if (validacionNumero?.Data == true)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "El número de reservación ya existe.");
                    guardando = false;
                    StateHasChanged();
                    return;
                }
            }

            ApiResponse<ReservacionDto>? resultado;

            if (EsEdicion)
            {
                var request = new ActualizarReservacionRequest
                {
                    Id = Reservacion.Id,
                    FechaReservacion = Reservacion.FechaReservacion,
                    HoraReservacion = Reservacion.HoraReservacion,
                    MesaId = Reservacion.MesaId,
                    NumeroPersonas = Reservacion.NumeroPersonas,
                    Observaciones = Reservacion.Observaciones,
                    NotasEspeciales = Reservacion.NotasEspeciales,
                    RequerimientosEspeciales = Reservacion.RequerimientosEspeciales,
                    Estado = Reservacion.Estado,
                    EsUrgente = Reservacion.EsUrgente,
                    EsVIP = Reservacion.EsVIP,
                    ContactoAlternativo = Reservacion.ContactoAlternativo,
                    TelefonoAlternativo = Reservacion.TelefonoAlternativo,
                    EmailAlternativo = Reservacion.EmailAlternativo
                };

                resultado = await ReservacionesApi.ActualizarReservacionAsync(request);
            }
            else
            {
                var request = new CrearReservacionRequest
                {
                    ClienteId = Reservacion.ClienteId,
                    MesaId = Reservacion.MesaId,
                    FechaReservacion = Reservacion.FechaReservacion,
                    HoraReservacion = Reservacion.HoraReservacion,
                    NumeroPersonas = Reservacion.NumeroPersonas,
                    Observaciones = Reservacion.Observaciones,
                    NotasEspeciales = Reservacion.NotasEspeciales,
                    RequerimientosEspeciales = Reservacion.RequerimientosEspeciales,
                    CanalReservacion = Reservacion.CanalReservacion,
                    FuenteReservacion = Reservacion.FuenteReservacion,
                    EsRecurrente = Reservacion.EsRecurrente,
                    FrecuenciaRecurrencia = Reservacion.FrecuenciaRecurrencia,
                    FechaFinRecurrencia = Reservacion.FechaFinRecurrencia,
                    RequiereConfirmacion = Reservacion.RequiereConfirmacion,
                    EsUrgente = Reservacion.EsUrgente,
                    EsVIP = Reservacion.EsVIP,
                    EsGrupo = Reservacion.EsGrupo,
                    ContactoAlternativo = Reservacion.ContactoAlternativo,
                    TelefonoAlternativo = Reservacion.TelefonoAlternativo,
                    EmailAlternativo = Reservacion.EmailAlternativo,
                    NombreGrupo = Reservacion.NombreGrupo,
                    EmpresaGrupo = Reservacion.EmpresaGrupo,
                    TamañoGrupo = Reservacion.TamañoGrupo
                };

                var resultadoCrear = await ReservacionesApi.CrearReservacionAsync(request);
                resultado = resultadoCrear;
            }

            if (resultado != null)
            {
                await OnReservacionGuardada.InvokeAsync(resultado);
                await Cerrar();
                await JSRuntime.InvokeVoidAsync("alert", EsEdicion ? "Reservación actualizada correctamente" : "Reservación creada correctamente");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al guardar la reservación");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task Cerrar()
    {
        await MostrarChanged.InvokeAsync(false);
    }

