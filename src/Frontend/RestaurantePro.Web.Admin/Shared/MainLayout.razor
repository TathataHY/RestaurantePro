@inherits LayoutComponentBase

<PageTitle>RestaurantePro Admin</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main-content">
        <div class="top-row">
            <div class="d-flex align-items-center gap-3">
                <h1 class="h4 mb-0 fw-bold text-primary">RestaurantePro Admin</h1>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
                    <button class="theme-toggle @(isDarkMode ? "active" : "")" @onclick="ToggleTheme" title="Cambiar tema">
                    </button>
                </div>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isDarkMode = false;

    protected override async Task OnInitializedAsync()
    {
        // Cargar preferencia de tema desde localStorage
        LoadThemePreference();
    }

    private void LoadThemePreference()
    {
        // Aquí podrías cargar la preferencia desde localStorage
        // Por ahora usamos el tema claro por defecto
        isDarkMode = false;
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        
        // Aplicar tema al body
        if (isDarkMode)
        {
            await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-theme", "dark");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-theme", "light");
        }
        
        // Guardar preferencia (opcional)
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "theme", isDarkMode ? "dark" : "light");
        
        StateHasChanged();
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}
