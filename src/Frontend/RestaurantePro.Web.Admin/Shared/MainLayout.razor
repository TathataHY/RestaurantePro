@inherits LayoutComponentBase
@using RestaurantePro.Web.Admin.Components

<PageTitle>RestaurantePro Admin</PageTitle>

<div class="page">
    <div class="sidebar @(isSidebarCollapsed ? "collapsed" : "")">
        <NavMenu @ref="navMenuComponent" />
    </div>

    <main class="main-content">
        <RestaurantePro.Web.Admin.Components.Header />
        
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isSidebarCollapsed = false;
    private NavMenu? navMenuComponent;

    public void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
        navMenuComponent?.ToggleSidebar();
        StateHasChanged();
    }
}
