@code {
    private bool isSidebarCollapsed = false;
    private bool isDarkMode = false;

    private string? SidebarCssClass => isSidebarCollapsed ? "collapsed" : null;
    private string? NavTextCssClass => isSidebarCollapsed ? "hidden" : null;

    public void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
        StateHasChanged();
    }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private RestaurantePro.Web.Admin.Auth.JwtAuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private RestaurantePro.Web.Admin.Services.TokenStore TokenStore { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private bool isAuthenticated;
    private string userName = string.Empty;
    private bool IsAdminOrGerente = false;

    protected override async Task OnInitializedAsync()
    {
        // Cargar preferencia de tema desde localStorage
        await LoadThemePreference();
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        userName = isAuthenticated ? user.Identity?.Name ?? "" : string.Empty;
        
        // Verificar si el usuario tiene rol de Administrador o Gerente
        IsAdminOrGerente = user.IsInRole("Administrador") ||
                          user.IsInRole("Gerente") || 
                          TokenStore.Roles.Contains("Administrador") ||
                          TokenStore.Roles.Contains("Gerente");
    }

    private async Task LoadThemePreference()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "theme");
            isDarkMode = theme == "dark";
            await ApplyTheme();
        }
        catch
        {
            isDarkMode = false;
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await ApplyTheme();
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "theme", isDarkMode ? "dark" : "light");
    }

    private async Task ApplyTheme()
    {
        if (isDarkMode)
        {
            await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-theme", "dark");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-theme", "light");
        }
    }

}