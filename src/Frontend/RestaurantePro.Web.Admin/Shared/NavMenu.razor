            </div>
        </div>

        <!-- Operaciones -->
        <div class="nav-section">
            <div class="nav-section-title">Operaciones</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="mesas">
                    <span class="material-symbols-outlined">table_restaurant</span> Mesas
