            <div class="nav-section-title">Comercial</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="clientes">
                    <span class="material-symbols-outlined">people</span> Clientes
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="facturas">
                    <span class="material-symbols-outlined">receipt</span> Facturas
