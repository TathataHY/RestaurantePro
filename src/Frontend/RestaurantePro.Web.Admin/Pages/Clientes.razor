@attribute [Authorize]
@page "/clientes"
@inject IClientesApiService ClientesApi
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@using RestaurantePro.Web.Admin.Services
@inject IJSRuntime JSRuntime

<PageTitle>Clientes</PageTitle>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Gestión de Clientes</h1>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-info" @onclick="MostrarEstadisticas">
            <i class="oi oi-bar-chart"></i> Estadísticas
        </button>
        <button class="btn btn-primary" @onclick="NuevoCliente">
            <i class="oi oi-plus"></i> Nuevo Cliente
        </button>
    </div>
</div>

<!-- Estadísticas generales -->
@if (estadisticas != null)
{
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card border-left-primary">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Clientes</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.TotalClientes</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-success">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Activos</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.ClientesActivos</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-info">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Frecuentes</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.ClientesFrecuentes</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-warning">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">VIP</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.ClientesVIP</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-danger">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Total Gastado</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.TotalGastado.ToString("C0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-primary">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Promedio Gasto</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.PromedioGasto.ToString("C0")</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filtros de búsqueda -->
<ClienteFiltros Filtros="filtros" 
                OnFiltrosAplicados="AplicarFiltros"
                Aplicando="cargando" />

<!-- Lista de clientes -->
<ClienteList Clientes="clientes" 
             Paginacion="paginacion"
             OnEditarCliente="EditarCliente"
             OnEliminarCliente="EliminarCliente"
             OnToggleActivar="ToggleActivar"
             OnVerDetalles="VerDetalles"
             OnNuevoCliente="NuevoCliente"
             OnCambiarPagina="CambiarPagina"
             OnExportarExcel="ExportarExcel" />

<!-- Formulario de cliente -->
<ClienteForm Mostrar="mostrarFormulario" 
             MostrarChanged="MostrarFormularioChanged"
             OnClienteGuardado="ClienteGuardado" />

<!-- Modal de detalles del cliente -->
@if (mostrarDetalles && clienteSeleccionado != null)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="oi oi-person"></i> Detalles del Cliente: @clienteSeleccionado.NombreCompleto
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarDetalles"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Información Personal</h6>
                            <table class="table table-sm">
                                <tr><td><strong>Nombre:</strong></td><td>@clienteSeleccionado.NombreCompleto</td></tr>
                                <tr><td><strong>Email:</strong></td><td>@clienteSeleccionado.Email</td></tr>
                                <tr><td><strong>Teléfono:</strong></td><td>@(clienteSeleccionado.Telefono ?? "No especificado")</td></tr>
                                <tr><td><strong>Edad:</strong></td><td>@clienteSeleccionado.Edad años</td></tr>
                                <tr><td><strong>Fecha Registro:</strong></td><td>@clienteSeleccionado.FechaRegistro.ToString("dd/MM/yyyy")</td></tr>
                                <tr><td><strong>Última Visita:</strong></td><td>@(clienteSeleccionado.UltimaVisita?.ToString("dd/MM/yyyy") ?? "Nunca")</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Información Comercial</h6>
                            <table class="table table-sm">
                                <tr><td><strong>Total Gastado:</strong></td><td>@clienteSeleccionado.TotalGastado.ToString("C0")</td></tr>
                                <tr><td><strong>Total Compras:</strong></td><td>@clienteSeleccionado.TotalCompras</td></tr>
                                <tr><td><strong>Total Visitas:</strong></td><td>@clienteSeleccionado.TotalVisitas</td></tr>
                                <tr><td><strong>Promedio Gasto:</strong></td><td>@clienteSeleccionado.PromedioGasto.ToString("C0")</td></tr>
                                <tr><td><strong>Segmento:</strong></td><td>@clienteSeleccionado.Segmento</td></tr>
                                <tr><td><strong>Puntos Fidelización:</strong></td><td>@clienteSeleccionado.PuntosFidelizacion</td></tr>
                            </table>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(clienteSeleccionado.Direccion) || !string.IsNullOrEmpty(clienteSeleccionado.Ciudad))
                    {
                        <h6>Ubicación</h6>
                        <p>
                            @if (!string.IsNullOrEmpty(clienteSeleccionado.Direccion))
                            {
                                @clienteSeleccionado.Direccion<br>
                            }
                            @if (!string.IsNullOrEmpty(clienteSeleccionado.Ciudad))
                            {
                                @clienteSeleccionado.Ciudad
                                @if (!string.IsNullOrEmpty(clienteSeleccionado.Pais))
                                {
                                    <text>, @clienteSeleccionado.Pais</text>
                                }
                            }
                        </p>
                    }
                    
                    @if (!string.IsNullOrEmpty(clienteSeleccionado.PreferenciasAlimentarias) || !string.IsNullOrEmpty(clienteSeleccionado.Alergias))
                    {
                        <h6>Preferencias</h6>
                        @if (!string.IsNullOrEmpty(clienteSeleccionado.PreferenciasAlimentarias))
                        {
                            <p><strong>Preferencias Alimentarias:</strong> @clienteSeleccionado.PreferenciasAlimentarias</p>
                        }
                        @if (!string.IsNullOrEmpty(clienteSeleccionado.Alergias))
                        {
                            <p><strong>Alergias:</strong> @clienteSeleccionado.Alergias</p>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarDetalles">
                        <i class="oi oi-x"></i> Cerrar
                    </button>
                    <button type="button" class="btn btn-warning" @onclick="EditarClienteDesdeDetalles">
                        <i class="oi oi-pencil"></i> Editar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private ClienteFiltrosDto filtros = new();
    private List<ClienteDto>? clientes;
    private PaginatedList<ClienteDto>? paginacion;
    private ClienteEstadisticasDto? estadisticas;
    private ClienteDto? clienteSeleccionado;
    
    private bool mostrarFormulario = false;
    private bool mostrarDetalles = false;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        await Task.WhenAll(
            CargarClientes(),
            CargarEstadisticas()
        );
    }

    private async Task CargarClientes()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            var resultado = await ClientesApi.ObtenerClientesAsync(filtros);
            if (resultado != null)
            {
                clientes = resultado.Items?.ToList() ?? new List<ClienteDto>();
                paginacion = resultado;
            }
            else
            {
                clientes = new List<ClienteDto>();
                paginacion = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
            clientes = new List<ClienteDto>();
            paginacion = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarEstadisticas()
    {
        try
        {
            estadisticas = await ClientesApi.ObtenerEstadisticasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar estadísticas: {ex.Message}");
        }
    }

    private async Task AplicarFiltros(ClienteFiltrosDto filtrosAplicados)
    {
        filtros = filtrosAplicados;
        await CargarClientes();
    }

    private async Task CambiarPagina(int pagina)
    {
        filtros.PageNumber = pagina;
        await CargarClientes();
    }

    private void NuevoCliente()
    {
        mostrarFormulario = true;
        StateHasChanged();
    }

    private void EditarCliente(ClienteDto cliente)
    {
        clienteSeleccionado = cliente;
        mostrarFormulario = true;
        StateHasChanged();
    }

    private void EditarClienteDesdeDetalles()
    {
        if (clienteSeleccionado != null)
        {
            mostrarDetalles = false;
            mostrarFormulario = true;
            StateHasChanged();
        }
    }

    private async Task EliminarCliente(ClienteDto cliente)
    {
        var confirmar = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Estás seguro de que deseas eliminar al cliente '{cliente.NombreCompleto}'?");
        
        if (confirmar)
        {
            try
            {
                var resultado = await ClientesApi.EliminarClienteAsync(cliente.Id);
                if (resultado == true)
                {
                    await CargarClientes();
                    await JSRuntime.InvokeVoidAsync("alert", "Cliente eliminado correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Error al eliminar el cliente");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task ToggleActivar(ClienteDto cliente)
    {
        try
        {
            var resultado = await ClientesApi.ToggleActivarClienteAsync(cliente.Id);
            if (resultado == true)
            {
                await CargarClientes();
                await JSRuntime.InvokeVoidAsync("alert", 
                    cliente.EstaActivo ? "Cliente desactivado correctamente" : "Cliente activado correctamente");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al cambiar el estado del cliente");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private void VerDetalles(ClienteDto cliente)
    {
        clienteSeleccionado = cliente;
        mostrarDetalles = true;
        StateHasChanged();
    }

    private void CerrarDetalles()
    {
        mostrarDetalles = false;
        clienteSeleccionado = null;
        StateHasChanged();
    }

    private void MostrarFormularioChanged(bool mostrar)
    {
        mostrarFormulario = mostrar;
        if (!mostrar)
        {
            clienteSeleccionado = null;
        }
        StateHasChanged();
    }

    private async Task ClienteGuardado(ClienteDto cliente)
    {
        await CargarDatos();
        mostrarFormulario = false;
        clienteSeleccionado = null;
        StateHasChanged();
    }

    private async Task MostrarEstadisticas()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función de estadísticas detalladas pendiente");
    }

    private async Task ExportarExcel()
    {
        try
        {
            var resultado = await ClientesApi.ExportarClientesAsync(filtros, "Excel");
            if (resultado?.Success == true && resultado.Data != null)
            {
                await JSRuntime.InvokeVoidAsync("descargarArchivo", 
                    Convert.ToBase64String(resultado.Data), 
                    $"clientes_{DateTime.Now:yyyyMMdd}.xlsx", 
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al exportar clientes");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al exportar: {ex.Message}");
        }
    }
}
