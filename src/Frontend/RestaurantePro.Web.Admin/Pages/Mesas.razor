@attribute [Authorize]
@page "/mesas"

@using RestaurantePro.Web.Admin.Components
@using RestaurantePro.Web.Admin.Models
@inject RestaurantePro.Web.Admin.Services.IMesasApiService MesasApi

<PageTitle>Mesas</PageTitle>

<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Gestión de Mesas</h1>
        <p class="text-gray-600 mt-2">Control de mesas, estados y disponibilidad del restaurante</p>
    </div>
    <div class="flex items-center gap-3">
        <!-- Toggle de vista -->
        <div class="flex items-center bg-gray-100 rounded-lg p-1">
            <button class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md @(vistaTabla ? "bg-white text-blue-600 shadow-sm" : "text-gray-600")" 
                    @onclick="() => CambiarVista(true)">
                <span class="material-symbols-outlined text-sm">table_rows</span>
                Tabla
            </button>
            <button class="flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md @(!vistaTabla ? "bg-white text-blue-600 shadow-sm" : "text-gray-600")" 
                    @onclick="() => CambiarVista(false)">
                <span class="material-symbols-outlined text-sm">grid_view</span>
                Grid
            </button>
        </div>
        <button class="flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition-colors" @onclick="NuevaMesa">
            <span class="material-symbols-outlined">add</span>
            <span class="truncate">Nueva Mesa</span>
        </button>
    </div>
</div>

<!-- Dashboard de estadísticas -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6 mb-8">
    <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
        <p class="text-sm font-medium text-gray-500">Total de Mesas</p>
        <p class="text-3xl font-bold text-gray-900">@totalMesas</p>
    </div>
    <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
        <p class="text-sm font-medium text-gray-500">Disponibles</p>
        <p class="text-3xl font-bold text-green-600">@mesasDisponibles</p>
    </div>
    <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
        <p class="text-sm font-medium text-gray-500">Ocupadas</p>
        <p class="text-3xl font-bold text-red-600">@mesasOcupadas</p>
    </div>
    <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
        <p class="text-sm font-medium text-gray-500">Reservadas</p>
        <p class="text-3xl font-bold text-blue-600">@mesasReservadas</p>
    </div>
    <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
        <p class="text-sm font-medium text-gray-500">Ocupación</p>
        <p class="text-3xl font-bold text-orange-600">@ocupacionPromedio%</p>
    </div>
    <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
        <p class="text-sm font-medium text-gray-500">Capacidad Total</p>
        <p class="text-3xl font-bold text-purple-600">@capacidadTotal</p>
    </div>
</div>

<!-- Filtros y acciones -->
<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Filtros Avanzados</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
        <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-gray-700">Estado</span>
            <select class="form-select w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" @bind="estado" @bind:after="BuscarAsync">
                <option value="">Todos los estados</option>
                <option value="Disponible">Disponible</option>
                <option value="Ocupada">Ocupada</option>
                <option value="Reservada">Reservada</option>
                <option value="Mantenimiento">Mantenimiento</option>
            </select>
        </label>
        <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-gray-700">Zona</span>
            <select class="form-select w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" @bind="ubicacion" @bind:after="BuscarAsync">
                <option value="">Todas las zonas</option>
                <option value="Interior">Interior</option>
                <option value="Terraza">Terraza</option>
                <option value="VIP">VIP</option>
                <option value="Ventana">Ventana</option>
                <option value="Privada">Privada</option>
                <option value="Barra">Barra</option>
            </select>
        </label>
        <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-gray-700">Capacidad Mínima</span>
            <input class="form-input w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" 
                   placeholder="2" 
                   type="number" 
                   min="1" 
                   @bind="capacidadMinima" 
                   @onkeyup="OnFiltroChanged" />
        </label>
        <button class="w-full lg:w-auto flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition-colors" @onclick="BuscarAsync">
            <span class="material-symbols-outlined text-base">filter_alt</span>
            Aplicar Filtros
        </button>
    </div>
</div>

@if (cargando)
{
    <div class="flex items-center justify-center py-12">
        <div class="flex flex-col items-center gap-4">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <span class="text-gray-500">Cargando mesas...</span>
        </div>
    </div>
}
else if (mesas is null)
{
    <div class="flex items-center justify-center py-12">
        <div class="flex flex-col items-center gap-4">
            <span class="material-symbols-outlined text-6xl text-gray-300">error</span>
            <span class="text-gray-500">No se pudieron cargar las mesas</span>
        </div>
    </div>
}
else if (!mesas.Any())
{
    <div class="flex items-center justify-center py-12">
        <div class="flex flex-col items-center gap-4">
            <span class="material-symbols-outlined text-6xl text-gray-300">table_restaurant</span>
            <span class="text-gray-500">No hay mesas disponibles</span>
        </div>
    </div>
}
else
{
    @if (vistaTabla)
    {
        <!-- Vista de Tabla -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-500">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-100">
                        <tr>
                            <th class="px-6 py-3" scope="col">Número</th>
                            <th class="px-6 py-3" scope="col">Capacidad</th>
                            <th class="px-6 py-3" scope="col">Estado</th>
                            <th class="px-6 py-3" scope="col">Zona</th>
                            <th class="px-6 py-3 text-right" scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in mesas)
                        {
                            <tr class="bg-white border-b hover:bg-gray-50">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap" scope="row">Mesa @m.Numero</th>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">@m.Capacidad personas</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetEstadoClass(m.Estado)">@m.Estado</span>
                                </td>
                                <td class="px-6 py-4 text-gray-900">@m.Zona</td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <button class="p-1 text-gray-400 hover:text-blue-600" @onclick="() => VerDetalles(m)" title="Ver detalles">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </button>
                                    <button class="p-1 text-gray-400 hover:text-green-600" @onclick="() => EditarMesa(m)" title="Editar">
                                        <span class="material-symbols-outlined">edit</span>
                                    </button>
                                    <button class="p-1 text-gray-400 hover:text-orange-500" @onclick="() => MostrarAccionesAdmin(m)" title="Acciones administrativas">
                                        <span class="material-symbols-outlined">settings</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Vista de Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var m in mesas)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-semibold text-gray-900">Mesa @m.Numero</h3>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetEstadoClass(m.Estado)">@m.Estado</span>
                    </div>
                    
                    <div class="space-y-3 mb-6">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-gray-400 text-sm">group</span>
                            <span class="text-sm text-gray-600">@m.Capacidad personas</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-gray-400 text-sm">location_on</span>
                            <span class="text-sm text-gray-600">@m.Zona</span>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-center">
                        <div class="flex space-x-1">
                            <button class="p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" @onclick="() => VerDetalles(m)" title="Ver detalles">
                                <span class="material-symbols-outlined text-sm">visibility</span>
                            </button>
                            <button class="p-2 text-gray-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors" @onclick="() => EditarMesa(m)" title="Editar">
                                <span class="material-symbols-outlined text-sm">edit</span>
                            </button>
                            <button class="p-2 text-gray-400 hover:text-orange-500 hover:bg-orange-50 rounded-lg transition-colors" @onclick="() => MostrarAccionesAdmin(m)" title="Acciones administrativas">
                                <span class="material-symbols-outlined text-sm">settings</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Controles de Paginación -->
    @if (mesas != null && mesas.Any() && totalPaginas > 1)
    {
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 mt-6">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <!-- Información de paginación -->
                <div class="flex items-center gap-4 text-sm text-gray-600">
                    <span>Mostrando @((paginaActual - 1) * tamanioPagina + 1) - @(Math.Min(paginaActual * tamanioPagina, mesasPaginadas?.TotalCount ?? 0)) de @(mesasPaginadas?.TotalCount ?? 0) mesas</span>
                    
                    <!-- Selector de tamaño de página -->
                    <div class="flex items-center gap-2">
                        <span>Mostrar:</span>
                        <select class="form-select text-sm border-gray-300 rounded-md px-2 py-1" 
                                value="@tamanioPagina"
                                @onchange="OnTamanoPaginaChanged">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <span>por página</span>
                    </div>
                </div>

                <!-- Navegación de páginas -->
                <div class="flex items-center gap-2">
                    <!-- Botón Anterior -->
                    <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
                            disabled="@(paginaActual == 1)"
                            @onclick="async () => await CambiarPagina(paginaActual - 1)">
                        <span class="material-symbols-outlined text-sm">chevron_left</span>
                        Anterior
                    </button>

                    <!-- Números de página -->
                    <div class="flex items-center gap-1">
                        @{
                            var inicio = Math.Max(1, paginaActual - 2);
                            var fin = Math.Min(totalPaginas, paginaActual + 2);
                        }
                        
                        @if (inicio > 1)
                        {
                            <button class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                                    @onclick="async () => await CambiarPagina(1)">1</button>
                            @if (inicio > 2)
                            {
                                <span class="px-2 text-gray-500">...</span>
                            }
                        }
                        
                        @for (int i = inicio; i <= fin; i++)
                        {
                            var pagina = i;
                            <button class="px-3 py-2 text-sm font-medium rounded-md border @(pagina == paginaActual ? "bg-blue-600 text-white border-blue-600" : "text-gray-500 bg-white border-gray-300 hover:bg-gray-50")"
                                    @onclick="async () => await CambiarPagina(pagina)">@pagina</button>
                        }
                        
                        @if (fin < totalPaginas)
                        {
                            @if (fin < totalPaginas - 1)
                            {
                                <span class="px-2 text-gray-500">...</span>
                            }
                            <button class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                                    @onclick="async () => await CambiarPagina(totalPaginas)">@totalPaginas</button>
                        }
                    </div>

                    <!-- Botón Siguiente -->
                    <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
                            disabled="@(paginaActual == totalPaginas)"
                            @onclick="async () => await CambiarPagina(paginaActual + 1)">
                        Siguiente
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>
    }
}

@if (mostrandoModal)
{
    <MesaModal Mostrar="mostrandoModal" 
               Editando="editando" 
               CrearModel="@crearDto"
               EditarModel="@editarDto"
               Error="@error" 
               Guardando="@guardando"
               OnCerrar="CerrarModal" 
               OnGuardar="GuardarAsync" />
}

@if (mostrandoDetalles && mesaSeleccionada != null)
{
    <MesaDetallesModal Mostrar="mostrandoDetalles" 
                       Mesa="@mesaSeleccionada"
                       OnCerrar="CerrarDetalles" 
                       OnGuardarNotas="GuardarNotas" />
}

<!-- Modal de Acciones Administrativas -->
@if (mostrandoAccionesAdmin && mesaParaAccionAdmin != null)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4">
            <div class="flex items-center justify-between p-6 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900">Acciones Administrativas</h3>
                <button @onclick="CerrarAccionesAdmin" class="text-gray-400 hover:text-gray-600">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            
            <div class="p-6">
                <div class="mb-4">
                    <p class="text-sm text-gray-600 mb-2">Mesa seleccionada:</p>
                    <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                        <span class="material-symbols-outlined text-gray-400">table_restaurant</span>
                        <div>
                            <p class="font-medium text-gray-900">Mesa @mesaParaAccionAdmin.Numero</p>
                            <p class="text-sm text-gray-500">@mesaParaAccionAdmin.Capacidad personas • @mesaParaAccionAdmin.Zona</p>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @GetEstadoClass(mesaParaAccionAdmin.Estado)">@mesaParaAccionAdmin.Estado</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    @if (mesaParaAccionAdmin.Estado != "Disponible")
                    {
                        <button @onclick="() => ResetearMesaDisponible()" 
                                disabled="@procesandoAccion"
                                class="w-full flex items-center gap-3 p-3 text-left text-green-700 bg-green-50 hover:bg-green-100 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            <span class="material-symbols-outlined">refresh</span>
                            <div>
                                <p class="font-medium">Resetear a Disponible</p>
                                <p class="text-sm">Marcar la mesa como disponible para uso</p>
                            </div>
                        </button>
                    }

                    @if (mesaParaAccionAdmin.Estado != "FueraDeServicio")
                    {
                        <button @onclick="() => PonerFueraDeServicio()" 
                                disabled="@procesandoAccion"
                                class="w-full flex items-center gap-3 p-3 text-left text-orange-700 bg-orange-50 hover:bg-orange-100 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            <span class="material-symbols-outlined">block</span>
                            <div>
                                <p class="font-medium">Poner Fuera de Servicio</p>
                                <p class="text-sm">Marcar la mesa como no disponible (mantenimiento)</p>
                            </div>
                        </button>
                    }

                    @if (mesaParaAccionAdmin.Estado == "FueraDeServicio")
                    {
                        <button @onclick="() => RestaurarMesa()" 
                                disabled="@procesandoAccion"
                                class="w-full flex items-center gap-3 p-3 text-left text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            <span class="material-symbols-outlined">restore</span>
                            <div>
                                <p class="font-medium">Restaurar Mesa</p>
                                <p class="text-sm">Volver a poner la mesa en servicio</p>
                            </div>
                        </button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-lg">
                        <p class="text-sm text-red-700">@error</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
  private PaginatedList<MesaDto>? mesasPaginadas;
  private List<MesaDto>? mesas;
  private bool cargando = true;
  private string estado = string.Empty;
  private string ubicacion = string.Empty;
  private int? capacidadMinima;
  private string tipoFiltro = string.Empty;
  private bool vistaTabla = true;

  // Paginación
  private int paginaActual = 1;
  private int tamanioPagina = 10;
  private int totalPaginas = 1;

  // Estadísticas
  private int totalMesas = 0;
  private int mesasDisponibles = 0;
  private int mesasOcupadas = 0;
  private int mesasReservadas = 0;
  private int ocupacionPromedio = 0;
  private int capacidadTotal = 0;

  private bool mostrandoModal = false;
  private bool editando = false;
  private bool guardando = false;
  private string error = string.Empty;
  private Guid mesaIdEditando;
  private CrearMesaRequest crearDto = new();
  private ActualizarMesaRequest editarDto = new();

  // Modal de detalles
  private bool mostrandoDetalles = false;
  private MesaDto? mesaSeleccionada;

  // Variables para acciones administrativas
  private bool mostrandoAccionesAdmin = false;
  private MesaDto? mesaParaAccionAdmin;
  private bool procesandoAccion = false;

  protected override async Task OnInitializedAsync()
  {
    await CargarAsync();
  }

  private async Task CargarAsync()
  {
    cargando = true;
    mesasPaginadas = await MesasApi.ObtenerAsync(
      string.IsNullOrWhiteSpace(estado) ? null : estado,
      string.IsNullOrWhiteSpace(ubicacion) ? null : ubicacion,
      capacidadMinima,
      paginaActual,
      tamanioPagina
    );
    
    if (mesasPaginadas != null)
    {
      mesas = mesasPaginadas.Items;
      totalPaginas = mesasPaginadas.TotalPages;
    }
    else
    {
      mesas = new List<MesaDto>();
      totalPaginas = 1;
    }
    
    CalcularEstadisticas();
    cargando = false;
    StateHasChanged();
  }

  private void CalcularEstadisticas()
  {
    if (mesas == null) return;
    
    totalMesas = mesas.Count;
    mesasDisponibles = mesas.Count(m => m.Estado == "Disponible");
    mesasOcupadas = mesas.Count(m => m.Estado == "Ocupada");
    mesasReservadas = mesas.Count(m => m.Estado == "Reservada");
    ocupacionPromedio = totalMesas > 0 ? (int)((mesasOcupadas + mesasReservadas) * 100.0 / totalMesas) : 0;
    capacidadTotal = mesas.Sum(m => m.Capacidad);
  }

  private void CambiarVista(bool esTabla)
  {
    vistaTabla = esTabla;
    StateHasChanged();
  }

  private string GetEstadoClass(string estado)
  {
    return estado switch
    {
        "Disponible" => "bg-green-100 text-green-800",
        "Ocupada" => "bg-red-100 text-red-800",
        "Reservada" => "bg-blue-100 text-blue-800",
        "Mantenimiento" => "bg-gray-100 text-gray-800",
        _ => "bg-gray-100 text-gray-800"
    };
  }

  private async Task OnFiltroChanged()
  {
    await Task.Delay(500); // Debounce
    await BuscarAsync();
  }

  private void VerDetalles(MesaDto mesa)
  {
    mesaSeleccionada = mesa;
    mostrandoDetalles = true;
  }

  private void MostrarAccionesAdmin(MesaDto mesa)
  {
    mesaParaAccionAdmin = mesa;
    mostrandoAccionesAdmin = true;
    error = string.Empty;
  }

  private void CerrarAccionesAdmin()
  {
    mostrandoAccionesAdmin = false;
    mesaParaAccionAdmin = null;
    error = string.Empty;
    procesandoAccion = false;
  }

  private async Task ResetearMesaDisponible()
  {
    if (mesaParaAccionAdmin == null) return;

    procesandoAccion = true;
    error = string.Empty;

    try
    {
      var success = await MesasApi.CambiarEstadoMesaAsync(mesaParaAccionAdmin.Id, "Disponible");
      if (success)
      {
        await CargarAsync();
        CerrarAccionesAdmin();
      }
      else
      {
        error = "No se pudo resetear la mesa a disponible.";
      }
    }
    catch (Exception ex)
    {
      error = $"Error al resetear la mesa: {ex.Message}";
    }
    finally
    {
      procesandoAccion = false;
      StateHasChanged();
    }
  }

  private async Task PonerFueraDeServicio()
  {
    if (mesaParaAccionAdmin == null) return;

    procesandoAccion = true;
    error = string.Empty;

    try
    {
      var success = await MesasApi.CambiarEstadoMesaAsync(mesaParaAccionAdmin.Id, "FueraDeServicio");
      if (success)
      {
        await CargarAsync();
        CerrarAccionesAdmin();
      }
      else
      {
        error = "No se pudo poner la mesa fuera de servicio.";
      }
    }
    catch (Exception ex)
    {
      error = $"Error al poner la mesa fuera de servicio: {ex.Message}";
    }
    finally
    {
      procesandoAccion = false;
      StateHasChanged();
    }
  }

  private async Task RestaurarMesa()
  {
    if (mesaParaAccionAdmin == null) return;

    procesandoAccion = true;
    error = string.Empty;

    try
    {
      var success = await MesasApi.CambiarEstadoMesaAsync(mesaParaAccionAdmin.Id, "Disponible");
      if (success)
      {
        await CargarAsync();
        CerrarAccionesAdmin();
      }
      else
      {
        error = "No se pudo restaurar la mesa.";
      }
    }
    catch (Exception ex)
    {
      error = $"Error al restaurar la mesa: {ex.Message}";
    }
    finally
    {
      procesandoAccion = false;
      StateHasChanged();
    }
  }

  private void CerrarDetalles()
  {
    mostrandoDetalles = false;
    mesaSeleccionada = null;
  }

  private async Task GuardarNotas(string notas)
  {
    if (mesaSeleccionada != null)
    {
      try
      {
        // Aquí implementarías la lógica para guardar las notas
        // Por ahora solo actualizamos el objeto local
        mesaSeleccionada.Notas = notas;
        await CargarAsync(); // Recargar para reflejar cambios
        CerrarDetalles();
      }
      catch (Exception ex)
      {
        error = $"Error al guardar notas: {ex.Message}";
      }
    }
  }

  private Task BuscarAsync() 
  {
    paginaActual = 1; // Reset a la primera página al buscar
    return CargarAsync();
  }

  private async Task CambiarPagina(int nuevaPagina)
  {
    if (nuevaPagina >= 1 && nuevaPagina <= totalPaginas && nuevaPagina != paginaActual)
    {
      paginaActual = nuevaPagina;
      await CargarAsync();
    }
  }

  private async Task CambiarTamanoPagina(int nuevoTamano)
  {
    if (nuevoTamano > 0 && nuevoTamano != tamanioPagina)
    {
      tamanioPagina = nuevoTamano;
      paginaActual = 1; // Reset a la primera página
      await CargarAsync();
    }
  }

  private void NuevaMesa()
  {
    crearDto = new()
    {
      Numero = "",
      Estado = "Disponible" // Estado por defecto para nuevas mesas
    };
    editando = false;
    error = string.Empty;
    mostrandoModal = true;
  }

  private void EditarMesa(MesaDto m)
  {
    mesaIdEditando = m.Id;
    editarDto = new ActualizarMesaRequest
    {
      Numero = m.Numero,
      Capacidad = m.Capacidad,
      Ubicacion = m.Zona, // m.Zona viene del DTO, pero se mapea a Ubicacion en el request
      Estado = m.Estado,
      Descripcion = m.Descripcion,
      Notas = m.Notas,
      TieneVentana = m.TieneVentana,
      TieneSofa = m.TieneSofa,
      EsAccesible = m.EsAccesible,
      TieneEnchufe = m.TieneEnchufe
    };
    editando = true;
    error = string.Empty;
    mostrandoModal = true;
  }

  private async Task GuardarAsync()
  {
    error = string.Empty;
    bool ok;
    if (editando)
    {
      try
      {
        var actualizado = await MesasApi.ActualizarAsync(mesaIdEditando, editarDto);
        ok = actualizado is not null;
      }
      catch (Exception ex)
      {
        error = ex.Message;
        return;
      }
    }
    else
    {
      // Validaciones de cliente
      if (string.IsNullOrWhiteSpace(crearDto.Numero)) { error = "El número de mesa es obligatorio."; return; }
      if (crearDto.Capacidad <= 0) { error = "La capacidad debe ser mayor a 0."; return; }
      if (string.IsNullOrWhiteSpace(crearDto.Ubicacion)) { error = "La ubicación es obligatoria."; return; }
      if (crearDto.Ubicacion.Length > 30) { error = "La ubicación no debe superar los 30 caracteres."; return; }
      if (!string.IsNullOrWhiteSpace(crearDto.Descripcion) && crearDto.Descripcion.Length > 200) { error = "La descripción no debe superar los 200 caracteres."; return; }

      try
      {
        var creado = await MesasApi.CrearAsync(crearDto);
        ok = creado is not null;
      }
      catch (Exception ex)
      {
        error = ex.Message;
        return;
      }
    }
    if (!ok)
    {
      error = "No se pudo guardar la mesa.";
      return;
    }
    mostrandoModal = false;
    await CargarAsync();
  }

  private void CerrarModal()
  {
    mostrandoModal = false;
  }


  private async Task OnTamanoPaginaChanged(ChangeEventArgs e)
  {
    if (int.TryParse(e.Value?.ToString(), out int nuevoTamano))
    {
      await CambiarTamanoPagina(nuevoTamano);
    }
  }
}


