    // Funciones de cálculo para métricas
    private int CalcularEficiencia()
    {
        if (estadisticas?.TotalComandas == 0) return 0;
        var completadas = estadisticas?.ComandasEntregadas ?? 0;
        var total = estadisticas?.TotalComandas ?? 1;
        return (int)((double)completadas / total * 100);
    }

    private double CalcularTasaCancelacion()
    {
        if (estadisticas?.TotalComandas == 0) return 0;
        var canceladas = estadisticas?.ComandasCanceladas ?? 0;
        var total = estadisticas?.TotalComandas ?? 1;
        return Math.Round((double)canceladas / total * 100, 1);
    }

    private double CalcularPorcentaje(int valor, int total)
    {
        if (total == 0) return 0;
        return Math.Round((double)valor / total * 100, 1);
    }

    private int CalcularAlturaBarra(int hora)
    {
        // Simulación de datos por hora (en un caso real vendría del backend)
        var datosPorHora = new Dictionary<int, int>
        {
            {8, 15}, {9, 25}, {10, 35}, {11, 45}, {12, 55}, {13, 60},
            {14, 50}, {15, 40}, {16, 30}, {17, 35}, {18, 45}, {19, 40}
        };
        
        var valor = datosPorHora.GetValueOrDefault(hora, 0);
        return Math.Max(20, (int)(valor * 2.5)); // Mínimo 20px, máximo basado en el valor
    }

    private string GetEstadoClass(string estado)
    {
        return estado switch
        {
            "Pendiente" => "bg-yellow-100 text-yellow-800",
            "EnProceso" => "bg-blue-100 text-blue-800",
            "Lista" => "bg-green-100 text-green-800",
            "Entregada" => "bg-gray-100 text-gray-800",
            "Cancelada" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetPrioridadClass(string prioridad)
    {
        return prioridad switch
        {
            "Urgente" => "bg-red-100 text-red-800",
            "Alta" => "bg-orange-100 text-orange-800",
            "Normal" => "bg-blue-100 text-blue-800",
            "Baja" => "bg-gray-100 text-gray-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
