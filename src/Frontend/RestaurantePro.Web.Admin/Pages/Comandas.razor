@attribute [Authorize]
@page "/comandas"
@inject RestaurantePro.Web.Admin.Services.ComandasApiService ComandasApi
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@inject IJSRuntime JSRuntime

<PageTitle>Análisis de Comandas</PageTitle>

<!-- Header Principal -->
<div class="flex-1 px-8 md:px-16 lg:px-24 py-8">
    <div class="mx-auto max-w-7xl">
        <div class="mb-8">
            <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">Análisis de Comandas</h1>
            <p class="text-lg text-gray-600 dark:text-gray-400">Monitoreo, análisis y reportes del rendimiento operativo de comandas</p>
        </div>

        <!-- Botones de Acción Administrativa -->
        <div class="flex flex-wrap gap-4 mb-8">
            <button class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2 shadow-sm hover:shadow-md" @onclick="MostrarReportes">
                <span class="material-symbols-outlined">analytics</span>
                Reportes Avanzados
            </button>
            <button class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors flex items-center gap-2 shadow-sm hover:shadow-md" @onclick="ExportarExcel">
                <span class="material-symbols-outlined">download</span>
                Exportar Excel
            </button>
            <button class="px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-2 shadow-sm hover:shadow-md" @onclick="MostrarConfiguracion">
                <span class="material-symbols-outlined">settings</span>
                Configuración
            </button>
            <button class="px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors flex items-center gap-2 shadow-sm hover:shadow-md" @onclick="ActualizarDatos">
                <span class="material-symbols-outlined">refresh</span>
                Actualizar Datos
            </button>
        </div>
    </div>
</div>

<!-- Dashboard de Análisis -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Métricas Principales -->
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Total Comandas</p>
                <p class="text-3xl font-bold text-gray-900">@(estadisticas?.TotalComandas ?? 0)</p>
                <p class="text-sm text-green-600">+12% vs ayer</p>
            </div>
            <div class="bg-blue-100 p-3 rounded-lg">
                <span class="material-symbols-outlined text-blue-600 text-2xl">receipt_long</span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Tiempo Promedio</p>
                <p class="text-3xl font-bold text-gray-900">@(estadisticas?.TiempoPromedioPreparacion ?? 0) min</p>
                <p class="text-sm text-red-600">+3 min vs ayer</p>
            </div>
            <div class="bg-orange-100 p-3 rounded-lg">
                <span class="material-symbols-outlined text-orange-600 text-2xl">schedule</span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Eficiencia</p>
                <p class="text-3xl font-bold text-gray-900">@(CalcularEficiencia())%</p>
                <p class="text-sm text-green-600">+5% vs ayer</p>
            </div>
            <div class="bg-green-100 p-3 rounded-lg">
                <span class="material-symbols-outlined text-green-600 text-2xl">trending_up</span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-600">Cancelaciones</p>
                <p class="text-3xl font-bold text-gray-900">@(estadisticas?.ComandasCanceladas ?? 0)</p>
                <p class="text-sm text-red-600">@(CalcularTasaCancelacion())% tasa</p>
            </div>
            <div class="bg-red-100 p-3 rounded-lg">
                <span class="material-symbols-outlined text-red-600 text-2xl">cancel</span>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos de Análisis -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Gráfico de Comandas por Estado -->
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Distribución por Estado</h3>
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-4 h-4 bg-yellow-500 rounded"></div>
                    <span class="text-sm text-gray-600">Pendientes</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-32 bg-gray-200 rounded-full h-2">
                        <div class="bg-yellow-500 h-2 rounded-full" style="width: @(CalcularPorcentaje(estadisticas?.ComandasPendientes ?? 0, estadisticas?.TotalComandas ?? 1))%"></div>
                    </div>
                    <span class="text-sm font-medium text-gray-900">@(estadisticas?.ComandasPendientes ?? 0)</span>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-4 h-4 bg-blue-500 rounded"></div>
                    <span class="text-sm text-gray-600">En Proceso</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-32 bg-gray-200 rounded-full h-2">
                        <div class="bg-blue-500 h-2 rounded-full" style="width: @(CalcularPorcentaje(estadisticas?.ComandasEnProceso ?? 0, estadisticas?.TotalComandas ?? 1))%"></div>
                    </div>
                    <span class="text-sm font-medium text-gray-900">@(estadisticas?.ComandasEnProceso ?? 0)</span>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-4 h-4 bg-green-500 rounded"></div>
                    <span class="text-sm text-gray-600">Completadas</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-32 bg-gray-200 rounded-full h-2">
                        <div class="bg-green-500 h-2 rounded-full" style="width: @(CalcularPorcentaje(estadisticas?.ComandasEntregadas ?? 0, estadisticas?.TotalComandas ?? 1))%"></div>
                    </div>
                    <span class="text-sm font-medium text-gray-900">@(estadisticas?.ComandasEntregadas ?? 0)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico de Tiempo Promedio por Hora -->
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Tiempo Promedio por Hora</h3>
        <div class="h-48 flex items-end justify-between gap-2">
            @for (int i = 0; i < 12; i++)
            {
                var hora = i + 8; // 8 AM a 7 PM
                var altura = CalcularAlturaBarra(hora);
                <div class="flex flex-col items-center gap-2">
                    <div class="bg-blue-500 rounded-t w-8" style="height: @(altura)px;"></div>
                    <span class="text-xs text-gray-500">@hora:00</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Filtros de búsqueda -->
<ComandaFiltros Filtros="filtros" 
                OnFiltrosAplicados="AplicarFiltros"
                Aplicando="cargando" />

<!-- Vista de Monitoreo en Tiempo Real -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
    <div class="p-6 border-b border-gray-200">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold text-gray-900">Monitoreo en Tiempo Real</h3>
                <p class="text-sm text-gray-600">Vista de comandas activas para supervisión administrativa</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                <span class="text-sm text-gray-600">En vivo</span>
            </div>
        </div>
    </div>
    
    <div class="p-6">
        @if (cargando)
        {
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                <span class="ml-3 text-gray-600">Cargando comandas...</span>
            </div>
        }
        else if (comandas == null || !comandas.Any())
        {
            <div class="text-center py-12">
                <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">receipt_long</span>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No hay comandas activas</h3>
                <p class="text-gray-600">No se encontraron comandas para mostrar en este momento.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                @foreach (var comanda in comandas.Take(12))
                {
                    <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                        <div class="flex items-start justify-between mb-3">
                            <div>
                                <h4 class="font-semibold text-gray-900">Comanda #@comanda.NumeroComanda</h4>
                                <p class="text-sm text-gray-600">@comanda.FechaCreacion.ToString("HH:mm")</p>
                            </div>
                            <span class="px-2 py-1 text-xs font-medium rounded-full @GetEstadoClass(comanda.Estado)">
                                @comanda.Estado
                            </span>
                        </div>
                        
                        <div class="space-y-2 mb-4">
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <span class="material-symbols-outlined text-sm">table_restaurant</span>
                                <span>Mesa @comanda.MesaNumero</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <span class="material-symbols-outlined text-sm">person</span>
                                <span>@comanda.NumeroPersonas personas</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <span class="material-symbols-outlined text-sm">schedule</span>
                                <span>@comanda.MinutosTranscurridos min</span>
                            </div>
                        </div>
                        
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-gray-500">Prioridad:</span>
                                <span class="px-2 py-1 text-xs font-medium rounded @GetPrioridadClass(comanda.Prioridad)">
                                    @comanda.Prioridad
                                </span>
                            </div>
                            <button class="text-blue-600 hover:text-blue-800 text-sm font-medium" @onclick="() => VerDetalles(comanda)">
                                Ver detalles
                            </button>
                        </div>
                    </div>
                }
            </div>
            
            @if (comandas.Count() > 12)
            {
                <div class="mt-6 text-center">
                    <button class="px-4 py-2 text-sm font-medium text-blue-600 hover:text-blue-800 border border-blue-200 rounded-lg hover:bg-blue-50">
                        Ver todas las comandas (@comandas.Count())
                    </button>
                </div>
            }
        }
    </div>
</div>

<!-- Modal de Detalles de Comanda (Solo Lectura) -->
@if (mostrarDetalles && comandaSeleccionada != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <div class="m-4 w-full max-w-4xl rounded-2xl bg-white shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
            <div class="flex flex-col">
                <!-- Header del Modal -->
                <div class="flex items-center justify-between p-6 border-b border-gray-200">
                    <div class="flex items-center gap-3">
                        <div class="bg-blue-100 p-2 rounded-lg">
                            <span class="material-symbols-outlined text-blue-600">receipt_long</span>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-gray-800">Comanda #@comandaSeleccionada.NumeroComanda</h2>
                            <p class="text-sm text-gray-500">Información detallada para análisis administrativo</p>
                        </div>
                    </div>
                    <button class="p-2 rounded-full hover:bg-gray-100" @onclick="CerrarDetalles">
                        <span class="material-symbols-outlined text-gray-500">close</span>
                    </button>
                </div>

                <!-- Body del Modal -->
                <div class="p-6 max-h-[70vh] overflow-y-auto">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Información General -->
                        <div class="space-y-4">
                            <h3 class="text-lg font-semibold text-gray-700 border-b pb-2">Información General</h3>
                            <div class="space-y-3">
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Fecha Creación:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Estado:</span>
                                    <span class="px-2 py-1 text-xs font-medium rounded-full @GetEstadoClass(comandaSeleccionada.Estado)">
                                        @comandaSeleccionada.Estado
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Prioridad:</span>
                                    <span class="px-2 py-1 text-xs font-medium rounded @GetPrioridadClass(comandaSeleccionada.Prioridad)">
                                        @comandaSeleccionada.Prioridad
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Tipo:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.TipoComanda</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Personas:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.NumeroPersonas</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Tiempo Transcurrido:</span>
                                    <span class="text-sm font-medium text-orange-600">@comandaSeleccionada.MinutosTranscurridos min</span>
                                </div>
                            </div>
                        </div>

                        <!-- Información de Mesa y Cliente -->
                        <div class="space-y-4">
                            <h3 class="text-lg font-semibold text-gray-700 border-b pb-2">Mesa y Cliente</h3>
                            <div class="space-y-3">
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Mesa:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.MesaNumero</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Cliente:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.ClienteNombre</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Teléfono:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.ClienteTelefono</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Mesero:</span>
                                    <span class="text-sm font-medium">@comandaSeleccionada.MeseroNombre</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-600">Total:</span>
                                    <span class="text-lg font-bold text-green-600">@comandaSeleccionada.Total.ToString("C")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Productos -->
                    @if (comandaSeleccionada.Detalles != null && comandaSeleccionada.Detalles.Any())
                    {
                        <div class="mt-6">
                            <h3 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4">Productos</h3>
                            <div class="bg-gray-50 rounded-lg p-4">
                                <div class="space-y-3">
                                    @foreach (var detalle in comandaSeleccionada.Detalles)
                                    {
                                        <div class="flex items-center justify-between py-2 border-b border-gray-200 last:border-b-0">
                                            <div class="flex-1">
                                                <p class="font-medium text-gray-900">@detalle.ProductoNombre</p>
                                                <p class="text-sm text-gray-600">Cantidad: @detalle.Cantidad</p>
                                            </div>
                                            <div class="text-right">
                                                <p class="font-medium text-gray-900">@detalle.Subtotal.ToString("C")</p>
                                                <span class="px-2 py-1 text-xs font-medium rounded @GetEstadoClass(detalle.Estado)">
                                                    @detalle.Estado
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Footer del Modal -->
                <div class="flex justify-end items-center gap-4 p-6 bg-gray-50 border-t border-gray-200 rounded-b-2xl">
                    <button class="px-6 py-2.5 rounded-lg text-sm font-semibold text-gray-600 bg-white border border-gray-300 hover:bg-gray-100 transition-colors"
                            @onclick="CerrarDetalles">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ComandaFiltrosDto filtros = new();
    private List<ComandaDto>? comandas;
    private PaginatedList<ComandaDto>? paginacion;
    private ComandaEstadisticasDto? estadisticas;
    private ComandaDto? comandaSeleccionada;
    
    private bool mostrarDetalles = false;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        await Task.WhenAll(
            CargarComandas(),
            CargarEstadisticas()
        );
    }

    private async Task CargarComandas()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            var resultado = await ComandasApi.ObtenerComandasAsync(filtros);
            if (resultado != null)
            {
                comandas = resultado.Items?.ToList() ?? new List<ComandaDto>();
                paginacion = resultado;
            }
            else
            {
                comandas = new List<ComandaDto>();
                paginacion = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar comandas: {ex.Message}");
            comandas = new List<ComandaDto>();
            paginacion = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarEstadisticas()
    {
        try
        {
            estadisticas = await ComandasApi.ObtenerEstadisticasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar estadísticas: {ex.Message}");
        }
    }

    private async Task AplicarFiltros(ComandaFiltrosDto filtrosAplicados)
    {
        filtros = filtrosAplicados;
        await CargarComandas();
    }

    private async Task CambiarPagina(int pagina)
    {
        filtros.PageNumber = pagina;
        await CargarComandas();
    }

    private void NuevaComanda()
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "La creación de comandas se realiza desde la aplicación móvil");
    }

    private void EditarComanda(ComandaDto comanda)
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "La edición de comandas se realiza desde la aplicación móvil");
    }

    private void EditarComandaDesdeDetalles()
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "La edición de comandas se realiza desde la aplicación móvil");
    }

    private async Task CancelarComanda(ComandaDto comanda)
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "La cancelación de comandas se realiza desde la aplicación móvil");
    }

    private async Task CambiarEstado(ComandaDto comanda)
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "El cambio de estado se realiza desde la aplicación móvil");
    }

    private async Task CambiarPrioridad(ComandaDto comanda)
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "El cambio de prioridad se realiza desde la aplicación móvil");
    }

    private async Task ReasignarMesa(ComandaDto comanda)
    {
        // Funcionalidad movida a la aplicación móvil
        JSRuntime.InvokeVoidAsync("alert", "La reasignación de mesas se realiza desde la aplicación móvil");
    }

    private void VerDetalles(ComandaDto comanda)
    {
        comandaSeleccionada = comanda;
        mostrarDetalles = true;
        StateHasChanged();
    }

    private void CerrarDetalles()
    {
        mostrarDetalles = false;
        comandaSeleccionada = null;
        StateHasChanged();
    }

    private void MostrarFormularioChanged(bool mostrar)
    {
        // Función eliminada - no se usa en vista administrativa
    }

    private async Task ComandaGuardada(ComandaDto comanda)
    {
        // Función eliminada - no se usa en vista administrativa
        await CargarDatos();
    }

    private void MostrarEstadisticas()
    {
        JSRuntime.InvokeVoidAsync("alert", "Función de estadísticas detalladas pendiente");
    }

    private async Task MostrarUrgentes()
    {
        filtros.EsUrgente = true;
        await CargarComandas();
    }

    private async Task MostrarLentas()
    {
        filtros.EsLenta = true;
        await CargarComandas();
    }

    private async Task ExportarExcel()
    {
        try
        {
            var resultado = await ComandasApi.ExportarComandasAsync(filtros, "Excel");
            if (resultado?.Success == true && resultado.Data != null)
            {
                await JSRuntime.InvokeVoidAsync("descargarArchivo", 
                    Convert.ToBase64String(resultado.Data), 
                    $"comandas_{DateTime.Now:yyyyMMdd}.xlsx", 
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al exportar comandas");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al exportar: {ex.Message}");
        }
    }

