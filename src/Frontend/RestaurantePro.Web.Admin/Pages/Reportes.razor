@attribute [Authorize]
@page "/reportes"
@inject RestaurantePro.Web.Admin.Services.IReportesApiService ReportesApi
@inject RestaurantePro.Web.Admin.Services.IReportesComercialesApiService ReportesComercialesApi
@inject RestaurantePro.Web.Admin.Services.IReportesInventarioApiService ReportesInventarioApi
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@inject IJSRuntime JSRuntime

<PageTitle>Reportes</PageTitle>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Reportes y Análisis</h1>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-info" @onclick="MostrarHistorial">
            <i class="oi oi-clock"></i> Historial
        </button>
        <button class="btn btn-primary" @onclick="NuevoReporte">
            <i class="oi oi-plus"></i> Nuevo Reporte
        </button>
    </div>
</div>

<!-- Estadísticas generales -->
@if (estadisticas != null)
{
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card border-left-primary">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Reportes</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.TotalReportesGenerados</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-success">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Hoy</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.ReportesHoy</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-info">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Esta Semana</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.ReportesEstaSemana</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-warning">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Este Mes</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.ReportesEsteMes</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-danger">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Tipo Más Usado</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@ObtenerTipoTexto(estadisticas.TipoMasSolicitado)</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-primary">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Último Reporte</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@estadisticas.UltimoReporteGenerado.ToString("dd/MM")</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filtros de reporte -->
<FiltrosReporte Filtros="filtros" 
                OnFiltrosAplicados="AplicarFiltros"
                Generando="generando" />

<!-- Navegación por pestañas -->
<ul class="nav nav-tabs mb-4" id="reportTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="operativos-tab" data-bs-toggle="tab" data-bs-target="#operativos" type="button" role="tab">
            <i class="oi oi-bar-chart"></i> Reportes Operativos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="comerciales-tab" data-bs-toggle="tab" data-bs-target="#comerciales" type="button" role="tab">
            <i class="oi oi-graph"></i> Reportes Comerciales
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="inventario-tab" data-bs-toggle="tab" data-bs-target="#inventario" type="button" role="tab">
            <i class="oi oi-box"></i> Reportes de Inventario
        </button>
    </li>
</ul>

<!-- Contenido de las pestañas -->
<div class="tab-content" id="reportTabsContent">
    <!-- Pestaña Reportes Operativos -->
    <div class="tab-pane fade show active" id="operativos" role="tabpanel">
        <!-- Filtros de reporte -->
        <FiltrosReporte Filtros="filtros" 
                        OnFiltrosAplicados="AplicarFiltros"
                        Generando="generando" />

        <!-- Contenido del reporte -->
        @if (mostrarReporte)
        {
            <div class="mt-4">
                @switch (filtros.Tipo)
                {
                    case TipoReporte.VentasPorPeriodo:
                        <ReporteVentas Reporte="reporteVentas" 
                                      OnExportarPDF="ExportarPDF"
                                      OnExportarExcel="ExportarExcel" />
                        break;
                    case TipoReporte.ProductosMasVendidos:
                    case TipoReporte.ProductosPorCategoria:
                        <ReporteProductos Reporte="reporteProductos" 
                                         OnExportarPDF="ExportarPDF"
                                         OnExportarExcel="ExportarExcel" />
                        break;
                    default:
                        <div class="alert alert-info">
                            <i class="oi oi-info"></i> Selecciona un tipo de reporte para generar el análisis correspondiente.
                        </div>
                        break;
                }
            </div>
        }
    </div>
    
    <!-- Pestaña Reportes Comerciales -->
    <div class="tab-pane fade" id="comerciales" role="tabpanel">
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Análisis de Clientes</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis detallado del comportamiento y preferencias de los clientes.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteComercial("analisis-clientes"))">
                            <i class="oi oi-people"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Segmentación de Clientes</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Clasificación de clientes por segmentos y comportamiento.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteComercial("segmentacion-clientes"))">
                            <i class="oi oi-tags"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Análisis de Productos</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis de rendimiento y popularidad de productos.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteComercial("analisis-productos"))">
                            <i class="oi oi-fork"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Rentabilidad por Producto</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis de rentabilidad y márgenes por producto.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteComercial("rentabilidad-productos"))">
                            <i class="oi oi-dollar"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Análisis de Promociones</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Efectividad y rendimiento de promociones activas.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteComercial("analisis-promociones"))">
                            <i class="oi oi-badge"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Tendencias de Ventas</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis de tendencias y patrones de ventas.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteComercial("tendencias-ventas"))">
                            <i class="oi oi-graph"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Pestaña Reportes de Inventario -->
    <div class="tab-pane fade" id="inventario" role="tabpanel">
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Análisis de Stock</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis completo del estado actual del inventario.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteInventario("analisis-stock"))">
                            <i class="oi oi-box"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Movimientos de Inventario</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Historial detallado de movimientos de inventario.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteInventario("movimientos"))">
                            <i class="oi oi-transfer"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Productos Próximos a Vencer</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Lista de productos con vencimiento próximo.</p>
                        <button class="btn btn-warning btn-sm" @onclick="@(() => GenerarReporteInventario("proximos-vencer"))">
                            <i class="oi oi-warning"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Rotación de Inventario</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis de velocidad de rotación de productos.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteInventario("rotacion"))">
                            <i class="oi oi-reload"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Análisis de Costos</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Análisis detallado de costos de inventario.</p>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => GenerarReporteInventario("analisis-costos"))">
                            <i class="oi oi-dollar"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Predicción de Demanda</h6>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Proyecciones de demanda futura basadas en datos históricos.</p>
                        <button class="btn btn-info btn-sm" @onclick="@(() => GenerarReporteInventario("prediccion-demanda"))">
                            <i class="oi oi-graph"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ReporteFiltrosDto filtros = new();
    private ReporteEstadisticasDto? estadisticas;
    
    // Reportes específicos
    private ReporteVentasDto? reporteVentas;
    private ReporteProductosDto? reporteProductos;
    
    private bool mostrarReporte = false;
    private bool generando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadisticas();
    }

    private async Task CargarEstadisticas()
    {
        try
        {
            estadisticas = await ReportesApi.ObtenerEstadisticasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar estadísticas: {ex.Message}");
        }
    }

    private async Task AplicarFiltros(ReporteFiltrosDto filtrosAplicados)
    {
        filtros = filtrosAplicados;
        generando = true;
        mostrarReporte = true;
        StateHasChanged();

        try
        {
            await GenerarReporte();
        }
        finally
        {
            generando = false;
            StateHasChanged();
        }
    }

    private async Task GenerarReporte()
    {
        // Limpiar reportes anteriores
        reporteVentas = null;
        reporteProductos = null;

        switch (filtros.Tipo)
        {
            case TipoReporte.VentasPorPeriodo:
                reporteVentas = await ReportesApi.GenerarReporteVentasAsync(filtros);
                break;
            case TipoReporte.ProductosMasVendidos:
            case TipoReporte.ProductosPorCategoria:
                reporteProductos = await ReportesApi.GenerarReporteProductosAsync(filtros);
                break;
        }
    }

    private async Task MostrarHistorial()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función de historial pendiente");
    }

    private void NuevoReporte()
    {
        mostrarReporte = false;
        filtros = new ReporteFiltrosDto
        {
            FechaInicio = DateTime.Today.AddDays(-30),
            FechaFin = DateTime.Today,
            OrdenarPor = "Fecha",
            DireccionOrden = "desc",
            LimiteResultados = 100
        };
        StateHasChanged();
    }

    private async Task ExportarPDF()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función de exportación PDF pendiente");
    }

    private async Task ExportarExcel()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función de exportación Excel pendiente");
    }

    private async Task GenerarReporteComercial(string tipoReporte)
    {
        try
        {
            generando = true;
            StateHasChanged();

            var fechaInicio = DateTime.Today.AddDays(-30);
            var fechaFin = DateTime.Today;

            object? resultado = null;

            switch (tipoReporte)
            {
                case "analisis-clientes":
                    resultado = await ReportesComercialesApi.ObtenerAnalisisClientesAsync(fechaInicio, fechaFin);
                    break;
                case "segmentacion-clientes":
                    resultado = await ReportesComercialesApi.ObtenerSegmentacionClientesAsync();
                    break;
                case "analisis-productos":
                    resultado = await ReportesComercialesApi.ObtenerAnalisisProductosAsync(fechaInicio, fechaFin);
                    break;
                case "rentabilidad-productos":
                    resultado = await ReportesComercialesApi.ObtenerRentabilidadProductosAsync(fechaInicio, fechaFin);
                    break;
                case "analisis-promociones":
                    resultado = await ReportesComercialesApi.ObtenerAnalisisPromocionesAsync(fechaInicio, fechaFin);
                    break;
                case "tendencias-ventas":
                    resultado = await ReportesComercialesApi.ObtenerTendenciasVentasAsync(fechaInicio, fechaFin);
                    break;
            }

            if (resultado != null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Reporte {tipoReporte} generado exitosamente");
                // Aquí podrías mostrar el resultado en un modal o en una sección específica
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al generar el reporte {tipoReporte}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error al generar reporte comercial {tipoReporte}:", ex.Message);
            await JSRuntime.InvokeVoidAsync("alert", $"Error al generar el reporte {tipoReporte}");
        }
        finally
        {
            generando = false;
            StateHasChanged();
        }
    }

    private async Task GenerarReporteInventario(string tipoReporte)
    {
        try
        {
            generando = true;
            StateHasChanged();

            var fechaInicio = DateTime.Today.AddDays(-30);
            var fechaFin = DateTime.Today;

            object? resultado = null;

            switch (tipoReporte)
            {
                case "analisis-stock":
                    resultado = await ReportesInventarioApi.ObtenerAnalisisStockAsync();
                    break;
                case "movimientos":
                    resultado = await ReportesInventarioApi.ObtenerMovimientosInventarioAsync(fechaInicio, fechaFin);
                    break;
                case "proximos-vencer":
                    resultado = await ReportesInventarioApi.ObtenerProductosProximosVencerAsync(7);
                    break;
                case "rotacion":
                    resultado = await ReportesInventarioApi.ObtenerRotacionInventarioAsync(fechaInicio, fechaFin);
                    break;
                case "analisis-costos":
                    resultado = await ReportesInventarioApi.ObtenerAnalisisCostosAsync(fechaInicio, fechaFin);
                    break;
                case "prediccion-demanda":
                    resultado = await ReportesInventarioApi.ObtenerPrediccionDemandaAsync(3);
                    break;
            }

            if (resultado != null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Reporte de inventario {tipoReporte} generado exitosamente");
                // Aquí podrías mostrar el resultado en un modal o en una sección específica
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al generar el reporte de inventario {tipoReporte}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error al generar reporte de inventario {tipoReporte}:", ex.Message);
            await JSRuntime.InvokeVoidAsync("alert", $"Error al generar el reporte de inventario {tipoReporte}");
        }
        finally
        {
            generando = false;
            StateHasChanged();
        }
    }

    private string ObtenerTipoTexto(TipoReporte tipo)
    {
        return tipo switch
        {
            TipoReporte.VentasPorPeriodo => "Ventas por Período",
            TipoReporte.ProductosMasVendidos => "Productos Más Vendidos",
            TipoReporte.RendimientoMesas => "Rendimiento de Mesas",
            TipoReporte.ResumenComandas => "Resumen de Comandas",
            TipoReporte.VentasPorMesero => "Ventas por Mesero",
            TipoReporte.VentasPorMesa => "Ventas por Mesa",
            TipoReporte.VentasPorHora => "Ventas por Hora",
            TipoReporte.VentasPorDia => "Ventas por Día",
            TipoReporte.ProductosPorCategoria => "Productos por Categoría",
            TipoReporte.ComandasPorEstado => "Comandas por Estado",
            _ => "Desconocido"
        };
    }
}