@attribute [Authorize]
@page "/productos"
@inject IProductosApiService Api
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Services

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .product-card {
        transition: all 0.2s ease-in-out;
    }
    
    .product-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }
    
    .view-toggle {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }
    
    .view-toggle-active {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
        box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
    }
</style>

<PageTitle>Productos</PageTitle>

<div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-text-light">Gestión de Productos y Menú</h1>
    <div class="flex items-center gap-4">
        <!-- Selector de Vista -->
        <div class="flex items-center view-toggle rounded-lg p-1">
            <button @onclick='() => CambiarVista("tabla")' 
                    class="flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 @(vistaActual == "tabla" ? "view-toggle-active" : "text-gray-600 hover:text-gray-900")">
                <span class="material-symbols-outlined text-base">table_view</span>
                <span>Tabla</span>
            </button>
            <button @onclick='() => CambiarVista("tarjetas")' 
                    class="flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 @(vistaActual == "tarjetas" ? "view-toggle-active" : "text-gray-600 hover:text-gray-900")">
                <span class="material-symbols-outlined text-base">grid_view</span>
                <span>Tarjetas</span>
            </button>
        </div>
        
        <button @onclick="ToggleDashboard" class="flex items-center gap-2 border border-primary-color text-primary-color font-bold py-2 px-4 rounded-lg shadow-md hover:bg-primary-color hover:text-white transition-colors">
            <span class="material-symbols-outlined">@(mostrandoDashboard ? "dashboard" : "analytics")</span>
            <span>@(mostrandoDashboard ? "Ocultar Dashboard" : "Ver Dashboard")</span>
        </button>
    <button @onclick="Nuevo" class="flex items-center gap-2 bg-primary-color text-white font-bold py-2 px-4 rounded-lg shadow-md hover:bg-primary-color/90 transition-colors">
        <span class="material-symbols-outlined">add</span>
        <span>Crear Producto</span>
    </button>
</div>
</div>

<!-- Dashboard de Estadísticas -->
@if (mostrandoDashboard)
{
    @if (cargandoEstadisticas)
    {
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900 rounded-xl border border-blue-200 dark:border-gray-700 p-6 mb-6">
            <div class="flex items-center justify-center py-12">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-color mx-auto mb-4"></div>
                    <p class="text-gray-600 dark:text-gray-300">Calculando estadísticas...</p>
                </div>
            </div>
        </div>
    }
    else if (estadisticas != null && estadisticas.TotalProductos > 0)
{
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900 rounded-xl border border-blue-200 dark:border-gray-700 p-6 mb-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">📊 Dashboard de Productos</h2>
                <p class="text-gray-600 dark:text-gray-300">Métricas y estadísticas en tiempo real</p>
            </div>
            <button @onclick="ToggleDashboard" class="p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        
        <!-- Métricas Principales -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Total de Productos -->
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center">
                    <div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-full">
                        <span class="material-symbols-outlined text-blue-600 dark:text-blue-400">inventory</span>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Productos</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">@estadisticas.TotalProductos</p>
                    </div>
                </div>
            </div>
            
            <!-- Productos Activos -->
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center">
                    <div class="p-3 bg-green-100 dark:bg-green-900 rounded-full">
                        <span class="material-symbols-outlined text-green-600 dark:text-green-400">check_circle</span>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Activos</p>
                        <p class="text-2xl font-bold text-green-600 dark:text-green-400">@estadisticas.ProductosActivos</p>
                        <p class="text-xs text-gray-500">@((estadisticas.TotalProductos > 0 ? (estadisticas.ProductosActivos * 100.0 / estadisticas.TotalProductos) : 0).ToString("F1"))% del total</p>
                    </div>
                </div>
            </div>
            
            <!-- Productos Inactivos -->
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center">
                    <div class="p-3 bg-red-100 dark:bg-red-900 rounded-full">
                        <span class="material-symbols-outlined text-red-600 dark:text-red-400">cancel</span>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Inactivos</p>
                        <p class="text-2xl font-bold text-red-600 dark:text-red-400">@estadisticas.ProductosInactivos</p>
                        <p class="text-xs text-gray-500">@((estadisticas.TotalProductos > 0 ? (estadisticas.ProductosInactivos * 100.0 / estadisticas.TotalProductos) : 0).ToString("F1"))% del total</p>
                    </div>
                </div>
            </div>
            
            <!-- Precio Promedio -->
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center">
                    <div class="p-3 bg-yellow-100 dark:bg-yellow-900 rounded-full">
                        <span class="material-symbols-outlined text-yellow-600 dark:text-yellow-400">attach_money</span>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Precio Promedio</p>
                        <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">$@estadisticas.PrecioPromedio.ToString("F0")</p>
                        <p class="text-xs text-gray-500">Rango: $@estadisticas.PrecioMinimo.ToString("F0") - $@estadisticas.PrecioMaximo.ToString("F0")</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Gráficos y Análisis -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Distribución por Categoría -->
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">📈 Productos por Categoría</h3>
                <div class="space-y-3">
                    @foreach (var categoria in estadisticas.ProductosPorCategoria.OrderByDescending(x => x.Cantidad).Take(5))
                    {
                        var porcentaje = estadisticas.TotalProductos > 0 ? (categoria.Cantidad * 100.0 / estadisticas.TotalProductos) : 0;
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@categoria.Nombre</span>
                                    <span class="text-sm text-gray-500">@categoria.Cantidad (@porcentaje.ToString("F1")%)</span>
                                </div>
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                                    <div class="bg-blue-600 h-2 rounded-full" style="width: @(porcentaje)%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            
            <!-- Productos por Popularidad -->
            <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">⭐ Distribución de Popularidad</h3>
                <div class="space-y-3">
                    @foreach (var nivel in estadisticas.ProductosPorPopularidad.OrderByDescending(x => x.Nivel))
                    {
                        var porcentaje = estadisticas.TotalProductos > 0 ? (nivel.Cantidad * 100.0 / estadisticas.TotalProductos) : 0;
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="material-symbols-outlined text-sm @(i <= nivel.Nivel ? "text-yellow-400" : "text-gray-300")">star</span>
                                }
                            </div>
                            <div class="flex-1 mx-3">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@nivel.Nivel estrellas</span>
                                    <span class="text-sm text-gray-500">@nivel.Cantidad (@porcentaje.ToString("F1")%)</span>
                                </div>
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                                    <div class="bg-yellow-400 h-2 rounded-full" style="width: @(porcentaje)%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <!-- Productos Recientes -->
        <div class="mt-6 bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">🆕 Productos Recientes</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var producto in estadisticas.ProductosRecientes.Take(6))
                {
                    <div class="flex items-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                        <div class="w-10 h-10 bg-gray-200 dark:bg-gray-600 rounded-lg flex items-center justify-center">
                            <span class="material-symbols-outlined text-gray-500">restaurant</span>
                        </div>
                        <div class="ml-3 flex-1">
                            <p class="text-sm font-medium text-gray-900 dark:text-white">@producto.Nombre</p>
                            <p class="text-xs text-gray-500">@producto.FechaCreacion.ToString("dd/MM/yyyy")</p>
                        </div>
                        <span class="material-symbols-outlined text-sm @(producto.Activo ? "text-green-500" : "text-red-500")">
                            @(producto.Activo ? "check_circle" : "cancel")
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
    }
    else if (estadisticas != null && estadisticas.TotalProductos == 0)
    {
        <div class="bg-gradient-to-r from-yellow-50 to-orange-50 dark:from-gray-800 dark:to-gray-900 rounded-xl border border-yellow-200 dark:border-gray-700 p-6 mb-6">
            <div class="flex items-center justify-center py-8">
                <div class="text-center">
                    <span class="material-symbols-outlined text-4xl text-yellow-500 mb-4">warning</span>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Sin datos disponibles</h3>
                    <p class="text-gray-600 dark:text-gray-300">No se encontraron productos para mostrar estadísticas</p>
                </div>
            </div>
        </div>
    }
}

<!-- Panel de Filtros -->
<div class="bg-background-light rounded-lg border border-border-light p-4 mb-6">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-text-light">Filtros de Búsqueda</h3>
        <button @onclick="ToggleFiltrosAvanzados" class="flex items-center gap-2 text-primary-color hover:text-primary-color/80 transition-colors">
            <span class="material-symbols-outlined">@(mostrandoFiltrosAvanzados ? "expand_less" : "expand_more")</span>
            <span class="text-sm font-medium">@(mostrandoFiltrosAvanzados ? "Ocultar filtros avanzados" : "Mostrar filtros avanzados")</span>
        </button>
    </div>
    
    <!-- Filtros Básicos -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
    <div class="md:col-span-2">
        <label class="sr-only" for="search">Buscar</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="material-symbols-outlined text-gray-400">search</span>
            </div>
            <input class="w-full pl-10 pr-4 py-2.5 rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                   id="search" 
                   placeholder="Buscar por nombre..." 
                   value="@filtro" 
                   @oninput="@(async (e) => { filtro = e.Value?.ToString() ?? ""; await OnFiltroChanged(); })" />
        </div>
    </div>
    <div>
        <select class="w-full py-2.5 px-4 rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                value="@categoriaIdString"
                @onchange="@(async (e) => { categoriaIdString = e.Value?.ToString() ?? ""; await OnFiltroChanged(); })">
            <option value="">Categoría</option>
            @foreach (var c in categorias)
            {
                <option value="@c.Id">@c.Nombre</option>
            }
        </select>
    </div>
    <div>
        <select class="w-full py-2.5 px-4 rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                value="@(soloActivos ? "true" : "false")"
                @onchange="@(async (e) => { soloActivos = bool.Parse(e.Value?.ToString() ?? "true"); await OnFiltroChanged(); })">
            <option value="true">Disponible</option>
            <option value="false">Agotado</option>
        </select>
    </div>
    </div>
    
    <!-- Filtros Avanzados -->
    @if (mostrandoFiltrosAvanzados)
    {
        <div class="border-t border-border-light pt-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Filtro de Precio -->
                <div>
                    <label class="block text-sm font-medium text-text-light mb-2">Rango de Precio</label>
                    <div class="flex gap-2">
                        <input type="number" 
                               value="@precioMinimo" 
                               @onchange="@(async (e) => { precioMinimo = decimal.TryParse(e.Value?.ToString(), out var val) ? val : null; await OnFiltroChanged(); })"
                               placeholder="Mín"
                               min="0"
                               step="0.01"
                               class="flex-1 px-3 py-2 border border-border-light rounded-lg focus:ring-2 focus:ring-primary-color focus:border-transparent bg-background-light text-text-light">
                        <input type="number" 
                               value="@precioMaximo" 
                               @onchange="@(async (e) => { precioMaximo = decimal.TryParse(e.Value?.ToString(), out var val) ? val : null; await OnFiltroChanged(); })"
                               placeholder="Máx"
                               min="0"
                               step="0.01"
                               class="flex-1 px-3 py-2 border border-border-light rounded-lg focus:ring-2 focus:ring-primary-color focus:border-transparent bg-background-light text-text-light">
                    </div>
                </div>
                
                <!-- Filtro de Fecha de Creación -->
                <div>
                    <label class="block text-sm font-medium text-text-light mb-2">Fecha de Creación</label>
                    <div class="flex gap-2">
                        <input type="date" 
                               value="@fechaCreacionDesde?.ToString("yyyy-MM-dd")" 
                               @onchange="@(async (e) => { fechaCreacionDesde = DateTime.TryParse(e.Value?.ToString(), out var val) ? val : null; await OnFiltroChanged(); })"
                               class="flex-1 px-3 py-2 border border-border-light rounded-lg focus:ring-2 focus:ring-primary-color focus:border-transparent bg-background-light text-text-light">
                        <input type="date" 
                               value="@fechaCreacionHasta?.ToString("yyyy-MM-dd")" 
                               @onchange="@(async (e) => { fechaCreacionHasta = DateTime.TryParse(e.Value?.ToString(), out var val) ? val : null; await OnFiltroChanged(); })"
                               class="flex-1 px-3 py-2 border border-border-light rounded-lg focus:ring-2 focus:ring-primary-color focus:border-transparent bg-background-light text-text-light">
                    </div>
                </div>
                
                <!-- Filtro de Popularidad -->
                <div>
                    <label class="block text-sm font-medium text-text-light mb-2">Nivel de Popularidad</label>
                    <div class="flex gap-2">
                        <input type="number" 
                               value="@popularidadMinima" 
                               @onchange="@(async (e) => { popularidadMinima = int.TryParse(e.Value?.ToString(), out var val) ? val : null; await OnFiltroChanged(); })"
                               placeholder="Mín"
                               min="0"
                               max="10"
                               class="flex-1 px-3 py-2 border border-border-light rounded-lg focus:ring-2 focus:ring-primary-color focus:border-transparent bg-background-light text-text-light">
                        <input type="number" 
                               value="@popularidadMaxima" 
                               @onchange="@(async (e) => { popularidadMaxima = int.TryParse(e.Value?.ToString(), out var val) ? val : null; await OnFiltroChanged(); })"
                               placeholder="Máx"
                               min="0"
                               max="10"
                               class="flex-1 px-3 py-2 border border-border-light rounded-lg focus:ring-2 focus:ring-primary-color focus:border-transparent bg-background-light text-text-light">
                    </div>
                </div>
                
                <!-- Botones de Acción -->
                <div class="flex items-end">
                    <div class="flex gap-2 w-full">
                        <button @onclick="LimpiarFiltrosAvanzados" 
                                class="flex-1 px-4 py-2 border border-border-light text-text-light rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors">
                            Limpiar
                        </button>
                        <button @onclick="OnFiltroChanged" 
                                class="flex-1 px-4 py-2 bg-primary-color text-white rounded-lg hover:bg-primary-color/90 transition-colors">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (cargando)
{
    <div class="flex justify-center items-center py-12">
        <div class="text-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-color mx-auto mb-4"></div>
            <p class="text-gray-500">Cargando productos...</p>
        </div>
    </div>
}
else if (productos.Items.Count == 0)
{
    <div class="text-center py-12">
        <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">inventory_2</span>
        <p class="text-gray-500 text-lg">No hay productos disponibles</p>
        <p class="text-gray-400 text-sm">Crea tu primer producto para comenzar</p>
    </div>
}
else
{
    @if (vistaActual == "tabla")
    {
        <!-- Vista de Tabla -->
    <div class="bg-background-light rounded-lg shadow-sm overflow-hidden border border-border-light">
        <table class="w-full">
            <thead class="bg-sidebar-bg-light">
                <tr>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Imagen</th>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Nombre</th>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Categoría</th>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Precio</th>
                    <th class="p-4 text-center text-sm font-bold uppercase tracking-wider text-gray-500">Disponibilidad</th>
                    <th class="p-4 text-right text-sm font-bold uppercase tracking-wider text-gray-500">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border-light">
                @foreach (var p in productos.Items)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                        <td class="p-4">
                            @if (!string.IsNullOrEmpty(p.ImagenUrl))
                            {
                                <img src="@p.ImagenUrl" alt="@p.Nombre" class="w-12 h-12 object-cover rounded-lg" />
                            }
                            else
                            {
                                <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                                    <span class="material-symbols-outlined text-gray-400 text-lg">restaurant</span>
                                </div>
                            }
                        </td>
                        <td class="p-4 font-medium text-text-light">@p.Nombre</td>
                        <td class="p-4 text-gray-500">@p.CategoriaNombre</td>
                        <td class="p-4 text-gray-500">$@p.Precio.ToString("N0")</td>
                        <td class="p-4 text-center">
                            @if (p.Activo)
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-success-color/10 text-success-color">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-warning-color/10 text-warning-color">
                                    Agotado
                                </span>
                            }
                        </td>
                        <td class="p-4 text-right">
                            <button class="text-primary-color hover:text-primary-color/80 transition-colors" @onclick="(() => Editar(p.Id))" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                                <button class="text-red-500 hover:text-red-400 ml-2 transition-colors" @onclick="(() => ConfirmarEliminar(p.Id, p.Nombre))" title="Eliminar">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
    else
    {
        <!-- Vista de Tarjetas -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var p in productos.Items)
            {
                <div class="bg-background-light rounded-lg shadow-sm border border-border-light overflow-hidden product-card">
                    <!-- Imagen del Producto -->
                    <div class="h-48 relative overflow-hidden">
                        @if (!string.IsNullOrEmpty(p.ImagenUrl))
                        {
                            <img src="@p.ImagenUrl" alt="@p.Nombre" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                                <span class="material-symbols-outlined text-6xl text-gray-400">restaurant</span>
                            </div>
                        }
                        
                        <!-- Badge de estado en la esquina -->
                        <div class="absolute top-3 right-3">
                            @if (p.Activo)
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-success-color/90 text-white">
                                    <span class="w-2 h-2 bg-white rounded-full mr-1"></span>
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-warning-color/90 text-white">
                                    <span class="w-2 h-2 bg-white rounded-full mr-1"></span>
                                    Agotado
                                </span>
                            }
                        </div>
                    </div>
                    
                    <!-- Contenido de la Tarjeta -->
                    <div class="p-4">
                        <!-- Header con nombre -->
                        <div class="mb-3">
                            <h3 class="font-semibold text-text-light text-lg leading-tight mb-1">@p.Nombre</h3>
                            
                            <!-- Categoría -->
                            <div class="flex items-center text-gray-500 text-sm">
                                <span class="material-symbols-outlined text-base mr-1">category</span>
                                <span>@p.CategoriaNombre</span>
                            </div>
                        </div>
                        
                        <!-- Descripción (si existe) -->
                        @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                        {
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">@p.Descripcion</p>
                        }
                        
                        <!-- Precio -->
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-2xl font-bold text-primary-color">$@p.Precio.ToString("N0")</span>
                        </div>
                        
                        <!-- Botones de Acción -->
                        <div class="flex gap-2">
                            <button @onclick="(() => Editar(p.Id))" 
                                    class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-primary-color text-white rounded-lg hover:bg-primary-color/90 transition-colors text-sm font-medium">
                                <span class="material-symbols-outlined text-base">edit</span>
                                <span>Editar</span>
                            </button>
                            <button @onclick="(() => ConfirmarEliminar(p.Id, p.Nombre))" 
                                    class="flex items-center justify-center px-3 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors">
                                <span class="material-symbols-outlined text-base">delete</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="flex justify-between items-center mt-6">
        <small class="text-gray-500">Página @paginaActual de @productos.TotalPages (Total: @productos.TotalCount)</small>
        <div class="flex gap-2">
            <button class="px-4 py-2 rounded-lg border border-border-light text-text-light hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
                    disabled="@(paginaActual <= 1)" 
                    @onclick="Anterior">
                Anterior
            </button>
            <button class="px-4 py-2 rounded-lg border border-border-light text-text-light hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
                    disabled="@(paginaActual >= productos.TotalPages)" 
                    @onclick="Siguiente">
                Siguiente
            </button>
        </div>
    </div>
}

