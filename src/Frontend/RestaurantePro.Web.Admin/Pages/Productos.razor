@attribute [Authorize]
@page "/productos"
@inject IProductosApiService Api
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Services

<PageTitle>Productos</PageTitle>

<div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-text-light">Gestión de Productos y Menú</h1>
    <button @onclick="Nuevo" class="flex items-center gap-2 bg-primary-color text-white font-bold py-2 px-4 rounded-lg shadow-md hover:bg-primary-color/90 transition-colors">
        <span class="material-symbols-outlined">add</span>
        <span>Crear Producto</span>
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="md:col-span-2">
        <label class="sr-only" for="search">Buscar</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="material-symbols-outlined text-gray-400">search</span>
            </div>
            <input class="w-full pl-10 pr-4 py-2.5 rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                   id="search" 
                   placeholder="Buscar por nombre..." 
                   @bind-value="filtro" 
                   @bind-value:event="oninput" />
        </div>
    </div>
    <div>
        <select class="w-full py-2.5 px-4 rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                @bind="categoriaIdString">
            <option value="">Categoría</option>
            @foreach (var c in categorias)
            {
                <option value="@c.Id">@c.Nombre</option>
            }
        </select>
    </div>
    <div>
        <select class="w-full py-2.5 px-4 rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                @bind="soloActivos">
            <option value="true">Disponible</option>
            <option value="false">Agotado</option>
        </select>
    </div>
</div>

@if (cargando)
{
    <div class="flex justify-center items-center py-12">
        <div class="text-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-color mx-auto mb-4"></div>
            <p class="text-gray-500">Cargando productos...</p>
        </div>
    </div>
}
else if (productos.Items.Count == 0)
{
    <div class="text-center py-12">
        <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">inventory_2</span>
        <p class="text-gray-500 text-lg">No hay productos disponibles</p>
        <p class="text-gray-400 text-sm">Crea tu primer producto para comenzar</p>
    </div>
}
else
{
    <div class="bg-background-light rounded-lg shadow-sm overflow-hidden border border-border-light">
        <table class="w-full">
            <thead class="bg-sidebar-bg-light">
                <tr>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Nombre</th>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Categoría</th>
                    <th class="p-4 text-left text-sm font-bold uppercase tracking-wider text-gray-500">Precio</th>
                    <th class="p-4 text-center text-sm font-bold uppercase tracking-wider text-gray-500">Disponibilidad</th>
                    <th class="p-4 text-right text-sm font-bold uppercase tracking-wider text-gray-500">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border-light">
                @foreach (var p in productos.Items)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                        <td class="p-4 font-medium text-text-light">@p.Nombre</td>
                        <td class="p-4 text-gray-500">@p.CategoriaNombre</td>
                        <td class="p-4 text-gray-500">$@p.Precio.ToString("N0")</td>
                        <td class="p-4 text-center">
                            @if (p.Activo)
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-success-color/10 text-success-color">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-warning-color/10 text-warning-color">
                                    Agotado
                                </span>
                            }
                        </td>
                        <td class="p-4 text-right">
                            <button class="text-primary-color hover:text-primary-color/80 transition-colors" @onclick="(() => Editar(p.Id))" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                            <button class="text-red-500 hover:text-red-400 ml-2 transition-colors" @onclick="(() => Eliminar(p.Id))" title="Eliminar">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="flex justify-between items-center mt-6">
        <small class="text-gray-500">Página @paginaActual de @productos.TotalPages (Total: @productos.TotalCount)</small>
        <div class="flex gap-2">
            <button class="px-4 py-2 rounded-lg border border-border-light text-text-light hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
                    disabled="@(paginaActual <= 1)" 
                    @onclick="Anterior">
                Anterior
            </button>
            <button class="px-4 py-2 rounded-lg border border-border-light text-text-light hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" 
                    disabled="@(paginaActual >= productos.TotalPages)" 
                    @onclick="Siguiente">
                Siguiente
            </button>
        </div>
    </div>
}

@if (mostrandoModal)
{
    <div class="fixed inset-0 z-10 bg-black/50" @onclick="CerrarModal">
        <div class="fixed inset-0 z-20 flex items-center justify-center p-4">
            <div class="bg-background-light rounded-lg shadow-xl p-8 w-full max-w-2xl" @onclick:stopPropagation="true">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-text-light">@(editando ? "Editar Producto" : "Crear / Editar Producto")</h2>
                    <button @onclick="CerrarModal" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                
                @if (editando)
                {
                    <EditForm Model="edicion">
                        <DataAnnotationsValidator />
                        <div class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="name-edit">Nombre</label>
                                    <InputText class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                               id="name-edit" 
                                               placeholder="Ej. Ensalada César" 
                                               @bind-Value="edicion.Nombre" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="price-edit">Precio</label>
                                    <InputNumber class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                                id="price-edit" 
                                                placeholder="Ej. 12.99" 
                                                @bind-Value="edicion.Precio" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="description-edit">Descripción</label>
                                <InputTextArea class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                              id="description-edit" 
                                              placeholder="Una breve descripción del producto..." 
                                              rows="3" 
                                              @bind-Value="edicion.Descripcion" />
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="category-edit">Categoría</label>
                                    <select class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                            id="category-edit" 
                                            @bind="edicion.CategoriaId">
                                        @foreach (var c in categorias)
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="ingredients-edit">Ingredientes</label>
                                    <input class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                           id="ingredients-edit" 
                                           placeholder="Ej. Lechuga, Pollo, Crutones..." 
                                           type="text" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Imagen del Producto</label>
                                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-border-light border-dashed rounded-lg">
                                    <div class="space-y-1 text-center">
                                        <svg aria-hidden="true" class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 48 48">
                                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                        </svg>
                                        <div class="flex text-sm text-gray-600 dark:text-gray-400">
                                            <label class="relative cursor-pointer bg-background-light rounded-md font-medium text-primary-color hover:text-primary-color/80 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-primary-color" for="file-upload-edit">
                                                <span>Sube un archivo</span>
                                                <input class="sr-only" id="file-upload-edit" name="file-upload" type="file"/>
                                            </label>
                                            <p class="pl-1">o arrastra y suelta</p>
                                        </div>
                                        <p class="text-xs text-gray-500">PNG, JPG, GIF hasta 10MB</p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input class="h-4 w-4 text-primary-color focus:ring-primary-color border-border-light rounded" 
                                       type="checkbox" 
                                       id="chkActivoEdit" 
                                       @bind="edicion.Activo" />
                                <label class="ml-2 block text-sm text-gray-700 dark:text-gray-300" for="chkActivoEdit">
                                    Producto activo
                                </label>
                            </div>
                        </div>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="nuevo">
                        <DataAnnotationsValidator />
                        <div class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="name-new">Nombre</label>
                                    <InputText class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                               id="name-new" 
                                               placeholder="Ej. Ensalada César" 
                                               @bind-Value="nuevo.Nombre" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="price-new">Precio</label>
                                    <InputNumber class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                                id="price-new" 
                                                placeholder="Ej. 12.99" 
                                                @bind-Value="nuevo.Precio" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="description-new">Descripción</label>
                                <InputTextArea class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                              id="description-new" 
                                              placeholder="Una breve descripción del producto..." 
                                              rows="3" 
                                              @bind-Value="nuevo.Descripcion" />
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="category-new">Categoría</label>
                                    <select class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                            id="category-new" 
                                            @bind="nuevo.CategoriaId">
                                        @foreach (var c in categorias)
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="ingredients-new">Ingredientes</label>
                                    <input class="mt-1 block w-full rounded-lg border-border-light bg-input-bg-light focus:ring-primary-color focus:border-primary-color transition" 
                                           id="ingredients-new" 
                                           placeholder="Ej. Lechuga, Pollo, Crutones..." 
                                           type="text" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Imagen del Producto</label>
                                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-border-light border-dashed rounded-lg">
                                    <div class="space-y-1 text-center">
                                        <svg aria-hidden="true" class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 48 48">
                                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                        </svg>
                                        <div class="flex text-sm text-gray-600 dark:text-gray-400">
                                            <label class="relative cursor-pointer bg-background-light rounded-md font-medium text-primary-color hover:text-primary-color/80 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-primary-color" for="file-upload-new">
                                                <span>Sube un archivo</span>
                                                <input class="sr-only" id="file-upload-new" name="file-upload" type="file"/>
                                            </label>
                                            <p class="pl-1">o arrastra y suelta</p>
                                        </div>
                                        <p class="text-xs text-gray-500">PNG, JPG, GIF hasta 10MB</p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center">
                                <input class="h-4 w-4 text-primary-color focus:ring-primary-color border-border-light rounded" 
                                       type="checkbox" 
                                       id="chkActivoNuevo" 
                                       @bind="nuevo.Activo" />
                                <label class="ml-2 block text-sm text-gray-700 dark:text-gray-300" for="chkActivoNuevo">
                                    Producto activo
                                </label>
                            </div>
                        </div>
                    </EditForm>
                }
                
                <div class="flex justify-end gap-4 mt-8">
                    <button @onclick="CerrarModal" class="py-2 px-4 rounded-lg border border-border-light text-text-light hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors" type="button">
                        Cancelar
                    </button>
                    <button @onclick="GuardarAsync" class="py-2 px-4 rounded-lg bg-primary-color text-white font-bold shadow-md hover:bg-primary-color/90 transition-colors" type="submit">
                        Guardar Producto
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaProductoDto> categorias = new();
    private PaginatedList<ProductoDto> productos = new();
    private string filtro = string.Empty;
    private Guid? categoriaId = null;
    private string categoriaIdString
    {
        get => categoriaId?.ToString() ?? string.Empty;
        set => categoriaId = Guid.TryParse(value, out var g) ? g : null;
    }
    private bool soloActivos = true;
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private string orderBy = "Nombre";
    private string orderDirection = "asc";
    private bool cargando = true;
    private bool mostrandoModal = false;
    private bool editando = false;
    private CreateProductoRequest nuevo = new();
    private UpdateProductoRequest edicion = new();

    protected override async Task OnInitializedAsync()
    {
        categorias = await Api.ObtenerCategoriasAsync() ?? new List<CategoriaProductoDto>();
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        cargando = true;
        productos = await Api.ObtenerProductosPaginadosAsync(paginaActual, tamanoPagina, filtro, categoriaId, soloActivos, orderBy, orderDirection) ?? new PaginatedList<ProductoDto>();
        cargando = false;
        StateHasChanged();
    }

    private void Nuevo()
    {
        editando = false;
        nuevo = new CreateProductoRequest { Activo = true, CategoriaId = categorias.FirstOrDefault()?.Id ?? Guid.Empty };
        mostrandoModal = true;
    }

    private async Task Editar(Guid id)
    {
        var p = await Api.ObtenerPorIdAsync(id);
        if (p is null) return;
        editando = true;
        edicion = new UpdateProductoRequest
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            Precio = p.Precio,
            CategoriaId = p.CategoriaId,
            Activo = p.Activo
        };
        mostrandoModal = true;
    }

    private void CerrarModal()
    {
        mostrandoModal = false;
    }

    private async Task GuardarAsync()
    {
        if (editando)
        {
            var res = await Api.ActualizarAsync(edicion);
        }
        else
        {
            var res = await Api.CrearAsync(nuevo);
        }
        mostrandoModal = false;
        await BuscarAsync();
    }

    private async Task Eliminar(Guid id)
    {
        if (await Api.EliminarAsync(id))
        {
            await BuscarAsync();
        }
    }

    private async Task Siguiente()
    {
        if (paginaActual < productos.TotalPages)
        {
            paginaActual++;
            await BuscarAsync();
        }
    }

    private async Task Anterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await BuscarAsync();
        }
    }
}


