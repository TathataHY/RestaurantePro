@code {
    private List<CategoriaProductoDto> categorias = new();
    private PaginatedList<ProductoDto> productos = new();
    private string filtro = string.Empty;
    private Guid? categoriaId = null;
    private string categoriaIdString
    {
        get => categoriaId?.ToString() ?? string.Empty;
        set => categoriaId = Guid.TryParse(value, out var g) ? g : null;
    }
    private bool soloActivos = true;
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private string orderBy = "Nombre";
    private string orderDirection = "asc";
    private bool cargando = true;
    private bool mostrandoModal = false;
    private bool editando = false;
    private CreateProductoRequest nuevo = new();
    private UpdateProductoRequest edicion = new();
    private string? imagenTemporal = null; // Para almacenar la imagen en base64 antes de crear el producto
    
    // Variables para confirmación de eliminación
    private bool mostrandoConfirmacionEliminar = false;
    private ProductoDto? productoAEliminar = null;
    
    // Variables para notificaciones
    private bool mostrandoNotificacion = false;
    private bool notificacionExito = true;
    private string mensajeNotificacion = string.Empty;
    
    // Variables para estados de carga
    private bool guardando = false;
    private bool eliminando = false;
    
    // Variables para vista
    private string vistaActual = "tabla"; // "tabla" o "tarjetas"
    
    // Variables para filtros avanzados
    private bool mostrandoFiltrosAvanzados = false;
    private decimal? precioMinimo;
    private decimal? precioMaximo;
    private DateTime? fechaCreacionDesde;
    private DateTime? fechaCreacionHasta;
    private int? popularidadMinima;
    private int? popularidadMaxima;
    
    // Variables para dashboard
    private bool mostrandoDashboard = false;
    private EstadisticasProductosDto? estadisticas;
    private bool cargandoEstadisticas = false;

    protected override async Task OnInitializedAsync()
    {
        categorias = await Api.ObtenerCategoriasAsync() ?? new List<CategoriaProductoDto>();
        Console.WriteLine($"🔍 Categorías cargadas: {categorias.Count}");
        foreach (var cat in categorias)
        {
            Console.WriteLine($"  - {cat.Nombre}: Id={cat.Id}, Activa={cat.Activa}");
        }
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        cargando = true;
        Console.WriteLine($"BuscarAsync: filtro='{filtro}', categoriaId={categoriaId}, soloActivos={soloActivos}");
        productos = await Api.ObtenerProductosPaginadosAsync(
            paginaActual, 
            tamanoPagina, 
            filtro, 
            categoriaId, 
            soloActivos,
            precioMinimo,
            precioMaximo,
            fechaCreacionDesde,
            fechaCreacionHasta,
            popularidadMinima,
            popularidadMaxima,
            orderBy, 
            orderDirection) ?? new PaginatedList<ProductoDto>();
        cargando = false;
        StateHasChanged();
    }

    private async Task OnFiltroChanged()
    {
        paginaActual = 1; // Reset a la primera página cuando cambian los filtros
        await BuscarAsync();
    }

    private void Nuevo()
    {
        editando = false;
        // Asignar la primera categoría activa disponible, o Guid.Empty si no hay categorías
        var primeraCategoria = categorias.FirstOrDefault(c => c.Activa);
        Console.WriteLine($"🔍 Creando nuevo producto - Categorías disponibles: {categorias.Count}");
        Console.WriteLine($"🔍 Primera categoría activa: {primeraCategoria?.Nombre} (Id: {primeraCategoria?.Id})");
        
        nuevo = new CreateProductoRequest { 
            Activo = true, 
            CategoriaId = primeraCategoria?.Id ?? Guid.Empty 
        };
        Console.WriteLine($"🔍 CategoriaId asignado: {nuevo.CategoriaId}");
        mostrandoModal = true;
    }

    private async Task Editar(Guid id)
    {
        var p = await Api.ObtenerPorIdAsync(id);
        if (p is null) return;
        editando = true;
        edicion = new UpdateProductoRequest
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            Precio = p.Precio,
            CategoriaId = p.CategoriaId,
            Activo = p.Activo
        };
        mostrandoModal = true;
    }

    private void CerrarModal()
    {
        mostrandoModal = false;
    }

    private async Task GuardarAsync()
    {
        // Validaciones del lado cliente
        if (editando)
        {
            if (string.IsNullOrWhiteSpace(edicion.Nombre))
            {
                MostrarNotificacion("El nombre del producto es requerido", false);
                return;
            }
            if (edicion.Precio <= 0)
            {
                MostrarNotificacion("El precio debe ser mayor a 0", false);
                return;
            }
            if (edicion.CategoriaId == Guid.Empty)
            {
                MostrarNotificacion("Debe seleccionar una categoría", false);
                return;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(nuevo.Nombre))
            {
                MostrarNotificacion("El nombre del producto es requerido", false);
                return;
            }
            if (nuevo.Precio <= 0)
            {
                MostrarNotificacion("El precio debe ser mayor a 0", false);
                return;
            }
            if (nuevo.CategoriaId == Guid.Empty)
            {
                MostrarNotificacion("Debe seleccionar una categoría", false);
                return;
            }
        }
        
        guardando = true;
        
        try
        {
            if (editando)
            {
                Console.WriteLine($"🔍 Editando producto - CategoriaId: {edicion.CategoriaId}");
                var res = await Api.ActualizarAsync(edicion);
                if (res != null)
                {
                    MostrarNotificacion("Producto actualizado exitosamente", true);
                }
                else
                {
                    MostrarNotificacion("Error al actualizar el producto", false);
                    return; // No cerrar modal si hay error
                }
        }
        else
        {
            Console.WriteLine($"🔍 Creando producto - CategoriaId: {nuevo.CategoriaId}");
            Console.WriteLine($"🔍 Datos del nuevo producto: Nombre={nuevo.Nombre}, Precio={nuevo.Precio}, Activo={nuevo.Activo}");
            var res = await Api.CrearAsync(nuevo);
                if (res != null)
                {
                    // Si hay una imagen temporal, subirla ahora que el producto existe
                    if (!string.IsNullOrEmpty(imagenTemporal) && imagenTemporal.StartsWith("data:"))
                    {
                        await SubirImagenTemporal(res.Id, imagenTemporal);
                    }
                    
                    MostrarNotificacion("Producto creado exitosamente", true);
                }
                else
                {
                    MostrarNotificacion("Error al crear el producto", false);
                    return; // No cerrar modal si hay error
                }
            }
            
            mostrandoModal = false;
            await BuscarAsync();
        }
        catch (Exception ex)
        {
            MostrarNotificacion($"Error: {ex.Message}", false);
        }
        finally
        {
            guardando = false;
            imagenTemporal = null; // Limpiar imagen temporal
        }
    }

    private async Task SubirImagenTemporal(Guid productoId, string imagenBase64)
    {
        try
        {
            // Convertir base64 a stream
            var base64Data = imagenBase64.Split(',')[1]; // Remover "data:image/...;base64,"
            var bytes = Convert.FromBase64String(base64Data);
            
            using var stream = new MemoryStream(bytes);
            
            // Determinar el tipo de contenido
            string contentType = "image/jpeg"; // Por defecto
            if (imagenBase64.Contains("image/png"))
                contentType = "image/png";
            else if (imagenBase64.Contains("image/gif"))
                contentType = "image/gif";
            
            var uploadedUrl = await Api.SubirImagenAsync(productoId, stream, $"producto_{productoId}.jpg", contentType);
            
            if (!string.IsNullOrEmpty(uploadedUrl))
            {
                Console.WriteLine($"✅ Imagen subida exitosamente para producto {productoId}: {uploadedUrl}");
            }
            else
            {
                Console.WriteLine($"❌ Error al subir imagen para producto {productoId}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al subir imagen temporal: {ex.Message}");
        }
    }

    private async Task OnImagenChanged(string? imagenUrl)
    {
        Console.WriteLine($"🔍 OnImagenChanged llamado - editando: {editando}");
        Console.WriteLine($"🔍 imagenUrl recibida: {(string.IsNullOrEmpty(imagenUrl) ? "null" : imagenUrl.Substring(0, Math.Min(50, imagenUrl.Length)) + "...")}");
        
        if (editando)
        {
            edicion.ImagenUrl = imagenUrl;
            Console.WriteLine($"🔍 Imagen asignada a edicion: {edicion.ImagenUrl?.Substring(0, Math.Min(50, edicion.ImagenUrl.Length))}...");
        }
        else
        {
            // Para productos nuevos, almacenar la imagen temporal
            if (!string.IsNullOrEmpty(imagenUrl) && imagenUrl.StartsWith("data:"))
            {
                imagenTemporal = imagenUrl;
                Console.WriteLine($"🔍 Imagen temporal almacenada - Base64 length: {imagenUrl.Length}");
            }
            nuevo.ImagenUrl = imagenUrl;
            Console.WriteLine($"🔍 Imagen asignada a nuevo: {nuevo.ImagenUrl?.Substring(0, Math.Min(50, nuevo.ImagenUrl.Length))}...");
        }
        
        // Forzar actualización del estado para mostrar la imagen
        StateHasChanged();
        Console.WriteLine($"✅ OnImagenChanged completado - StateHasChanged() llamado");
    }

    private void MostrarNotificacion(string mensaje, bool esExito)
    {
        mensajeNotificacion = mensaje;
        notificacionExito = esExito;
        mostrandoNotificacion = true;
        
        // Auto-cerrar después de 5 segundos
        Task.Delay(5000).ContinueWith(_ => {
            InvokeAsync(() => {
                mostrandoNotificacion = false;
                StateHasChanged();
            });
        });
    }

    private void CerrarNotificacion()
    {
        mostrandoNotificacion = false;
    }

    private void CambiarVista(string nuevaVista)
    {
        vistaActual = nuevaVista;
        StateHasChanged();
    }

    private void ToggleFiltrosAvanzados()
    {
        mostrandoFiltrosAvanzados = !mostrandoFiltrosAvanzados;
        StateHasChanged();
    }

    private async Task LimpiarFiltrosAvanzados()
    {
        precioMinimo = null;
        precioMaximo = null;
        fechaCreacionDesde = null;
        fechaCreacionHasta = null;
        popularidadMinima = null;
        popularidadMaxima = null;
        
        await OnFiltroChanged();
        StateHasChanged();
    }

    private async Task ToggleDashboard()
    {
        mostrandoDashboard = !mostrandoDashboard;
        
        if (mostrandoDashboard && estadisticas == null)
        {
            await CargarEstadisticas();
        }
        
        StateHasChanged();
    }

    private async Task CargarEstadisticas()
    {
        if (cargandoEstadisticas) return;
        
        cargandoEstadisticas = true;
        Console.WriteLine("🔄 Iniciando carga de estadísticas...");
        
        try
        {
            // Usar el endpoint específico de estadísticas
            Console.WriteLine("📡 Llamando al endpoint de estadísticas...");
            estadisticas = await Api.ObtenerEstadisticasAsync();
            
            if (estadisticas != null)
            {
                Console.WriteLine($"✅ Estadísticas obtenidas: {estadisticas.TotalProductos} productos totales");
                Console.WriteLine($"📊 Productos activos: {estadisticas.ProductosActivos}");
                Console.WriteLine($"📊 Productos inactivos: {estadisticas.ProductosInactivos}");
                Console.WriteLine($"💰 Precio promedio: {estadisticas.PrecioPromedio:C}");
            }
            else
            {
                Console.WriteLine("⚠️ No se pudieron obtener estadísticas de la API");
                estadisticas = new EstadisticasProductosDto(); // Crear estadísticas vacías
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al cargar estadísticas: {ex.Message}");
            Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");
            estadisticas = new EstadisticasProductosDto(); // Crear estadísticas vacías en caso de error
        }
        finally
        {
            cargandoEstadisticas = false;
            Console.WriteLine("🏁 Carga de estadísticas completada");
        }
    }


    private void ConfirmarEliminar(Guid id, string nombre)
    {
        productoAEliminar = new ProductoDto { Id = id, Nombre = nombre };
        mostrandoConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        mostrandoConfirmacionEliminar = false;
        productoAEliminar = null;
    }

    private async Task EliminarConfirmado()
    {
        if (productoAEliminar == null) return;
        
        eliminando = true;
        mostrandoConfirmacionEliminar = false;
        
        try
        {
            var resultado = await Api.EliminarAsync(productoAEliminar.Id);
            if (resultado)
            {
                MostrarNotificacion($"Producto '{productoAEliminar.Nombre}' eliminado exitosamente", true);
        await BuscarAsync();
            }
            else
            {
                MostrarNotificacion("Error al eliminar el producto", false);
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacion($"Error al eliminar el producto: {ex.Message}", false);
        }
        finally
        {
            eliminando = false;
            productoAEliminar = null;
        }
    }

    private async Task Eliminar(Guid id)
    {
        if (await Api.EliminarAsync(id))
        {
            await BuscarAsync();
        }
    }

    private async Task Siguiente()
    {
        if (paginaActual < productos.TotalPages)
        {
            paginaActual++;
            await BuscarAsync();
        }
    }

    private async Task Anterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await BuscarAsync();
        }
    }
}


