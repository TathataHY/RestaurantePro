@attribute [Authorize]
@page "/reservaciones"
@inject RestaurantePro.Web.Admin.Services.ReservacionesApiService ReservacionesApi
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@inject IJSRuntime JSRuntime

<PageTitle>Reservaciones</PageTitle>

<!-- Header Principal -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title">Gestión de Reservaciones</h1>
            <p class="dashboard-subtitle">Administración completa de reservas y análisis de ocupación</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info" @onclick="MostrarEstadisticas">
                <i class="oi oi-bar-chart"></i> Estadísticas
            </button>
            <button class="btn btn-outline-warning" @onclick="MostrarUrgentes">
                <i class="oi oi-warning"></i> Urgentes
            </button>
            <button class="btn btn-outline-success" @onclick="MostrarHoy">
                <i class="oi oi-calendar"></i> Hoy
            </button>
            <button class="btn btn-outline-primary" @onclick="MostrarCalendario">
                <i class="oi oi-calendar"></i> Calendario
            </button>
            <button class="btn btn-primary" @onclick="NuevaReservacion">
                <i class="oi oi-plus"></i> Nueva Reservación
            </button>
        </div>
    </div>
</div>

<!-- Dashboard de Métricas -->
@if (estadisticas != null)
{
    <div class="metrics-grid mb-4">
        <MetricaCard Titulo="Total Reservaciones" 
                     Valor="@estadisticas.TotalReservaciones.ToString()" 
                     Subtexto="Este período" 
                     Icono="oi oi-calendar" 
                     CardClass="metric-card primary" 
                     ValorClass="text-primary" 
                     IconoClass="text-primary" 
                     MostrarCambio="true" 
                     Cambio="@(estadisticas.CambioTotalReservaciones)" />
        
        <MetricaCard Titulo="Confirmadas" 
                     Valor="@estadisticas.ReservacionesConfirmadas.ToString()" 
                     Subtexto="@(estadisticas.TotalReservaciones > 0 ? $"{Math.Round((double)estadisticas.ReservacionesConfirmadas / estadisticas.TotalReservaciones * 100, 1)}% del total" : "0%")" 
                     Icono="oi oi-check" 
                     CardClass="metric-card success" 
                     ValorClass="text-success" 
                     IconoClass="text-success" />
        
        <MetricaCard Titulo="Pendientes" 
                     Valor="@estadisticas.ReservacionesPendientes.ToString()" 
                     Subtexto="@(estadisticas.TotalReservaciones > 0 ? $"{Math.Round((double)estadisticas.ReservacionesPendientes / estadisticas.TotalReservaciones * 100, 1)}% del total" : "0%")" 
                     Icono="oi oi-clock" 
                     CardClass="metric-card warning" 
                     ValorClass="text-warning" 
                     IconoClass="text-warning" />
        
        <MetricaCard Titulo="No-Show" 
                     Valor="@estadisticas.ReservacionesNoShow.ToString()" 
                     Subtexto="@(estadisticas.TotalReservaciones > 0 ? $"{Math.Round((double)estadisticas.ReservacionesNoShow / estadisticas.TotalReservaciones * 100, 1)}% del total" : "0%")" 
                     Icono="oi oi-x" 
                     CardClass="metric-card danger" 
                     ValorClass="text-danger" 
                     IconoClass="text-danger" />
        
        <MetricaCard Titulo="Ingresos" 
                     Valor="@estadisticas.IngresosPorReservaciones.ToString("C0")" 
                     Subtexto="Este período" 
                     Icono="oi oi-dollar" 
                     CardClass="metric-card info" 
                     ValorClass="text-info" 
                     IconoClass="text-info" 
                     MostrarCambio="true" 
                     Cambio="@(estadisticas.CambioIngresos)" />
        
        <MetricaCard Titulo="Ocupación" 
                     Valor="@($"{estadisticas.OcupacionPromedio:F1}%")" 
                     Subtexto="Promedio diario" 
                     Icono="oi oi-pie-chart" 
                     CardClass="metric-card primary" 
                     ValorClass="text-primary" 
                     IconoClass="text-primary" 
                     MostrarCambio="true" 
                     Cambio="@(estadisticas.CambioOcupacion)" />
    </div>
}

<!-- Gráficos de Análisis -->
@if (estadisticas != null)
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="oi oi-pie-chart"></i> Distribución por Estado
                    </h6>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 250px;">
                        <canvas id="estadoChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="oi oi-bar-chart"></i> Reservaciones por Hora
                    </h6>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 250px;">
                        <canvas id="horaChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="oi oi-graph"></i> Tendencia Semanal
                    </h6>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 250px;">
                        <canvas id="tendenciaChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filtros de búsqueda -->
<ReservacionFiltros Filtros="filtros" 
                    OnFiltrosAplicados="AplicarFiltros"
                    Aplicando="cargando" />

<!-- Filtros Rápidos y Acciones Administrativas -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="oi oi-magnifying-glass"></i> Filtros Rápidos
                </h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-primary @(filtros.EsHoy == true ? "active" : "")" @onclick="FiltroHoy">
                        <i class="oi oi-calendar"></i> Hoy
                    </button>
                    <button class="btn btn-sm btn-outline-primary @(filtros.EsFutura == true ? "active" : "")" @onclick="FiltroMañana">
                        <i class="oi oi-calendar"></i> Mañana
                    </button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="FiltroEstaSemana">
                        <i class="oi oi-calendar"></i> Esta Semana
                    </button>
                    <button class="btn btn-sm btn-outline-warning @(filtros.EsUrgente == true ? "active" : "")" @onclick="FiltroPendientes">
                        <i class="oi oi-clock"></i> Pendientes
                    </button>
                    <button class="btn btn-sm btn-outline-warning @(filtros.EsVIP == true ? "active" : "")" @onclick="FiltroVIP">
                        <i class="oi oi-star"></i> VIP
                    </button>
                    <button class="btn btn-sm btn-outline-info @(filtros.EsGrupo == true ? "active" : "")" @onclick="FiltroGrupos">
                        <i class="oi oi-people"></i> Grupos
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltros">
                        <i class="oi oi-reload"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="oi oi-cog"></i> Acciones
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button class="btn btn-success btn-sm" @onclick="ImportarReservaciones">
                        <i class="oi oi-data-transfer-upload"></i> Importar
                    </button>
                    <button class="btn btn-warning btn-sm" @onclick="ExportarExcel">
                        <i class="oi oi-spreadsheet"></i> Exportar Excel
                    </button>
                    <button class="btn btn-info btn-sm" @onclick="ConfigurarHorarios">
                        <i class="oi oi-clock"></i> Configurar Horarios
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="GenerarReportes">
                        <i class="oi oi-document"></i> Reportes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lista de reservaciones -->
<ReservacionList Reservaciones="reservaciones" 
                 Paginacion="paginacion"
                 OnEditarReservacion="EditarReservacion"
                 OnCancelar="CancelarReservacion"
                 OnConfirmar="ConfirmarReservacion"
                 OnMarcarLlegada="MarcarLlegada"
                 OnMarcarSalida="MarcarSalida"
                 OnReasignarMesa="ReasignarMesa"
                 OnCambiarHora="CambiarHora"
                 OnDuplicar="DuplicarReservacion"
                 OnVerDetalles="VerDetalles"
                 OnNuevaReservacion="NuevaReservacion"
                 OnCambiarPagina="CambiarPagina"
                 OnExportarExcel="ExportarExcel" />

<!-- Formulario de reservación -->
<ReservacionForm Mostrar="mostrarFormulario" 
                 MostrarChanged="MostrarFormularioChanged"
                 OnReservacionGuardada="ReservacionGuardada" />

<!-- Modal de detalles de la reservación -->
@if (mostrarDetalles && reservacionSeleccionada != null)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="oi oi-calendar"></i> Detalles de la Reservación: @reservacionSeleccionada.NumeroReservacion
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarDetalles"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Información de la Reservación</h6>
                            <table class="table table-sm">
                                <tr><td><strong>Número:</strong></td><td>@reservacionSeleccionada.NumeroReservacion</td></tr>
                                <tr><td><strong>Fecha Creación:</strong></td><td>@reservacionSeleccionada.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td></tr>
                                <tr><td><strong>Fecha Reservación:</strong></td><td>@reservacionSeleccionada.FechaReservacion.ToString("dd/MM/yyyy")</td></tr>
                                <tr><td><strong>Hora:</strong></td><td>@reservacionSeleccionada.HoraReservacion.ToString("hh\\:mm")</td></tr>
                                <tr><td><strong>Estado:</strong></td><td><span class="badge bg-@reservacionSeleccionada.ClaseEstado">@reservacionSeleccionada.EstadoVisual</span></td></tr>
                                <tr><td><strong>Personas:</strong></td><td>@reservacionSeleccionada.NumeroPersonas</td></tr>
                                <tr><td><strong>Canal:</strong></td><td>@reservacionSeleccionada.CanalReservacion</td></tr>
                                <tr><td><strong>Fuente:</strong></td><td>@reservacionSeleccionada.FuenteReservacion</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Información del Cliente y Mesa</h6>
                            <table class="table table-sm">
                                <tr><td><strong>Cliente:</strong></td><td>@reservacionSeleccionada.ClienteNombre</td></tr>
                                <tr><td><strong>Email:</strong></td><td>@reservacionSeleccionada.ClienteEmail</td></tr>
                                <tr><td><strong>Teléfono:</strong></td><td>@reservacionSeleccionada.ClienteTelefono</td></tr>
                                <tr><td><strong>Mesa:</strong></td><td>@reservacionSeleccionada.MesaNombre</td></tr>
                                <tr><td><strong>Ubicación:</strong></td><td>@reservacionSeleccionada.MesaUbicacion</td></tr>
                                <tr><td><strong>Capacidad:</strong></td><td>@reservacionSeleccionada.MesaCapacidad personas</td></tr>
                                <tr><td><strong>Urgente:</strong></td><td>@(reservacionSeleccionada.EsUrgente ? "Sí" : "No")</td></tr>
                                <tr><td><strong>VIP:</strong></td><td>@(reservacionSeleccionada.EsVIP ? "Sí" : "No")</td></tr>
                            </table>
                        </div>
                    </div>
                    
                    @if (reservacionSeleccionada.EsGrupo)
                    {
                        <h6>Información de Grupo</h6>
                        <div class="card">
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(reservacionSeleccionada.NombreGrupo))
                                {
                                    <p><strong>Nombre del Grupo:</strong> @reservacionSeleccionada.NombreGrupo</p>
                                }
                                @if (!string.IsNullOrEmpty(reservacionSeleccionada.EmpresaGrupo))
                                {
                                    <p><strong>Empresa:</strong> @reservacionSeleccionada.EmpresaGrupo</p>
                                }
                                @if (reservacionSeleccionada.TamañoGrupo.HasValue)
                                {
                                    <p><strong>Tamaño del Grupo:</strong> @reservacionSeleccionada.TamañoGrupo personas</p>
                                }
                            </div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(reservacionSeleccionada.ContactoAlternativo))
                    {
                        <h6>Información de Contacto Adicional</h6>
                        <div class="card">
                            <div class="card-body">
                                <p><strong>Contacto:</strong> @reservacionSeleccionada.ContactoAlternativo</p>
                                @if (!string.IsNullOrEmpty(reservacionSeleccionada.TelefonoAlternativo))
                                {
                                    <p><strong>Teléfono:</strong> @reservacionSeleccionada.TelefonoAlternativo</p>
                                }
                                @if (!string.IsNullOrEmpty(reservacionSeleccionada.EmailAlternativo))
                                {
                                    <p><strong>Email:</strong> @reservacionSeleccionada.EmailAlternativo</p>
                                }
                            </div>
                        </div>
                    }
                    
                    @if (reservacionSeleccionada.EsRecurrente)
                    {
                        <h6>Información de Recurrencia</h6>
                        <div class="card">
                            <div class="card-body">
                                <p><strong>Frecuencia:</strong> @reservacionSeleccionada.FrecuenciaRecurrencia</p>
                                @if (reservacionSeleccionada.FechaFinRecurrencia.HasValue)
                                {
                                    <p><strong>Fecha Fin:</strong> @reservacionSeleccionada.FechaFinRecurrencia.Value.ToString("dd/MM/yyyy")</p>
                                }
                            </div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(reservacionSeleccionada.Observaciones))
                    {
                        <h6>Observaciones</h6>
                        <p>@reservacionSeleccionada.Observaciones</p>
                    }
                    
                    @if (!string.IsNullOrEmpty(reservacionSeleccionada.NotasEspeciales))
                    {
                        <h6>Notas Especiales</h6>
                        <p>@reservacionSeleccionada.NotasEspeciales</p>
                    }
                    
                    @if (!string.IsNullOrEmpty(reservacionSeleccionada.RequerimientosEspeciales))
                    {
                        <h6>Requerimientos Especiales</h6>
                        <p>@reservacionSeleccionada.RequerimientosEspeciales</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarDetalles">
                        <i class="oi oi-x"></i> Cerrar
                    </button>
                    <button type="button" class="btn btn-warning" @onclick="EditarReservacionDesdeDetalles">
                        <i class="oi oi-pencil"></i> Editar
                    </button>
                    @if (reservacionSeleccionada.EstaPendiente)
                    {
                        <button type="button" class="btn btn-success" @onclick="ConfirmarReservacionDesdeDetalles">
                            <i class="oi oi-check"></i> Confirmar
                        </button>
                    }
                    @if (reservacionSeleccionada.EstaConfirmada && !reservacionSeleccionada.EstaCompletada)
                    {
                        <button type="button" class="btn btn-info" @onclick="MarcarLlegadaDesdeDetalles">
                            <i class="oi oi-arrow-right"></i> Marcar Llegada
                        </button>
                    }
                    @if (reservacionSeleccionada.EstaEnProceso)
                    {
                        <button type="button" class="btn btn-primary" @onclick="MarcarSalidaDesdeDetalles">
                            <i class="oi oi-arrow-left"></i> Marcar Salida
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private ReservacionFiltrosDto filtros = new();
    private List<ReservacionDto>? reservaciones;
    private PaginatedList<ReservacionDto>? paginacion;
    private ReservacionEstadisticasDto? estadisticas;
    private ReservacionDto? reservacionSeleccionada;
    
    private bool mostrarFormulario = false;
    private bool mostrarDetalles = false;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        await Task.WhenAll(
            CargarReservaciones(),
            CargarEstadisticas()
        );
    }

    private async Task CargarReservaciones()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            var resultado = await ReservacionesApi.ObtenerReservacionesAsync(filtros);
            if (resultado != null)
            {
                reservaciones = resultado.Items?.ToList() ?? new List<ReservacionDto>();
                paginacion = resultado;
            }
            else
            {
                reservaciones = new List<ReservacionDto>();
                paginacion = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reservaciones: {ex.Message}");
            reservaciones = new List<ReservacionDto>();
            paginacion = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarEstadisticas()
    {
        try
        {
            estadisticas = await ReservacionesApi.ObtenerEstadisticasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar estadísticas: {ex.Message}");
        }
    }

    private async Task AplicarFiltros(ReservacionFiltrosDto filtrosAplicados)
    {
        filtros = filtrosAplicados;
        await CargarReservaciones();
    }

    private async Task CambiarPagina(int pagina)
    {
        filtros.PageNumber = pagina;
        await CargarReservaciones();
    }

    private void NuevaReservacion()
    {
        mostrarFormulario = true;
        StateHasChanged();
    }

    private void EditarReservacion(ReservacionDto reservacion)
    {
        reservacionSeleccionada = reservacion;
        mostrarFormulario = true;
        StateHasChanged();
    }

    private void EditarReservacionDesdeDetalles()
    {
        if (reservacionSeleccionada != null)
        {
            mostrarDetalles = false;
            mostrarFormulario = true;
            StateHasChanged();
        }
    }

    private async Task ConfirmarReservacion(ReservacionDto reservacion)
    {
        var confirmacion = await JSRuntime.InvokeAsync<bool>("confirm", 
            "¿Estás seguro de que quieres confirmar esta reservación?");
        
        if (confirmacion)
        {
            try
            {
                var request = new ConfirmarReservacionRequest
                {
                    ReservacionId = reservacion.Id,
                    Observaciones = "Reservación confirmada desde el sistema"
                };

                var resultado = await ReservacionesApi.ConfirmarReservacionAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Reservación confirmada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al confirmar la reservación");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task ConfirmarReservacionDesdeDetalles()
    {
        if (reservacionSeleccionada != null)
        {
            await ConfirmarReservacion(reservacionSeleccionada);
        }
    }

    private async Task CancelarReservacion(ReservacionDto reservacion)
    {
        var motivo = await JSRuntime.InvokeAsync<string>("prompt", 
            "Ingresa el motivo de cancelación:", "");
        
        if (!string.IsNullOrEmpty(motivo))
        {
            try
            {
                var request = new CancelarReservacionRequest
                {
                    ReservacionId = reservacion.Id,
                    MotivoCancelacion = motivo,
                    Observaciones = "Reservación cancelada desde el sistema"
                };

                var resultado = await ReservacionesApi.CancelarReservacionAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Reservación cancelada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al cancelar la reservación");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task MarcarLlegada(ReservacionDto reservacion)
    {
        var confirmacion = await JSRuntime.InvokeAsync<bool>("confirm", 
            "¿Estás seguro de que quieres marcar la llegada de esta reservación?");
        
        if (confirmacion)
        {
            try
            {
                var request = new MarcarLlegadaRequest
                {
                    ReservacionId = reservacion.Id,
                    Observaciones = "Llegada marcada desde el sistema"
                };

                var resultado = await ReservacionesApi.MarcarLlegadaAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Llegada marcada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al marcar la llegada");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task MarcarLlegadaDesdeDetalles()
    {
        if (reservacionSeleccionada != null)
        {
            await MarcarLlegada(reservacionSeleccionada);
        }
    }

    private async Task MarcarSalida(ReservacionDto reservacion)
    {
        var confirmacion = await JSRuntime.InvokeAsync<bool>("confirm", 
            "¿Estás seguro de que quieres marcar la salida de esta reservación?");
        
        if (confirmacion)
        {
            try
            {
                var request = new MarcarSalidaRequest
                {
                    ReservacionId = reservacion.Id,
                    Observaciones = "Salida marcada desde el sistema"
                };

                var resultado = await ReservacionesApi.MarcarSalidaAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Salida marcada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al marcar la salida");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task MarcarSalidaDesdeDetalles()
    {
        if (reservacionSeleccionada != null)
        {
            await MarcarSalida(reservacionSeleccionada);
        }
    }

    private async Task ReasignarMesa(ReservacionDto reservacion)
    {
        var nuevaMesaId = await JSRuntime.InvokeAsync<string>("prompt", 
            "Ingresa el ID de la nueva mesa:", "");
        
        if (!string.IsNullOrEmpty(nuevaMesaId) && Guid.TryParse(nuevaMesaId, out var mesaId))
        {
            try
            {
                var request = new ReasignarMesaReservacionRequest
                {
                    ReservacionId = reservacion.Id,
                    NuevaMesaId = mesaId,
                    Observaciones = "Mesa reasignada desde el sistema"
                };

                var resultado = await ReservacionesApi.ReasignarMesaAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Mesa reasignada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al reasignar la mesa");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task CambiarHora(ReservacionDto reservacion)
    {
        var nuevaHora = await JSRuntime.InvokeAsync<string>("prompt", 
            "Ingresa la nueva hora (HH:MM):", reservacion.HoraReservacion.ToString("hh\\:mm"));
        
        if (!string.IsNullOrEmpty(nuevaHora) && TimeSpan.TryParse(nuevaHora, out var hora))
        {
            try
            {
                var request = new CambiarHoraReservacionRequest
                {
                    ReservacionId = reservacion.Id,
                    NuevaHora = hora,
                    Observaciones = "Hora cambiada desde el sistema"
                };

                var resultado = await ReservacionesApi.CambiarHoraAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Hora cambiada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al cambiar la hora");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private async Task DuplicarReservacion(ReservacionDto reservacion)
    {
        var nuevaFecha = await JSRuntime.InvokeAsync<string>("prompt", 
            "Ingresa la nueva fecha (YYYY-MM-DD):", reservacion.FechaReservacion.ToString("yyyy-MM-dd"));
        
        if (!string.IsNullOrEmpty(nuevaFecha) && DateTime.TryParse(nuevaFecha, out var fecha))
        {
            try
            {
                var request = new DuplicarReservacionRequest
                {
                    ReservacionId = reservacion.Id,
                    NuevaFecha = fecha,
                    NuevaHora = reservacion.HoraReservacion,
                    Observaciones = "Reservación duplicada desde el sistema"
                };

                var resultado = await ReservacionesApi.DuplicarReservacionAsync(request);
                if (resultado?.Success == true)
                {
                    await CargarReservaciones();
                    await JSRuntime.InvokeVoidAsync("alert", "Reservación duplicada correctamente");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al duplicar la reservación");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            }
        }
    }

    private void VerDetalles(ReservacionDto reservacion)
    {
        reservacionSeleccionada = reservacion;
        mostrarDetalles = true;
        StateHasChanged();
    }

    private void CerrarDetalles()
    {
        mostrarDetalles = false;
        reservacionSeleccionada = null;
        StateHasChanged();
    }

    private void MostrarFormularioChanged(bool mostrar)
    {
        mostrarFormulario = mostrar;
        if (!mostrar)
        {
            reservacionSeleccionada = null;
        }
        StateHasChanged();
    }

    private async Task ReservacionGuardada(ReservacionDto reservacion)
    {
        await CargarDatos();
        mostrarFormulario = false;
        reservacionSeleccionada = null;
        StateHasChanged();
    }

