    // Métodos para filtros rápidos
    private async Task FiltroHoy()
    {
        filtros.EsHoy = !filtros.EsHoy;
        filtros.FechaInicio = DateTime.Today;
        filtros.FechaFin = DateTime.Today;
        await CargarReservaciones();
    }

    private async Task FiltroMañana()
    {
        filtros.EsFutura = !filtros.EsFutura;
        filtros.FechaInicio = DateTime.Today.AddDays(1);
        filtros.FechaFin = DateTime.Today.AddDays(1);
        await CargarReservaciones();
    }

    private async Task FiltroEstaSemana()
    {
        var inicioSemana = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
        var finSemana = inicioSemana.AddDays(6);
        filtros.FechaInicio = inicioSemana;
        filtros.FechaFin = finSemana;
        await CargarReservaciones();
    }

    private async Task FiltroPendientes()
    {
        filtros.Estado = filtros.Estado == "Pendiente" ? "" : "Pendiente";
        await CargarReservaciones();
    }

    private async Task FiltroVIP()
    {
        filtros.EsVIP = !filtros.EsVIP;
        await CargarReservaciones();
    }

    private async Task FiltroGrupos()
    {
        filtros.EsGrupo = !filtros.EsGrupo;
        await CargarReservaciones();
    }

    private async Task LimpiarFiltros()
    {
        filtros = new ReservacionFiltrosDto
        {
            OrdenarPor = "FechaHoraCompleta",
            DireccionOrden = "asc",
            PageNumber = 1,
            PageSize = 20
        };
        await CargarReservaciones();
    }

