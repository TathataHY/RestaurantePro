@page "/test-auth"
@using RestaurantePro.Web.Admin.Services
@inject TokenStore TokenStore
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Test de Autenticación</PageTitle>

<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">🧪 Test de Funcionalidad "Recordar mi Sesión"</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Estado Actual -->
        <div class="bg-white p-4 rounded-lg shadow">
            <h2 class="text-lg font-semibold mb-4">📊 Estado Actual de la Sesión</h2>
            <div class="space-y-2 text-sm">
                <p><strong>Usuario:</strong> @TokenStore.UserName</p>
                <p><strong>Token válido:</strong> @(TokenStore.IsAuthenticated ? "✅ Sí" : "❌ No")</p>
                <p><strong>Expiración:</strong> @TokenStore.Expiration.ToString("dd/MM/yyyy HH:mm:ss")</p>
                <p><strong>Refresh Token:</strong> @(string.IsNullOrEmpty(TokenStore.RefreshToken) ? "❌ No disponible" : "✅ Disponible")</p>
                <p><strong>Roles:</strong> @string.Join(", ", TokenStore.Roles)</p>
            </div>
        </div>

        <!-- Datos en localStorage -->
        <div class="bg-white p-4 rounded-lg shadow">
            <h2 class="text-lg font-semibold mb-4">💾 Datos en localStorage</h2>
            <div class="space-y-2 text-sm">
                <p><strong>Token guardado:</strong> @(string.IsNullOrEmpty(localStorageToken) ? "❌ No" : "✅ Sí")</p>
                <p><strong>Refresh Token guardado:</strong> @(string.IsNullOrEmpty(localStorageRefreshToken) ? "❌ No" : "✅ Sí")</p>
                <p><strong>Fecha guardada:</strong> @localStorageExpiration</p>
                <p><strong>Usuario guardado:</strong> @localStorageUserName</p>
            </div>
            <button class="mt-4 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" @onclick="LoadLocalStorageData">
                🔄 Actualizar Datos
            </button>
        </div>
    </div>

    <!-- Pruebas -->
    <div class="mt-6 bg-yellow-50 p-4 rounded-lg">
        <h2 class="text-lg font-semibold mb-4">🧪 Pruebas de Funcionalidad</h2>
        <div class="space-y-4">
            <div>
                <h3 class="font-medium">Test 1: Verificar Persistencia</h3>
                <p class="text-sm text-gray-600 mb-2">Recarga la página para ver si la sesión se mantiene</p>
                <button class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600" @onclick="ReloadPage">
                    🔄 Recargar Página
                </button>
            </div>

            <div>
                <h3 class="font-medium">Test 2: Limpiar Sesión</h3>
                <p class="text-sm text-gray-600 mb-2">Limpia la sesión actual para probar el login</p>
                <button class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600" @onclick="ClearSession">
                    🗑️ Limpiar Sesión
                </button>
            </div>
        </div>
    </div>

    <!-- Instrucciones -->
    <div class="mt-6 bg-blue-50 p-4 rounded-lg">
        <h2 class="text-lg font-semibold mb-4">📝 Instrucciones para Probar</h2>
        <ol class="list-decimal list-inside space-y-2 text-sm">
            <li>Haz logout y vuelve a hacer login <strong>CON</strong> la opción "Recordar mi sesión" marcada</li>
            <li>Verifica que aparezca un "Refresh Token" en el estado actual</li>
            <li>Cierra el navegador completamente y vuelve a abrir</li>
            <li>Navega a la página administrativa - deberías seguir logueado</li>
            <li>Repite el proceso <strong>SIN</strong> marcar "Recordar mi sesión" y verifica la diferencia</li>
        </ol>
    </div>
</div>

@code {
    private string localStorageToken = "";
    private string localStorageRefreshToken = "";
    private string localStorageExpiration = "";
    private string localStorageUserName = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadLocalStorageData();
        }
    }

    private async Task LoadLocalStorageData()
    {
        try
        {
            localStorageToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "auth_token") ?? "";
            localStorageRefreshToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "auth_refresh_token") ?? "";
            localStorageExpiration = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "auth_expiration") ?? "";
            localStorageUserName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "auth_username") ?? "";
            
            // Truncar el token para mostrar solo los primeros y últimos caracteres
            if (!string.IsNullOrEmpty(localStorageToken) && localStorageToken.Length > 20)
            {
                localStorageToken = localStorageToken[..10] + "..." + localStorageToken[^10..];
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading localStorage data: {ex.Message}");
        }
    }

    private async Task ReloadPage()
    {
        await JSRuntime.InvokeVoidAsync("location.reload");
    }

    private async Task ClearSession()
    {
        await TokenStore.ClearAsync();
        await JSRuntime.InvokeVoidAsync("location.reload");
    }
}
