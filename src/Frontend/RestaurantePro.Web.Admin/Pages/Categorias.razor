@attribute [Authorize]
@page "/categorias"
@using RestaurantePro.Web.Admin.Models
@inject RestaurantePro.Web.Admin.Services.ICategoriasApiService CategoriasApi
@inject IJSRuntime JSRuntime

<PageTitle>Categorías</PageTitle>

<!-- Header Responsive -->
<div class="mb-6 space-y-4">
    <!-- Título -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Gestión de Categorías</h1>
            <p class="text-gray-600 mt-2">Organiza y gestiona las categorías de productos del menú</p>
        </div>
        
        <!-- Botón Nueva Categoría (Solo móvil) -->
        <button class="sm:hidden flex items-center justify-center gap-2 bg-blue-600 text-white font-bold py-3 px-4 rounded-lg shadow-md hover:bg-blue-700 transition-colors w-full" @onclick="NuevaCategoria">
            <span class="material-symbols-outlined">add</span>
            <span>Nueva Categoría</span>
        </button>
    </div>
    
    <!-- Controles -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <!-- Toggle de vista -->
        <div class="flex items-center bg-gray-100 rounded-lg p-1 w-full sm:w-auto">
            <button class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium rounded-md @(vistaTabla ? "bg-white text-blue-600 shadow-sm" : "text-gray-600")" 
                    @onclick="() => CambiarVista(true)">
                <span class="material-symbols-outlined text-sm">table_rows</span>
                <span class="hidden sm:inline">Tabla</span>
            </button>
            <button class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium rounded-md @(!vistaTabla ? "bg-white text-blue-600 shadow-sm" : "text-gray-600")" 
                    @onclick="() => CambiarVista(false)">
                <span class="material-symbols-outlined text-sm">grid_view</span>
                <span class="hidden sm:inline">Grid</span>
            </button>
        </div>
        
        <!-- Botón Nueva Categoría (Desktop) -->
        <button class="hidden sm:flex items-center gap-2 bg-blue-600 text-white font-bold py-2 px-4 rounded-lg shadow-md hover:bg-blue-700 transition-colors" @onclick="NuevaCategoria">
            <span class="material-symbols-outlined">add</span>
            <span>Nueva Categoría</span>
        </button>
    </div>
</div>

        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md mb-8">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Filtros</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 items-end">
                <label class="flex flex-col gap-2">
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Nombre</span>
                    <input class="form-input w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-primary-color focus:border-primary-color transition" 
                           placeholder="Buscar por nombre" 
                           @bind="filtro" 
                           @oninput="BuscarAsync" />
                </label>
                <label class="flex flex-col gap-2">
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Estado</span>
                    <select class="form-select w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-primary-color focus:border-primary-color transition" 
                            value="@estadoFiltro" 
                            @onchange="OnEstadoChanged">
                        <option value="">Todos</option>
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </label>
                <button class="flex items-center justify-center gap-2 rounded-md h-10 px-4 bg-primary-color text-white text-sm font-medium shadow-md hover:bg-blue-700 transition-colors w-full lg:w-auto" 
                        @onclick="BuscarAsync">
                    <span class="material-symbols-outlined">search</span>
                    <span>Aplicar Filtros</span>
                </button>
            </div>
        </div>

        @if (cargando)
        {
            <div class="flex justify-center items-center py-12">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-color mx-auto mb-4"></div>
                    <p class="text-gray-500">Cargando categorías...</p>
                </div>
            </div>
        }
        else
        {
            <!-- Métricas principales -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
                    <p class="text-sm font-medium text-gray-500">Total de Categorías</p>
                    <p class="text-3xl font-bold text-gray-900">@(categorias?.Count ?? 0)</p>
                </div>
                <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
                    <p class="text-sm font-medium text-gray-500">Categorías Activas</p>
                    <p class="text-3xl font-bold text-green-600">@(categorias?.Count(c => c.Activa) ?? 0)</p>
                </div>
                <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
                    <p class="text-sm font-medium text-gray-500">Productos Asociados</p>
                    <p class="text-3xl font-bold text-blue-600">@(categorias?.Sum(c => c.CantidadProductos) ?? 0)</p>
                </div>
                <div class="flex flex-col gap-2 rounded-xl bg-white p-6 shadow-sm border border-gray-200">
                    <p class="text-sm font-medium text-gray-500">Categoría Más Popular</p>
                    <p class="text-xl font-bold text-orange-500 truncate">@(categorias?.OrderByDescending(c => c.CantidadProductos).FirstOrDefault()?.Nombre ?? "N/A")</p>
                </div>
            </div>
            @if (categorias == null || !categorias.Any())
            {
                <div class="text-center py-12">
                    <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">category</span>
                    <p class="text-gray-500 text-lg">No hay categorías</p>
                    <p class="text-gray-400 text-sm">Crea tu primera categoría para organizar los productos del menú</p>
                    <button class="mt-4 px-4 py-2 bg-primary-color text-white rounded-lg hover:bg-primary-color/90 transition-colors" @onclick="NuevaCategoria">
                        <span class="material-symbols-outlined">add</span> Crear Primera Categoría
                    </button>
                </div>
            }
            else
            {
                @if (vistaTabla)
                {
                    <!-- Vista de Tabla Responsive -->
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                        <!-- Vista Desktop -->
                        <div class="hidden md:block overflow-x-auto">
                            <table class="w-full text-sm text-left text-gray-500">
                                <thead class="text-xs text-gray-700 uppercase bg-gray-100">
                                    <tr>
                                        <th class="px-6 py-3" scope="col">Icono</th>
                                        <th class="px-6 py-3" scope="col">Nombre</th>
                                        <th class="px-6 py-3" scope="col">Descripción</th>
                                        <th class="px-6 py-3 text-center" scope="col">Productos</th>
                                        <th class="px-6 py-3" scope="col">Estado</th>
                                        <th class="px-6 py-3" scope="col">Posición</th>
                                        <th class="px-6 py-3 text-right" scope="col">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in categorias.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                                    {
                                        <tr class="bg-white border-b hover:bg-gray-50">
                                            <td class="px-6 py-4">
                                                <div class="flex items-center justify-center w-10 h-10 rounded-lg" style="background-color: @c.Color">
                                                    <span class="material-symbols-outlined text-white text-lg">@c.Icono</span>
                                                </div>
                                            </td>
                                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap" scope="row">@c.Nombre</th>
                                            <td class="px-6 py-4 text-gray-500">@(string.IsNullOrEmpty(c.Descripcion) ? "Sin descripción" : c.Descripcion)</td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">@c.CantidadProductos productos</span>
                                            </td>
                                            <td class="px-6 py-4">
                                                @if (c.Activa)
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                        <span class="w-1.5 h-1.5 bg-green-400 rounded-full mr-1.5"></span>
                                                        Activo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                        <span class="w-1.5 h-1.5 bg-red-400 rounded-full mr-1.5"></span>
                                                        Inactivo
                                                    </span>
                                                }
                                            </td>
                                            <td class="px-6 py-4 text-gray-500">
                                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                    #@c.Orden
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right space-x-2">
                                                <button class="p-1 text-gray-400 hover:text-blue-600" @onclick="() => EditarCategoria(c.Id)" title="Editar">
                                                    <span class="material-symbols-outlined">edit</span>
                                                </button>
                                                <button class="p-1 text-gray-400 hover:text-red-600" @onclick="() => EliminarCategoria(c.Id)" title="Eliminar">
                                                    <span class="material-symbols-outlined">delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Vista Mobile (Lista de Cards) -->
                        <div class="md:hidden space-y-3 p-4">
                            @foreach (var c in categorias.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                            {
                                <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
                                    <div class="flex items-start gap-3">
                                        <!-- Icono -->
                                        <div class="flex-shrink-0">
                                            <div class="flex items-center justify-center w-12 h-12 rounded-lg" style="background-color: @c.Color">
                                                <span class="material-symbols-outlined text-white text-lg">@c.Icono</span>
                                            </div>
                                        </div>
                                        
                                        <!-- Contenido -->
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-start justify-between gap-2">
                                                <div class="flex-1 min-w-0">
                                                    <h3 class="font-semibold text-gray-900 truncate">@c.Nombre</h3>
                                                    <p class="text-sm text-gray-500 truncate">@(string.IsNullOrEmpty(c.Descripcion) ? "Sin descripción" : c.Descripcion)</p>
                                                    <div class="flex items-center gap-3 mt-2">
                                                        <span class="text-sm font-medium text-blue-600">@c.CantidadProductos productos</span>
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                            Posición #@c.Orden
                                                        </span>
                                                    </div>
                                                </div>
                                                
                                                <!-- Estado -->
                                                <div class="flex-shrink-0">
                                                    @if (c.Activa)
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                            <span class="w-1.5 h-1.5 bg-green-400 rounded-full mr-1"></span>
                                                            Activo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                            <span class="w-1.5 h-1.5 bg-red-400 rounded-full mr-1"></span>
                                                            Inactivo
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <!-- Acciones -->
                                            <div class="flex items-center gap-2 mt-3">
                                                <button @onclick="() => EditarCategoria(c.Id)" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium">
                                                    <span class="material-symbols-outlined text-base">edit</span>
                                                    <span>Editar</span>
                                                </button>
                                                <button @onclick="() => EliminarCategoria(c.Id)" class="flex items-center justify-center px-3 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors" title="Eliminar">
                                                    <span class="material-symbols-outlined text-base">delete</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- Vista de Grid Responsive -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
                        @foreach (var c in categorias.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                        {
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 hover:shadow-lg transition-all duration-300 hover:scale-105">
                                <!-- Header con icono y estado -->
                                <div class="flex flex-col items-center text-center mb-6">
                                    <div class="flex items-center justify-center w-16 h-16 rounded-2xl mb-4 shadow-sm" style="background-color: @c.Color">
                                        <span class="material-symbols-outlined text-white text-2xl">@c.Icono</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-gray-900 mb-2">@c.Nombre</h3>
                                    <div class="flex items-center justify-center gap-2 mb-3">
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            Posición #@c.Orden en el menú
                                        </span>
                                    </div>
                                    @if (c.Activa)
                                    {
                                        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            <span class="w-2 h-2 bg-red-400 rounded-full mr-2"></span>
                                            Inactivo
                                        </span>
                                    }
                                </div>
                                
                                <!-- Información de la categoría -->
                                <div class="space-y-4 mb-8">
                                    <div class="flex items-start gap-3">
                                        <span class="material-symbols-outlined text-gray-400 text-lg mt-0.5">description</span>
                                        <div>
                                            <p class="text-sm font-medium text-gray-700 mb-1">Descripción</p>
                                            <p class="text-sm text-gray-600 leading-relaxed">@(string.IsNullOrEmpty(c.Descripcion) ? "Sin descripción" : c.Descripcion)</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-gray-400 text-lg">inventory</span>
                                        <div>
                                            <p class="text-sm font-medium text-gray-700">Productos</p>
                                            <p class="text-lg font-bold text-blue-600">@c.CantidadProductos</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-gray-400 text-lg">calendar_today</span>
                                        <div>
                                            <p class="text-sm font-medium text-gray-700">Creado</p>
                                            <p class="text-sm text-gray-600">@c.FechaCreacion.ToString("dd/MM/yyyy")</p>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Botones de acción -->
                                <div class="flex items-center justify-center gap-2">
                                    <button class="flex items-center gap-2 px-4 py-2 text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all duration-200 font-medium" @onclick="() => EditarCategoria(c.Id)" title="Editar">
                                        <span class="material-symbols-outlined text-lg">edit</span>
                                        <span class="text-sm">Editar</span>
                                    </button>
                                    <button class="flex items-center gap-2 px-4 py-2 text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all duration-200 font-medium" @onclick="() => EliminarCategoria(c.Id)" title="Eliminar">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                        <span class="text-sm">Eliminar</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }

<!-- Modal para Crear/Editar Categoría -->
@if (mostrandoModal)
{
    <div aria-labelledby="modal-title" aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-6 sm:p-8" role="dialog">
        <div class="relative flex flex-col bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[80vh] sm:max-h-[75vh] overflow-hidden">
            <!-- Header del Modal -->
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-gray-200">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center rounded-full bg-primary-color/10 shrink-0 size-8 sm:size-10">
                        <span class="material-symbols-outlined text-primary-color text-lg sm:text-xl">@(editando ? "edit" : "add")</span>
                    </div>
                    <div>
                        <h2 class="text-lg sm:text-xl font-bold text-gray-900" id="modal-title">@(editando ? "Editar Categoría" : "Nueva Categoría")</h2>
                        <p class="text-xs sm:text-sm text-gray-500 hidden sm:block">@(editando ? "Modifica los datos de la categoría" : "Crea una nueva categoría para organizar tus productos")</p>
                    </div>
                </div>
                <button type="button" class="text-gray-400 hover:text-gray-600 transition-colors p-1" @onclick="CerrarModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <EditForm Model="categoriaForm" OnValidSubmit="GuardarCategoria">
                <DataAnnotationsValidator />
                
                <!-- Body del Modal -->
                <div class="flex-1 overflow-y-auto p-4 sm:p-6" style="max-height: calc(75vh - 180px);">
                    @if (!string.IsNullOrEmpty(errorValidacion))
                    {
                        <div class="mb-4 p-3 sm:p-4 bg-red-50 border border-red-200 rounded-lg">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-red-500 text-lg">error</span>
                                <span class="text-red-700 font-medium text-sm sm:text-base">Error de validación:</span>
                            </div>
                            <p class="text-red-600 text-sm mt-1">@errorValidacion</p>
                        </div>
                    }
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
                        <!-- Columna Izquierda - Información Básica -->
                        <div class="space-y-4">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 mb-3">Información Básica</h3>
                                
                                <!-- Nombre -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre de la Categoría *</label>
                                    <input type="text" 
                                           @bind="categoriaForm.Nombre" 
                                           @oninput="OnNombreChanged"
                                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors" 
                                           placeholder="Ej: Entradas, Platos Principales, Postres" />
                                    <ValidationMessage For="@(() => categoriaForm.Nombre)" class="text-red-500 text-sm mt-1" />
                                    @if (mostrandoValidacionNombre)
                                    {
                                        <div class="flex items-center gap-2 text-blue-500 text-sm mt-1">
                                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-500"></div>
                                            <span>Validando nombre...</span>
                                        </div>
                                    }
                                    @if (nombreDisponible && !string.IsNullOrEmpty(categoriaForm.Nombre))
                                    {
                                        <div class="flex items-center gap-2 text-green-500 text-sm mt-1">
                                            <span class="material-symbols-outlined text-sm">check_circle</span>
                                            <span>Nombre disponible</span>
                                        </div>
                                    }
                                </div>

                                <!-- Descripción -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                                    <textarea @bind="categoriaForm.Descripcion" 
                                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors resize-none" 
                                              rows="3" 
                                              placeholder="Describe brevemente esta categoría"></textarea>
                                    <div class="text-right text-xs text-gray-500 mt-1">@(categoriaForm.Descripcion?.Length ?? 0)/200</div>
                                </div>


                                <!-- Orden y Estado -->
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Posición en el Menú
                                            <span class="text-xs text-gray-500 font-normal block">¿En qué orden aparece en el menú?</span>
                                        </label>
                                        <input type="number" 
                                               @bind="categoriaForm.Orden" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors" 
                                               min="1" max="100" 
                                               placeholder="Ej: 1 (primera), 2 (segunda)..." />
                                        <p class="text-xs text-gray-500 mt-1">
                                            💡 <strong>1</strong> = Primera categoría, <strong>2</strong> = Segunda, etc.
                                        </p>
                                        <!-- Ejemplo visual del orden -->
                                        <div class="mt-2 p-2 bg-blue-50 rounded-lg border border-blue-200">
                                            <p class="text-xs text-blue-700 font-medium mb-1">📋 Ejemplo:</p>
                                            <div class="text-xs text-blue-600">1️⃣ Entradas → 2️⃣ Sopas → 3️⃣ Principales → 4️⃣ Postres</div>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-center">
                                        <div class="flex items-center gap-3">
                                            <span class="text-sm font-medium text-gray-700">Activa</span>
                                            <label class="relative inline-flex items-center cursor-pointer">
                                                <input type="checkbox" @bind="categoriaForm.Activa" class="sr-only peer">
                                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-color/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-color"></div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Columna Derecha - Configuración Visual -->
                        <div class="space-y-4">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 mb-3">Configuración Visual</h3>
                                
                                <!-- Color -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Color de la Categoría</label>
                                    <div class="space-y-2">
                                        <!-- Paleta de colores sugeridos -->
                                        <div class="grid grid-cols-6 gap-1">
                                            @foreach (var color in new[] { "#1e71f6", "#22c55e", "#f97316", "#8b5cf6", "#ef4444", "#ec4899" })
                                            {
                                                <button type="button" 
                                                        @onclick="() => categoriaForm.Color = color"
                                                        class="w-6 h-6 rounded-full border-2 @(categoriaForm.Color == color ? "border-gray-900" : "border-gray-300") hover:scale-110 transition-transform"
                                                        style="background-color: @color"></button>
                                            }
                                        </div>
                                        <!-- Input de color personalizado -->
                                        <div class="flex gap-2">
                                            <input type="text" 
                                                   @bind="categoriaForm.Color" 
                                                   class="flex-1 px-2 py-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors text-sm" 
                                                   placeholder="#1e71f6" />
                                            <input type="color" 
                                                   @bind="categoriaForm.Color"
                                                   class="w-10 h-8 border border-gray-300 rounded-lg cursor-pointer" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Icono -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Icono de la Categoría</label>
                                    <div class="space-y-2">
                                        <!-- Grid de iconos sugeridos -->
                                        <div class="grid grid-cols-6 gap-1">
                                            @foreach (var icono in new[] { "restaurant", "local_dining", "cake", "local_bar", "coffee", "wine_bar" })
                                            {
                                                <button type="button" 
                                                        @onclick="() => categoriaForm.Icono = icono"
                                                        class="w-8 h-8 flex items-center justify-center border-2 @(categoriaForm.Icono == icono ? "border-primary-color bg-primary-color/10" : "border-gray-300") rounded-lg hover:border-primary-color/50 transition-colors">
                                                    <span class="material-symbols-outlined text-sm" style="color: @categoriaForm.Color">@icono</span>
                                                </button>
                                            }
                                        </div>
                                        <!-- Input de icono personalizado -->
                                        <input type="text" 
                                               @bind="categoriaForm.Icono"
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors text-sm" 
                                               placeholder="restaurant" />
                                    </div>
                                </div>

                                <!-- Vista Previa -->
                                <div class="p-3 bg-gray-50 rounded-lg">
                                    <h4 class="text-sm font-medium text-gray-700 mb-2">Vista Previa</h4>
                                    <div class="flex items-center gap-2 p-2 bg-white rounded-lg border border-gray-200">
                                        <span class="material-symbols-outlined text-base" style="color: @categoriaForm.Color">@categoriaForm.Icono</span>
                                        <div class="min-w-0 flex-1">
                                            <div class="font-medium text-gray-900 text-sm truncate">@(string.IsNullOrEmpty(categoriaForm.Nombre) ? "Nombre de la categoría" : categoriaForm.Nombre)</div>
                                            <div class="text-xs text-gray-500 truncate">@(string.IsNullOrEmpty(categoriaForm.Descripcion) ? "Descripción" : categoriaForm.Descripcion)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer del Modal Responsive -->
                <div class="border-t border-gray-200 p-4 sm:p-8 sm:pt-4">
                    <div class="flex flex-col sm:flex-row sm:justify-end gap-3 sm:gap-4">
                        <button type="button" 
                                class="order-2 sm:order-1 py-3 sm:py-2 px-4 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed w-full sm:w-auto" 
                                disabled="@guardando"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>
                        <button type="submit" 
                                class="order-1 sm:order-2 py-3 sm:py-2 px-4 rounded-lg bg-primary-color text-white font-bold shadow-md hover:bg-primary-color/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 w-full sm:w-auto" 
                                disabled="@guardando">
                            @if (guardando)
                            {
                                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-sm">@(editando ? "save" : "add")</span>
                                <span>@(editando ? "Actualizar" : "Crear")</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación -->
@if (mostrandoConfirmacionEliminar)
{
    <div aria-labelledby="modal-title" aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60" role="dialog">
        <div class="relative flex flex-col bg-white rounded-xl shadow-2xl w-full max-w-lg m-4">
            <div class="flex flex-col p-6 sm:p-8">
                <div class="flex items-center gap-4">
                    <div class="flex items-center justify-center rounded-full bg-red-100 shrink-0 size-12">
                        <svg fill="#dc2626" height="32px" viewBox="0 0 256 256" width="32px" xmlns="http://www.w3.org/2000/svg">
                            <path d="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-red-600" id="modal-title">Confirmar Eliminación</h2>
                        <p class="text-gray-600 mt-1">¿Estás seguro de que deseas eliminar la categoría '<strong>@categoriaAEliminar?.Nombre</strong>'?</p>
                    </div>
                </div>
                <div class="mt-6 border-t border-gray-200 pt-6 space-y-4">
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Nombre de la Categoría</p>
                        <p class="text-gray-800 col-span-2">@categoriaAEliminar?.Nombre</p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Número de Productos</p>
                        <p class="text-gray-800 col-span-2">@categoriaAEliminar?.CantidadProductos</p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Fecha de Creación</p>
                        <p class="text-gray-800 col-span-2">@categoriaAEliminar?.FechaCreacion.ToString("dd 'de' MMMM 'de' yyyy")</p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Estado</p>
                        @if (categoriaAEliminar?.Activa == true)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 col-span-2 w-fit">Activo</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 col-span-2 w-fit">Inactivo</span>
                        }
                    </div>
                </div>
                @if (categoriaAEliminar?.CantidadProductos > 0)
                {
                    <div class="mt-6 p-4 rounded-lg bg-yellow-50 border border-yellow-200">
                        <p class="text-sm font-medium text-yellow-700">Esta categoría tiene @categoriaAEliminar.CantidadProductos productos asociados. No se puede eliminar hasta que muevas o elimines todos los productos.</p>
                    </div>
                }
                else
                {
                    <div class="mt-6 p-4 rounded-lg bg-red-50 border border-red-200">
                        <p class="text-sm font-medium text-red-700">Esta acción no se puede deshacer. Una vez eliminada, la categoría desaparecerá permanentemente.</p>
                    </div>
                }
            </div>
            <div class="bg-gray-50 px-4 sm:px-6 py-4 rounded-b-xl border-t border-gray-200">
                <div class="flex flex-col sm:flex-row sm:justify-end gap-3 sm:gap-4">
                    <button class="order-2 sm:order-1 flex items-center justify-center rounded-lg h-12 sm:h-10 px-4 bg-white border border-gray-300 text-gray-700 text-sm font-semibold transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 w-full sm:w-auto sm:min-w-[120px]" 
                            type="button" @onclick="CancelarEliminacion">
                        <span class="truncate">Cancelar</span>
                    </button>
                    <button class="order-1 sm:order-2 flex items-center justify-center rounded-lg h-12 sm:h-10 px-4 bg-red-600 text-white text-sm font-semibold transition-colors hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 disabled:opacity-50 disabled:cursor-not-allowed w-full sm:w-auto sm:min-w-[120px]" 
                            type="button" @onclick="ConfirmarEliminacion" 
                            disabled="@(categoriaAEliminar?.CantidadProductos > 0 || guardando)">
                        @if (guardando)
                        {
                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                            <span class="truncate">Eliminando...</span>
                        }
                        else
                        {
                            <span class="truncate">Eliminar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaProductoDto>? categorias;
    private string filtro = string.Empty;
    private string estadoFiltro = string.Empty;
    private bool cargando = true;
    
    // Modal de categoría
    private bool mostrandoModal = false;
    private bool editando = false;
    private bool guardando = false;
    private CreateCategoriaRequest categoriaForm = new();
    private UpdateCategoriaRequest categoriaEdicion = new();
    
    // Validación de nombre
    private bool mostrandoValidacionNombre = false;
    private bool nombreDisponible = false;
    private string? errorValidacion = null;
    private Timer? validacionTimer;
    
    // Modal de eliminación
    private bool mostrandoConfirmacionEliminar = false;
    private CategoriaProductoDto? categoriaAEliminar;
    
    // Variables para notificaciones toast
    private bool mostrandoNotificacion = false;
    private bool notificacionExito = true;
    private string mensajeNotificacion = string.Empty;
    
    // Vista
    private bool vistaTabla = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        StateHasChanged();
        
        try
        {
            var soloActivas = estadoFiltro == "true";
            var soloInactivas = estadoFiltro == "false";
            var ocultarVacias = false; // Por ahora no implementamos este filtro
            categorias = await CategoriasApi.ObtenerAsync(soloActivas, soloInactivas, ocultarVacias);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task BuscarAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(filtro))
            {
                // Si no hay filtro de texto, aplicar solo el filtro de estado
                var soloActivas = false;
                var soloInactivas = false;
                var ocultarVacias = false;
                
                if (estadoFiltro == "true")
                {
                    soloActivas = true;
                }
                else if (estadoFiltro == "false")
                {
                    soloInactivas = true;
                }
                // Si estadoFiltro está vacío, ambos son false = todas las categorías
                
                categorias = await CategoriasApi.ObtenerAsync(soloActivas, soloInactivas, ocultarVacias);
            }
            else
            {
                // Si hay filtro de texto, buscar por texto
                categorias = await CategoriasApi.BuscarAsync(filtro);
                
                // Aplicar filtro de estado después de la búsqueda por texto
                if (!string.IsNullOrWhiteSpace(estadoFiltro))
                {
                    var soloActivas = estadoFiltro == "true";
                    categorias = categorias?.Where(c => c.Activa == soloActivas).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al buscar categorías: {ex.Message}");
        }
    }

    private async Task OnEstadoChanged(ChangeEventArgs e)
    {
        estadoFiltro = e.Value?.ToString() ?? string.Empty;
        await BuscarAsync();
    }

    private void CambiarVista(bool esTabla)
    {
        vistaTabla = esTabla;
        StateHasChanged();
    }

    private void NuevaCategoria()
    {
        editando = false;
        var siguientePosicion = (categorias?.Count ?? 0) + 1;
        
        categoriaForm = new CreateCategoriaRequest 
        { 
            Activa = true,
            Color = "#2196F3",
            Icono = "restaurant",
            Orden = siguientePosicion
        };
        
        nombreDisponible = true; // Permitir crear sin validación previa
        errorValidacion = null; // Limpiar errores previos
        mostrandoModal = true;
    }

    private async Task EditarCategoria(Guid id)
    {
        try
        {
            var categoria = await CategoriasApi.ObtenerPorIdAsync(id);
            if (categoria == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Categoría no encontrada");
                return;
            }

            editando = true;
            categoriaEdicion = new UpdateCategoriaRequest
            {
                Id = categoria.Id,
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion,
                Color = categoria.Color,
                Icono = categoria.Icono,
                Orden = categoria.Orden,
                Activa = categoria.Activa
            };
            categoriaForm = new CreateCategoriaRequest
            {
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion,
                Color = categoria.Color,
                Icono = categoria.Icono,
                Orden = categoria.Orden,
                Activa = categoria.Activa
            };
            nombreDisponible = true; // Al editar, el nombre ya existe
            errorValidacion = null; // Limpiar errores previos
            mostrandoModal = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar categoría: {ex.Message}");
        }
    }

    private void VerDetalles(Guid id)
    {
        // TODO: Implementar vista de detalles
        JSRuntime.InvokeVoidAsync("alert", "Vista de detalles - En desarrollo");
    }

    private void EliminarCategoria(Guid id)
    {
        categoriaAEliminar = categorias?.FirstOrDefault(c => c.Id == id);
        if (categoriaAEliminar != null)
        {
            mostrandoConfirmacionEliminar = true;
        }
    }

    private void CerrarModal()
    {
        mostrandoModal = false;
        categoriaForm = new();
        categoriaEdicion = new();
        nombreDisponible = false;
        errorValidacion = null; // Limpiar errores al cerrar
        validacionTimer?.Dispose();
    }

    private void CancelarEliminacion()
    {
        mostrandoConfirmacionEliminar = false;
        categoriaAEliminar = null;
    }

    private async Task GuardarCategoria()
    {
        guardando = true;
        errorValidacion = null; // Limpiar errores previos
        StateHasChanged();

        try
        {
            ApiResponse<CategoriaProductoDto>? resultado;

            if (editando)
            {
                categoriaEdicion.Nombre = categoriaForm.Nombre;
                categoriaEdicion.Descripcion = categoriaForm.Descripcion;
                categoriaEdicion.Color = categoriaForm.Color;
                categoriaEdicion.Icono = categoriaForm.Icono;
                categoriaEdicion.Orden = categoriaForm.Orden;
                categoriaEdicion.Activa = categoriaForm.Activa;

                resultado = await CategoriasApi.ActualizarAsync(categoriaEdicion.Id, categoriaEdicion);
            }
            else
            {
                resultado = await CategoriasApi.CrearAsync(categoriaForm);
            }

            if (resultado?.Success == true)
            {
                MostrarNotificacion(editando ? "Categoría actualizada correctamente" : "Categoría creada correctamente", true);
                CerrarModal();
                await CargarAsync();
            }
            else
            {
                // Mostrar error de validación en el modal
                errorValidacion = resultado?.Message ?? "Error al guardar la categoría";
                
                // Si hay errores específicos, mostrarlos
                if (resultado?.Errors != null && resultado.Errors.Any())
                {
                    errorValidacion = string.Join(", ", resultado.Errors);
                }
            }
        }
        catch (Exception ex)
        {
            errorValidacion = $"Error: {ex.Message}";
            MostrarNotificacion($"Error: {ex.Message}", false);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmarEliminacion()
    {
        if (categoriaAEliminar == null) return;

        guardando = true;
        StateHasChanged();

        try
        {
            var resultado = await CategoriasApi.EliminarAsync(categoriaAEliminar.Id);
            
            if (resultado)
            {
                MostrarNotificacion("Categoría eliminada correctamente", true);
                CancelarEliminacion();
                await CargarAsync();
            }
            else
            {
                MostrarNotificacion("Error al eliminar la categoría", false);
            }
        }
        catch (Exception ex)
        {
            MostrarNotificacion($"Error: {ex.Message}", false);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    // Validación de nombre en tiempo real
    private async void OnNombreChanged()
    {
        validacionTimer?.Dispose();
        
        if (string.IsNullOrEmpty(categoriaForm.Nombre))
        {
            nombreDisponible = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        validacionTimer = new Timer(async _ => await ValidarNombreAsync(), null, 1000, Timeout.Infinite);
    }

    private async Task ValidarNombreAsync()
    {
        if (string.IsNullOrEmpty(categoriaForm.Nombre)) return;

        mostrandoValidacionNombre = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var nombreExiste = await CategoriasApi.ValidarNombreUnicoAsync(
                categoriaForm.Nombre, 
                editando ? categoriaEdicion.Id : null);
            nombreDisponible = !nombreExiste;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error al validar nombre: {ex.Message}");
            nombreDisponible = false;
        }
        finally
        {
            mostrandoValidacionNombre = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void MostrarNotificacion(string mensaje, bool esExito = true)
    {
        mensajeNotificacion = mensaje;
        notificacionExito = esExito;
        mostrandoNotificacion = true;
        
        // Auto-cerrar después de 5 segundos
        Task.Delay(5000).ContinueWith(_ => {
            InvokeAsync(() => {
                mostrandoNotificacion = false;
                StateHasChanged();
            });
        });
        
        StateHasChanged();
    }

    private void CerrarNotificacion()
    {
        mostrandoNotificacion = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        validacionTimer?.Dispose();
    }
}

<!-- Toast de notificaciones -->
@if (mostrandoNotificacion)
{
    <div class="fixed top-4 right-4 z-50">
        <div class="bg-white rounded-lg shadow-lg border-l-4 @(notificacionExito ? "border-green-500" : "border-red-500") p-4 max-w-sm">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    @if (notificacionExito)
                    {
                        <span class="material-symbols-outlined text-green-500">check_circle</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-red-500">error</span>
                    }
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900">@mensajeNotificacion</p>
                </div>
                <div class="ml-auto pl-3">
                    <div class="-mx-1.5 -my-1.5">
                        <button type="button" class="inline-flex rounded-md p-1.5 text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-50 focus:ring-indigo-600" @onclick="CerrarNotificacion">
                            <span class="sr-only">Cerrar</span>
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
