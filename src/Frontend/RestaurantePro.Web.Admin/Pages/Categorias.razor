@attribute [Authorize]
@page "/categorias"
@using RestaurantePro.Web.Admin.Models
@inject RestaurantePro.Web.Admin.Services.CategoriasApiService CategoriasApi
@inject IJSRuntime JSRuntime

<PageTitle>Categorías</PageTitle>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Gestión de Categorías</h1>
        <p class="text-muted mb-0">Administra las categorías de productos del menú</p>
    </div>
    <div>
        <button class="btn btn-primary" @onclick="NuevaCategoria">
            <i class="oi oi-plus"></i> Nueva Categoría
        </button>
    </div>
</div>

<div class="row mb-3">
  <div class="col-md-4">
    <input class="form-control" placeholder="Buscar por nombre" @bind="filtro" />
  </div>
  <div class="col-md-2">
    <button class="btn btn-primary w-100" @onclick="BuscarAsync">Buscar</button>
  </div>
  <div class="col-md-3 d-flex align-items-center">
    <div class="form-check me-3">
      <input class="form-check-input" type="checkbox" id="chkSoloActivas" @bind="soloActivas" />
      <label class="form-check-label" for="chkSoloActivas">Solo activas</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="chkOcultarVacias" @bind="ocultarVacias" />
      <label class="form-check-label" for="chkOcultarVacias">Ocultar vacías</label>
    </div>
  </div>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2 text-muted">Cargando categorías...</p>
    </div>
}
else if (categorias == null || !categorias.Any())
{
    <div class="text-center py-5">
        <div class="text-muted">
            <i class="oi oi-tags" style="font-size: 3rem;"></i>
            <h5 class="mt-3">No hay categorías</h5>
            <p>Crea tu primera categoría para organizar los productos del menú</p>
            <button class="btn btn-primary" @onclick="NuevaCategoria">
                <i class="oi oi-plus"></i> Crear Primera Categoría
            </button>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Icono</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Orden</th>
                    <th>Estado</th>
                    <th>Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in categorias.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                {
                    <tr>
                        <td>
                            <span style="font-size: 1.5rem; color: @c.Color;">@c.Icono</span>
                        </td>
                        <td>
                            <strong>@c.Nombre</strong>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.Descripcion))
                            {
                                <span class="text-muted">@c.Descripcion</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Sin descripción</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">@c.Orden</span>
                        </td>
                        <td>
                            @if (c.Activa)
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-bold">@c.CantidadProductos</span>
                                <small class="text-muted">@c.ProductosDisponibles disponibles</small>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarCategoria(c.Id)" title="Editar">
                                    <i class="oi oi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info" @onclick="() => VerDetalles(c.Id)" title="Ver detalles">
                                    <i class="oi oi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarCategoria(c.Id)" 
                                        disabled="@(c.CantidadProductos > 0)" 
                                        title="@(c.CantidadProductos > 0 ? "No se puede eliminar: tiene productos asociados" : "Eliminar")">
                                    <i class="oi oi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal para Crear/Editar Categoría -->
@if (mostrandoModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="oi oi-tags"></i> @(editando ? "Editar Categoría" : "Nueva Categoría")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                
                <EditForm Model="categoriaForm" OnValidSubmit="GuardarCategoria">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label class="form-label">Nombre *</label>
                                    <InputText @bind-Value="categoriaForm.Nombre" 
                                               @oninput="OnNombreChanged"
                                               class="form-control" 
                                               placeholder="Nombre de la categoría" />
                                    <ValidationMessage For="@(() => categoriaForm.Nombre)" class="text-danger" />
                                    @if (mostrandoValidacionNombre)
                                    {
                                        <div class="form-text text-info">
                                            <i class="oi oi-reload"></i> Validando nombre...
                                        </div>
                                    }
                                    @if (nombreDisponible && !string.IsNullOrEmpty(categoriaForm.Nombre))
                                    {
                                        <div class="form-text text-success">
                                            <i class="oi oi-check"></i> Nombre disponible
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Orden</label>
                                    <InputNumber @bind-Value="categoriaForm.Orden" class="form-control" min="0" max="1000" />
                                    <ValidationMessage For="@(() => categoriaForm.Orden)" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea @bind-Value="categoriaForm.Descripcion" class="form-control" rows="3" placeholder="Descripción de la categoría" />
                            <ValidationMessage For="@(() => categoriaForm.Descripcion)" class="text-danger" />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Color</label>
                                    <div class="input-group">
                                        <InputText @bind-Value="categoriaForm.Color" class="form-control" placeholder="#FF5733" />
                                        <input type="color" @bind="categoriaForm.Color" class="form-control form-control-color" style="width: 50px;" />
                                    </div>
                                    <ValidationMessage For="@(() => categoriaForm.Color)" class="text-danger" />
                                    <div class="form-text">Vista previa: <span style="color: @categoriaForm.Color; font-size: 1.2rem;">@categoriaForm.Icono</span></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Icono</label>
                                    <InputText @bind-Value="categoriaForm.Icono" class="form-control" placeholder="🍽️" maxlength="10" />
                                    <ValidationMessage For="@(() => categoriaForm.Icono)" class="text-danger" />
                                    <div class="form-text">Usa emojis o símbolos (máx. 10 caracteres)</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-check">
                            <InputCheckbox @bind-Value="categoriaForm.Activa" class="form-check-input" />
                            <label class="form-check-label">
                                Categoría activa
                            </label>
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                            <i class="oi oi-x"></i> Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@(guardando || !nombreDisponible)">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            else
                            {
                                <i class="oi oi-check"></i>
                            }
                            @(editando ? "Actualizar" : "Crear")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación -->
@if (mostrandoConfirmacionEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="oi oi-warning"></i> Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminacion"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que deseas eliminar la categoría <strong>@categoriaAEliminar?.Nombre</strong>?</p>
                    @if (categoriaAEliminar?.CantidadProductos > 0)
                    {
                        <div class="alert alert-warning">
                            <i class="oi oi-warning"></i> Esta categoría tiene @categoriaAEliminar.CantidadProductos productos asociados. 
                            No se puede eliminar hasta que muevas o elimines todos los productos.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminacion">
                        <i class="oi oi-x"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminacion" 
                            disabled="@(categoriaAEliminar?.CantidadProductos > 0 || guardando)">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="oi oi-trash"></i>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaProductoDto>? categorias;
    private string filtro = string.Empty;
    private bool soloActivas = false;
    private bool ocultarVacias = false;
    private bool cargando = true;
    
    // Modal de categoría
    private bool mostrandoModal = false;
    private bool editando = false;
    private bool guardando = false;
    private CreateCategoriaRequest categoriaForm = new();
    private UpdateCategoriaRequest categoriaEdicion = new();
    
    // Validación de nombre
    private bool mostrandoValidacionNombre = false;
    private bool nombreDisponible = false;
    private Timer? validacionTimer;
    
    // Modal de eliminación
    private bool mostrandoConfirmacionEliminar = false;
    private CategoriaProductoDto? categoriaAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        StateHasChanged();
        
        try
        {
            categorias = await CategoriasApi.ObtenerAsync(soloActivas, ocultarVacias);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            await CargarAsync();
        }
        else
        {
            try
            {
                categorias = await CategoriasApi.BuscarAsync(filtro);
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al buscar categorías: {ex.Message}");
            }
        }
    }

    private void NuevaCategoria()
    {
        editando = false;
        categoriaForm = new CreateCategoriaRequest 
        { 
            Activa = true,
            Color = "#2196F3",
            Icono = "🍽️",
            Orden = categorias?.Count ?? 0
        };
        nombreDisponible = false;
        mostrandoModal = true;
    }

    private async Task EditarCategoria(Guid id)
    {
        try
        {
            var categoria = await CategoriasApi.ObtenerPorIdAsync(id);
            if (categoria == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Categoría no encontrada");
                return;
            }

            editando = true;
            categoriaEdicion = new UpdateCategoriaRequest
            {
                Id = categoria.Id,
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion,
                Color = categoria.Color,
                Icono = categoria.Icono,
                Orden = categoria.Orden,
                Activa = categoria.Activa
            };
            categoriaForm = new CreateCategoriaRequest
            {
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion,
                Color = categoria.Color,
                Icono = categoria.Icono,
                Orden = categoria.Orden,
                Activa = categoria.Activa
            };
            nombreDisponible = true; // Al editar, el nombre ya existe
            mostrandoModal = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar categoría: {ex.Message}");
        }
    }

    private void VerDetalles(Guid id)
    {
        // TODO: Implementar vista de detalles
        JSRuntime.InvokeVoidAsync("alert", "Vista de detalles - En desarrollo");
    }

    private void EliminarCategoria(Guid id)
    {
        categoriaAEliminar = categorias?.FirstOrDefault(c => c.Id == id);
        if (categoriaAEliminar != null)
        {
            mostrandoConfirmacionEliminar = true;
        }
    }

    private void CerrarModal()
    {
        mostrandoModal = false;
        categoriaForm = new();
        categoriaEdicion = new();
        nombreDisponible = false;
        validacionTimer?.Dispose();
    }

    private void CancelarEliminacion()
    {
        mostrandoConfirmacionEliminar = false;
        categoriaAEliminar = null;
    }

    private async Task GuardarCategoria()
    {
        guardando = true;
        StateHasChanged();

        try
        {
            ApiResponse<CategoriaProductoDto>? resultado;

            if (editando)
            {
                categoriaEdicion.Nombre = categoriaForm.Nombre;
                categoriaEdicion.Descripcion = categoriaForm.Descripcion;
                categoriaEdicion.Color = categoriaForm.Color;
                categoriaEdicion.Icono = categoriaForm.Icono;
                categoriaEdicion.Orden = categoriaForm.Orden;
                categoriaEdicion.Activa = categoriaForm.Activa;

                resultado = await CategoriasApi.ActualizarAsync(categoriaEdicion.Id, categoriaEdicion);
            }
            else
            {
                resultado = await CategoriasApi.CrearAsync(categoriaForm);
            }

            if (resultado?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", editando ? "Categoría actualizada correctamente" : "Categoría creada correctamente");
                CerrarModal();
                await CargarAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al guardar la categoría");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmarEliminacion()
    {
        if (categoriaAEliminar == null) return;

        guardando = true;
        StateHasChanged();

        try
        {
            var resultado = await CategoriasApi.EliminarAsync(categoriaAEliminar.Id);
            
            if (resultado)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Categoría eliminada correctamente");
                CancelarEliminacion();
                await CargarAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al eliminar la categoría");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    // Validación de nombre en tiempo real
    private async Task OnNombreChanged()
    {
        validacionTimer?.Dispose();
        
        if (string.IsNullOrEmpty(categoriaForm.Nombre))
        {
            nombreDisponible = false;
            StateHasChanged();
            return;
        }

        validacionTimer = new Timer(async _ => await ValidarNombreAsync(), null, 1000, Timeout.Infinite);
    }

    private async Task ValidarNombreAsync()
    {
        if (string.IsNullOrEmpty(categoriaForm.Nombre)) return;

        mostrandoValidacionNombre = true;
        StateHasChanged();

        try
        {
            var nombreExiste = await CategoriasApi.ValidarNombreUnicoAsync(
                categoriaForm.Nombre, 
                editando ? categoriaEdicion.Id : null);
            nombreDisponible = !nombreExiste;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error al validar nombre: {ex.Message}");
            nombreDisponible = false;
        }
        finally
        {
            mostrandoValidacionNombre = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        validacionTimer?.Dispose();
    }
}
