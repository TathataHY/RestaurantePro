@attribute [Authorize]
@page "/categorias"
@using RestaurantePro.Web.Admin.Models
@inject RestaurantePro.Web.Admin.Services.ICategoriasApiService CategoriasApi
@inject IJSRuntime JSRuntime

<PageTitle>Categorías</PageTitle>

<div class="flex-1 px-4 sm:px-6 lg:px-8 py-8 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Gestión de Categorías</h2>
                <p class="text-gray-500 dark:text-gray-400 mt-1">
                    Administra las categorías de productos de tu restaurante. Crea, edita y elimina categorías para organizar tu menú de manera efectiva.
                </p>
            </div>
            <button class="flex items-center justify-center gap-2 rounded-md h-10 px-4 bg-primary-color text-white text-sm font-medium shadow-md hover:bg-blue-700 transition-colors" @onclick="NuevaCategoria">
                <span class="material-symbols-outlined">add</span>
                <span class="truncate">Nueva Categoría</span>
            </button>
        </div>

        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md mb-8">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Filtros</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 items-end">
                <label class="flex flex-col gap-2">
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Nombre</span>
                    <input class="form-input w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-primary-color focus:border-primary-color transition" 
                           placeholder="Buscar por nombre" 
                           @bind="filtro" />
                </label>
                <label class="flex flex-col gap-2">
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Estado</span>
                    <select class="form-select w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-primary-color focus:border-primary-color transition" 
                            @bind="estadoFiltro">
                        <option value="">Todos</option>
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </label>
                <button class="flex items-center justify-center gap-2 rounded-md h-10 px-4 bg-primary-color text-white text-sm font-medium shadow-md hover:bg-blue-700 transition-colors w-full lg:w-auto" 
                        @onclick="BuscarAsync">
                    <span class="material-symbols-outlined">search</span>
                    <span>Aplicar Filtros</span>
                </button>
            </div>
        </div>

        @if (cargando)
        {
            <div class="flex justify-center items-center py-12">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-color mx-auto mb-4"></div>
                    <p class="text-gray-500">Cargando categorías...</p>
                </div>
            </div>
        }
        else
        {
            <!-- Métricas principales -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="neumorphic-light dark:neumorphic-dark p-6 flex flex-col gap-2">
                    <p class="text-gray-600 dark:text-gray-300 font-medium">Total de Categorías</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@(categorias?.Count ?? 0)</p>
                </div>
                <div class="neumorphic-light dark:neumorphic-dark p-6 flex flex-col gap-2">
                    <p class="text-gray-600 dark:text-gray-300 font-medium">Categorías Activas</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@(categorias?.Count(c => c.Activa) ?? 0)</p>
                </div>
                <div class="neumorphic-light dark:neumorphic-dark p-6 flex flex-col gap-2">
                    <p class="text-gray-600 dark:text-gray-300 font-medium">Productos Asociados</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@(categorias?.Sum(c => c.CantidadProductos) ?? 0)</p>
                </div>
                <div class="neumorphic-light dark:neumorphic-dark p-6 flex flex-col gap-2">
                    <p class="text-gray-600 dark:text-gray-300 font-medium">Categoría Más Popular</p>
                    <p class="text-xl font-bold text-gray-900 dark:text-white truncate">@(categorias?.OrderByDescending(c => c.CantidadProductos).FirstOrDefault()?.Nombre ?? "N/A")</p>
                </div>
            </div>
            @if (categorias == null || !categorias.Any())
            {
                <div class="text-center py-12">
                    <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">category</span>
                    <p class="text-gray-500 text-lg">No hay categorías</p>
                    <p class="text-gray-400 text-sm">Crea tu primera categoría para organizar los productos del menú</p>
                    <button class="mt-4 px-4 py-2 bg-primary-color text-white rounded-lg hover:bg-primary-color/90 transition-colors" @onclick="NuevaCategoria">
                        <span class="material-symbols-outlined">add</span> Crear Primera Categoría
                    </button>
                </div>
            }
            else
            {
                <!-- Tabla principal -->
                <div class="overflow-x-auto rounded-lg shadow-md">
                    <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400 bg-white dark:bg-gray-800">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                            <tr>
                                <th class="px-6 py-3" scope="col">Nombre</th>
                                <th class="px-6 py-3" scope="col">Descripción</th>
                                <th class="px-6 py-3 text-center" scope="col">Productos</th>
                                <th class="px-6 py-3" scope="col">Estado</th>
                                <th class="px-6 py-3" scope="col">Fecha de Creación</th>
                                <th class="px-6 py-3 text-right" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in categorias.OrderBy(x => x.Orden).ThenBy(x => x.Nombre))
                            {
                                <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                                    <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">@c.Nombre</td>
                                    <td class="px-6 py-4">@(string.IsNullOrEmpty(c.Descripcion) ? "Sin descripción" : c.Descripcion)</td>
                                    <td class="px-6 py-4 text-center">@c.CantidadProductos</td>
                                    <td class="px-6 py-4">
                                        @if (c.Activa)
                                        {
                                            <span class="status-badge-active">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge-inactive">Inactivo</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">@c.FechaCreacion.ToString("yyyy-MM-dd")</td>
                                    <td class="px-6 py-4 text-right flex gap-2 justify-end">
                                        <button class="text-blue-600 dark:text-blue-500 hover:underline" @onclick="() => EditarCategoria(c.Id)">Editar</button>
                                        <button class="text-red-600 dark:text-red-500 hover:underline" @onclick="() => EliminarCategoria(c.Id)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<!-- Modal para Crear/Editar Categoría -->
@if (mostrandoModal)
{
    <div aria-labelledby="modal-title" aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60" role="dialog">
        <div class="relative flex flex-col bg-white rounded-xl shadow-2xl w-full max-w-4xl m-4 max-h-[90vh] overflow-hidden">
            <!-- Header del Modal -->
            <div class="flex items-center justify-between p-6 border-b border-gray-200">
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center rounded-full bg-primary-color/10 shrink-0 size-10">
                        <span class="material-symbols-outlined text-primary-color">@(editando ? "edit" : "add")</span>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-900" id="modal-title">@(editando ? "Editar Categoría" : "Nueva Categoría")</h2>
                        <p class="text-sm text-gray-500">@(editando ? "Modifica los datos de la categoría" : "Crea una nueva categoría para organizar tus productos")</p>
                    </div>
                </div>
                <button type="button" class="text-gray-400 hover:text-gray-600 transition-colors" @onclick="CerrarModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <EditForm Model="categoriaForm" OnValidSubmit="GuardarCategoria">
                <DataAnnotationsValidator />
                
                <!-- Body del Modal -->
                <div class="flex-1 overflow-y-auto p-6">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <!-- Columna Izquierda - Información Básica -->
                        <div class="space-y-6">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Información Básica</h3>
                                
                                <!-- Nombre -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre de la Categoría *</label>
                                    <input type="text" 
                                           @bind="categoriaForm.Nombre" 
                                           @oninput="OnNombreChanged"
                                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors" 
                                           placeholder="Ej: Entradas, Platos Principales, Postres" />
                                    <ValidationMessage For="@(() => categoriaForm.Nombre)" class="text-red-500 text-sm mt-1" />
                                    @if (mostrandoValidacionNombre)
                                    {
                                        <div class="flex items-center gap-2 text-blue-500 text-sm mt-1">
                                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-500"></div>
                                            <span>Validando nombre...</span>
                                        </div>
                                    }
                                    @if (nombreDisponible && !string.IsNullOrEmpty(categoriaForm.Nombre))
                                    {
                                        <div class="flex items-center gap-2 text-green-500 text-sm mt-1">
                                            <span class="material-symbols-outlined text-sm">check_circle</span>
                                            <span>Nombre disponible</span>
                                        </div>
                                    }
                                </div>

                                <!-- Descripción -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                                    <textarea @bind="categoriaForm.Descripcion" 
                                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors resize-none" 
                                              rows="3" 
                                              placeholder="Describe brevemente esta categoría"></textarea>
                                    <div class="text-right text-xs text-gray-500 mt-1">@(categoriaForm.Descripcion?.Length ?? 0)/200</div>
                                </div>


                                <!-- Orden y Estado -->
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Orden</label>
                                        <input type="number" 
                                               @bind="categoriaForm.Orden" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors" 
                                               min="0" max="1000" />
                                    </div>
                                    <div class="flex items-center justify-center">
                                        <div class="flex items-center gap-3">
                                            <span class="text-sm font-medium text-gray-700">Activa</span>
                                            <label class="relative inline-flex items-center cursor-pointer">
                                                <input type="checkbox" @bind="categoriaForm.Activa" class="sr-only peer">
                                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-color/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-color"></div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Columna Derecha - Configuración Visual -->
                        <div class="space-y-6">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Configuración Visual</h3>
                                
                                <!-- Color -->
                                <div class="mb-6">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Color de la Categoría</label>
                                    <div class="space-y-3">
                                        <!-- Paleta de colores sugeridos -->
                                        <div class="grid grid-cols-6 gap-2">
                                            @foreach (var color in new[] { "#1e71f6", "#22c55e", "#f97316", "#8b5cf6", "#ef4444", "#ec4899" })
                                            {
                                                <button type="button" 
                                                        @onclick="() => categoriaForm.Color = color"
                                                        class="w-8 h-8 rounded-full border-2 @(categoriaForm.Color == color ? "border-gray-900" : "border-gray-300") hover:scale-110 transition-transform"
                                                        style="background-color: @color"></button>
                                            }
                                        </div>
                                        <!-- Input de color personalizado -->
                                        <div class="flex gap-2">
                                            <input type="text" 
                                                   @bind="categoriaForm.Color" 
                                                   class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors" 
                                                   placeholder="#1e71f6" />
                                            <input type="color" 
                                                   @bind="categoriaForm.Color" 
                                                   class="w-12 h-10 border border-gray-300 rounded-lg cursor-pointer" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Icono -->
                                <div class="mb-6">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Icono de la Categoría</label>
                                    <div class="space-y-3">
                                        <!-- Grid de iconos sugeridos -->
                                        <div class="grid grid-cols-6 gap-2">
                                            @foreach (var icono in new[] { "restaurant", "local_dining", "cake", "local_bar", "coffee", "ice_cream", "lunch_dining", "bakery_dining", "wine_bar", "fastfood", "ramen_dining", "set_meal" })
                                            {
                                                <button type="button" 
                                                        @onclick="() => categoriaForm.Icono = icono"
                                                        class="w-10 h-10 flex items-center justify-center border-2 @(categoriaForm.Icono == icono ? "border-primary-color bg-primary-color/10" : "border-gray-300") rounded-lg hover:border-primary-color/50 transition-colors">
                                                    <span class="material-symbols-outlined text-lg" style="color: @categoriaForm.Color">@icono</span>
                                                </button>
                                            }
                                        </div>
                                        <!-- Input de icono personalizado -->
                                        <input type="text" 
                                               @bind="categoriaForm.Icono" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-color focus:border-primary-color transition-colors" 
                                               placeholder="restaurant" />
                                    </div>
                                </div>

                                <!-- Vista Previa -->
                                <div class="p-4 bg-gray-50 rounded-lg">
                                    <h4 class="text-sm font-medium text-gray-700 mb-3">Vista Previa</h4>
                                    <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200">
                                        <span class="material-symbols-outlined text-2xl" style="color: @categoriaForm.Color">@categoriaForm.Icono</span>
                                        <div>
                                            <div class="font-medium text-gray-900">@(string.IsNullOrEmpty(categoriaForm.Nombre) ? "Nombre de la categoría" : categoriaForm.Nombre)</div>
                                            <div class="text-sm text-gray-500">@(string.IsNullOrEmpty(categoriaForm.Descripcion) ? "Descripción de la categoría" : categoriaForm.Descripcion)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer del Modal -->
                <div class="flex justify-end gap-4 bg-gray-50 px-6 py-4 border-t border-gray-200">
                    <button type="button" 
                            class="flex min-w-[120px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-white border border-gray-300 text-gray-700 text-sm font-semibold leading-normal tracking-wide transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400" 
                            @onclick="CerrarModal">
                        <span class="truncate">Cancelar</span>
                    </button>
                    <button type="submit" 
                            class="flex min-w-[120px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary-color text-white text-sm font-semibold leading-normal tracking-wide transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-color disabled:opacity-50 disabled:cursor-not-allowed" 
                            disabled="@(guardando || !nombreDisponible)">
                        @if (guardando)
                        {
                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-sm mr-2">@(editando ? "save" : "add")</span>
                        }
                        <span class="truncate">@(editando ? "Actualizar" : "Crear")</span>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación -->
@if (mostrandoConfirmacionEliminar)
{
    <div aria-labelledby="modal-title" aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60" role="dialog">
        <div class="relative flex flex-col bg-white rounded-xl shadow-2xl w-full max-w-lg m-4">
            <div class="flex flex-col p-6 sm:p-8">
                <div class="flex items-center gap-4">
                    <div class="flex items-center justify-center rounded-full bg-red-100 shrink-0 size-12">
                        <svg fill="#dc2626" height="32px" viewBox="0 0 256 256" width="32px" xmlns="http://www.w3.org/2000/svg">
                            <path d="M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM222.93,203.8a8.5,8.5,0,0,1-7.48,4.2H40.55a8.5,8.5,0,0,1-7.48-4.2,7.59,7.59,0,0,1,0-7.72L120.52,44.21a8.75,8.75,0,0,1,15,0l87.45,151.87A7.59,7.59,0,0,1,222.93,203.8ZM120,144V104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,180Z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-red-600" id="modal-title">Confirmar Eliminación</h2>
                        <p class="text-gray-600 mt-1">¿Estás seguro de que deseas eliminar la categoría '<strong>@categoriaAEliminar?.Nombre</strong>'?</p>
                    </div>
                </div>
                <div class="mt-6 border-t border-gray-200 pt-6 space-y-4">
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Nombre de la Categoría</p>
                        <p class="text-gray-800 col-span-2">@categoriaAEliminar?.Nombre</p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Número de Productos</p>
                        <p class="text-gray-800 col-span-2">@categoriaAEliminar?.CantidadProductos</p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Fecha de Creación</p>
                        <p class="text-gray-800 col-span-2">@categoriaAEliminar?.FechaCreacion.ToString("dd 'de' MMMM 'de' yyyy")</p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <p class="text-gray-500 font-medium col-span-1">Estado</p>
                        @if (categoriaAEliminar?.Activa == true)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 col-span-2 w-fit">Activo</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 col-span-2 w-fit">Inactivo</span>
                        }
                    </div>
                </div>
                @if (categoriaAEliminar?.CantidadProductos > 0)
                {
                    <div class="mt-6 p-4 rounded-lg bg-yellow-50 border border-yellow-200">
                        <p class="text-sm font-medium text-yellow-700">Esta categoría tiene @categoriaAEliminar.CantidadProductos productos asociados. No se puede eliminar hasta que muevas o elimines todos los productos.</p>
                    </div>
                }
                else
                {
                    <div class="mt-6 p-4 rounded-lg bg-red-50 border border-red-200">
                        <p class="text-sm font-medium text-red-700">Esta acción no se puede deshacer. Una vez eliminada, la categoría desaparecerá permanentemente.</p>
                    </div>
                }
            </div>
            <div class="flex justify-end gap-4 bg-gray-50 px-6 sm:px-8 py-4 rounded-b-xl border-t border-gray-200">
                <button class="flex min-w-[120px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-white border border-gray-300 text-gray-700 text-sm font-semibold leading-normal tracking-wide transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400" 
                        type="button" @onclick="CancelarEliminacion">
                    <span class="truncate">Cancelar</span>
                </button>
                <button class="flex min-w-[120px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-red-600 text-white text-sm font-semibold leading-normal tracking-wide transition-colors hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 disabled:opacity-50 disabled:cursor-not-allowed" 
                        type="button" @onclick="ConfirmarEliminacion" 
                        disabled="@(categoriaAEliminar?.CantidadProductos > 0 || guardando)">
                    @if (guardando)
                    {
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                    }
                    <span class="truncate">Eliminar</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaProductoDto>? categorias;
    private string filtro = string.Empty;
    private string estadoFiltro = string.Empty;
    private bool cargando = true;
    
    // Modal de categoría
    private bool mostrandoModal = false;
    private bool editando = false;
    private bool guardando = false;
    private CreateCategoriaRequest categoriaForm = new();
    private UpdateCategoriaRequest categoriaEdicion = new();
    
    // Validación de nombre
    private bool mostrandoValidacionNombre = false;
    private bool nombreDisponible = false;
    private Timer? validacionTimer;
    
    // Modal de eliminación
    private bool mostrandoConfirmacionEliminar = false;
    private CategoriaProductoDto? categoriaAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        StateHasChanged();
        
        try
        {
            var soloActivas = estadoFiltro == "true";
            var ocultarVacias = false; // Por ahora no implementamos este filtro
            categorias = await CategoriasApi.ObtenerAsync(soloActivas, ocultarVacias);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            await CargarAsync();
        }
        else
        {
            try
            {
                categorias = await CategoriasApi.BuscarAsync(filtro);
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al buscar categorías: {ex.Message}");
            }
        }
    }

    private void NuevaCategoria()
    {
        editando = false;
        categoriaForm = new CreateCategoriaRequest 
        { 
            Activa = true,
            Color = "#2196F3",
            Icono = "🍽️",
            Orden = categorias?.Count ?? 0
        };
        nombreDisponible = false;
        mostrandoModal = true;
    }

    private async Task EditarCategoria(Guid id)
    {
        try
        {
            var categoria = await CategoriasApi.ObtenerPorIdAsync(id);
            if (categoria == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Categoría no encontrada");
                return;
            }

            editando = true;
            categoriaEdicion = new UpdateCategoriaRequest
            {
                Id = categoria.Id,
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion,
                Color = categoria.Color,
                Icono = categoria.Icono,
                Orden = categoria.Orden,
                Activa = categoria.Activa
            };
            categoriaForm = new CreateCategoriaRequest
            {
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion,
                Color = categoria.Color,
                Icono = categoria.Icono,
                Orden = categoria.Orden,
                Activa = categoria.Activa
            };
            nombreDisponible = true; // Al editar, el nombre ya existe
            mostrandoModal = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar categoría: {ex.Message}");
        }
    }

    private void VerDetalles(Guid id)
    {
        // TODO: Implementar vista de detalles
        JSRuntime.InvokeVoidAsync("alert", "Vista de detalles - En desarrollo");
    }

    private void EliminarCategoria(Guid id)
    {
        categoriaAEliminar = categorias?.FirstOrDefault(c => c.Id == id);
        if (categoriaAEliminar != null)
        {
            mostrandoConfirmacionEliminar = true;
        }
    }

    private void CerrarModal()
    {
        mostrandoModal = false;
        categoriaForm = new();
        categoriaEdicion = new();
        nombreDisponible = false;
        validacionTimer?.Dispose();
    }

    private void CancelarEliminacion()
    {
        mostrandoConfirmacionEliminar = false;
        categoriaAEliminar = null;
    }

    private async Task GuardarCategoria()
    {
        guardando = true;
        StateHasChanged();

        try
        {
            ApiResponse<CategoriaProductoDto>? resultado;

            if (editando)
            {
                categoriaEdicion.Nombre = categoriaForm.Nombre;
                categoriaEdicion.Descripcion = categoriaForm.Descripcion;
                categoriaEdicion.Color = categoriaForm.Color;
                categoriaEdicion.Icono = categoriaForm.Icono;
                categoriaEdicion.Orden = categoriaForm.Orden;
                categoriaEdicion.Activa = categoriaForm.Activa;

                resultado = await CategoriasApi.ActualizarAsync(categoriaEdicion.Id, categoriaEdicion);
            }
            else
            {
                resultado = await CategoriasApi.CrearAsync(categoriaForm);
            }

            if (resultado?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", editando ? "Categoría actualizada correctamente" : "Categoría creada correctamente");
                CerrarModal();
                await CargarAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", resultado?.Message ?? "Error al guardar la categoría");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmarEliminacion()
    {
        if (categoriaAEliminar == null) return;

        guardando = true;
        StateHasChanged();

        try
        {
            var resultado = await CategoriasApi.EliminarAsync(categoriaAEliminar.Id);
            
            if (resultado)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Categoría eliminada correctamente");
                CancelarEliminacion();
                await CargarAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al eliminar la categoría");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    // Validación de nombre en tiempo real
    private void OnNombreChanged()
    {
        validacionTimer?.Dispose();
        
        if (string.IsNullOrEmpty(categoriaForm.Nombre))
        {
            nombreDisponible = false;
            StateHasChanged();
            return;
        }

        validacionTimer = new Timer(async _ => await ValidarNombreAsync(), null, 1000, Timeout.Infinite);
    }

    private async Task ValidarNombreAsync()
    {
        if (string.IsNullOrEmpty(categoriaForm.Nombre)) return;

        mostrandoValidacionNombre = true;
        StateHasChanged();

        try
        {
            var nombreExiste = await CategoriasApi.ValidarNombreUnicoAsync(
                categoriaForm.Nombre, 
                editando ? categoriaEdicion.Id : null);
            nombreDisponible = !nombreExiste;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error al validar nombre: {ex.Message}");
            nombreDisponible = false;
        }
        finally
        {
            mostrandoValidacionNombre = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        validacionTimer?.Dispose();
    }
}
