@page "/preparaciones"
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Services
@using RestaurantePro.Web.Admin.Components
@inject IPreparacionesApiService PreparacionesApi
@inject IJSRuntime JSRuntime

<PageTitle>Análisis de Preparaciones - RestaurantePro</PageTitle>

<link href="css/preparaciones.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="js/preparaciones-charts.js"></script>

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="oi oi-restaurant"></i> Análisis de Preparaciones</h2>
            <p class="text-muted">Supervisión y análisis del rendimiento de cocina</p>
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-primary" @onclick="ToggleVistaTabular">
                <i class="oi @(mostrarVistaTabular ? "oi-list" : "oi-grid-three-up")"></i>
                @(mostrarVistaTabular ? "Vista Cola" : "Vista Tabla")
            </button>
            <button class="btn btn-outline-primary" @onclick="GenerarReportes">
                <i class="oi oi-bar-chart"></i> Reportes
            </button>
            <button class="btn btn-outline-success" @onclick="ExportarExcel">
                <i class="oi oi-document"></i> Exportar Excel
            </button>
            <button class="btn btn-outline-warning" @onclick="ConfigurarTiempos">
                <i class="oi oi-cog"></i> Configurar
            </button>
            <button class="btn btn-outline-info" @onclick="AsignarCocineros">
                <i class="oi oi-people"></i> Asignar
            </button>
            <button class="btn btn-primary" @onclick="RefrescarDatos">
                <i class="oi oi-reload"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- Dashboard de Métricas -->
    @if (estadisticas != null)
    {
        <div class="row mb-4">
            <!-- Total de Preparaciones -->
            <div class="col-md-2">
                <div class="card metric-card border-primary">
                    <div class="card-body text-center">
                        <div class="metric-icon text-primary">
                            <i class="oi oi-clipboard"></i>
                        </div>
                        <h3 class="metric-value text-primary">@estadisticas.PreparacionesHoy</h3>
                        <p class="metric-label">Total Preparaciones</p>
                        <small class="text-muted">@(estadisticas.PreparacionesHoy > 0 ? "+12%" : "0%") vs ayer</small>
                    </div>
                </div>
            </div>
            
            <!-- Preparaciones Pendientes -->
            <div class="col-md-2">
                <div class="card metric-card border-warning">
                    <div class="card-body text-center">
                        <div class="metric-icon text-warning">
                            <i class="oi oi-clock"></i>
                        </div>
                        <h3 class="metric-value text-warning">@estadisticas.PreparacionesPendientes</h3>
                        <p class="metric-label">Pendientes</p>
                        <small class="text-muted">@(estadisticas.PreparacionesHoy > 0 ? Math.Round((double)estadisticas.PreparacionesPendientes / estadisticas.PreparacionesHoy * 100, 1) : 0)% del total</small>
                    </div>
                </div>
            </div>
            
            <!-- Preparaciones En Proceso -->
            <div class="col-md-2">
                <div class="card metric-card border-info">
                    <div class="card-body text-center">
                        <div class="metric-icon text-info">
                            <i class="oi oi-play-circle"></i>
                        </div>
                        <h3 class="metric-value text-info">@estadisticas.PreparacionesEnProceso</h3>
                        <p class="metric-label">En Proceso</p>
                        <small class="text-muted">@(estadisticas.PreparacionesHoy > 0 ? Math.Round((double)estadisticas.PreparacionesEnProceso / estadisticas.PreparacionesHoy * 100, 1) : 0)% del total</small>
                    </div>
                </div>
            </div>
            
            <!-- Preparaciones Completadas -->
            <div class="col-md-2">
                <div class="card metric-card border-success">
                    <div class="card-body text-center">
                        <div class="metric-icon text-success">
                            <i class="oi oi-check-circle"></i>
                        </div>
                        <h3 class="metric-value text-success">@estadisticas.PreparacionesCompletadas</h3>
                        <p class="metric-label">Completadas</p>
                        <small class="text-muted">@(estadisticas.PreparacionesHoy > 0 ? Math.Round((double)estadisticas.PreparacionesCompletadas / estadisticas.PreparacionesHoy * 100, 1) : 0)% del total</small>
                    </div>
                </div>
            </div>
            
            <!-- Tiempo Promedio -->
            <div class="col-md-2">
                <div class="card metric-card border-secondary">
                    <div class="card-body text-center">
                        <div class="metric-icon text-secondary">
                            <i class="oi oi-timer"></i>
                        </div>
                        <h3 class="metric-value text-secondary">@estadisticas.TiempoPromedioPreparacion.ToString("F0")</h3>
                        <p class="metric-label">Tiempo Promedio</p>
                        <small class="text-muted">minutos</small>
                    </div>
                </div>
            </div>
            
            <!-- Eficiencia de Cocina -->
            <div class="col-md-2">
                <div class="card metric-card border-success">
                    <div class="card-body text-center">
                        <div class="metric-icon text-success">
                            <i class="oi oi-trending-up"></i>
                        </div>
                        <h3 class="metric-value text-success">@estadisticas.EficienciaCocina.ToString("F0")%</h3>
                        <p class="metric-label">Eficiencia</p>
                        <small class="text-muted">de cocina</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Gráficos de Análisis -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="oi oi-bar-chart"></i> Distribución por Estado
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="distribucionEstadoChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="oi oi-timer"></i> Tiempo de Preparación por Hora
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="tiempoPorHoraChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="oi oi-person"></i> Rendimiento por Cocinero
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="rendimientoCocineroChart" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <PreparacionFiltros Filtros="filtros" 
                        OnFiltrosAplicados="AplicarFiltros" 
                        OnLimpiarFiltros="LimpiarFiltros" />

    <!-- Lista de Preparaciones -->
    <div class="mt-4">
        @if (cargando)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-2">Cargando preparaciones...</p>
            </div>
        }
        else if (preparaciones.Any())
        {
            <PreparacionList Preparaciones="preparaciones"
                            Paginacion="paginacion"
                            MostrarVistaTabular="mostrarVistaTabular"
                            OnEditar="EditarPreparacion"
                            OnVerDetalles="VerDetallesPreparacion"
                            OnIniciarPreparacion="IniciarPreparacion"
                            OnCompletarPreparacion="CompletarPreparacion"
                            OnCambiarPagina="CambiarPagina" />
        }
        else
        {
            <div class="text-center py-5">
                <i class="oi oi-clipboard display-1 text-muted"></i>
                <h4 class="text-muted mt-3">No hay preparaciones</h4>
                <p class="text-muted">No se encontraron preparaciones con los filtros aplicados.</p>
                <button class="btn btn-primary" @onclick="RefrescarDatos">
                    <i class="oi oi-reload"></i> Actualizar
                </button>
            </div>
        }
    </div>
</div>

<!-- Modal de Detalles de Preparación -->
<PreparacionDetallesModal Preparacion="preparacionSeleccionada"
                          Mostrar="mostrarModalDetalles"
                          OnCerrar="CerrarModalDetalles" />

@code {
    private List<PreparacionDto> preparaciones = new();
    private PaginatedList<PreparacionDto>? paginacion;
    private PreparacionFiltrosDto filtros = new();
    private PreparacionEstadisticasDto? estadisticas;
    private PreparacionDto preparacionSeleccionada = new();
    private bool mostrarModalDetalles = false;
    private bool cargando = false;
    private bool mostrarVistaTabular = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("preparacionesCharts.initAll", estadisticas);
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            // Cargar preparaciones
            var preparacionesTask = PreparacionesApi.ObtenerPreparacionesPaginadasAsync(1, 20, filtros);
            var estadisticasTask = PreparacionesApi.ObtenerEstadisticasAsync();

            await Task.WhenAll(preparacionesTask, estadisticasTask);

            paginacion = await preparacionesTask;
            preparaciones = paginacion?.Items ?? new();

            estadisticas = await estadisticasTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
            
            // Actualizar gráficos después de cargar datos
            await JSRuntime.InvokeVoidAsync("preparacionesCharts.initAll", estadisticas);
        }
    }

    private async Task AplicarFiltros(PreparacionFiltrosDto nuevosFiltros)
    {
        filtros = nuevosFiltros;
        await CargarDatos();
    }

    private async Task LimpiarFiltros()
    {
        filtros = new PreparacionFiltrosDto();
        await CargarDatos();
    }

    private async Task RefrescarDatos()
    {
        await CargarDatos();
    }

    private void EditarPreparacion(PreparacionDto preparacion)
    {
        preparacionSeleccionada = preparacion;
        mostrarModalDetalles = true;
        StateHasChanged();
    }

    private async Task VerDetallesPreparacion(PreparacionDto preparacion)
    {
        try
        {
            var detalles = await PreparacionesApi.ObtenerPreparacionAsync(preparacion.Id);
            if (detalles != null)
            {
                preparacionSeleccionada = detalles;
                mostrarModalDetalles = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al obtener detalles: {ex.Message}");
        }
    }

    private async Task IniciarPreparacion(PreparacionDto preparacion)
    {
        try
        {
            var exito = await PreparacionesApi.IniciarPreparacionAsync(preparacion.Id);
            if (exito)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Preparación iniciada exitosamente");
                await CargarDatos();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al iniciar la preparación");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task CompletarPreparacion(PreparacionDto preparacion)
    {
        try
        {
            var exito = await PreparacionesApi.CompletarPreparacionAsync(preparacion.Id);
            if (exito)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Preparación completada exitosamente");
                await CargarDatos();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al completar la preparación");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private void CerrarModalDetalles()
    {
        mostrarModalDetalles = false;
        preparacionSeleccionada = new();
        StateHasChanged();
    }

    private async Task CambiarPagina(int pagina)
    {
        try
        {
            paginacion = await PreparacionesApi.ObtenerPreparacionesPaginadasAsync(pagina, 20, filtros);
            preparaciones = paginacion?.Items ?? new();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cambiar página: {ex.Message}");
        }
    }

    private void ToggleVistaTabular()
    {
        mostrarVistaTabular = !mostrarVistaTabular;
        StateHasChanged();
    }

    private async Task GenerarReportes()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidad de reportes en desarrollo");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al generar reportes: {ex.Message}");
        }
    }

    private async Task ConfigurarTiempos()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("alert", "Configuración de tiempos en desarrollo");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al configurar tiempos: {ex.Message}");
        }
    }

    private async Task AsignarCocineros()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("alert", "Asignación de cocineros en desarrollo");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al asignar cocineros: {ex.Message}");
        }
    }

    private async Task ExportarExcel()
    {
        try
        {
            var datos = await PreparacionesApi.ExportarExcelAsync(filtros);
            if (datos != null)
            {
                var fileName = $"preparaciones_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(datos));
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al exportar datos");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al exportar: {ex.Message}");
        }
    }
}
