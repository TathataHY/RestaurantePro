    private async Task SeleccionarTurnoEspecifico(string turno)
    {
        turnoSeleccionado = turno;
        
        // Recargar datos con el nuevo turno
        await CargarDatos();
    }

    private string GetTurnoButtonClass(string turno)
    {
        var baseClass = "px-3 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center justify-center";
        if (turnoSeleccionado == turno)
        {
            return $"{baseClass} bg-blue-100 text-blue-700";
        }
        return $"{baseClass} bg-gray-100 text-gray-700 hover:bg-gray-200";
    }

    private string GetTurnoDisplayText()
