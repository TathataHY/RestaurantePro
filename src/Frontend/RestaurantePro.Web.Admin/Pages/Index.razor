    private async Task ActualizarDatos()
    {
        await CargarDatos();
    }

    private async Task ActualizarMetricasTiempoReal()
    {
        try
        {
            // Solo actualizar las métricas sin recargar todo el dashboard
            var nuevoResumen = await DashboardApi.ObtenerDashboardAsync(periodoSeleccionado, turnoSeleccionado);
            if (nuevoResumen != null)
            {
                resumen = nuevoResumen;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            // Error al actualizar métricas en tiempo real
        }
    }

    private async Task CrearGraficos()
    {
        if (resumen == null)
        {
            return;
        }

        try
        {
            
            // Verificar si Chart.js está disponible (intentar múltiples veces)
            bool chartJSCargado = false;
            for (int i = 0; i < 5; i++)
            {
                chartJSCargado = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
                if (chartJSCargado)
                {
                    break;
                }
                await Task.Delay(1000);
            }
            
            if (!chartJSCargado)
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    if (typeof Chart === 'undefined') {
                        var script = document.createElement('script');
                        script.src = 'https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js';
                        script.onload = function() {
                            console.log('Chart.js cargado exitosamente desde CDN');
                        };
                        script.onerror = function() {
                            console.error('Error al cargar Chart.js desde CDN');
                        };
                        document.head.appendChild(script);
                    }
                ");
                // Esperar un poco más para que se cargue
                await Task.Delay(3000);
                
                // Verificar una vez más
                chartJSCargado = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
                if (!chartJSCargado)
                {
                    return;
                }
            }
            
            // Destruir gráficos existentes
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    if (window.dashboardCharts && window.dashboardCharts.destruirGrafico) {
                        if (window.graficoVentasHora) {
                            window.dashboardCharts.destruirGrafico(window.graficoVentasHora);
                            window.graficoVentasHora = null;
                        }
                        if (window.graficoIngresosCategoria) {
                            window.dashboardCharts.destruirGrafico(window.graficoIngresosCategoria);
                            window.graficoIngresosCategoria = null;
                        }
                        if (window.graficoProductosVendidos) {
                            window.dashboardCharts.destruirGrafico(window.graficoProductosVendidos);
                            window.graficoProductosVendidos = null;
                        }
                        if (window.graficoEstadosMesas) {
                            window.dashboardCharts.destruirGrafico(window.graficoEstadosMesas);
                            window.graficoEstadosMesas = null;
                        }
                    }
                ");
            }
            catch (Exception ex)
            {
            }

            // Crear gráfico de ventas por hora
            var datosVentasHora = resumen.IngresosPorHora?.Select(i => new { 
                hora = i.Hora.ToString("00"), 
                monto = (double)i.Monto 
            }).ToArray() ?? new object[0];
            
            await JSRuntime.InvokeVoidAsync("eval", $@"
                window.graficoVentasHora = window.dashboardCharts.crearGraficoVentasHora('graficoVentasHora', {System.Text.Json.JsonSerializer.Serialize(datosVentasHora)});
            ");

                // Crear gráfico de ingresos por categoría (datos reales del backend)
                var coloresCategorias = new[] { "#ef4444", "#10b981", "#f59e0b", "#3b82f6", "#8b5cf6", "#06b6d4", "#84cc16", "#f97316" };
                var datosCategorias = resumen.IngresosPorCategoria?.Select((c, index) => new { 
                    categoria = c.Categoria, 
                    porcentaje = (double)c.Porcentaje,
                    monto = (double)c.Monto,
                    color = coloresCategorias[index % coloresCategorias.Length]
                }).ToArray() ?? new object[0];
            
            
            await JSRuntime.InvokeVoidAsync("eval", $@"
                window.graficoIngresosCategoria = window.dashboardCharts.crearGraficoIngresosCategoria('graficoIngresosCategoria', {System.Text.Json.JsonSerializer.Serialize(datosCategorias)});
            ");

        // Crear gráfico de productos más vendidos
        var datosProductosVendidos = resumen.ProductosMasVendidos.Select(p => new { 
            nombre = p.Nombre, 
            cantidadVendida = p.CantidadVendida,
            ingresos = (double)p.Ingresos
        }).ToArray();
        
        await JSRuntime.InvokeVoidAsync("eval", $@"
            if (window.dashboardCharts && window.dashboardCharts.crearGraficoProductosVendidos) {{
                window.graficoProductosVendidos = window.dashboardCharts.crearGraficoProductosVendidos('graficoProductosVendidos', {System.Text.Json.JsonSerializer.Serialize(datosProductosVendidos)});
            }} else {{
                console.error('dashboardCharts.crearGraficoProductosVendidos no está disponible');
            }}
        ");

        // Crear gráfico de estados de mesas
        var datosEstadosMesas = new[]
        {
            new { estado = "Ocupadas", cantidad = resumen.EstadoMesas.Ocupadas },
            new { estado = "Disponibles", cantidad = resumen.EstadoMesas.Disponibles },
            new { estado = "Reservadas", cantidad = resumen.EstadoMesas.Reservadas },
            new { estado = "En Limpieza", cantidad = resumen.EstadoMesas.EnLimpieza }
        };
        
        await JSRuntime.InvokeVoidAsync("eval", $@"
            window.graficoEstadosMesas = window.dashboardCharts.crearGraficoEstadosMesas('graficoEstadosMesas', {System.Text.Json.JsonSerializer.Serialize(datosEstadosMesas)});
        ");
            
        }
        catch (Exception ex)
        {
            // Error al crear gráficos
        }
    }

    private string GetFechaMostrada()
    {
        return periodoSeleccionado switch
        {
            "hoy" => DateTime.Today.ToString("dd/MM/yyyy"),
            "ayer" => DateTime.Today.AddDays(-1).ToString("dd/MM/yyyy"),
            "semana" => $"{DateTime.Today.AddDays(-7):dd/MM/yyyy} - {DateTime.Today:dd/MM/yyyy}",
            "mes" => $"{DateTime.Today.AddDays(-30):dd/MM/yyyy} - {DateTime.Today:dd/MM/yyyy}",
            _ => DateTime.Today.ToString("dd/MM/yyyy")
        };
    }

