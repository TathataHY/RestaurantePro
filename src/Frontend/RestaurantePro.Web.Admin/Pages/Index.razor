                        </div>
                    </div>
                </div>
            </section>

            <!-- Vista Rápida de Operaciones -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
                <div class="lg:col-span-2">
                    <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Vista Rápida de Operaciones</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="flex items-center justify-center rounded-lg bg-blue-100 text-blue-600 size-12 shrink-0">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-base font-medium">Comandas Activas</p>
                                    <p class="text-gray-500 text-sm">@resumen.Metricas.ComandasActivas comandas activas</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="flex items-center justify-center rounded-lg bg-purple-100 text-purple-600 size-12 shrink-0">
                                    <span class="material-symbols-outlined">calendar_month</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-base font-medium">Reservaciones del Día</p>
                                    <p class="text-gray-500 text-sm">@(resumen.EstadoMesas.Reservadas) reservaciones hoy</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm mt-6">
                        <p class="text-gray-800 text-base font-medium mb-4">Estado de Mesas</p>
                        <div class="w-full h-48 rounded-lg bg-cover bg-center" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC2dMjSIcs84fJqO9c5tryYrzyS18rAoeYMad7Uqkw2DvinXeJHXEn_kIqw5A6iHEH0jrLFWAl8LwNVgTkDRZCDsG0TzlsHUUF7f6cK18-6Ew7Vc12LbOdGw5tzxB_EzJ3MTu8xnrZHzWyGsPWqgQxw-fEh7dGxKXcQ0DxXlHOnXsRC2R2QykFGaJVxw_XMmDYon5fM042wTG4Bf_4jV7w6NSjwfB5uEFhhWIe14Rswdqlm5PugAXuQEfZVHaaNc0D3xj5ZtzAvJaz9");'></div>
                    </div>
                </div>

                <!-- Panel Derecho -->
                <div class="flex flex-col gap-6">
                    <!-- Alertas y Notificaciones -->
                    <div>
                        <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Alertas y Notificaciones</h2>
                        <div class="space-y-4">
                            <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-yellow-300 shadow-sm">
                                <div class="flex items-center justify-center rounded-full bg-yellow-100 text-yellow-600 size-10 shrink-0">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                </div>
