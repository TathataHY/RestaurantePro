        }

@code {
    private DashboardResumenDto? resumen;
    private bool cargando = true;
    private string periodoSeleccionado = "hoy";
    private string turnoSeleccionado = "todos";
    
    // Constantes para los turnos
    private const string todos = "todos";
    private const string mañana = "mañana";
    private const string tarde = "tarde";
    private const string noche = "noche";
    private const string madrugada = "madrugada";
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        
        // Iniciar timer para actualización automática cada 30 segundos
        _timer = new Timer(async _ => await ActualizarMetricasTiempoReal(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            resumen = await DashboardApi.ObtenerDashboardAsync(periodoSeleccionado, turnoSeleccionado);
            
            if (resumen != null)
            {
                Console.WriteLine($"Datos del dashboard cargados correctamente - Período: {periodoSeleccionado}, Turno: {turnoSeleccionado}");
                
                // 🔍 LOGS DE DEBUG - DATOS RECIBIDOS DEL BACKEND
                Console.WriteLine("=== 📊 DATOS RECIBIDOS DEL BACKEND ===");
                Console.WriteLine($"💰 Ventas Hoy: ${resumen.Metricas.VentasHoy:N2}");
                Console.WriteLine($"💰 Ventas Total Día: ${resumen.Metricas.VentasTotalDia:N2}");
                Console.WriteLine($"💰 Ventas Ayer: ${resumen.Metricas.VentasAyer:N2}");
                Console.WriteLine($"💰 Ventas Semana: ${resumen.Metricas.VentasSemana:N2}");
                Console.WriteLine($"💰 Ventas Mes: ${resumen.Metricas.VentasMes:N2}");
                Console.WriteLine($"🏢 Mesas Ocupadas: {resumen.Metricas.MesasOcupadas}");
                Console.WriteLine($"🏢 Mesas Disponibles: {resumen.Metricas.MesasDisponibles}");
                Console.WriteLine($"🏢 Total Mesas: {resumen.Metricas.TotalMesas}");
                Console.WriteLine($"📋 Comandas Activas: {resumen.Metricas.ComandasActivas}");
                Console.WriteLine($"📋 Comandas Completadas: {resumen.Metricas.ComandasCompletadas}");
                Console.WriteLine($"📦 Productos Vendidos Hoy: {resumen.Metricas.ProductosVendidosHoy}");
                Console.WriteLine($"👥 Clientes Atendidos Hoy: {resumen.Metricas.ClientesAtendidosHoy}");
                Console.WriteLine($"💳 Promedio Ticket: ${resumen.Metricas.PromedioTicket:N2}");
                Console.WriteLine($"📈 Crecimiento Ventas: {resumen.Metricas.CrecimientoVentas:N1}%");
                Console.WriteLine($"⏰ Última Actualización: {resumen.Metricas.UltimaActualizacion}");
                
                // Logs de datos de gráficos
                Console.WriteLine("=== 📊 DATOS DE GRÁFICOS ===");
                Console.WriteLine($"📈 Ventas Últimos 7 Días: {resumen.VentasPorPeriodo?.Count ?? 0} elementos");
                Console.WriteLine($"📈 Ingresos por Hora: {resumen.IngresosPorHora?.Count ?? 0} elementos");
                Console.WriteLine($"🏆 Productos Más Vendidos: {resumen.ProductosMasVendidos?.Count ?? 0} elementos");
                Console.WriteLine($"🏷️ Ingresos por Categoría: {resumen.IngresosPorCategoria?.Count ?? 0} elementos");
                Console.WriteLine($"🍽️ Estados de Mesas: {resumen.EstadoMesas?.Ocupadas ?? 0} ocupadas, {resumen.EstadoMesas?.Disponibles ?? 0} disponibles");
                Console.WriteLine($"📋 Comandas por Estado: Pendientes={resumen.ComandasPorEstado?.Pendientes ?? 0}, EnPreparacion={resumen.ComandasPorEstado?.EnPreparacion ?? 0}, Listas={resumen.ComandasPorEstado?.Listas ?? 0}, Completadas={resumen.ComandasPorEstado?.Completadas ?? 0}");
                Console.WriteLine("=== 🔚 FIN DATOS RECIBIDOS ===");
                
                // Esperar un poco y luego intentar crear los gráficos automáticamente
                _ = Task.Run(async () => {
                    await Task.Delay(3000); // Esperar 3 segundos
                    await CrearGraficos();
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos del dashboard: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task SeleccionarPeriodo(string periodo)
    {
        periodoSeleccionado = periodo;
        Console.WriteLine($"Período seleccionado: {periodo}");
        
        // Recargar datos con el nuevo período
        await CargarDatos();
    }

    private async Task SeleccionarHoy()
    {
        await SeleccionarPeriodo("hoy");
    }

    private async Task SeleccionarAyer()
    {
        await SeleccionarPeriodo("ayer");
    }

    private async Task SeleccionarSemana()
    {
        await SeleccionarPeriodo("semana");
    }

    private async Task SeleccionarMes()
    {
        await SeleccionarPeriodo("mes");
    }

    private async Task SeleccionarTodos()
    {
        await SeleccionarTurnoEspecifico("todos");
    }

    private async Task SeleccionarMañana()
    {
        await SeleccionarTurnoEspecifico("mañana");
    }

    private async Task SeleccionarTarde()
    {
        await SeleccionarTurnoEspecifico("tarde");
    }

    private async Task SeleccionarNoche()
    {
        await SeleccionarTurnoEspecifico("noche");
    }

    private async Task SeleccionarMadrugada()
    {
        await SeleccionarTurnoEspecifico("madrugada");
    }

    private async Task SeleccionarTurnoEspecifico(string turno)
    {
        turnoSeleccionado = turno;
        Console.WriteLine($"Turno seleccionado: {turnoSeleccionado}");
        
        // Recargar datos con el nuevo turno
        await CargarDatos();
    }

    private string GetTurnoButtonClass(string turno)
    {
        var baseClass = "px-3 py-1 rounded-md text-sm font-medium transition-colors";
        if (turnoSeleccionado == turno)
        {
            return $"{baseClass} bg-blue-100 text-blue-700";
        }
        return $"{baseClass} bg-gray-100 text-gray-700 hover:bg-gray-200";
    }

    private string GetTurnoDisplayText()
    {
        return turnoSeleccionado switch
        {
            "todos" => "Todos los turnos (24 horas)",
            "mañana" => "Mañana (6:00 AM - 12:00 PM)",
            "tarde" => "Tarde (12:00 PM - 6:00 PM)",
            "noche" => "Noche (6:00 PM - 12:00 AM)",
            "madrugada" => "Madrugada (12:00 AM - 6:00 AM)",
            _ => "Todos los turnos (24 horas)"
        };
    }

    private int CalcularTiempoPromedio()
    {
        // Simulación de tiempo promedio por mesa (en minutos)
        // En una implementación real, esto vendría de la base de datos
        if (resumen?.EstadoMesas.Ocupadas > 0)
        {
            return (resumen.EstadoMesas.Ocupadas * 45) / resumen.EstadoMesas.Ocupadas; // 45 minutos promedio
        }
        return 0;
    }

    private string GetPeriodoButtonClass(string periodo)
    {
        var baseClass = "px-3 py-1 rounded-md text-sm font-medium transition-colors";
        if (periodoSeleccionado == periodo)
        {
            return $"{baseClass} bg-blue-100 text-blue-700";
        }
        return $"{baseClass} bg-gray-100 text-gray-700 hover:bg-gray-200";
    }

    private async Task ActualizarDatos()
    {
        await CargarDatos();
    }

    private async Task ActualizarMetricasTiempoReal()
    {
        try
        {
            // Solo actualizar las métricas sin recargar todo el dashboard
            var nuevoResumen = await DashboardApi.ObtenerDashboardAsync(periodoSeleccionado, turnoSeleccionado);
            if (nuevoResumen != null)
            {
                resumen = nuevoResumen;
                await InvokeAsync(StateHasChanged);
                Console.WriteLine("Métricas actualizadas en tiempo real");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar métricas en tiempo real: {ex.Message}");
        }
    }

    private async Task CrearGraficos()
    {
        if (resumen == null) 
        {
            Console.WriteLine("No hay datos del resumen para crear gráficos");
            return;
        }

        try
        {
            Console.WriteLine("Iniciando creación de gráficos...");
            
            // Verificar si Chart.js está disponible (intentar múltiples veces)
            bool chartJSCargado = false;
            for (int i = 0; i < 5; i++)
            {
                chartJSCargado = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
                if (chartJSCargado)
                {
                    Console.WriteLine("Chart.js está disponible");
                    break;
                }
                Console.WriteLine($"Intento {i + 1}: Chart.js no está disponible, esperando...");
                await Task.Delay(1000);
            }
            
            if (!chartJSCargado)
            {
                Console.WriteLine("Chart.js no está disponible después de 5 intentos. Intentando cargar desde CDN...");
                await JSRuntime.InvokeVoidAsync("eval", @"
                    if (typeof Chart === 'undefined') {
                        var script = document.createElement('script');
                        script.src = 'https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js';
                        script.onload = function() {
                            console.log('Chart.js cargado exitosamente desde CDN');
                        };
                        script.onerror = function() {
                            console.error('Error al cargar Chart.js desde CDN');
                        };
                        document.head.appendChild(script);
                    }
                ");
                // Esperar un poco más para que se cargue
                await Task.Delay(3000);
                
                // Verificar una vez más
                chartJSCargado = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
                if (!chartJSCargado)
                {
                    Console.WriteLine("Chart.js no se pudo cargar. Saltando creación de gráficos.");
                    return;
                }
            }
            
            // Destruir gráficos existentes
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    if (window.dashboardCharts && window.dashboardCharts.destruirGrafico) {
                        if (window.graficoVentasHora) {
                            window.dashboardCharts.destruirGrafico(window.graficoVentasHora);
                            window.graficoVentasHora = null;
                        }
                        if (window.graficoIngresosCategoria) {
                            window.dashboardCharts.destruirGrafico(window.graficoIngresosCategoria);
                            window.graficoIngresosCategoria = null;
                        }
                        if (window.graficoProductosVendidos) {
                            window.dashboardCharts.destruirGrafico(window.graficoProductosVendidos);
                            window.graficoProductosVendidos = null;
                        }
                        if (window.graficoEstadosMesas) {
                            window.dashboardCharts.destruirGrafico(window.graficoEstadosMesas);
                            window.graficoEstadosMesas = null;
                        }
                    }
                ");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al destruir gráficos existentes: {ex.Message}");
            }

            // Crear gráfico de ventas por hora
            var datosVentasHora = resumen.IngresosPorHora?.Select(i => new { 
                hora = i.Hora.ToString("00"), 
                monto = (double)i.Monto 
            }).ToArray() ?? new object[0];
            
            Console.WriteLine($"Creando gráfico de ventas por hora con {datosVentasHora.Length} datos");
            Console.WriteLine($"📊 DEBUG: IngresosPorHora datos: {System.Text.Json.JsonSerializer.Serialize(resumen.IngresosPorHora)}");
            await JSRuntime.InvokeVoidAsync("eval", $@"
                window.graficoVentasHora = window.dashboardCharts.crearGraficoVentasHora('graficoVentasHora', {System.Text.Json.JsonSerializer.Serialize(datosVentasHora)});
            ");

                // Crear gráfico de ingresos por categoría (datos reales del backend)
                var coloresCategorias = new[] { "#ef4444", "#10b981", "#f59e0b", "#3b82f6", "#8b5cf6", "#06b6d4", "#84cc16", "#f97316" };
                var datosCategorias = resumen.IngresosPorCategoria?.Select((c, index) => new { 
                    categoria = c.Categoria, 
                    porcentaje = (double)c.Porcentaje,
                    monto = (double)c.Monto,
                    color = coloresCategorias[index % coloresCategorias.Length]
                }).ToArray() ?? new object[0];
            
            Console.WriteLine($"Creando gráfico de ingresos por categoría con {datosCategorias.Length} categorías");
            Console.WriteLine($"📊 DEBUG: IngresosPorCategoria datos: {System.Text.Json.JsonSerializer.Serialize(datosCategorias)}");
            
            await JSRuntime.InvokeVoidAsync("eval", $@"
                window.graficoIngresosCategoria = window.dashboardCharts.crearGraficoIngresosCategoria('graficoIngresosCategoria', {System.Text.Json.JsonSerializer.Serialize(datosCategorias)});
            ");

        // Crear gráfico de productos más vendidos
        var datosProductosVendidos = resumen.ProductosMasVendidos.Select(p => new { 
            nombre = p.Nombre, 
            cantidadVendida = p.CantidadVendida,
            ingresos = (double)p.Ingresos
        }).ToArray();
        
        Console.WriteLine($"Creando gráfico de productos más vendidos con {datosProductosVendidos.Length} productos");
        await JSRuntime.InvokeVoidAsync("eval", $@"
            if (window.dashboardCharts && window.dashboardCharts.crearGraficoProductosVendidos) {{
                window.graficoProductosVendidos = window.dashboardCharts.crearGraficoProductosVendidos('graficoProductosVendidos', {System.Text.Json.JsonSerializer.Serialize(datosProductosVendidos)});
            }} else {{
                console.error('dashboardCharts.crearGraficoProductosVendidos no está disponible');
            }}
        ");

        // Crear gráfico de estados de mesas
        var datosEstadosMesas = new[]
        {
            new { estado = "Ocupadas", cantidad = resumen.EstadoMesas.Ocupadas },
            new { estado = "Disponibles", cantidad = resumen.EstadoMesas.Disponibles },
            new { estado = "Reservadas", cantidad = resumen.EstadoMesas.Reservadas },
            new { estado = "En Limpieza", cantidad = resumen.EstadoMesas.EnLimpieza }
        };
        
        Console.WriteLine($"Creando gráfico de estados de mesas con {datosEstadosMesas.Length} estados");
        await JSRuntime.InvokeVoidAsync("eval", $@"
            window.graficoEstadosMesas = window.dashboardCharts.crearGraficoEstadosMesas('graficoEstadosMesas', {System.Text.Json.JsonSerializer.Serialize(datosEstadosMesas)});
        ");
            
            Console.WriteLine("Gráficos creados exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al crear gráficos: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Limpiar timer
        _timer?.Dispose();
        
        // Limpiar gráficos al destruir el componente
        try
        {
            JSRuntime.InvokeVoidAsync("eval", @"
                if (window.dashboardCharts && window.dashboardCharts.destruirGrafico) {
                    if (window.graficoVentasHora) {
                        window.dashboardCharts.destruirGrafico(window.graficoVentasHora);
                        window.graficoVentasHora = null;
                    }
                    if (window.graficoIngresosCategoria) {
                        window.dashboardCharts.destruirGrafico(window.graficoIngresosCategoria);
                        window.graficoIngresosCategoria = null;
                    }
                    if (window.graficoProductosVendidos) {
                        window.dashboardCharts.destruirGrafico(window.graficoProductosVendidos);
                        window.graficoProductosVendidos = null;
                    }
                }
            ");
        }
        catch { }
    }
}
