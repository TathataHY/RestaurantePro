@page "/"
@attribute [Authorize]
@inject RestaurantePro.Web.Admin.Services.DashboardApiService DashboardApi
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard Ejecutivo</PageTitle>

<div class="dashboard-header">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="dashboard-title">Dashboard Ejecutivo</h1>
            <p class="dashboard-subtitle">Resumen de operaciones en tiempo real</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="last-update">
                <span class="oi oi-clock text-muted"></span>
                <small class="text-muted ms-1">
                    Última actualización: @(resumen?.Metricas.UltimaActualizacion.ToString("HH:mm") ?? "Cargando...")
                </small>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="ActualizarDatos">
                <span class="oi oi-reload"></span> Actualizar
            </button>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="loading-container">
        <div class="loading-spinner">
            <div class="spinner"></div>
        </div>
        <h3 class="loading-title">Cargando Dashboard</h3>
        <p class="loading-subtitle">Obteniendo métricas en tiempo real...</p>
    </div>
}
else if (resumen != null)
{
    <!-- Métricas principales -->
    <div class="metrics-grid">
        <MetricaCardModern Titulo="Ventas Hoy" 
                          Valor="@resumen.Metricas.VentasHoy.ToString("C0")" 
                          Subtexto="@($"vs ayer: {resumen.Metricas.VentasAyer.ToString("C0")}")"
                          Icono="oi oi-dollar" 
                          CardClass="success"
                          ValorClass="text-success"
                          IconoClass="success"
                          MostrarCambio="true"
                          Cambio="@resumen.Metricas.CrecimientoVentas" />

        <MetricaCardModern Titulo="Mesas Ocupadas" 
                          Valor="@($"{resumen.Metricas.MesasOcupadas} de {resumen.Metricas.TotalMesas}")" 
                          Subtexto="@($"{resumen.Metricas.MesasDisponibles} disponibles")"
                          Icono="oi oi-grid-three-up" 
                          CardClass="info"
                          ValorClass="text-info"
                          IconoClass="info" />

        <MetricaCardModern Titulo="Comandas Activas" 
                          Valor="@resumen.Metricas.ComandasActivas.ToString()" 
                          Subtexto="@($"{resumen.Metricas.ComandasCompletadas} completadas hoy")"
                          Icono="oi oi-list-rich" 
                          CardClass="warning"
                          ValorClass="text-warning"
                          IconoClass="warning" />

        <MetricaCardModern Titulo="Promedio Ticket" 
                          Valor="@resumen.Metricas.PromedioTicket.ToString("C0")" 
                          Subtexto="@($"{resumen.Metricas.ClientesAtendidosHoy} clientes atendidos")"
                          Icono="oi oi-people" 
                          CardClass="primary"
                          ValorClass="text-primary"
                          IconoClass="primary" />
    </div>

    <!-- Gráficos principales -->
    <div class="charts-grid">
        <!-- Gráfico de ventas -->
        <div class="card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <span class="oi oi-bar-chart"></span> Ventas de los Últimos 7 Días
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="graficoVentas"></canvas>
                </div>
            </div>
        </div>

        <!-- Estado de mesas -->
        <div class="card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <span class="oi oi-grid-three-up"></span> Estado de Mesas
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="graficoMesas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos secundarios -->
    <div class="charts-row">
        <!-- Productos más vendidos -->
        <div class="card">
            <ProductosMasVendidos Productos="resumen.ProductosMasVendidos" />
        </div>

        <!-- Comandas por estado -->
        <div class="card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <span class="oi oi-list-rich"></span> Comandas por Estado
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="graficoComandas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico de ingresos por hora -->
    <div class="charts-full">
        <div class="card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <span class="oi oi-clock"></span> Ingresos por Hora (Hoy)
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-container" style="height: 250px;">
                    <canvas id="graficoIngresosHora"></canvas>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="error-container">
        <div class="error-icon">
            <span class="oi oi-warning"></span>
        </div>
        <h3 class="error-title">Error al cargar el dashboard</h3>
        <p class="error-message">No se pudieron cargar las métricas del dashboard. Por favor, inténtalo de nuevo.</p>
        <button class="btn btn-primary" @onclick="ActualizarDatos">
            <span class="oi oi-reload"></span> Reintentar
        </button>
    </div>
}

@code {
    private DashboardResumenDto? resumen;
    private bool cargando = true;
    private object? graficoVentas;
    private object? graficoMesas;
    private object? graficoComandas;
    private object? graficoIngresosHora;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            resumen = await DashboardApi.ObtenerResumenAsync();
            
            if (resumen != null)
            {
                await Task.Delay(100); // Pequeña pausa para asegurar que el DOM esté listo
                await CrearGraficos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos del dashboard: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task ActualizarDatos()
    {
        await CargarDatos();
    }

    private async Task CrearGraficos()
    {
        if (resumen == null) return;

        try
        {
            // Destruir gráficos existentes
            if (graficoVentas != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoVentas);
            if (graficoMesas != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoMesas);
            if (graficoComandas != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoComandas);
            if (graficoIngresosHora != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoIngresosHora);

            // Crear gráfico de ventas
            var datosVentas = resumen.VentasUltimos7Dias.Select(v => new { 
                fecha = v.Fecha.ToString("dd/MM"), 
                monto = (double)v.Monto 
            }).ToArray();
            graficoVentas = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoVentas", "graficoVentas", datosVentas);

            // Crear gráfico de mesas
            var datosMesas = new { 
                disponibles = resumen.EstadoMesas.Disponibles,
                ocupadas = resumen.EstadoMesas.Ocupadas,
                reservadas = resumen.EstadoMesas.Reservadas,
                enLimpieza = resumen.EstadoMesas.EnLimpieza
            };
            graficoMesas = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoMesas", "graficoMesas", datosMesas);

            // Crear gráfico de comandas
            var datosComandas = new { 
                pendientes = resumen.ComandasPorEstado.Pendientes,
                enPreparacion = resumen.ComandasPorEstado.EnPreparacion,
                listas = resumen.ComandasPorEstado.Listas,
                completadas = resumen.ComandasPorEstado.Completadas,
                canceladas = resumen.ComandasPorEstado.Canceladas
            };
            graficoComandas = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoComandas", "graficoComandas", datosComandas);

            // Crear gráfico de ingresos por hora
            var datosIngresos = resumen.IngresosPorHora.Select(i => new { 
                hora = i.Hora, 
                monto = (double)i.Monto 
            }).ToArray();
            graficoIngresosHora = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoIngresosHora", "graficoIngresosHora", datosIngresos);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al crear gráficos: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Limpiar gráficos al destruir el componente
        if (graficoVentas != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoVentas);
        if (graficoMesas != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoMesas);
        if (graficoComandas != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoComandas);
        if (graficoIngresosHora != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoIngresosHora);
    }
}
