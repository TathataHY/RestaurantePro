@page "/"
@attribute [Authorize]
@inject RestaurantePro.Web.Admin.Services.DashboardApiService DashboardApi
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard Ejecutivo</PageTitle>

<div class="flex-1 px-8 md:px-16 lg:px-24 py-8">
    <div class="mx-auto max-w-7xl">
        <h2 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-8">Dashboard Ejecutivo</h2>

@if (cargando)
{
    <div class="flex justify-center items-center py-12">
        <div class="text-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-color mx-auto mb-4"></div>
            <p class="text-gray-500">Cargando dashboard...</p>
        </div>
    </div>
}
else if (resumen != null)
{
    <!-- Métricas principales -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
            <div class="flex items-center justify-between">
                <p class="text-base font-medium text-gray-600 dark:text-gray-400">Ventas</p>
                <span class="material-symbols-outlined text-success-color">trending_up</span>
            </div>
            <p class="text-4xl font-bold text-gray-900 dark:text-white mt-2">@resumen.Metricas.VentasHoy.ToString("C0")</p>
            <p class="text-sm font-medium text-success-color mt-1">+@resumen.Metricas.CrecimientoVentas.ToString("F1")%</p>
        </div>
        
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
            <div class="flex items-center justify-between">
                <p class="text-base font-medium text-gray-600 dark:text-gray-400">Mesas Ocupadas</p>
                <span class="material-symbols-outlined text-primary-color">restaurant</span>
            </div>
            <p class="text-4xl font-bold text-gray-900 dark:text-white mt-2">@resumen.Metricas.MesasOcupadas / @resumen.Metricas.TotalMesas</p>
            <p class="text-sm font-medium text-success-color mt-1">+5%</p>
        </div>
        
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
            <div class="flex items-center justify-between">
                <p class="text-base font-medium text-gray-600 dark:text-gray-400">Comandas Activas</p>
                <span class="material-symbols-outlined text-warning-color">receipt_long</span>
            </div>
            <p class="text-4xl font-bold text-gray-900 dark:text-white mt-2">@resumen.Metricas.ComandasActivas</p>
            <p class="text-sm font-medium text-red-500 mt-1">-3%</p>
        </div>
        
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800" style="box-shadow: 0.1em 0.1em 0.3em #00000008, -0.1em -0.1em 0.3em #ffffff;">
            <div class="flex items-center justify-between">
                <p class="text-base font-medium text-gray-600 dark:text-gray-400">Promedio por Ticket</p>
                <span class="material-symbols-outlined text-purple-color">payments</span>
            </div>
            <p class="text-4xl font-bold text-gray-900 dark:text-white mt-2">@resumen.Metricas.PromedioTicket.ToString("C0")</p>
            <p class="text-sm font-medium text-success-color mt-1">+8%</p>
        </div>
    </div>

    <!-- Gráficos principales -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
        <!-- Gráfico de ventas -->
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Ventas de los Últimos 7 días</h3>
            <div class="flex items-baseline gap-2 mt-2">
                <p class="text-3xl font-bold text-gray-900 dark:text-white">@resumen.Metricas.VentasHoy.ToString("C0")</p>
                <p class="text-sm font-medium text-success-color">+@resumen.Metricas.CrecimientoVentas.ToString("F1")%</p>
            </div>
            <div class="h-64 mt-4">
                <canvas id="graficoVentas"></canvas>
            </div>
        </div>

        <!-- Estado de mesas -->
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Estado de Mesas</h3>
            <div class="flex items-baseline gap-2 mt-2">
                <p class="text-3xl font-bold text-gray-900 dark:text-white">@resumen.Metricas.MesasOcupadas / @resumen.Metricas.TotalMesas</p>
                <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Ocupadas</p>
            </div>
            <div class="h-64 mt-4 flex items-center justify-center">
                <canvas id="graficoMesas"></canvas>
            </div>
        </div>
    </div>

    <!-- Gráficos secundarios -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
        <!-- Comandas por estado -->
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Comandas por Estado</h3>
            <div class="mt-4 space-y-4">
                <div class="flex items-center">
                    <span class="w-24 text-sm font-medium text-gray-600 dark:text-gray-400">Pendientes</span>
                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-4">
                        <div class="bg-warning-color h-4 rounded-full" style="width: 30%"></div>
                    </div>
                    <span class="w-12 text-right text-sm font-bold text-gray-900 dark:text-white">@resumen.ComandasPorEstado.Pendientes</span>
                </div>
                <div class="flex items-center">
                    <span class="w-24 text-sm font-medium text-gray-600 dark:text-gray-400">En Preparación</span>
                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-4">
                        <div class="bg-primary-color h-4 rounded-full" style="width: 50%"></div>
                    </div>
                    <span class="w-12 text-right text-sm font-bold text-gray-900 dark:text-white">@resumen.ComandasPorEstado.EnPreparacion</span>
                </div>
                <div class="flex items-center">
                    <span class="w-24 text-sm font-medium text-gray-600 dark:text-gray-400">Entregadas</span>
                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-4">
                        <div class="bg-success-color h-4 rounded-full" style="width: 20%"></div>
                    </div>
                    <span class="w-12 text-right text-sm font-bold text-gray-900 dark:text-white">@resumen.ComandasPorEstado.Completadas</span>
                </div>
            </div>
        </div>

        <!-- Ingresos por hora -->
        <div class="rounded-2xl p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700" style="box-shadow: 0.05em 0.05em 0.2em #00000005, -0.05em -0.05em 0.2em #ffffff;">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Ingresos por Hora</h3>
            <div class="h-64 mt-4">
                <canvas id="graficoIngresosHora"></canvas>
            </div>
        </div>
    </div>

}
else
{
    <div class="text-center py-12">
        <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">error</span>
        <p class="text-gray-500 text-lg">Error al cargar el dashboard</p>
        <p class="text-gray-400 text-sm">No se pudieron cargar las métricas del dashboard</p>
        <button class="mt-4 px-4 py-2 bg-primary-color text-white rounded-lg hover:bg-primary-color/90 transition-colors" @onclick="ActualizarDatos">
            Reintentar
        </button>
    </div>
}
    </div>
</div>

@code {
    private DashboardResumenDto? resumen;
    private bool cargando = true;
    private object? graficoVentas;
    private object? graficoMesas;
    private object? graficoComandas;
    private object? graficoIngresosHora;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            resumen = await DashboardApi.ObtenerResumenAsync();
            
            if (resumen != null)
            {
                await Task.Delay(100); // Pequeña pausa para asegurar que el DOM esté listo
                await CrearGraficos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos del dashboard: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task ActualizarDatos()
    {
        await CargarDatos();
    }

    private async Task CrearGraficos()
    {
        if (resumen == null) return;

        try
        {
            // Destruir gráficos existentes
            if (graficoVentas != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoVentas);
            if (graficoMesas != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoMesas);
            if (graficoComandas != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoComandas);
            if (graficoIngresosHora != null) await JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoIngresosHora);

            // Crear gráfico de ventas
            var datosVentas = resumen.VentasUltimos7Dias.Select(v => new { 
                fecha = v.Fecha.ToString("dd/MM"), 
                monto = (double)v.Monto 
            }).ToArray();
            graficoVentas = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoVentas", "graficoVentas", datosVentas);

            // Crear gráfico de mesas
            var datosMesas = new { 
                disponibles = resumen.EstadoMesas.Disponibles,
                ocupadas = resumen.EstadoMesas.Ocupadas,
                reservadas = resumen.EstadoMesas.Reservadas,
                enLimpieza = resumen.EstadoMesas.EnLimpieza
            };
            graficoMesas = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoMesas", "graficoMesas", datosMesas);

            // Crear gráfico de comandas
            var datosComandas = new { 
                pendientes = resumen.ComandasPorEstado.Pendientes,
                enPreparacion = resumen.ComandasPorEstado.EnPreparacion,
                listas = resumen.ComandasPorEstado.Listas,
                completadas = resumen.ComandasPorEstado.Completadas,
                canceladas = resumen.ComandasPorEstado.Canceladas
            };
            graficoComandas = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoComandas", "graficoComandas", datosComandas);

            // Crear gráfico de ingresos por hora
            var datosIngresos = resumen.IngresosPorHora.Select(i => new { 
                hora = i.Hora, 
                monto = (double)i.Monto 
            }).ToArray();
            graficoIngresosHora = await JSRuntime.InvokeAsync<object>("dashboardCharts.crearGraficoIngresosHora", "graficoIngresosHora", datosIngresos);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al crear gráficos: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Limpiar gráficos al destruir el componente
        if (graficoVentas != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoVentas);
        if (graficoMesas != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoMesas);
        if (graficoComandas != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoComandas);
        if (graficoIngresosHora != null) JSRuntime.InvokeVoidAsync("dashboardCharts.destruirGrafico", graficoIngresosHora);
    }
}
