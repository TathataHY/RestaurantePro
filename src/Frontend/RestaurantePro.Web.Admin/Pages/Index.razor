@page "/"
@attribute [Authorize]
@inject RestaurantePro.Web.Admin.Services.IDashboardApiService DashboardApi
@inject RestaurantePro.Web.Admin.Services.PermissionService PermissionService
@using RestaurantePro.Web.Admin.Models
@using RestaurantePro.Web.Admin.Components
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Dashboard Ejecutivo</PageTitle>

<!-- Header del Dashboard -->
<div class="flex flex-wrap justify-between items-center gap-4 mb-8">
    <div>
        <h1 class="text-gray-900 text-3xl font-bold leading-tight">Dashboard Ejecutivo</h1>
        <p class="text-gray-500 text-base font-normal leading-normal">Resumen de métricas clave y operaciones.</p>
    </div>
</div>

<!-- Selector de Período -->
<div class="bg-white rounded-lg border border-gray-200 p-4 mb-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
            <label class="text-gray-700 text-sm font-medium">Período:</label>
            <div class="grid grid-cols-2 gap-2 sm:flex sm:gap-2">
                <button @onclick="SeleccionarHoy" 
                        class="px-3 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center justify-center @(periodoSeleccionado == "hoy" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    Hoy
                </button>
                <button @onclick="SeleccionarAyer" 
                        class="px-3 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center justify-center @(periodoSeleccionado == "ayer" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    Ayer
                </button>
                <button @onclick="SeleccionarSemana" 
                        class="px-3 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center justify-center @(periodoSeleccionado == "semana" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    Esta Semana
                </button>
                <button @onclick="SeleccionarMes" 
                        class="px-3 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center justify-center @(periodoSeleccionado == "mes" ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    Este Mes
                </button>
            </div>
        </div>
        <div class="text-sm text-gray-500">
            <span>Mostrando datos de @(periodoSeleccionado switch { "hoy" => "hoy", "ayer" => "ayer", "semana" => "esta semana", "mes" => "este mes", _ => "hoy" }) (@GetFechaMostrada())</span>
        </div>
    </div>
</div>

<!-- Filtros por Turno -->
<div class="bg-white rounded-lg border border-gray-200 p-4 mb-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
            <label class="text-gray-700 text-sm font-medium">Turno:</label>
            <div class="grid grid-cols-3 gap-2 sm:flex sm:gap-2">
                <button @onclick="SeleccionarTodos" 
                        class="@GetTurnoButtonClass(todos)">
                    Todos
                </button>
                <button @onclick="SeleccionarMañana" 
                        class="@GetTurnoButtonClass(mañana)">
                    Mañana
                </button>
                <button @onclick="SeleccionarTarde" 
                        class="@GetTurnoButtonClass(tarde)">
                    Tarde
                </button>
                <button @onclick="SeleccionarNoche" 
                        class="@GetTurnoButtonClass(noche)">
                    Noche
                </button>
                <button @onclick="SeleccionarMadrugada" 
                        class="@GetTurnoButtonClass(madrugada)">
                    Madrugada
                </button>
            </div>
        </div>
        <div class="text-sm text-gray-500">
            <span>Turno: @GetTurnoDisplayText()</span>
        </div>
    </div>
</div>

        @if (cargando)
        {
            <div class="flex justify-center items-center py-12">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--primary-color)] mx-auto mb-4"></div>
                    <p class="text-gray-500">Cargando dashboard...</p>
                </div>
            </div>
        }
        else if (resumen != null)
        {
            <!-- Métricas Principales -->
            <section>
                <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Métricas Principales</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    @if (canViewFinancialData)
                    {
                        <div class="flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <p class="text-gray-600 text-sm font-medium">@GetVentasLabel()</p>
                            <p class="text-gray-900 text-3xl font-bold">@resumen.Metricas.VentasHoy.ToString("C0")</p>
                            <div class="flex items-center gap-1 text-green-600 text-sm font-medium">
                                <span class="material-symbols-outlined text-base">arrow_upward</span>
                                <span>+@resumen.Metricas.CrecimientoVentas.ToString("F1")%</span>
                            </div>
                        </div>
                    }
                    
                    <div class="flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                        <p class="text-gray-600 text-sm font-medium">Ocupación de Mesas</p>
                        <p class="text-gray-900 text-3xl font-bold">@((resumen.Metricas.TotalMesas > 0 ? (resumen.Metricas.MesasOcupadas * 100 / resumen.Metricas.TotalMesas) : 0).ToString("F0"))%</p>
                        <div class="flex items-center gap-1 text-red-600 text-sm font-medium">
                            <span class="material-symbols-outlined text-base">arrow_downward</span>
                            <span>-5%</span>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                        <p class="text-gray-600 text-sm font-medium">Producto Más Vendido</p>
                        <p class="text-gray-900 text-3xl font-bold">@(resumen.ProductosMasVendidos.FirstOrDefault()?.Nombre ?? "N/A")</p>
                        <div class="flex items-center gap-1 text-green-600 text-sm font-medium">
                            <span class="material-symbols-outlined text-base">arrow_upward</span>
                            <span>+@(resumen.ProductosMasVendidos.FirstOrDefault()?.PorcentajeTotal.ToString("F1") ?? "0")%</span>
                        </div>
                    </div>
                    
                    @if (canViewFinancialData)
                    {
                        <div class="flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <p class="text-gray-600 text-sm font-medium">@GetVentasTotalLabel()</p>
                            <p class="text-gray-900 text-3xl font-bold">@resumen.Metricas.VentasTotalDia.ToString("C0")</p>
                            <div class="flex items-center gap-1 text-blue-600 text-sm font-medium">
                                <span class="material-symbols-outlined text-base">trending_up</span>
                                <span>Todos los turnos</span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Gráficos Interactivos -->
            <section class="mt-8">
                <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Gráficos Interactivos</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 lg:gap-6">
                    @if (canViewFinancialData)
                    {
                        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <p class="text-gray-800 text-base font-medium mb-4">Ventas por Hora</p>
                            <div class="h-64">
                                <canvas id="graficoVentasHora"></canvas>
                            </div>
                        </div>
                        
                        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <p class="text-gray-800 text-base font-medium mb-4">Ingresos por Categoría</p>
                            <div class="h-64 flex items-center justify-center">
                                <div class="relative w-48 h-48">
                                    <canvas id="graficoIngresosCategoria"></canvas>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2 xl:col-span-1">
                        <p class="text-gray-800 text-base font-medium mb-4">Productos Más Vendidos</p>
                        <div class="h-64">
                            <canvas id="graficoProductosVendidos"></canvas>
                        </div>
                    </div>

                    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2 xl:col-span-1">
                        <p class="text-gray-800 text-base font-medium mb-4">Estados de Mesas</p>
                        <div class="h-64">
                            <canvas id="graficoEstadosMesas"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Métricas en Tiempo Real -->
            @if (canViewOperationalData)
            {
                <section class="mt-8">
                    <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Métricas en Tiempo Real</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center rounded-lg bg-green-100 text-green-600 size-10 shrink-0">
                                <span class="material-symbols-outlined">restaurant</span>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs font-medium">Mesas Ocupadas</p>
                                <p class="text-gray-900 text-lg font-bold">@resumen.EstadoMesas.Ocupadas</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center rounded-lg bg-blue-100 text-blue-600 size-10 shrink-0">
                                <span class="material-symbols-outlined">receipt_long</span>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs font-medium">Comandas Activas</p>
                                <p class="text-gray-900 text-lg font-bold">@resumen.Metricas.ComandasActivas</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center rounded-lg bg-purple-100 text-purple-600 size-10 shrink-0">
                                <span class="material-symbols-outlined">attach_money</span>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs font-medium">Ventas del Día</p>
                                <p class="text-gray-900 text-lg font-bold">$@resumen.Metricas.VentasHoy.ToString("N0")</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center rounded-lg bg-orange-100 text-orange-600 size-10 shrink-0">
                                <span class="material-symbols-outlined">schedule</span>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs font-medium">Tiempo Promedio</p>
                                <p class="text-gray-900 text-lg font-bold">@(resumen?.Metricas.TiempoPromedio ?? 0) min</p>
                            </div>
                        </div>
                    </div>
                </div>
                </section>
            }

            <!-- Vista Rápida de Operaciones -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
                <div class="lg:col-span-2">
                    <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Vista Rápida de Operaciones</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="flex items-center justify-center rounded-lg bg-blue-100 text-blue-600 size-12 shrink-0">
                                    <span class="material-symbols-outlined">receipt_long</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-base font-medium">Comandas Activas</p>
                                    <p class="text-gray-500 text-sm">@resumen.Metricas.ComandasActivas comandas activas</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="flex items-center justify-center rounded-lg bg-purple-100 text-purple-600 size-12 shrink-0">
                                    <span class="material-symbols-outlined">calendar_month</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-base font-medium">Reservaciones del Día</p>
                                    <p class="text-gray-500 text-sm">@(resumen.EstadoMesas.Reservadas) reservaciones hoy</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Mapa Interactivo de Mesas -->
                    <div class="rounded-lg border border-gray-200 bg-white p-4 sm:p-6 shadow-sm mt-6">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-4">
                            <p class="text-gray-800 text-base font-medium">Mapa de Mesas</p>
                            <div class="grid grid-cols-2 sm:flex sm:items-center gap-2 sm:gap-4 text-xs sm:text-sm text-gray-500">
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                                    <span class="hidden sm:inline">Disponible</span>
                                    <span class="sm:hidden">Disp.</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                    <span class="hidden sm:inline">Ocupada</span>
                                    <span class="sm:hidden">Ocup.</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                                    <span class="hidden sm:inline">Reservada</span>
                                    <span class="sm:hidden">Reserv.</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <div class="w-3 h-3 rounded-full bg-gray-500"></div>
                                    <span class="hidden sm:inline">Fuera de Servicio</span>
                                    <span class="sm:hidden">Fuera</span>
                                </div>
                            </div>
                        </div>
                        
                        @if (mesasDetalle != null && mesasDetalle.Any())
                        {
                            <div class="grid grid-cols-2 xs:grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-2 sm:gap-3 overflow-x-auto">
                                @foreach (var mesa in mesasDetalle.OrderBy(m => m.Numero))
                                {
                                    <div class="relative group min-w-0">
                                        <div class="w-full h-12 sm:h-16 rounded-lg border-2 border-gray-300 flex flex-col items-center justify-center text-xs font-medium transition-all duration-200 hover:scale-105 cursor-pointer"
                                             style="background-color: @mesa.Color; border-color: @mesa.Color;"
                                             title="Mesa @mesa.Numero - @mesa.Estado - Capacidad: @mesa.Capacidad - @mesa.Ubicacion">
                                            <div class="text-white font-bold text-xs sm:text-sm">@mesa.Numero</div>
                                            <div class="text-white text-xs opacity-90 hidden sm:block">@mesa.Capacidad</div>
                                        </div>
                                        
                                        <!-- Tooltip mejorado para móvil -->
                                        <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-2 sm:px-3 py-1 sm:py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none z-10 max-w-xs">
                                            <div class="font-semibold text-center">Mesa @mesa.Numero</div>
                                            <div class="text-center">Estado: @mesa.Estado</div>
                                            <div class="text-center">Capacidad: @mesa.Capacidad personas</div>
                                            <div class="text-center text-xs">Ubicación: @mesa.Ubicacion</div>
                                            <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-gray-500">
                                <span class="material-symbols-outlined text-4xl mb-2">table_restaurant</span>
                                <p>No hay datos de mesas disponibles</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Panel Derecho -->
                <div class="flex flex-col gap-6">
                    <!-- Alertas y Notificaciones -->
                    <div>
                        <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Alertas y Notificaciones</h2>
                        <div class="space-y-4">
                            <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-yellow-300 shadow-sm">
                                <div class="flex items-center justify-center rounded-full bg-yellow-100 text-yellow-600 size-10 shrink-0">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-sm font-medium">Tomates casi agotados</p>
                                    <p class="text-gray-500 text-xs">Alerta de bajo stock</p>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-orange-300 shadow-sm">
                                <div class="flex items-center justify-center rounded-full bg-orange-100 text-orange-600 size-10 shrink-0">
                                    <span class="material-symbols-outlined">table_restaurant</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-sm font-medium">Mesas excediendo capacidad</p>
                                    <p class="text-gray-500 text-xs">Alerta de alta ocupación</p>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-red-300 shadow-sm">
                                <div class="flex items-center justify-center rounded-full bg-red-100 text-red-600 size-10 shrink-0">
                                    <span class="material-symbols-outlined">running_with_errors</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-sm font-medium">5 comandas atrasadas</p>
                                    <p class="text-gray-500 text-xs">Alerta de comandas tardías</p>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-blue-300 shadow-sm">
                                <div class="flex items-center justify-center rounded-full bg-blue-100 text-blue-600 size-10 shrink-0">
                                    <span class="material-symbols-outlined">event_available</span>
                                </div>
                                <div>
                                    <p class="text-gray-800 text-sm font-medium">Reserva para 4 a las 7 PM</p>
                                    <p class="text-gray-500 text-xs">Alerta de nueva reservación</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Accesos Rápidos -->
                    <div>
                        <h2 class="text-gray-800 text-xl font-bold leading-tight tracking-tight mb-4">Accesos Rápidos</h2>
                        <div class="grid grid-cols-2 gap-4">
                            <button class="flex items-center justify-center gap-2 rounded-lg bg-gray-100 px-4 py-3 text-gray-700 text-sm font-medium hover:bg-gray-200">
                                <span class="material-symbols-outlined">assessment</span>
                                <span class="truncate">Reportes</span>
                            </button>
                            <button class="flex items-center justify-center gap-2 rounded-lg bg-gray-100 px-4 py-3 text-gray-700 text-sm font-medium hover:bg-gray-200">
                                <span class="material-symbols-outlined">book_online</span>
                                <span class="truncate">Reservas</span>
                            </button>
                            <button class="flex items-center justify-center gap-2 rounded-lg bg-gray-100 px-4 py-3 text-gray-700 text-sm font-medium hover:bg-gray-200">
                                <span class="material-symbols-outlined">inventory</span>
                                <span class="truncate">Inventario</span>
                            </button>
                            <button class="flex items-center justify-center gap-2 rounded-lg bg-gray-100 px-4 py-3 text-gray-700 text-sm font-medium hover:bg-gray-200">
                                <span class="material-symbols-outlined">settings</span>
                                <span class="truncate">Ajustes</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">error</span>
                <p class="text-gray-500 text-lg">Error al cargar el dashboard</p>
                <p class="text-gray-400 text-sm">No se pudieron cargar las métricas del dashboard</p>
                <button class="mt-4 px-4 py-2 bg-[var(--primary-color)] text-white rounded-lg hover:bg-opacity-90 transition-colors" @onclick="ActualizarDatos">
                    Reintentar
                </button>
            </div>
        }

@code {
    private DashboardResumenDto? resumen;
    private bool cargando = true;
    private string periodoSeleccionado = "hoy";
    private string turnoSeleccionado = "todos";
    private List<MesaDetalleDto>? mesasDetalle;
    
    // Constantes para los turnos
    private const string todos = "todos";
    private const string mañana = "mañana";
    private const string tarde = "tarde";
    private const string noche = "noche";
    private const string madrugada = "madrugada";
    private Timer? _timer;
    
    // Variables de permisos
    private bool canViewFinancialData = false;
    private bool canViewOperationalData = false;
    private bool canViewDetailedReports = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarPermisosAsync();
        await CargarDatos();
        
        // Iniciar timer para actualización automática cada 30 segundos
        _timer = new Timer(async _ => await ActualizarMetricasTiempoReal(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task CargarPermisosAsync()
    {
        canViewFinancialData = await PermissionService.CanViewFinancialDataAsync();
        canViewOperationalData = await PermissionService.CanViewOperationalDataAsync();
        canViewDetailedReports = await PermissionService.CanViewDetailedReportsAsync();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            resumen = await DashboardApi.ObtenerDashboardAsync(periodoSeleccionado, turnoSeleccionado);
            mesasDetalle = await DashboardApi.ObtenerMesasDetalleAsync();
            
            if (resumen != null)
            {
                // Esperar un poco y luego intentar crear los gráficos automáticamente
                _ = Task.Run(async () => {
                    await Task.Delay(3000); // Esperar 3 segundos
                    await CrearGraficos();
                });
            }
        }
        catch (Exception ex)
        {
            // Error al cargar datos del dashboard
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task SeleccionarPeriodo(string periodo)
    {
        periodoSeleccionado = periodo;
        
        // Recargar datos con el nuevo período
        await CargarDatos();
    }

    private async Task SeleccionarHoy()
    {
        await SeleccionarPeriodo("hoy");
    }

    private async Task SeleccionarAyer()
    {
        await SeleccionarPeriodo("ayer");
    }

    private async Task SeleccionarSemana()
    {
        await SeleccionarPeriodo("semana");
    }

    private async Task SeleccionarMes()
    {
