@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@using RestaurantePro.Web.Admin.Models
@inject RestaurantePro.Web.Admin.Services.IAuthApiService Auth
@inject NavigationManager Nav
@inject RestaurantePro.Web.Admin.Auth.JwtAuthenticationStateProvider AuthState

<PageTitle>Iniciar sesión - Admin</PageTitle>

<div class="relative flex size-full min-h-screen flex-col group/design-root" style="font-family: Manrope, 'Noto Sans', sans-serif; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 50%, #cbd5e1 100%);">
    <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
        <header class="flex items-center mb-6 text-2xl font-semibold text-gray-800">
            <span class="material-symbols-outlined w-8 h-8 mr-2 text-black" style="font-size: 2rem;">restaurant_menu</span>
            RestaurantePro
        </header>
        
        <div class="w-full bg-white rounded-lg shadow-xl dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
            <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">Inicia sesión en tu cuenta</h1>
                <p class="text-gray-500 dark:text-gray-400">Bienvenido de nuevo a RestaurantePro Admin.</p>
                
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="p-4 mb-4 text-sm text-red-700 bg-red-100 rounded-lg dark:bg-red-200 dark:text-red-800">
                        @error
                    </div>
                }
                
                <EditForm Model="model" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator />
                    <div class="space-y-4 md:space-y-6">
                        <div>
                            <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white" for="email">Email / Usuario</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                                    <span class="material-symbols-outlined text-gray-500 dark:text-gray-400">person</span>
                                </div>
                                <InputText class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block w-full pl-10 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" 
                                          @bind-Value="model.Email" 
                                          placeholder="nombre@email.com" 
                                          type="email" />
                            </div>
                        </div>
                        
                        <div>
                            <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white" for="password">Contraseña</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                                    <span class="material-symbols-outlined text-gray-500 dark:text-gray-400">lock</span>
                                </div>
                                <InputText class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-blue-600 focus:border-blue-600 block w-full pl-10 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" 
                                          @bind-Value="model.Password" 
                                          placeholder="••••••••" 
                                          type="password" />
                            </div>
                        </div>
                        
                        <div class="flex items-center justify-between">
                            <div class="flex items-start">
                                <div class="flex items-center h-5">
                                    <InputCheckbox class="w-4 h-4 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-blue-300 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-blue-600 dark:ring-offset-gray-800" 
                                                  @bind-Value="model.Recordarme" />
                                </div>
                                <div class="ml-3 text-sm">
                                    <label class="text-gray-500 dark:text-gray-300">Recordar mi sesión</label>
                                </div>
                            </div>
                            <a class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-500" href="#">¿Olvidaste tu contraseña?</a>
                        </div>
                        
                        <button class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors duration-200" 
                                type="submit" 
                                disabled="@loading">
                            @if (loading)
                            {
                                <div class="flex items-center justify-center">
                                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                                    Iniciando sesión...
                                </div>
                            }
                            else
                            {
                                @("Iniciar Sesión")
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
        
        <footer class="mt-8 text-center text-sm text-gray-600">
            <p>Contacta con nosotros: support@restaurantepro.com</p>
            <p>Versión 1.2.3</p>
        </footer>
    </div>
</div>

@code {
  private LoginRequest model = new();
  private string error = string.Empty;
  private bool loading = false;

  private string? returnUrl;

  protected override void OnInitialized()
  {
    var uri = new Uri(Nav.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
    returnUrl = query["returnUrl"];
  }

  private async Task LoginAsync()
  {
    error = string.Empty;
    loading = true;
    var resp = await Auth.LoginAsync(model);
    loading = false;
    if (resp is null || !resp.Success || string.IsNullOrWhiteSpace(resp.Token))
    {
      error = "Usuario o contraseña inválidos";
      return;
    }
    
    // Establecer autenticación
    await AuthState.SetAuthAsync(resp);
    
    // Forzar una actualización del estado de autenticación
    await AuthState.InitializeAsync();
    
    // Pequeña pausa para asegurar que el estado se actualice
    await Task.Delay(100);
    
    if (!string.IsNullOrWhiteSpace(returnUrl))
    {
      Nav.NavigateTo(returnUrl, forceLoad: true);
    }
    else
    {
      Nav.NavigateTo("/", forceLoad: true);
    }
  }
}


