            }
            else
            {
                TestOutput.WriteLine("⚠️ Advertencia: Se detectaron elementos del dashboard, posiblemente ya estemos logueados");
            }
            
            // PASO 4: Verificar que el botón siga siendo interactivo
            TestOutput.WriteLine("🔘 PASO 4: Verificando que el botón siga siendo interactivo...");
            
            // Buscar el botón nuevamente para verificar su estado
            var loginButtonAfterClick = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            
            loginButtonAfterClick.Displayed.Should().BeTrue("El botón de login debe seguir visible después del click");
            loginButtonAfterClick.Enabled.Should().BeTrue("El botón de login debe seguir habilitado después del click");
            TestOutput.WriteLine($"✅ Botón de login sigue siendo interactivo después del click");
            
