            Thread.Sleep(3000);
            
            // PASO 1: Verificar que el botón de login esté disponible
            TestOutput.WriteLine("🔘 PASO 1: Verificando disponibilidad del botón de login...");
            
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            
            loginButton.Displayed.Should().BeTrue("El botón de login debe estar visible");
            loginButton.Enabled.Should().BeTrue("El botón de login debe estar habilitado");
            TestOutput.WriteLine($"✅ Botón de login verificado: Visible={loginButton.Displayed}, Enabled={loginButton.Enabled}");
            
            // PASO 2: Verificar que el botón responda al click
            TestOutput.WriteLine("🖱️ PASO 2: Verificando respuesta del botón al click...");
            
            // Hacer click en el botón
            loginButton.Click();
            Thread.Sleep(2000);
            TestOutput.WriteLine("✅ Click en botón de login realizado");
            
            // PASO 3: Verificar que el click no causó errores críticos
            TestOutput.WriteLine("🔍 PASO 3: Verificando que el click no causó errores...");
            
            // Verificar que no estemos en el dashboard (porque no llenamos campos)
            var dashboardElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='Dashboard'] | //android.widget.TextView[contains(@text, 'Mesas')]"));
            
            if (dashboardElements.Count == 0)
            {
