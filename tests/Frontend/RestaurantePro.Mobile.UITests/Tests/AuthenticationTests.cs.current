using FluentAssertions;
using OpenQA.Selenium.Appium.Android;
using RestaurantePro.Mobile.UITests.TestBase;

namespace RestaurantePro.Mobile.UITests.Tests;

/// <summary>
/// Tests de autenticación corregidos y funcionales
/// </summary>
public class AuthenticationTests : AppiumTestBase
{
    public AuthenticationTests(ITestOutputHelper testOutput) : base(testOutput) { }

    [Fact]
    public void LoginWithValidCredentials_ShouldNavigateToDashboard()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de login con credenciales válidas...");
            
            // Esperar a que la app se cargue
            Thread.Sleep(3000);
            
            // PASO 1: Encontrar y limpiar el campo de email
            TestOutput.WriteLine("📧 PASO 1: Buscando campo de email...");
            
            // Buscar el campo de email por múltiples estrategias
            var emailField = Driver.FindElement(By.XPath("//android.widget.EditText[@text='Correo Electrónico'] | //android.widget.EditText[1] | //android.widget.EditText[@hint='Correo Electrónico']"));
            TestOutput.WriteLine($"✅ Campo email encontrado: '{emailField.Text}' - Visible: {emailField.Displayed} - Enabled: {emailField.Enabled}");
            
            // Limpiar el campo
            emailField.Clear();
            Thread.Sleep(500);
            
            // PASO 2: Ingresar email
            TestOutput.WriteLine("📝 PASO 2: Ingresando email...");
            var testEmail = "admin@restaurantepro.com";
            emailField.SendKeys(testEmail);
            Thread.Sleep(1000);
            
            // Verificar que se ingresó correctamente
            var enteredEmail = emailField.Text;
            TestOutput.WriteLine($"📧 Email ingresado: '{enteredEmail}'");
            TestOutput.WriteLine($"🎯 Email esperado: '{testEmail}'");
            TestOutput.WriteLine($"✅ Coinciden: {enteredEmail == testEmail}");
            
            // PASO 3: Buscar campo de contraseña
            TestOutput.WriteLine("🔒 PASO 3: Buscando campo de contraseña...");
            
            // Buscar el campo de contraseña por múltiples estrategias
            var passwordField = Driver.FindElement(By.XPath("//android.widget.EditText[2] | //android.widget.EditText[@hint='Ingrese su contraseña'] | //android.widget.EditText[@text='Ingrese su contraseña']"));
            TestOutput.WriteLine($"✅ Campo contraseña encontrado: '{passwordField.Text}' - Visible: {passwordField.Displayed} - Enabled: {passwordField.Enabled}");
            
            // Limpiar el campo
            passwordField.Clear();
            Thread.Sleep(500);
            
            // PASO 4: Ingresar contraseña
            TestOutput.WriteLine("📝 PASO 4: Ingresando contraseña...");
            var testPassword = "AdminRestaurante123!"; // Contraseña correcta del archivo de configuración
            passwordField.SendKeys(testPassword);
            Thread.Sleep(1000);
            
            // Verificar que se ingresó correctamente
            var enteredPassword = passwordField.Text;
            TestOutput.WriteLine($"🔒 Contraseña ingresada: '{enteredPassword}'");
            TestOutput.WriteLine($"🎯 Contraseña esperada: '{testPassword}'");
            TestOutput.WriteLine($"✅ Coinciden: {enteredPassword == testPassword}");
            
            // PASO 5: Buscar botón de login
            TestOutput.WriteLine("🔘 PASO 5: Buscando botón de login...");
            
            // Buscar todos los botones disponibles para debug
            var allButtons = Driver.FindElements(By.XPath("//android.widget.Button"));
            TestOutput.WriteLine($"🔍 Botones encontrados en la pantalla: {allButtons.Count}");
            
            for (int i = 0; i < allButtons.Count; i++)
            {
                var button = allButtons[i];
                TestOutput.WriteLine($"  Botón {i + 1}: Text='{button.Text}', Visible={button.Displayed}, Enabled={button.Enabled}");
            }
            
            // Buscar el botón por múltiples estrategias
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            TestOutput.WriteLine($"✅ Botón encontrado: '{loginButton.Text}' - Visible: {loginButton.Displayed} - Enabled: {loginButton.Enabled}");
            
            // Verificar que el botón esté habilitado antes de hacer click
            if (!loginButton.Enabled)
            {
                TestOutput.WriteLine("⚠️ Botón de login está deshabilitado, esperando...");
                Thread.Sleep(2000);
            }
            
            // PASO 6: Hacer click en el botón de login
            TestOutput.WriteLine("🖱️ PASO 6: Haciendo click en botón de login...");
                loginButton.Click();
            TestOutput.WriteLine("✅ Click en botón de login realizado");
            
            // PASO 7: Esperar y verificar resultado
            TestOutput.WriteLine("⏳ PASO 7: Esperando resultado del login...");
            Thread.Sleep(5000);
            
            // Verificar si hay mensajes de error
            var errorMessages = Driver.FindElements(By.XPath("//android.widget.TextView[contains(@text, 'Error')] | //android.widget.TextView[contains(@text, 'Incorrecto')] | //android.widget.TextView[contains(@text, 'HTTP')]"));
            
            if (errorMessages.Count > 0)
            {
                foreach (var error in errorMessages)
                {
                    if (error.Displayed)
                    {
                        TestOutput.WriteLine($"❌ Mensaje de error encontrado: '{error.Text}'");
                    }
                }
            }
            
            // PASO 8: Verificar que estamos en el dashboard
            TestOutput.WriteLine("🏠 PASO 8: Verificando navegación al dashboard...");
            
            // Buscar elementos específicos del dashboard
            var dashboardElements = new List<string>
            {
                "//android.widget.TextView[@text='Dashboard']",
                "//android.widget.TextView[@text='RestaurantePro']",
                "//android.widget.TextView[contains(@text, 'Mesas')]",
                "//android.widget.TextView[contains(@text, 'Comandas')]",
                "//android.widget.TextView[contains(@text, 'Pagos')]",
                "//android.widget.TextView[contains(@text, 'Reportes')]"
            };
            
            var foundElements = 0;
            foreach (var xpath in dashboardElements)
            {
                try
                {
                    var element = Driver.FindElement(By.XPath(xpath));
                    if (element.Displayed)
                    {
                        TestOutput.WriteLine($"✅ Elemento del dashboard encontrado: '{element.Text}'");
                        foundElements++;
                    }
                }
                catch
                {
                    // Elemento no encontrado, continuar
                }
            }
            
            TestOutput.WriteLine($"🎯 Elementos del dashboard encontrados: {foundElements}/{dashboardElements.Count}");
            
            // Verificar que al menos algunos elementos del dashboard estén visibles
            foundElements.Should().BeGreaterThan(0, "Debe navegar al dashboard después del login exitoso");
            
            TestOutput.WriteLine("🎉 ¡Test de login completado exitosamente!");
        }
        catch (Exception ex)
        {
            // Tomar screenshot para debug
            try
            {
                var screenshot = ((ITakesScreenshot)Driver).GetScreenshot();
                var screenshotPath = Path.Combine("Screenshots", $"login_error_{DateTime.Now:yyyyMMdd_HHmmss}.png");
                screenshot.SaveAsFile(screenshotPath);
                TestOutput.WriteLine($"📸 Screenshot de error guardado: {screenshotPath}");
            }
            catch { }
            
            TestOutput.WriteLine($"❌ Error en test simple: {ex.Message}");
            throw;
        }
    }

    [Fact]
    public void LoginWithInvalidCredentials_ShouldShowErrorMessage()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de login con credenciales inválidas...");
            
            // Esperar a que la app se cargue
            Thread.Sleep(3000);
            
            // PASO 1: Encontrar y limpiar el campo de email
            TestOutput.WriteLine("📧 PASO 1: Buscando campo de email...");
            
            // Buscar el campo de email por múltiples estrategias
            var emailField = Driver.FindElement(By.XPath("//android.widget.EditText[@text='Correo Electrónico'] | //android.widget.EditText[1] | //android.widget.EditText[@hint='Correo Electrónico']"));
            TestOutput.WriteLine($"✅ Campo email encontrado: '{emailField.Text}' - Visible: {emailField.Displayed} - Enabled: {emailField.Enabled}");
            
            // Limpiar el campo
            emailField.Clear();
            Thread.Sleep(500);
            
            // PASO 2: Ingresar email inválido
            TestOutput.WriteLine("📝 PASO 2: Ingresando email inválido...");
            var invalidEmail = "invalid@example.com";
            emailField.SendKeys(invalidEmail);
            Thread.Sleep(1000);
            
            // PASO 3: Buscar campo de contraseña
            TestOutput.WriteLine("🔒 PASO 3: Buscando campo de contraseña...");
            
            // Buscar el campo de contraseña por múltiples estrategias
            var passwordField = Driver.FindElement(By.XPath("//android.widget.EditText[2] | //android.widget.EditText[@hint='Ingrese su contraseña'] | //android.widget.EditText[@text='Ingrese su contraseña']"));
            TestOutput.WriteLine($"✅ Campo contraseña encontrado: '{passwordField.Text}' - Visible: {passwordField.Displayed} - Enabled: {passwordField.Enabled}");
            
            // Limpiar el campo
            passwordField.Clear();
            Thread.Sleep(500);
            
            // PASO 4: Ingresar contraseña inválida
            TestOutput.WriteLine("📝 PASO 4: Ingresando contraseña inválida...");
            var invalidPassword = "WrongPassword123!";
            passwordField.SendKeys(invalidPassword);
            Thread.Sleep(1000);
            
            // PASO 5: Buscar botón de login
            TestOutput.WriteLine("🔘 PASO 5: Buscando botón de login...");
            
            // Buscar el botón por múltiples estrategias
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            TestOutput.WriteLine($"✅ Botón encontrado: '{loginButton.Text}' - Visible: {loginButton.Displayed} - Enabled: {loginButton.Enabled}");
            
            // PASO 6: Hacer click en el botón de login
            TestOutput.WriteLine("🖱️ PASO 6: Haciendo click en botón de login...");
            loginButton.Click();
            TestOutput.WriteLine("✅ Click en botón de login realizado");
            
            // PASO 7: Esperar y verificar mensaje de error
            TestOutput.WriteLine("⏳ PASO 7: Esperando mensaje de error...");
            Thread.Sleep(3000);
            
            // Verificar si hay mensajes de error
            var errorMessages = Driver.FindElements(By.XPath("//android.widget.TextView[contains(@text, 'Error')] | //android.widget.TextView[contains(@text, 'Incorrecto')] | //android.widget.TextView[contains(@text, 'HTTP')] | //android.widget.TextView[contains(@text, 'inválid')] | //android.widget.TextView[contains(@text, 'incorrect')]"));
            
            if (errorMessages.Count > 0)
            {
                var errorFound = false;
                foreach (var error in errorMessages)
                {
                    if (error.Displayed)
                    {
                        TestOutput.WriteLine($"✅ Mensaje de error encontrado: '{error.Text}'");
                        errorFound = true;
                        
                        // Verificar que el mensaje contenga palabras clave de error
                        var errorText = error.Text.ToLower();
                        var hasErrorKeywords = errorText.Contains("error") || errorText.Contains("incorrect") || errorText.Contains("inválid") || errorText.Contains("incorrecto");
                        
                        if (hasErrorKeywords)
                        {
                            TestOutput.WriteLine($"✅ Mensaje de error válido con palabras clave correctas");
                        }
                        else
                        {
                            TestOutput.WriteLine($"⚠️ Mensaje de error encontrado pero sin palabras clave esperadas");
                        }
                    }
                }
                
                // Verificar que se encontró al menos un mensaje de error
                errorFound.Should().BeTrue("Debe mostrar un mensaje de error para credenciales inválidas");
            }
            else
            {
                // Si no hay mensajes de error visibles, verificar que no estemos en el dashboard
                TestOutput.WriteLine("🔍 No se encontraron mensajes de error, verificando que no estemos en el dashboard...");
                
                var dashboardElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='Dashboard'] | //android.widget.TextView[contains(@text, 'Mesas')]"));
                
                if (dashboardElements.Count == 0)
                {
                    TestOutput.WriteLine("✅ No estamos en el dashboard, lo cual es correcto para credenciales inválidas");
                }
                else
                {
                    throw new Exception("Se navegó al dashboard con credenciales inválidas, lo cual no debería suceder");
                }
            }
            
            TestOutput.WriteLine("🎉 ¡Test de credenciales inválidas completado exitosamente!");
        }
        catch (Exception ex)
        {
            // Tomar screenshot para debug
            try
            {
                var screenshot = ((ITakesScreenshot)Driver).GetScreenshot();
                var screenshotPath = Path.Combine("Screenshots", $"invalid_credentials_error_{DateTime.Now:yyyyMMdd_HHmmss}.png");
                screenshot.SaveAsFile(screenshotPath);
                TestOutput.WriteLine($"📸 Screenshot de error guardado: {screenshotPath}");
            }
            catch { }
            
            TestOutput.WriteLine($"❌ Error en test de credenciales inválidas: {ex.Message}");
            throw;
        }
    }

    [Fact]
    public void LoginWithEmptyCredentials_ShouldShowValidationErrors()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de login con credenciales vacías...");
            
            // Esperar a que la app se cargue
            Thread.Sleep(3000);
            
            // PASO 1: Buscar botón de login directamente (sin llenar campos)
            TestOutput.WriteLine("🔘 PASO 1: Buscando botón de login...");
            
            // Buscar el botón por múltiples estrategias
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            TestOutput.WriteLine($"✅ Botón encontrado: '{loginButton.Text}' - Visible: {loginButton.Displayed} - Enabled: {loginButton.Enabled}");
            
            // PASO 2: Hacer click en el botón de login sin llenar campos
            TestOutput.WriteLine("🖱️ PASO 2: Haciendo click en botón de login sin llenar campos...");
            loginButton.Click();
            TestOutput.WriteLine("✅ Click en botón de login realizado");
            
            // PASO 3: Esperar y verificar mensajes de validación
            TestOutput.WriteLine("⏳ PASO 3: Esperando mensajes de validación...");
            Thread.Sleep(3000);
            
            // Verificar si hay mensajes de error o validación
            var validationMessages = Driver.FindElements(By.XPath("//android.widget.TextView[contains(@text, 'Error')] | //android.widget.TextView[contains(@text, 'Incorrecto')] | //android.widget.TextView[contains(@text, 'requerido')] | //android.widget.TextView[contains(@text, 'obligatorio')] | //android.widget.TextView[contains(@text, 'vací')] | //android.widget.TextView[contains(@text, 'empty')]"));
            
            if (validationMessages.Count > 0)
            {
                var validationFound = false;
                foreach (var message in validationMessages)
                {
                    if (message.Displayed)
                    {
                        TestOutput.WriteLine($"✅ Mensaje de validación encontrado: '{message.Text}'");
                        validationFound = true;
                        
                        // Verificar que el mensaje contenga palabras clave de validación
                        var messageText = message.Text.ToLower();
                        var hasValidationKeywords = messageText.Contains("error") || messageText.Contains("requerido") || messageText.Contains("obligatorio") || messageText.Contains("vací") || messageText.Contains("empty");
                        
                        if (hasValidationKeywords)
                        {
                            TestOutput.WriteLine($"✅ Mensaje de validación válido con palabras clave correctas");
                        }
                        else
                        {
                            TestOutput.WriteLine($"⚠️ Mensaje de validación encontrado pero sin palabras clave esperadas");
                        }
                    }
                }
                
                // Verificar que se encontró al menos un mensaje de validación
                validationFound.Should().BeTrue("Debe mostrar un mensaje de validación para campos vacíos");
            }
            else
            {
                // Si no hay mensajes de validación visibles, verificar que no estemos en el dashboard
                TestOutput.WriteLine("🔍 No se encontraron mensajes de validación, verificando que no estemos en el dashboard...");
                
                var dashboardElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='Dashboard'] | //android.widget.TextView[contains(@text, 'Mesas')]"));
                
                if (dashboardElements.Count == 0)
                {
                    TestOutput.WriteLine("✅ No estamos en el dashboard, lo cual es correcto para campos vacíos");
                }
                else
                {
                    throw new Exception("Se navegó al dashboard con campos vacíos, lo cual no debería suceder");
                }
            }
            
            TestOutput.WriteLine("🎉 ¡Test de campos vacíos completado exitosamente!");
        }
        catch (Exception ex)
        {
            // Tomar screenshot para debug
            try
            {
                var screenshot = ((ITakesScreenshot)Driver).GetScreenshot();
                var screenshotPath = Path.Combine("Screenshots", $"empty_credentials_error_{DateTime.Now:yyyyMMdd_HHmmss}.png");
                screenshot.SaveAsFile(screenshotPath);
                TestOutput.WriteLine($"📸 Screenshot de error guardado: {screenshotPath}");
            }
            catch { }
            
            TestOutput.WriteLine($"❌ Error en test de campos vacíos: {ex.Message}");
            throw;
        }
    }

    [Fact]
    public void LoginWithInvalidEmailFormat_ShouldShowValidationError()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de login con formato de email inválido...");
            
            // Esperar a que la app se cargue
            Thread.Sleep(3000);
            
            // PASO 1: Encontrar y limpiar el campo de email
            TestOutput.WriteLine("📧 PASO 1: Buscando campo de email...");
            
            // Buscar el campo de email por múltiples estrategias
            var emailField = Driver.FindElement(By.XPath("//android.widget.EditText[@text='Correo Electrónico'] | //android.widget.EditText[1] | //android.widget.EditText[@hint='Correo Electrónico']"));
            TestOutput.WriteLine($"✅ Campo email encontrado: '{emailField.Text}' - Visible: {emailField.Displayed} - Enabled: {emailField.Enabled}");
            
            // Limpiar el campo
            emailField.Clear();
            Thread.Sleep(500);
            
            // PASO 2: Ingresar email con formato inválido
            TestOutput.WriteLine("📝 PASO 2: Ingresando email con formato inválido...");
            var invalidEmail = "invalid-email-format"; // Email sin @ ni dominio válido
            emailField.SendKeys(invalidEmail);
            Thread.Sleep(1000);
            
            // PASO 3: Buscar campo de contraseña
            TestOutput.WriteLine("🔒 PASO 3: Buscando campo de contraseña...");
            
            // Buscar el campo de contraseña por múltiples estrategias
            var passwordField = Driver.FindElement(By.XPath("//android.widget.EditText[2] | //android.widget.EditText[@hint='Ingrese su contraseña'] | //android.widget.EditText[@text='Ingrese su contraseña']"));
            TestOutput.WriteLine($"✅ Campo contraseña encontrado: '{passwordField.Text}' - Visible: {passwordField.Displayed} - Enabled: {passwordField.Enabled}");
            
            // Limpiar el campo
            passwordField.Clear();
            Thread.Sleep(500);
            
            // PASO 4: Ingresar contraseña válida (para probar solo el formato del email)
            TestOutput.WriteLine("📝 PASO 4: Ingresando contraseña válida...");
            var validPassword = "AdminRestaurante123!";
            passwordField.SendKeys(validPassword);
            Thread.Sleep(1000);
            
            // PASO 5: Buscar botón de login
            TestOutput.WriteLine("🔘 PASO 5: Buscando botón de login...");
            
            // Buscar el botón por múltiples estrategias
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            TestOutput.WriteLine($"✅ Botón encontrado: '{loginButton.Text}' - Visible: {loginButton.Displayed} - Enabled: {loginButton.Enabled}");
            
            // PASO 6: Hacer click en el botón de login
            TestOutput.WriteLine("🖱️ PASO 6: Haciendo click en botón de login...");
            loginButton.Click();
            TestOutput.WriteLine("✅ Click en botón de login realizado");
            
            // PASO 7: Esperar y verificar mensaje de validación de formato
            TestOutput.WriteLine("⏳ PASO 7: Esperando mensaje de validación de formato...");
            Thread.Sleep(3000);
            
            // Verificar si hay mensajes de error o validación de formato
            var validationMessages = Driver.FindElements(By.XPath("//android.widget.TextView[contains(@text, 'Error')] | //android.widget.TextView[contains(@text, 'formato')] | //android.widget.TextView[contains(@text, 'email')] | //android.widget.TextView[contains(@text, 'válido')] | //android.widget.TextView[contains(@text, 'inválido')] | //android.widget.TextView[contains(@text, 'incorrecto')]"));
            
            if (validationMessages.Count > 0)
            {
                var validationFound = false;
                foreach (var message in validationMessages)
                {
                    if (message.Displayed)
                    {
                        TestOutput.WriteLine($"✅ Mensaje de validación encontrado: '{message.Text}'");
                        validationFound = true;
                        
                        // Verificar que el mensaje contenga palabras clave de validación de formato
                        var messageText = message.Text.ToLower();
                        var hasFormatKeywords = messageText.Contains("email") || messageText.Contains("formato") || messageText.Contains("válido") || messageText.Contains("inválido");
                        
                        if (hasFormatKeywords)
                        {
                            TestOutput.WriteLine($"✅ Mensaje de validación de formato válido con palabras clave correctas");
                        }
                        else
                        {
                            TestOutput.WriteLine($"⚠️ Mensaje de validación encontrado pero sin palabras clave de formato esperadas");
                        }
                    }
                }
                
                // Verificar que se encontró al menos un mensaje de validación
                validationFound.Should().BeTrue("Debe mostrar un mensaje de validación para formato de email inválido");
            }
            else
            {
                // Si no hay mensajes de validación visibles, verificar que no estemos en el dashboard
                TestOutput.WriteLine("🔍 No se encontraron mensajes de validación, verificando que no estemos en el dashboard...");
                
                var dashboardElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='Dashboard'] | //android.widget.TextView[contains(@text, 'Mesas')]"));
                
                if (dashboardElements.Count == 0)
                {
                    TestOutput.WriteLine("✅ No estamos en el dashboard, lo cual es correcto para formato de email inválido");
                }
                else
                {
                    throw new Exception("Se navegó al dashboard con formato de email inválido, lo cual no debería suceder");
                }
            }
            
            TestOutput.WriteLine("🎉 ¡Test de formato de email inválido completado exitosamente!");
        }
        catch (Exception ex)
        {
            // Tomar screenshot para debug
            try
            {
                var screenshot = ((ITakesScreenshot)Driver).GetScreenshot();
                var screenshotPath = Path.Combine("Screenshots", $"invalid_email_format_error_{DateTime.Now:yyyyMMdd_HHmmss}.png");
                screenshot.SaveAsFile(screenshotPath);
                TestOutput.WriteLine($"📸 Screenshot de error guardado: {screenshotPath}");
            }
            catch { }
            
            TestOutput.WriteLine($"❌ Error en test de formato de email inválido: {ex.Message}");
            throw;
        }
    }

    [Fact]
    public void LoginPage_ShouldDisplayAllRequiredElements()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de verificación de elementos requeridos...");
            
            // Esperar a que la app se cargue
            Thread.Sleep(3000);
            
            // PASO 1: Verificar título principal de la página
            TestOutput.WriteLine("📋 PASO 1: Verificando título principal...");
            
            var titleElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='RestaurantePro'] | //android.widget.TextView[contains(@text, 'Restaurante')] | //android.widget.TextView[contains(@text, 'Login')] | //android.widget.TextView[contains(@text, 'Iniciar')]"));
            
            if (titleElements.Count > 0)
            {
                var titleFound = false;
                foreach (var title in titleElements)
                {
                    if (title.Displayed)
                    {
                        TestOutput.WriteLine($"✅ Título encontrado: '{title.Text}'");
                        titleFound = true;
                        break;
                    }
                }
                
                titleFound.Should().BeTrue("Debe mostrar un título principal en la página de login");
            }
            else
            {
                TestOutput.WriteLine("⚠️ No se encontró título principal, continuando con otros elementos...");
            }
            
            // PASO 2: Verificar campo de email
            TestOutput.WriteLine("📧 PASO 2: Verificando campo de email...");
            
            var emailField = Driver.FindElement(By.XPath("//android.widget.EditText[@text='Correo Electrónico'] | //android.widget.EditText[1] | //android.widget.EditText[@hint='Correo Electrónico']"));
            
            emailField.Displayed.Should().BeTrue("El campo de email debe estar visible");
            emailField.Enabled.Should().BeTrue("El campo de email debe estar habilitado");
            TestOutput.WriteLine($"✅ Campo email verificado: Visible={emailField.Displayed}, Enabled={emailField.Enabled}");
            
            // PASO 3: Verificar campo de contraseña
            TestOutput.WriteLine("🔒 PASO 3: Verificando campo de contraseña...");
            
            var passwordField = Driver.FindElement(By.XPath("//android.widget.EditText[2] | //android.widget.EditText[@hint='Ingrese su contraseña'] | //android.widget.EditText[@text='Ingrese su contraseña']"));
            
            passwordField.Displayed.Should().BeTrue("El campo de contraseña debe estar visible");
            passwordField.Enabled.Should().BeTrue("El campo de contraseña debe estar habilitado");
            TestOutput.WriteLine($"✅ Campo contraseña verificado: Visible={passwordField.Displayed}, Enabled={passwordField.Enabled}");
            
            // PASO 4: Verificar botón de login
            TestOutput.WriteLine("🔘 PASO 4: Verificando botón de login...");
            
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            
            loginButton.Displayed.Should().BeTrue("El botón de login debe estar visible");
            loginButton.Enabled.Should().BeTrue("El botón de login debe estar habilitado");
            TestOutput.WriteLine($"✅ Botón login verificado: Visible={loginButton.Displayed}, Enabled={loginButton.Enabled}, Text='{loginButton.Text}'");
            
            // PASO 5: Verificar checkbox "Recordarme" (si existe)
            TestOutput.WriteLine("☑️ PASO 5: Verificando checkbox 'Recordarme'...");
            
            var rememberMeCheckboxes = Driver.FindElements(By.XPath("//android.widget.CheckBox | //android.widget.CheckBox[@text='Recordarme'] | //android.widget.CheckBox[contains(@text, 'Recordar')]"));
            
            if (rememberMeCheckboxes.Count > 0)
            {
                var rememberMeFound = false;
                foreach (var checkbox in rememberMeCheckboxes)
                {
                    if (checkbox.Displayed)
                    {
                        TestOutput.WriteLine($"✅ Checkbox 'Recordarme' encontrado: '{checkbox.Text}' - Visible: {checkbox.Displayed}");
                        rememberMeFound = true;
                        
                        // Verificar que esté habilitado
                        checkbox.Enabled.Should().BeTrue("El checkbox 'Recordarme' debe estar habilitado");
                        break;
                    }
                }
                
                if (!rememberMeFound)
                {
                    TestOutput.WriteLine("⚠️ Checkbox 'Recordarme' encontrado pero no visible");
                }
            }
            else
            {
                TestOutput.WriteLine("ℹ️ Checkbox 'Recordarme' no encontrado (opcional)");
            }
            
            // PASO 6: Verificar otros elementos de UI (labels, textos informativos)
            TestOutput.WriteLine("📝 PASO 6: Verificando otros elementos de UI...");
            
            var allTextViews = Driver.FindElements(By.XPath("//android.widget.TextView"));
            var visibleTexts = new List<string>();
            
            foreach (var textView in allTextViews)
            {
                if (textView.Displayed && !string.IsNullOrEmpty(textView.Text))
                {
                    visibleTexts.Add(textView.Text);
                }
            }
            
            TestOutput.WriteLine($"📋 Textos visibles encontrados ({visibleTexts.Count}):");
            foreach (var text in visibleTexts.Take(10)) // Mostrar solo los primeros 10
            {
                TestOutput.WriteLine($"   • {text}");
            }
            
            if (visibleTexts.Count > 5)
            {
                TestOutput.WriteLine("✅ Se encontraron suficientes elementos de texto en la UI");
            }
            else
            {
                TestOutput.WriteLine("⚠️ Pocos elementos de texto encontrados");
            }
            
            // PASO 7: Verificar que no estemos en el dashboard
            TestOutput.WriteLine("🔍 PASO 7: Verificando que estemos en la página de login...");
            
            var dashboardElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='Dashboard'] | //android.widget.TextView[contains(@text, 'Mesas')]"));
            
            if (dashboardElements.Count == 0)
            {
                TestOutput.WriteLine("✅ Correcto: Estamos en la página de login, no en el dashboard");
            }
            else
            {
                TestOutput.WriteLine("⚠️ Advertencia: Se detectaron elementos del dashboard, posiblemente ya estemos logueados");
            }
            
            TestOutput.WriteLine("🎉 ¡Test de verificación de elementos requeridos completado exitosamente!");
        }
        catch (Exception ex)
        {
            // Tomar screenshot para debug
            try
            {
                var screenshot = ((ITakesScreenshot)Driver).GetScreenshot();
                var screenshotPath = Path.Combine("Screenshots", $"required_elements_error_{DateTime.Now:yyyyMMdd_HHmmss}.png");
                screenshot.SaveAsFile(screenshotPath);
                TestOutput.WriteLine($"📸 Screenshot de error guardado: {screenshotPath}");
            }
            catch { }
            
            TestOutput.WriteLine($"❌ Error en test de verificación de elementos requeridos: {ex.Message}");
            throw;
        }
    }

    [Fact]
    public void LoginPage_ShouldAllowBasicInteraction()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de interacción básica...");
            
            // Esperar a que la app se cargue
            Thread.Sleep(3000);
            
            // PASO 1: Encontrar y interactuar con el campo de email
            TestOutput.WriteLine("📧 PASO 1: Interactuando con campo de email...");
            
            var emailField = Driver.FindElement(By.XPath("//android.widget.EditText[@text='Correo Electrónico'] | //android.widget.EditText[1] | //android.widget.EditText[@hint='Correo Electrónico']"));
            
            // Verificar que esté habilitado
            emailField.Enabled.Should().BeTrue("El campo de email debe estar habilitado para interacción");
            
            // Hacer click en el campo
            emailField.Click();
            Thread.Sleep(500);
            TestOutput.WriteLine("✅ Click en campo email realizado");
            
            // Limpiar el campo
            emailField.Clear();
            Thread.Sleep(500);
            TestOutput.WriteLine("✅ Campo email limpiado");
            
            // Ingresar texto de prueba
            var testEmail = "test@example.com";
            emailField.SendKeys(testEmail);
            Thread.Sleep(1000);
            TestOutput.WriteLine($"✅ Texto ingresado en email: '{testEmail}'");
            
            // Verificar que el texto se ingresó correctamente
            var emailText = emailField.Text;
            if (!string.IsNullOrEmpty(emailText))
            {
                TestOutput.WriteLine($"✅ Texto en campo email: '{emailText}'");
            }
            else
            {
                TestOutput.WriteLine("⚠️ Campo email no muestra el texto ingresado");
            }
            
            // PASO 2: Interactuar con el campo de contraseña
            TestOutput.WriteLine("🔒 PASO 2: Interactuando con campo de contraseña...");
            
            // Buscar el campo de contraseña con múltiples estrategias más robustas
            var passwordField = Driver.FindElement(By.XPath("//android.widget.EditText[2] | //android.widget.EditText[@hint='Ingrese su contraseña'] | //android.widget.EditText[@text='Ingrese su contraseña'] | //android.widget.EditText[@password='true'] | //android.widget.EditText[contains(@hint, 'contraseña')] | //android.widget.EditText[contains(@hint, 'password')] | //android.widget.EditText[contains(@text, 'contraseña')] | //android.widget.EditText[contains(@text, 'password')]"));
            
            // Verificar que esté habilitado
            passwordField.Enabled.Should().BeTrue("El campo de contraseña debe estar habilitado para interacción");
            
            // Hacer click en el campo
            passwordField.Click();
            Thread.Sleep(500);
            TestOutput.WriteLine("✅ Click en campo contraseña realizado");
            
            // Limpiar el campo
            passwordField.Clear();
            Thread.Sleep(500);
            TestOutput.WriteLine("✅ Campo contraseña limpiado");
            
            // Ingresar texto de prueba
            var testPassword = "TestPassword123!";
            passwordField.SendKeys(testPassword);
            Thread.Sleep(1000);
            TestOutput.WriteLine($"✅ Texto ingresado en contraseña: '{testPassword}'");
            
            // Verificar que el texto se ingresó correctamente
            var passwordText = passwordField.Text;
            if (!string.IsNullOrEmpty(passwordText))
            {
                TestOutput.WriteLine($"✅ Texto en campo contraseña: '{passwordText}'");
            }
            else
            {
                TestOutput.WriteLine("⚠️ Campo contraseña no muestra el texto ingresado");
            }
            
            // PASO 3: Interactuar con el botón de login
            TestOutput.WriteLine("🔘 PASO 3: Interactuando con botón de login...");
            
            var loginButton = Driver.FindElement(By.XPath("//android.widget.Button[@text='Iniciar Sesión'] | //android.widget.Button[contains(@text, 'Iniciar')] | //android.widget.Button[1]"));
            
            // Verificar que esté habilitado
            loginButton.Enabled.Should().BeTrue("El botón de login debe estar habilitado para interacción");
            
            // Verificar que esté visible
            loginButton.Displayed.Should().BeTrue("El botón de login debe estar visible para interacción");
            
            // Hacer click en el botón
            loginButton.Click();
            Thread.Sleep(2000);
            TestOutput.WriteLine("✅ Click en botón de login realizado");
            
            // PASO 4: Verificar que la interacción no causó errores críticos
            TestOutput.WriteLine("🔍 PASO 4: Verificando que la interacción no causó errores...");
            
            // Verificar que no estemos en el dashboard (porque usamos credenciales de prueba)
            var dashboardElements = Driver.FindElements(By.XPath("//android.widget.TextView[@text='Dashboard'] | //android.widget.TextView[contains(@text, 'Mesas')]"));
            
            if (dashboardElements.Count == 0)
            {
                TestOutput.WriteLine("✅ Correcto: No estamos en el dashboard (esperado con credenciales de prueba)");
            }
            else
            {
                TestOutput.WriteLine("⚠️ Advertencia: Se detectaron elementos del dashboard, posiblemente las credenciales de prueba sean válidas");
            }
            
            // Verificar que los campos sigan siendo interactivos
            emailField.Enabled.Should().BeTrue("El campo de email debe seguir habilitado después de la interacción");
            passwordField.Enabled.Should().BeTrue("El campo de contraseña debe seguir habilitado después de la interacción");
            loginButton.Enabled.Should().BeTrue("El botón de login debe seguir habilitado después de la interacción");
            
            TestOutput.WriteLine("🎉 ¡Test de interacción básica completado exitosamente!");
        }
        catch (Exception ex)
        {
            // Tomar screenshot para debug
            try
            {
                var screenshot = ((ITakesScreenshot)Driver).GetScreenshot();
                var screenshotPath = Path.Combine("Screenshots", $"basic_interaction_error_{DateTime.Now:yyyyMMdd_HHmmss}.png");
                screenshot.SaveAsFile(screenshotPath);
                TestOutput.WriteLine($"📸 Screenshot de error guardado: {screenshotPath}");
                }
                catch { }
                
            TestOutput.WriteLine($"❌ Error en test de interacción básica: {ex.Message}");
            throw;
        }
    }

    [Fact]
    public void LoginPage_ShouldAllowButtonClick()
    {
        try
        {
            TestOutput.WriteLine("🚀 Iniciando test de verificación de clicks en botones...");
            
